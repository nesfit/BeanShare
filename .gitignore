deploy/deploy.sh
deploy/setup-keycloak-fly.sh
deploy/fly-*.toml

# Ad-hoc test scripts (not the .NET integration tests)
tests/*.js
tests/*.md

# Production configs (may contain secrets)
**/appsettings.Production.json

# Playwright MCP scratch snapshots/screenshots
.playwright-mcp/
