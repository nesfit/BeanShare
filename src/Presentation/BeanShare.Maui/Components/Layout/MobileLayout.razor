@inherits LayoutComponentBase
@using BeanShare.Maui.Components.Layout
@using Microsoft.AspNetCore.Components.Authorization
@using BeanShare.Maui.Services
@using BeanShare.Application.Features.Spaces.Dtos
@using BeanShare.Application.Features.CoffeeStock.Dtos
@using BeanShare.SharedUi.Components.Consumption.Models
@using BeanShare.SharedUi.Services
@using Microsoft.Extensions.Logging
@using BeanShare.Application.Abstractions
@inject NavigationManager Navigation
@inject IActiveQrService ActiveQrService
@inject QrCodeResolveCache QrResolveCache
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserContext UserContext
@inject ISpacesService SpacesService
@inject IStockService StockService
@inject IConsumptionService ConsumptionService
@inject IPresetService PresetService
@inject ILogger<MobileLayout> Logger
@inject IAlertService AlertService
@implements IDisposable

<div class="mobile-app-container">
    <AuthorizeView>
        <Authorized>
            <MobileHeader Title="@GetPageTitle()"
                         Subtitle="@GetPageSubtitle()"
                         ShowBackButton="@ShouldShowBackButton()"
                         ShowSearch="@ShouldShowSearch()"
                         ShowNotifications="true"
                         ShowMenu="true"
                         OnSearch="HandleSearch"
                         OnBack="HandleBack" />

            <main class="mobile-content">
                <CascadingValue Value="RefreshCallback">
                    @ChildContent
                </CascadingValue>
            </main>

            <BottomTabBar CurrentSpaceId="@currentSpaceId"
                         OnCreateSpace="ShowCreateSpace"
                         OnJoinSpace="ShowJoinSpace"
                         OnLogConsumption="ShowLogConsumption"
                         OnAddStock="ShowAddStock" />
        </Authorized>
        <NotAuthorized>
            <div class="mobile-auth-container">
                @ChildContent
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

@if (showCreateSpaceModal)
{
    <BeanShare.SharedUi.Components.Spaces.CreateSpaceModal IsVisible="true" OnSubmit="HandleCreateSpaceSubmit" OnCancel="CloseCreateSpace" />
}

@if (showJoinSpaceModal)
{
    <BeanShare.SharedUi.Components.Spaces.JoinSpaceModal IsVisible="true" OnSubmit="HandleJoinSpaceSubmit" OnCancel="CloseJoinSpace" />
}

<BeanShare.SharedUi.Components.Consumption.QuickConsumptionModal
    IsVisible="@showConsumptionModal"
    Spaces="@userSpaces"
    DefaultSpaceId="@currentSpaceId"
    StockProducts="@quickConsumptionStock"
    Presets="@quickConsumptionPresets"
    SpaceMembers="@quickConsumptionMembers"
    IsLoadingStock="@isLoadingQuickConsumptionData"
    OnSpaceSelected="HandleQuickConsumptionSpaceSelected"
    OnSubmit="HandleQuickConsumptionSubmit"
    OnCancel="CloseConsumptionModal"
    OnScanQr="HandleQuickScanQr"
    CurrentUserId="@UserContext.CurrentUserId.Value" />

<BeanShare.SharedUi.Components.Consumption.QrScannerModal
    IsVisible="@showQuickQrScanner"
    OnScanned="HandleQuickQrScanned"
    OnClose="@(() => showQuickQrScanner = false)" />

<BeanShare.SharedUi.Components.Consumption.QrConsumptionConfirmModal
    IsVisible="@showQuickQrConfirm"
    Payload="@quickQrPayload"
    SpaceMembers="@quickConsumptionMembers"
    CurrentUserId="@UserContext.CurrentUserId.Value"
    QuickPresets="@quickConsumptionPresets"
    OnConfirm="HandleQuickQrConfirm"
    OnCancel="@(() => { showQuickQrConfirm = false; quickQrPayload = null; })" />

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string CurrentRoute { get; set; } = "/";

    private string currentSpaceId = "";
    private bool showCreateSpaceModal = false;
    private bool showJoinSpaceModal = false;
    private bool showConsumptionModal = false;
    private bool isRefreshing = false;
    private EventCallback<bool> RefreshCallback;

    // Quick consumption modal state
    private List<SpaceSummaryDto>? userSpaces;
    private List<StockLevelDto>? quickConsumptionStock;
    private List<PresetOption>? quickConsumptionPresets;
    private List<MembershipDto>? quickConsumptionMembers;
    private bool isLoadingQuickConsumptionData;

    // QR scanner state
    private bool showQuickQrScanner;
    private bool showQuickQrConfirm;
    private QrConsumptionPayload? quickQrPayload;

    protected override async Task OnInitializedAsync()
    {
        RefreshCallback = EventCallback.Factory.Create<bool>(this, HandleRefresh);
        UpdateCurrentSpaceId();
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateCurrentSpaceId();
        StateHasChanged();
    }

    private void UpdateCurrentSpaceId()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        var segments = path.Split('/');

        if (segments.Length >= 2 && segments[0] == "spaces" && Guid.TryParse(segments[1], out _))
        {
            currentSpaceId = segments[1];
        }
    }

    private string GetPageTitle()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);

        if (segments.Length == 0)
            return "BeanShare";

        return segments[0] switch
        {
            "spaces" when segments.Length == 1 => "My Spaces",
            "spaces" when segments.Length >= 2 => GetSpacePageTitle(segments),
            "profile" => "Profile",
            "settings" => "Settings",
            "notifications" => "Notifications",
            "help" => "Help & Support",
            _ => "BeanShare"
        };
    }

    private string GetSpacePageTitle(string[] segments)
    {
        if (segments.Length >= 3)
        {
            return segments[2] switch
            {
                "stock" => "Stock",
                "consumption" => "Consumption",
                _ => "Space Details"
            };
        }
        return "Space Details";
    }

    private string? GetPageSubtitle()
    {
        return null;
    }

    private bool ShouldShowBackButton()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        return !string.IsNullOrEmpty(path) && path != "spaces";
    }

    private bool ShouldShowSearch()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        return path == "spaces" || path.Contains("/stock") || path.Contains("/consumption");
    }

    private async Task HandleSearch(string query)
    {
        Navigation.NavigateTo($"/spaces?q={Uri.EscapeDataString(query)}");
    }

    private void HandleBack()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (path.Contains("/stock") || path.Contains("/consumption"))
        {
            Navigation.NavigateTo($"/spaces/{currentSpaceId}");
        }
        else
        {
            Navigation.NavigateTo("/spaces");
        }
    }

    private async Task HandleRefresh(bool isRefreshing)
    {
        this.isRefreshing = isRefreshing;
        StateHasChanged();

        if (isRefreshing)
        {
            await Task.Delay(1500);
            this.isRefreshing = false;
            StateHasChanged();
        }
    }

    private void ShowCreateSpace()
    {
        showCreateSpaceModal = true;
    }

    private void CloseCreateSpace()
    {
        showCreateSpaceModal = false;
    }

    private async Task HandleCreateSpaceSubmit((string Name, string CurrencyCode) spaceData)
    {
        try
        {
            var spaceId = await SpacesService.CreateSpaceAsync(spaceData.Name, spaceData.CurrencyCode);
            showCreateSpaceModal = false;
            if (spaceId.HasValue)
            {
                Navigation.NavigateTo($"/spaces/{spaceId.Value}");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating space");
            await AlertService.ShowAlertAsync("Error", "Failed to create space. Please try again.");
            showCreateSpaceModal = false;
        }
    }

    private void ShowJoinSpace()
    {
        showJoinSpaceModal = true;
    }

    private void CloseJoinSpace()
    {
        showJoinSpaceModal = false;
    }

    private async Task HandleJoinSpaceSubmit(string inviteCode)
    {
        try
        {
            var success = await SpacesService.JoinSpaceAsync(inviteCode);
            showJoinSpaceModal = false;
            if (success)
            {
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error joining space");
            await AlertService.ShowAlertAsync("Error", "Failed to join space. Please check the invite code and try again.");
            showJoinSpaceModal = false;
        }
    }

    private async Task ShowLogConsumption()
    {
        try
        {
            userSpaces = await SpacesService.GetUserSpacesAsync();
            quickConsumptionStock = null;
            quickConsumptionPresets = null;
            showConsumptionModal = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading spaces for quick consumption");
            await AlertService.ShowAlertAsync("Error", "Failed to load spaces. Please try again.");
        }
    }

    private void CloseConsumptionModal()
    {
        showConsumptionModal = false;
        quickConsumptionStock = null;
        quickConsumptionPresets = null;
        quickConsumptionMembers = null;
    }

    private async Task HandleQuickConsumptionSpaceSelected(Guid spaceId)
    {
        isLoadingQuickConsumptionData = true;
        quickConsumptionStock = null;
        quickConsumptionPresets = null;
        quickConsumptionMembers = null;
        StateHasChanged();

        try
        {
            var stockTask = StockService.GetSpaceStockAsync(spaceId);
            var presetsTask = PresetService.GetQuickPresetsAsync(spaceId);
            var spaceTask = SpacesService.GetSpaceByIdAsync(spaceId);

            await Task.WhenAll(stockTask, presetsTask, spaceTask);

            var stockResult = await stockTask;
            if (stockResult?.StockLevels != null)
            {
                quickConsumptionStock = stockResult.StockLevels.ToList();
            }

            quickConsumptionPresets = await presetsTask;

            var spaceResult = await spaceTask;
            if (spaceResult?.Members != null)
            {
                quickConsumptionMembers = spaceResult.Members.ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading space data for quick consumption");
            await AlertService.ShowAlertAsync("Error", "Failed to load space data. Please try again.");
        }
        finally
        {
            isLoadingQuickConsumptionData = false;
            StateHasChanged();
        }
    }

    private async Task HandleQuickConsumptionSubmit(QuickConsumptionRequest request)
    {
        try
        {
            var targetUserIds = new List<Guid?>();
            if (request.ForUserIds != null && request.ForUserIds.Count > 0)
            {
                targetUserIds.AddRange(request.ForUserIds.Select(id => (Guid?)id));
            }
            else
            {
                targetUserIds.Add(null); // null = myself
            }

            var successCount = 0;
            foreach (var targetUserId in targetUserIds)
            {
                var success = await ConsumptionService.RecordConsumptionAsync(
                    request.SpaceId,
                    request.ProductName,
                    request.ProductBrand,
                    request.ProductType,
                    request.Grams,
                    request.ConsumedAt,
                    request.PresetName,
                    targetUserId,
                    request.StockLotId
                );
                if (success) successCount++;
            }

            if (successCount > 0)
            {
                showConsumptionModal = false;
                var msg = successCount == 1
                    ? $"Logged {request.Grams}g of coffee!"
                    : $"Logged {request.Grams}g of coffee for {successCount} members!";
                await AlertService.ShowAlertAsync("Success", msg);
            }
            else
            {
                await AlertService.ShowAlertAsync("Error", "Failed to log consumption. Please try again.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error logging consumption");
            await AlertService.ShowAlertAsync("Error", "Failed to log consumption. Please try again.");
        }
    }

    private void ShowAddStock()
    {
        if (!string.IsNullOrEmpty(currentSpaceId))
        {
            Navigation.NavigateTo($"/spaces/{currentSpaceId}/stock");
        }
        else
        {
            Navigation.NavigateTo("/spaces");
        }
    }

    private void HandleQuickScanQr()
    {
        showConsumptionModal = false;
        showQuickQrScanner = true;
    }

    private async Task HandleQuickQrScanned(QrConsumptionPayload payload)
    {
        showQuickQrScanner = false;

        if (payload.Version >= 2 && payload.QrCodeId.HasValue)
        {
            try
            {
                var resolved = await ActiveQrService.ResolveActiveQrCodeAsync(payload.QrCodeId.Value);
                if (resolved != null)
                {
                    payload.SpaceId = resolved.SpaceId;
                    payload.ProductName = resolved.ProductName;
                    payload.ProductBrand = resolved.ProductBrand;
                    payload.ProductType = resolved.ProductType;
                    payload.DefaultGrams = resolved.DefaultGrams;
                    payload.QrLabel = resolved.Label;
                    payload.RecipeName = resolved.RecipeName;
                    payload.StockLotId = resolved.StockLotId;
                    QrResolveCache.Store(payload.QrCodeId.Value, payload);
                }
                else
                {
                    await AlertService.ShowAlertAsync("Error", "QR code not found or deactivated.");
                    return;
                }
            }
            catch
            {
                var cached = QrResolveCache.TryGet(payload.QrCodeId.Value);
                if (cached != null)
                {
                    payload.SpaceId = cached.SpaceId;
                    payload.ProductName = cached.ProductName;
                    payload.ProductBrand = cached.ProductBrand;
                    payload.ProductType = cached.ProductType;
                    payload.DefaultGrams = cached.DefaultGrams;
                    payload.QrLabel = cached.QrLabel;
                    payload.RecipeName = cached.RecipeName;
                    payload.StockLotId = cached.StockLotId;
                }
                else
                {
                    await AlertService.ShowAlertAsync("Error", "Could not resolve QR code. Check your connection.");
                    return;
                }
            }
        }

        quickQrPayload = payload;
        showQuickQrConfirm = true;
        StateHasChanged();
    }

    private async Task HandleQuickQrConfirm(ConsumptionFormModel model)
    {
        var spaceId = quickQrPayload?.SpaceId ?? (Guid.TryParse(currentSpaceId, out var sid) ? sid : Guid.Empty);
        // Capture the bound bag before clearing the payload; an empty/gone bag falls back server-side.
        var stockLotId = quickQrPayload?.StockLotId;

        showQuickQrConfirm = false;
        quickQrPayload = null;

        var request = new QuickConsumptionRequest
        {
            SpaceId = spaceId,
            ProductName = model.ProductName ?? "Coffee",
            ProductBrand = model.ProductBrand ?? "Generic",
            ProductType = model.ProductType ?? "Ground",
            Grams = model.Grams,
            ConsumedAt = model.ConsumedAt.ToUniversalTime(),
            PresetName = model.PresetName,
            ForUserIds = model.ForUserIds,
            StockLotId = stockLotId
        };

        await HandleQuickConsumptionSubmit(request);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}