@page "/spaces/{SpaceId}/presets"
@using BeanShare.Contracts.Presets
@using BeanShare.Maui.Components.Layout
@using BeanShare.Maui.Services
@using System.Net.Http.Headers
@using Microsoft.Extensions.Logging
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IPresetService PresetService
@inject IAlertService AlertService

<div class="mobile-page">
    <MobileHeader Title="Coffee Presets" />

    <!-- Global Presets Section -->
    <div class="global-presets-section">
        <div class="global-presets-header" @onclick="ToggleGlobalPresetsSection">
            <div class="global-presets-title">
                <span class="material-symbols-outlined">language</span>
                <span>Built-in Quick Presets</span>
                <span class="badge-count">@(globalPresets?.Count(p => p.IsEnabled) ?? 0) on</span>
            </div>
            <span class="material-symbols-outlined">@(isGlobalPresetsSectionOpen ? "expand_less" : "expand_more")</span>
        </div>

        @if (isGlobalPresetsSectionOpen)
        {
            <div class="global-presets-content">
                <p class="global-presets-desc">Enable or disable built-in quick presets for this space.</p>

                @if (isLoadingGlobalPresets)
                {
                    <div class="loading-container" style="padding: 1rem;">
                        <div class="spinner"></div>
                    </div>
                }
                else if (globalPresets == null || !globalPresets.Any())
                {
                    <p style="text-align: center; color: var(--bs-text-subtle); padding: 1rem;">No built-in presets available.</p>
                }
                else
                {
                    <div class="global-presets-list">
                        @foreach (var preset in globalPresets)
                        {
                            <div class="global-preset-item @(preset.IsEnabled ? "" : "disabled")">
                                <div class="global-preset-info">
                                    <span class="global-preset-name">@preset.Name (@preset.DefaultGrams g)</span>
                                    <span class="global-preset-detail">@preset.CoffeeType · @preset.Preparation</span>
                                </div>
                                <label class="toggle-switch">
                                    <input type="checkbox" checked="@preset.IsEnabled" @onchange="() => ToggleGlobalPreset(preset)" disabled="@isTogglingPreset" />
                                    <span class="toggle-slider"></span>
                                </label>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <div class="content">
        @if (isLoading)
        {
            <div class="loading-container">
                <div class="spinner"></div>
                <p>Loading presets...</p>
            </div>
        }
        else if (presets == null || !presets.Any())
        {
            <div class="empty-state">
                <span class="material-symbols-outlined" style="font-size: 48px; color: var(--bs-primary);">coffee</span>
                <h3>No Presets Yet</h3>
                <p>Create your first coffee preset to speed up logging</p>
                <button class="btn btn-primary" @onclick="ShowCreateModal">
                    Create Preset
                </button>
            </div>
        }
        else
        {
            <div class="presets-list">
                @foreach (var preset in presets)
                {
                    <div class="preset-card">
                        <div class="preset-header">
                            <h4>@preset.Name</h4>
                            @if (preset.IsOwner)
                            {
                                <span class="badge">Mine</span>
                            }
                        </div>

                        <div class="preset-details">
                            <span class="detail">@preset.CoffeeType</span>
                            <span class="detail">@preset.DefaultGrams g</span>
                        </div>

                        @if (!string.IsNullOrEmpty(preset.Notes))
                        {
                            <p class="preset-notes">@preset.Notes</p>
                        }

                        <div class="preset-actions">
                            <button class="btn btn-sm btn-primary" @onclick="() => UsePreset(preset)">
                                Use
                            </button>
                            @if (preset.IsOwner)
                            {
                                @* Was btn-secondary (grey) — a destructive action with no
                                   danger signal at all, sitting 8px from the "Use" button. *@
                                <button class="btn btn-sm btn-danger" @onclick="() => RequestDeletePreset(preset)">
                                    Delete
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            <button class="fab" @onclick="ShowCreateModal">
                <span class="material-symbols-outlined">add</span>
            </button>
        }
    </div>
</div>

@* Simple modal for creating preset *@
@if (showCreateModal)
{
    <div class="modal-overlay" @onclick="HideCreateModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <h3>New Preset</h3>

            <div class="form-group">
                <label>Name</label>
                <input type="text" @bind="presetName" placeholder="Morning Espresso" />
            </div>

            <div class="form-group">
                <label>Type</label>
                <input type="text" @bind="presetCoffeeType" placeholder="Arabica" />
            </div>

            <div class="form-group">
                <label>Preparation Method</label>
                <select @bind="presetPreparation">
                    <option value="">-- Select --</option>
                    <option value="Espresso">Espresso</option>
                    <option value="Filter">Filter</option>
                    <option value="French Press">French Press</option>
                    <option value="Aeropress">Aeropress</option>
                    <option value="V60">V60</option>
                    <option value="Chemex">Chemex</option>
                    <option value="Moka Pot">Moka Pot</option>
                    <option value="Cold Brew">Cold Brew</option>
                </select>
            </div>

            <div class="form-group">
                <label>Default Amount (g)</label>
                <input type="number" @bind="presetDefaultGrams" min="1" max="1000" />
            </div>

            <div class="form-group">
                <label>Notes (optional)</label>
                <textarea @bind="presetNotes" rows="2"></textarea>
            </div>

            @* Retagged from the mobile-only .btn family onto .bs-btn so this row
               uses the shared emphasis tokens instead of a parallel vocabulary. *@
            <div class="bs-hero-actions">
                <button type="button" class="bs-btn bs-btn-primary bs-btn-hero" @onclick="CreatePreset" disabled="@isCreating">
                    @(isCreating ? "Creating..." : "Create")
                </button>
                <button type="button" class="bs-btn bs-btn-quiet" @onclick="HideCreateModal">Cancel</button>
            </div>
        </div>
    </div>
}

@* Wording mirrors BlazorWeb's Spaces/Presets.razor, which already gated this. *@
<ConfirmDialog IsVisible="@showDeleteDialog"
               Title="Delete preset?"
               Message="@($"Delete preset '{pendingDeleteName}'? This can't be undone.")"
               ConfirmText="Delete"
               IsDestructive="true"
               IsProcessing="@isDeleting"
               OnConfirm="ConfirmDeletePreset"
               OnCancel="@(() => showDeleteDialog = false)" />

@code {
    [Parameter]
    public string SpaceId { get; set; } = "";

    private List<PresetDto>? presets;
    private List<SpaceGlobalPresetDto>? globalPresets;
    private bool isLoading = true;
    private bool isLoadingGlobalPresets = false;
    private bool isGlobalPresetsSectionOpen = false;
    private bool isTogglingPreset = false;
    private bool showCreateModal = false;
    private bool isCreating = false;
    private bool showDeleteDialog = false;
    private bool isDeleting = false;
    private Guid pendingDeleteId;
    private string pendingDeleteName = "this preset";

    // Form fields for binding
    private string presetName = "";
    private string presetCoffeeType = "";
    private string presetPreparation = "Espresso";
    private int presetDefaultGrams = 18;
    private string presetNotes = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadPresets();
        await LoadGlobalPresets();
    }

    private async Task LoadPresets()
    {
        try
        {
            isLoading = true;
            var response = await Http.GetAsync($"/api/spaces/{SpaceId}/presets");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<GetSpacePresetsResponse>();
                presets = result?.Presets?.ToList();
            }
        }
        catch (Exception ex)
        {
            await AlertService.ShowAlertAsync("Error", $"Failed to load presets: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowCreateModal()
    {
        showCreateModal = true;
        // Reset form fields
        presetName = "";
        presetCoffeeType = "";
        presetPreparation = "Espresso";
        presetDefaultGrams = 18;
        presetNotes = "";
    }

    private void HideCreateModal()
    {
        showCreateModal = false;
    }

    private async Task CreatePreset()
    {
        if (string.IsNullOrEmpty(presetName) ||
            string.IsNullOrEmpty(presetCoffeeType) ||
            string.IsNullOrEmpty(presetPreparation))
        {
            return;
        }

        if (!Guid.TryParse(SpaceId, out var spaceGuid))
        {
            // Invalid SpaceId, cannot create preset
            return;
        }

        try
        {
            isCreating = true;
            var newPreset = new CreatePresetRequest
            {
                SpaceId = spaceGuid,
                Name = presetName,
                CoffeeType = presetCoffeeType,
                DefaultGrams = presetDefaultGrams,
                Preparation = presetPreparation,
                Notes = presetNotes,
                IsShared = true
            };

            var response = await Http.PostAsJsonAsync("/api/presets", newPreset);
            if (response.IsSuccessStatusCode)
            {
                HideCreateModal();
                await LoadPresets();
            }
        }
        catch (Exception ex)
        {
            await AlertService.ShowAlertAsync("Error", $"Failed to create preset: {ex.Message}");
        }
        finally
        {
            isCreating = false;
        }
    }

    private void RequestDeletePreset(PresetDto preset)
    {
        pendingDeleteId = preset.Id;
        pendingDeleteName = preset.Name;
        showDeleteDialog = true;
    }

    private async Task ConfirmDeletePreset()
    {
        isDeleting = true;
        try
        {
            var response = await Http.DeleteAsync($"/api/presets/{pendingDeleteId}");
            if (response.IsSuccessStatusCode)
            {
                await LoadPresets();
            }
        }
        catch (Exception ex)
        {
            await AlertService.ShowAlertAsync("Error", $"Failed to delete preset: {ex.Message}");
        }
        finally
        {
            isDeleting = false;
            showDeleteDialog = false;
        }
    }

    private void UsePreset(PresetDto preset)
    {
        Navigation.NavigateTo($"/spaces/{SpaceId}/consumption?presetId={preset.Id}");
    }

    private void ToggleGlobalPresetsSection()
    {
        isGlobalPresetsSectionOpen = !isGlobalPresetsSectionOpen;
    }

    private async Task LoadGlobalPresets()
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid))
            return;

        try
        {
            isLoadingGlobalPresets = true;
            globalPresets = await PresetService.GetSpaceGlobalPresetsAsync(spaceGuid);
        }
        catch (Exception ex)
        {
            await AlertService.ShowAlertAsync("Error", $"Failed to load global presets: {ex.Message}");
            globalPresets = new List<SpaceGlobalPresetDto>();
        }
        finally
        {
            isLoadingGlobalPresets = false;
        }
    }

    private async Task ToggleGlobalPreset(SpaceGlobalPresetDto preset)
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid))
            return;

        try
        {
            isTogglingPreset = true;
            StateHasChanged();

            var success = await PresetService.ToggleGlobalPresetAsync(spaceGuid, preset.GlobalPresetId, !preset.IsEnabled);

            if (success)
            {
                var index = globalPresets?.FindIndex(p => p.GlobalPresetId == preset.GlobalPresetId) ?? -1;
                if (index >= 0 && globalPresets != null)
                {
                    globalPresets[index] = new SpaceGlobalPresetDto
                    {
                        GlobalPresetId = preset.GlobalPresetId,
                        Name = preset.Name,
                        CoffeeType = preset.CoffeeType,
                        Preparation = preset.Preparation,
                        DefaultGrams = preset.DefaultGrams,
                        Description = preset.Description,
                        IsEnabled = !preset.IsEnabled,
                        DisplayOrder = preset.DisplayOrder
                    };
                }
            }
        }
        catch (Exception ex)
        {
            await AlertService.ShowAlertAsync("Error", $"Failed to toggle preset: {ex.Message}");
        }
        finally
        {
            isTogglingPreset = false;
            StateHasChanged();
        }
    }
}