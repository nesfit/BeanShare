@page "/spaces/{SpaceId}"
@using BeanShare.SharedUi.Components.Consumption.Models
@using BeanShare.SharedUi.Components.Analytics
@using BeanShare.Application.Features.Analytics.Queries.GetSpaceAnalytics
@using BeanShare.Application.Features.CoffeeStock.Dtos
@using BeanShare.Application.Abstractions
@using BeanShare.Maui.Services
@inject ISpacesService SpacesService
@inject IStockService StockService
@inject IConsumptionService ConsumptionService
@inject IAnalyticsService AnalyticsService
@inject IPresetService PresetService
@inject NavigationManager Navigation
@inject IUserContext UserContext

<PageTitle>@spaceName - BeanShare</PageTitle>

@if (!hasSpace || space == null)
{
    <div class="bs-container" style="padding-top: 4rem; text-align: center;">
        <div class="bs-skeleton" style="width: 12rem; height: 2rem; margin: 0 auto 1rem;"></div>
        <div class="bs-skeleton" style="width: 20rem; height: 1rem; margin: 0 auto;"></div>
    </div>
}
else
{
    <SpaceHeader SpaceId="@SpaceId"
                 SpaceName="@space.Name"
                 InviteCode="@space.InviteCode"
                 ActiveTab="@activeTab"
                 OnTabChange="HandleTabChange"
                 PreventNavigation="true" />

    <div class="bs-container" style="padding: 2rem 0;">
        @if (activeTab == "members")
        {
            <SpaceMembers Members="@space.Members"
                         IsLoading="@isLoadingMembers"
                         IsAdmin="@isAdmin"
                         CurrentUserId="@UserContext.CurrentUserId.Value"
                         OnPromoteMember="HandlePromoteMember"
                         OnDemoteMember="HandleDemoteMember"
                         OnRemoveMember="RequestRemoveMember"
                         OnLeaveSpace="HandleLeaveSpace" />
        }
        else if (activeTab == "stock")
        {
            <div>
                <StockPurchases Purchases="@purchases"
                               IsLoading="@isLoadingStock"
                               CurrencyCode="@(space?.CurrencyCode ?? "USD")"
                               TotalPurchaseCount="@totalPurchaseCount"
                               TotalStockGrams="@totalStockGrams"
                               TotalInvestmentAmount="@totalInvestmentAmount"
                               IsLoadingMore="@isLoadingMorePurchases"
                               OnLoadMore="HandleLoadMorePurchases"
                               OnClonePurchase="HandleClonePurchase" />

                @if (isAdmin)
                {
                    @* See StockPage: .fab clears the bottom tab bar; the old inline
                       `bottom: 2rem` did not. *@
                    <button class="fab"
                            @onclick="@(() => showAddPurchaseModal = true)"
                            title="Add Stock Purchase"
                            aria-label="Add Stock Purchase">
                        <span class="material-symbols-outlined">add</span>
                    </button>
                }
            </div>
        }
        else if (activeTab == "consumption")
        {
            <div class="bs-flex bs-flex-col bs-gap-6">
                <ConsumptionKpis MyCupsToday="@myCupsToday"
                                MyTotalCost="@myTotalCost"
                                RemainingStockGrams="@remainingStock"
                                CurrencyCode="@(space?.CurrencyCode ?? "USD")" />

                <ConsumptionForm OnSubmit="HandleLogConsumption"
                                 OnValidationError="HandleFormValidationError"
                                 StockProducts="@stockProducts"
                                 QuickPresets="@quickPresets"
                                 SpaceMembers="@space?.Members?.ToList()"
                                 CurrentUserId="@UserContext.CurrentUserId.Value" />

                <RecentConsumptionList RecentLogs="@recentConsumptions"
                                      IsLoading="@isLoadingConsumption" />
            </div>
        }
        else if (activeTab == "analytics")
        {
            <SpaceAnalytics Analytics="@spaceAnalytics"
                           IsLoading="@isLoadingAnalytics" />
        }
        else if (activeTab == "billing")
        {
            <div style="text-align: center; padding: 2rem;">
                <p>Manage billing periods for this space.</p>
                <button class="bs-btn bs-btn-primary" @onclick='@(() => Navigation.NavigateTo($"/spaces/{SpaceId}/billing"))'>
                    Go to Billing
                </button>
            </div>
        }
        else if (activeTab == "settlements")
        {
            <div style="text-align: center; padding: 2rem;">
                <p>View and manage settlements for this space.</p>
                <button class="bs-btn bs-btn-primary" @onclick='@(() => Navigation.NavigateTo($"/spaces/{SpaceId}/settlements"))'>
                    Go to Settlements
                </button>
            </div>
        }
        else if (activeTab == "presets")
        {
            <div style="text-align: center; padding: 2rem;">
                <p>Navigate to the presets page to manage your coffee presets.</p>
                <button class="bs-btn bs-btn-primary" @onclick='@(() => Navigation.NavigateTo($"/spaces/{SpaceId}/presets"))'>
                    Go to Presets
                </button>
            </div>
        }
    </div>
}

<AddPurchaseModal IsVisible="@showAddPurchaseModal"
                 OnSubmit="HandleAddPurchase"
                 OnCancel="HandleAddPurchaseCancel"
                 CurrencyCode="@(space?.CurrencyCode ?? "USD")"
                 PrefillFrom="@purchasePrefill" />

<ConfirmDialog IsVisible="@showRemoveDialog"
               Title="Remove member?"
               Message="@($"Remove {pendingRemoveName} from this space? They'll lose access to its data and can only rejoin with an invite code. Their past consumption stays in the records.")"
               ConfirmText="Remove"
               IsDestructive="true"
               IsProcessing="@isRemoving"
               OnConfirm="ExecuteRemoveMember"
               OnCancel="@(() => showRemoveDialog = false)" />

<Toast IsVisible="@showToast"
       IsError="@isToastError"
       Title="@toastTitle"
       Message="@toastMessage"
       OnClose="@(() => showToast = false)" />

@code {
    [Parameter]
    public string SpaceId { get; set; } = "";

    private SpaceDto? space;
    private string spaceName => space?.Name ?? "Loading...";
    private bool hasSpace => !string.IsNullOrEmpty(SpaceId) && space != null;
    private bool isAdmin;
    private string activeTab = "members";

    private bool isLoadingMembers = false;
    private bool isLoadingStock;
    private bool isLoadingConsumption;
    private bool isLoadingAnalytics;

    private List<StockPurchaseDto> purchases = new();
    private int totalPurchaseCount;
    private decimal totalStockGrams;
    private decimal totalInvestmentAmount;
    private int currentPurchasePage = 1;
    private bool isLoadingMorePurchases;
    private List<StockLevelDto> stockProducts = new();
    private List<PresetOption> quickPresets = new();
    private List<ConsumptionEntryDto> recentConsumptions = new();
    private int myCupsToday = 0;
    private decimal myTotalCost = 0m;
    private int remainingStock = 0;
    private SpaceAnalyticsDto? spaceAnalytics;

    private bool showAddPurchaseModal;
    private AddPurchaseModal.PurchasePrefill? purchasePrefill;
    private bool showRemoveDialog;
    private bool isRemoving;
    private string pendingRemoveUserId = "";
    private string pendingRemoveName = "this member";

    private bool showToast;
    private bool isToastError;
    private string toastTitle = "";
    private string toastMessage = "";

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(SpaceId))
        {
            if (!Guid.TryParse(SpaceId, out var spaceGuid))
            {
                Navigation.NavigateTo("/spaces");
                return;
            }
            await LoadSpace();
            await LoadTabData();
        }
    }

    private async Task LoadSpace()
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid))
        {
            Navigation.NavigateTo("/spaces");
            return;
        }

        try
        {
            space = await SpacesService.GetSpaceByIdAsync(spaceGuid);
            if (space != null)
            {
                var currentUserId = UserContext.CurrentUserId.Value;
                isAdmin = space.Members.Any(m => m.UserId == currentUserId && m.Role == "Admin");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load space: {ex.Message}");
        }
    }

    private async Task LoadTabData()
    {
        if (activeTab == "stock")
            await LoadStock();
        else if (activeTab == "consumption")
            await LoadConsumption();
        else if (activeTab == "analytics")
            await LoadAnalytics();
    }

    private async Task LoadStock()
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid))
        {
            Navigation.NavigateTo("/spaces");
            return;
        }

        isLoadingStock = true;
        currentPurchasePage = 1;
        try
        {
            var stockData = await StockService.GetSpaceStockAsync(spaceGuid);
            if (stockData != null)
            {
                purchases = stockData.RecentPurchases.ToList();
                totalPurchaseCount = stockData.TotalPurchaseCount;
                totalStockGrams = stockData.TotalCurrentStockGrams;
                totalInvestmentAmount = stockData.TotalInvestmentAmount;
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load stock: {ex.Message}");
        }
        finally
        {
            isLoadingStock = false;
        }
    }

    private async Task HandleLoadMorePurchases()
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid)) return;

        isLoadingMorePurchases = true;
        StateHasChanged();

        try
        {
            currentPurchasePage++;
            var stockData = await StockService.GetSpaceStockAsync(spaceGuid, currentPurchasePage);
            if (stockData != null)
            {
                purchases.AddRange(stockData.RecentPurchases);
                totalPurchaseCount = stockData.TotalPurchaseCount;
            }
        }
        catch (Exception ex)
        {
            currentPurchasePage--;
            ShowToast(true, "Error", $"Failed to load more purchases: {ex.Message}");
        }
        finally
        {
            isLoadingMorePurchases = false;
            StateHasChanged();
        }
    }

    private async Task LoadConsumption()
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid))
        {
            Navigation.NavigateTo("/spaces");
            return;
        }

        isLoadingConsumption = true;
        StateHasChanged();
        try
        {
            var consumptionTask = ConsumptionService.GetRecentConsumptionsAsync(spaceGuid);
            var stockTask = StockService.GetSpaceStockAsync(spaceGuid);
            var presetsTask = PresetService.GetQuickPresetsAsync(spaceGuid);

            await Task.WhenAll(consumptionTask, stockTask, presetsTask);

            var consumptionData = consumptionTask.Result;
            if (consumptionData != null)
            {
                recentConsumptions = consumptionData.Entries.ToList();
                myCupsToday = consumptionData.MyCupsToday;
                myTotalCost = consumptionData.MyTotalCost;
                remainingStock = consumptionData.RemainingStockGrams;
            }

            var stockData = stockTask.Result;
            if (stockData?.StockLevels != null)
            {
                stockProducts = stockData.StockLevels.ToList();
            }

            quickPresets = presetsTask.Result;
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load consumption: {ex.Message}");
        }
        finally
        {
            isLoadingConsumption = false;
            StateHasChanged();
        }
    }

    private async Task LoadAnalytics()
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid))
        {
            Navigation.NavigateTo("/spaces");
            return;
        }

        isLoadingAnalytics = true;
        try
        {
            spaceAnalytics = await AnalyticsService.GetSpaceAnalyticsAsync(
                spaceGuid,
                DateTime.UtcNow.AddDays(-30),
                DateTime.UtcNow
            );
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load analytics: {ex.Message}");
        }
        finally
        {
            isLoadingAnalytics = false;
        }
    }

    private async Task HandleTabChange(string newTab)
    {
        switch (newTab)
        {
            case "consumption":
                Navigation.NavigateTo($"/spaces/{SpaceId}/consumption");
                return;
            case "stock":
                Navigation.NavigateTo($"/spaces/{SpaceId}/stock");
                return;
            case "billing":
                Navigation.NavigateTo($"/spaces/{SpaceId}/billing");
                return;
            case "settlements":
                Navigation.NavigateTo($"/spaces/{SpaceId}/settlements");
                return;
            case "presets":
                Navigation.NavigateTo($"/spaces/{SpaceId}/presets");
                return;
        }

        activeTab = newTab;
        isLoadingAnalytics = (newTab == "analytics");
        StateHasChanged();
        await LoadTabData();
        StateHasChanged();
    }

    private async Task HandlePromoteMember(string userId)
    {
        if (!Guid.TryParse(userId, out var userGuid) || !Guid.TryParse(SpaceId, out var spaceGuid))
        {
            ShowToast(true, "Error", "Invalid user or space ID");
            return;
        }

        try
        {
            var success = await SpacesService.PromoteMemberAsync(spaceGuid, userGuid);
            if (success)
            {
                ShowToast(false, "Success", "Member promoted to Admin");
                await LoadSpace();
            }
            else
            {
                ShowToast(true, "Error", "Failed to promote member. Please try again.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to promote member: {ex.Message}");
        }
    }

    private async Task HandleDemoteMember(string userId)
    {
        if (!Guid.TryParse(userId, out var userGuid) || !Guid.TryParse(SpaceId, out var spaceGuid))
        {
            ShowToast(true, "Error", "Invalid user or space ID");
            return;
        }

        try
        {
            var success = await SpacesService.DemoteMemberAsync(spaceGuid, userGuid);
            if (success)
            {
                ShowToast(false, "Success", "Member demoted to regular member");
                await LoadSpace();
            }
            else
            {
                ShowToast(true, "Error", "Failed to demote member. Please try again.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to demote member: {ex.Message}");
        }
    }

    // Mirrors BlazorWeb's Members.razor, which already gated this. Removing a member
    // is financially consequential — they drop out of the settlement.
    private void RequestRemoveMember(string userId)
    {
        pendingRemoveUserId = userId;
        pendingRemoveName = space?.Members
            .FirstOrDefault(m => m.UserId.ToString() == userId)?.UserName ?? "this member";
        showRemoveDialog = true;
    }

    private async Task ExecuteRemoveMember()
    {
        isRemoving = true;
        try
        {
            await HandleRemoveMember(pendingRemoveUserId);
        }
        finally
        {
            isRemoving = false;
            showRemoveDialog = false;
        }
    }

    private async Task HandleRemoveMember(string userId)
    {
        if (!Guid.TryParse(userId, out var userGuid) || !Guid.TryParse(SpaceId, out var spaceGuid))
        {
            ShowToast(true, "Error", "Invalid user or space ID");
            return;
        }

        try
        {
            var success = await SpacesService.RemoveMemberAsync(spaceGuid, userGuid);
            if (success)
            {
                var currentUserId = UserContext.CurrentUserId.Value;
                if (userGuid == currentUserId)
                {
                    Navigation.NavigateTo("/spaces");
                    return;
                }
                ShowToast(false, "Success", "Member removed from space");
                await LoadSpace();
            }
            else
            {
                ShowToast(true, "Error", "Failed to remove member. Please try again.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to remove member: {ex.Message}");
        }
    }

    private async Task HandleLeaveSpace()
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid))
        {
            ShowToast(true, "Error", "Invalid space ID");
            return;
        }

        try
        {
            var success = await SpacesService.LeaveSpaceAsync(spaceGuid);
            if (success)
            {
                Navigation.NavigateTo("/spaces");
                return;
            }
            else
            {
                ShowToast(true, "Error", "Failed to leave space. You may have unpaid settlements or be the last admin.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to leave space: {ex.Message}");
        }
    }

    private async Task HandleAddPurchase(AddPurchaseModal.AddPurchaseModel model)
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid))
        {
            ShowToast(true, "Error", "Invalid space ID");
            return;
        }

        try
        {
            var success = await StockService.AddStockPurchaseAsync(
                spaceGuid,
                model.ProductName,
                model.CoffeeType,
                model.QuantityGrams,
                model.TotalCost,
                model.Currency,
                model.PurchasedAt
            );

            if (success)
            {
                showAddPurchaseModal = false;
                purchasePrefill = null;
                ShowToast(false, "Success", "Stock purchase added successfully!");
                await LoadStock();
            }
            else
            {
                ShowToast(true, "Error", "Failed to add purchase. Please try again.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to add purchase: {ex.Message}");
        }
    }

    private void HandleAddPurchaseCancel()
    {
        showAddPurchaseModal = false;
        purchasePrefill = null;
    }

    private void HandleClonePurchase(PurchaseRow.PurchaseCloneModel model)
    {
        purchasePrefill = new AddPurchaseModal.PurchasePrefill
        {
            ProductBrand = model.ProductBrand,
            ProductName = model.ProductName,
            QuantityGrams = model.QuantityGrams,
            CostAmount = model.CostAmount,
            CoffeeType = model.CoffeeType
        };
        showAddPurchaseModal = true;
    }

    private async Task HandleLogConsumption(ConsumptionFormModel model)
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid))
        {
            ShowToast(true, "Error", "Invalid space ID");
            return;
        }

        try
        {
            var targetUserIds = new List<Guid?>();
            if (model.ForUserIds != null && model.ForUserIds.Count > 0)
            {
                targetUserIds.AddRange(model.ForUserIds.Select(id => (Guid?)id));
            }
            else
            {
                targetUserIds.Add(null);
            }

            var successCount = 0;
            foreach (var targetUserId in targetUserIds)
            {
                var success = await ConsumptionService.RecordConsumptionAsync(
                    spaceGuid,
                    model.ProductName ?? "Coffee",
                    model.ProductBrand ?? "Generic",
                    model.ProductType ?? "Ground",
                    model.Grams,
                    model.ConsumedAt.ToUniversalTime(),
                    model.PresetName,
                    targetUserId
                );
                if (success) successCount++;
            }

            if (successCount > 0)
            {
                var msg = successCount == 1
                    ? "Consumption logged successfully!"
                    : $"Logged consumption for {successCount} members!";
                ShowToast(false, "Success", msg);
                await LoadConsumption();
                StateHasChanged();
            }
            else
            {
                ShowToast(true, "Error", "Failed to log consumption. Please try again.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to log consumption: {ex.Message}");
        }
    }

    private void HandleFormValidationError(string message) => ShowToast(true, "Validation", message);

    private void ShowToast(bool isError, string title, string message)
    {
        isToastError = isError;
        toastTitle = title;
        toastMessage = message;
        showToast = true;
    }
}
