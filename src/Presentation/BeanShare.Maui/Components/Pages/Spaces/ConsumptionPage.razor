@page "/spaces/{SpaceId}/consumption"
@using BeanShare.SharedUi.Components.Consumption.Models
@using BeanShare.Application.Features.CoffeeStock.Dtos
@using BeanShare.Application.Features.Consumption.Dtos
@using BeanShare.Application.Features.Presets.Queries
@using BeanShare.Application.Abstractions
@using BeanShare.SharedUi.Services
@using BeanShare.Maui.Services
@inject ISpacesService SpacesService
@inject IConsumptionService ConsumptionService
@inject IStockService StockService
@inject IPresetService PresetService
@inject IUserContext UserContext
@inject NavigationManager Navigation
@inject IAlertService AlertService
@inject IActiveQrService ActiveQrService
@inject QrCodeResolveCache QrResolveCache
@inject SpaceDashboardService DashboardService

<PageTitle>Consumption - @spaceName - BeanShare</PageTitle>

@if (!hasSpace || space == null)
{
    <div class="bs-container" style="padding-top: 4rem; text-align: center;">
        <div class="bs-skeleton" style="width: 12rem; height: 2rem; margin: 0 auto 1rem;"></div>
        <div class="bs-skeleton" style="width: 20rem; height: 1rem; margin: 0 auto;"></div>
    </div>
}
else
{
    <div style="position: sticky; top: 0; z-index: 10; background: var(--bs-background-light); border-bottom: 1px solid var(--bs-border); padding: 1rem 0;">
        <div class="bs-container">
            <div class="bs-flex bs-items-center bs-justify-between" style="margin-bottom: 1rem;">
                <button class="bs-btn-sm" style="background: transparent; border: none; cursor: pointer;" @onclick='@(() => Navigation.NavigateTo("/spaces"))'>
                    <span class="material-symbols-outlined">arrow_back</span>
                </button>
                <h1 class="bs-font-bold" style="margin: 0; font-size: 1.25rem;">@space.Name</h1>
                <div style="width: 2rem;"></div>
            </div>

            <div style="background: var(--bs-gray-100); border-radius: 0.5rem; padding: 0.75rem; margin-bottom: 1rem;">
                <div class="bs-flex bs-items-center bs-justify-between">
                    <span class="bs-text-subtle" style="font-size: 0.75rem; font-weight: 600;">INVITE CODE</span>
                    <div class="bs-flex bs-items-center bs-gap-2">
                        <span style="font-family: monospace; font-size: 0.875rem; font-weight: 700;">@space.InviteCode</span>
                        <button class="bs-btn-sm" style="background: var(--bs-primary-light); color: var(--bs-primary); border: none; padding: 0.25rem 0.5rem;" title="Copy invite code" @onclick="CopyInviteCode">
                            <span class="material-symbols-outlined" style="font-size: 1rem;">content_copy</span>
                        </button>
                    </div>
                </div>
            </div>

            <SpaceTabs SpaceId="@SpaceId"
                      ActiveTab="consumption"
                      OnTabChange="HandleTabChange"
                      PreventNavigation="false" />
        </div>
    </div>

    <div class="bs-container" style="padding: 2rem 0;">
        <div class="bs-flex bs-flex-col bs-gap-6">
            <ConsumptionKpis MyCupsToday="@myCupsToday"
                            MyTotalCost="@myTotalCost"
                            RemainingStockGrams="@remainingStock"
                            CurrencyCode="@(space?.CurrencyCode ?? "USD")" />

            <div class="bs-flex bs-justify-between bs-items-center" style="flex-wrap: wrap; gap: 0.5rem;">
                <button class="bs-btn" style="background: var(--bs-primary-light, #e0e7ff); color: var(--bs-primary); font-size: 0.875rem; gap: 0.375rem;" @onclick="() => showQrScanner = true">
                    <span class="material-symbols-outlined" style="font-size: 1.125rem;">qr_code_scanner</span>
                    Scan QR
                </button>
                @if (isCurrentUserAdmin)
                {
                    <button class="bs-btn" style="background: var(--bs-gray-100); color: var(--bs-text); font-size: 0.875rem; gap: 0.375rem;" @onclick="() => showCsvImport = true">
                        <span class="material-symbols-outlined" style="font-size: 1.125rem;">upload_file</span>
                        Import CSV
                    </button>
                }
            </div>

            <ConsumptionForm OnSubmit="HandleLogConsumption"
                           OnValidationError="HandleFormValidationError"
                           StockProducts="@stockProducts"
                           PresetData="@presetData"
                           QuickPresets="@quickPresets"
                           SpaceMembers="@space?.Members?.ToList()"
                           CurrentUserId="@UserContext.CurrentUserId.Value"
                           DefaultStockLevelId="@(stockProducts.Where(s => s.IsCurrentlyUsed).OrderByDescending(s => s.UpdatedAt).FirstOrDefault()?.Id)" />

            <div>
                <div class="bs-flex bs-items-center bs-justify-between" style="margin-bottom: 0.75rem;">
                    <h2 class="bs-font-bold" style="margin: 0; font-size: 1.125rem;">Recent Logs</h2>
                    <div class="bs-filter-toggle">
                        <button type="button"
                                class="bs-btn bs-btn-sm bs-filter-toggle-btn @(showOnlyMine ? "" : "bs-btn-primary")"
                                @onclick="() => SetRecentFilter(false)">
                            Everyone
                        </button>
                        <button type="button"
                                class="bs-btn bs-btn-sm bs-filter-toggle-btn @(showOnlyMine ? "bs-btn-primary" : "")"
                                @onclick="() => SetRecentFilter(true)">
                            Just Me
                        </button>
                    </div>
                </div>
                <RecentConsumptionList RecentLogs="@recentConsumptions"
                                      IsLoading="@isLoadingConsumption"
                                      OnEdit="HandleEditConsumption"
                                      OnDelete="HandleDeleteConsumption"
                                      HideHeader="true" />
            </div>
        </div>
    </div>
}

<CsvImportModal IsVisible="@showCsvImport"
               OnCancel="@(() => showCsvImport = false)"
               OnImport="HandleCsvImport"
               ImportResult="@csvImportResult"
               OnClose="HandleCsvImportClose" />

<QrScannerModal IsVisible="@showQrScanner"
               OnScanned="HandleQrScanned"
               OnClose="@(() => showQrScanner = false)" />

<QrConsumptionConfirmModal IsVisible="@showQrConfirm"
                          Payload="@scannedPayload"
                          SpaceMembers="@space?.Members?.ToList()"
                          CurrentUserId="@UserContext.CurrentUserId.Value"
                          QuickPresets="@quickPresets"
                          OnConfirm="HandleQrConsumptionConfirm"
                          OnCancel="@(() => { showQrConfirm = false; scannedPayload = null; })" />

@if (qrResolutionFailed)
{
    <div class="bs-toast-banner bs-toast-banner--error">
        <span class="material-symbols-outlined" style="color: #dc2626;">wifi_off</span>
        <div style="flex: 1;">
            <p style="margin: 0; font-size: 0.875rem; font-weight: 600; color: #991b1b;">Could not resolve QR code</p>
            <p style="margin: 0.25rem 0 0 0; font-size: 0.75rem; color: #b91c1c;">Check your connection and try again.</p>
        </div>
        <button class="bs-btn bs-btn-sm bs-btn-primary" @onclick="RetryQrResolution" style="white-space: nowrap;">Retry</button>
        <button class="bs-btn-icon" @onclick="DismissQrRetry" style="background: transparent; border: none; cursor: pointer; padding: 0;">
            <span class="material-symbols-outlined" style="font-size: 1.125rem; color: #991b1b;">close</span>
        </button>
    </div>
}

@if (usingCachedQrData && showQrConfirm)
{
    <div class="bs-toast-banner bs-toast-banner--warning">
        <span class="material-symbols-outlined" style="color: #a16207; font-size: 1.125rem;">cached</span>
        <p style="margin: 0; font-size: 0.75rem; color: #854d0e;">Using cached data — product info may be outdated.</p>
    </div>
}

<Toast IsVisible="@showToast"
       IsError="@isToastError"
       Title="@toastTitle"
       Message="@toastMessage"
       OnClose="@(() => showToast = false)" />

@code {
    [Parameter]
    public string SpaceId { get; set; } = "";

    private SpaceDto? space;
    private string spaceName => space?.Name ?? "Loading...";
    private bool hasSpace => !string.IsNullOrEmpty(SpaceId) && space != null;
    private bool isLoadingConsumption;

    private List<ConsumptionEntryDto> recentConsumptions = new();
    private List<StockLevelDto> stockProducts = new();
    private List<PresetOption> quickPresets = new();
    private int myCupsToday = 0;
    private decimal myTotalCost = 0m;
    private int remainingStock = 0;
    private PresetDto? presetData;

    private bool showToast;
    private bool isToastError;
    private string toastTitle = "";
    private string toastMessage = "";
    private bool showCsvImport;
    private ImportConsumptionCsvResult? csvImportResult;
    private bool isCurrentUserAdmin;
    private bool showOnlyMine;
    private bool showQrScanner;
    private bool showQrConfirm;
    private QrConsumptionPayload? scannedPayload;
    private bool qrResolutionFailed;
    private QrConsumptionPayload? pendingQrPayload;
    private bool usingCachedQrData;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(SpaceId))
        {
            if (!Guid.TryParse(SpaceId, out var spaceGuid))
            {
                Navigation.NavigateTo("/spaces");
                return;
            }

            var dashboard = await DashboardService.GetDashboardAsync(spaceGuid);
            if (dashboard?.Space != null)
            {
                ApplyDashboardData(dashboard);
            }
            else
            {
                await LoadSpace();
                await Task.WhenAll(LoadStock(), LoadConsumption(), LoadQuickPresets());
            }

            await LoadPresetIfProvided();
        }
    }

    private void ApplyDashboardData(SpaceDashboardData dashboard)
    {
        if (dashboard.Space != null)
        {
            space = new SpaceDto
            {
                Id = dashboard.Space.Id,
                Name = dashboard.Space.Name,
                CurrencyCode = dashboard.Space.CurrencyCode,
                InviteCode = dashboard.Space.InviteCode,
                IsActive = dashboard.Space.IsActive,
                MemberCount = dashboard.Space.MemberCount,
                CreatedAt = dashboard.Space.CreatedAt,
                CreatedBy = Guid.Empty,
                Members = dashboard.Space.Members
            };

            var currentUserId = UserContext.CurrentUserId.Value;
            isCurrentUserAdmin = space.Members?.Any(m => m.UserId == currentUserId && m.Role == "Admin") ?? false;
        }

        if (dashboard.Stock?.StockLevels != null)
            stockProducts = dashboard.Stock.StockLevels.Where(s => s.CurrentStockGrams > 0).ToList();

        if (dashboard.Consumption != null)
        {
            recentConsumptions = dashboard.Consumption.Entries.ToList();
            myCupsToday = dashboard.Consumption.MyCupsToday;
            myTotalCost = dashboard.Consumption.MyTotalCost;
            remainingStock = dashboard.Consumption.RemainingStockGrams;
        }

        if (dashboard.Presets?.Presets != null)
        {
            quickPresets = dashboard.Presets.Presets.Select(p => new PresetOption
            {
                GlobalPresetId = p.GlobalPresetId,
                SpacePresetId = p.SpacePresetId,
                Name = p.Name,
                CoffeeType = p.CoffeeType,
                Preparation = p.Preparation,
                Grams = (int)p.DefaultGrams,
                Description = p.Description,
                IsFavorite = p.IsFavorite,
                IsGlobal = p.IsGlobal,
                DisplayOrder = p.DisplayOrder
            }).ToList();
        }
    }

    private async Task LoadPresetIfProvided()
    {
        var uri = Navigation.Uri;
        if (uri.Contains("presetId="))
        {
            var index = uri.IndexOf("presetId=") + 9;
            var endIndex = uri.IndexOf('&', index);
            var presetIdString = endIndex == -1 ? uri.Substring(index) : uri.Substring(index, endIndex - index);

            if (Guid.TryParse(presetIdString, out var presetGuid))
            {
                try
                {
                    var contractsPreset = await PresetService.GetPresetByIdAsync(presetGuid);
                    if (contractsPreset != null)
                    {
                        presetData = new PresetDto(
                            contractsPreset.Id,
                            contractsPreset.UserId,
                            contractsPreset.UserName,
                            contractsPreset.Name,
                            contractsPreset.CoffeeType,
                            contractsPreset.Preparation,
                            contractsPreset.DefaultGrams,
                            contractsPreset.Notes,
                            contractsPreset.IsShared,
                            contractsPreset.IsOwner,
                            contractsPreset.CreatedAt,
                            contractsPreset.LastUsedAt,
                            contractsPreset.UsageCount);
                    }
                }
                catch (Exception ex)
                {
                    ShowToast(true, "Error", $"Failed to load preset: {ex.Message}");
                }
            }
        }
    }

    private async Task LoadSpace()
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid))
        {
            Navigation.NavigateTo("/spaces");
            return;
        }

        try
        {
            space = await SpacesService.GetSpaceByIdAsync(spaceGuid);
            if (space != null)
            {
                var currentUserId = UserContext.CurrentUserId.Value;
                isCurrentUserAdmin = space.Members?.Any(m => m.UserId == currentUserId && m.Role == "Admin") ?? false;
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load space: {ex.Message}");
        }
    }

    private async Task LoadConsumption()
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid))
        {
            Navigation.NavigateTo("/spaces");
            return;
        }

        isLoadingConsumption = true;
        StateHasChanged();

        try
        {
            Guid? filterUserId = showOnlyMine ? UserContext.CurrentUserId.Value : null;
            var consumptionData = await ConsumptionService.GetRecentConsumptionsAsync(spaceGuid, filterUserId);
            if (consumptionData != null)
            {
                recentConsumptions = consumptionData.Entries.ToList();
                myCupsToday = consumptionData.MyCupsToday;
                myTotalCost = consumptionData.MyTotalCost;
                remainingStock = consumptionData.RemainingStockGrams;
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load consumption: {ex.Message}");
        }
        finally
        {
            isLoadingConsumption = false;
            StateHasChanged();
        }
    }

    private async Task SetRecentFilter(bool onlyMine)
    {
        if (showOnlyMine == onlyMine) return;
        showOnlyMine = onlyMine;
        await LoadConsumption();
    }

    private async Task LoadStock()
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid))
        {
            Navigation.NavigateTo("/spaces");
            return;
        }

        try
        {
            var stockData = await StockService.GetSpaceStockAsync(spaceGuid);
            if (stockData != null && stockData.StockLevels != null)
            {
                stockProducts = stockData.StockLevels.Where(s => s.CurrentStockGrams > 0).ToList();
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load stock: {ex.Message}");
        }
    }

    private async Task LoadQuickPresets()
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid))
        {
            return;
        }

        try
        {
            quickPresets = await PresetService.GetQuickPresetsAsync(spaceGuid);
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load presets: {ex.Message}");
        }
    }

    private async Task HandleTabChange(string newTab)
    {
        if (newTab == "members")
        {
            Navigation.NavigateTo($"/spaces/{SpaceId}");
        }
        else if (newTab == "stock")
        {
            Navigation.NavigateTo($"/spaces/{SpaceId}/stock");
        }
    }

    private async Task HandleLogConsumption(ConsumptionFormModel model)
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid))
        {
            ShowToast(true, "Error", "Invalid space ID");
            return;
        }

        try
        {
            var consumedAtUtc = model.ConsumedAt.ToUniversalTime();

            var targetUserIds = new List<Guid?>();
            if (model.ForUserIds != null && model.ForUserIds.Count > 0)
            {
                targetUserIds.AddRange(model.ForUserIds.Select(id => (Guid?)id));
            }
            else
            {
                targetUserIds.Add(null); // null = myself
            }

            var successCount = 0;
            foreach (var targetUserId in targetUserIds)
            {
                var success = await ConsumptionService.RecordConsumptionAsync(
                    spaceGuid,
                    model.ProductName ?? "Coffee",
                    model.ProductBrand ?? "Generic",
                    model.ProductType ?? "Ground",
                    model.Grams,
                    consumedAtUtc,
                    model.PresetName,
                    targetUserId,
                    model.StockLotId
                );
                if (success) successCount++;
            }

            if (successCount > 0)
            {
                var msg = successCount == 1
                    ? "Consumption logged successfully!"
                    : $"Logged consumption for {successCount} members!";
                ShowToast(false, "Success", msg);
                if (Guid.TryParse(SpaceId, out var sid))
                    DashboardService.InvalidateDashboard(sid);
                await LoadConsumption();
                await LoadStock();
                StateHasChanged();
            }
            else
            {
                ShowToast(true, "Error", "Failed to log consumption. Please try again.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to log consumption: {ex.Message}");
        }
    }

    private async Task CopyInviteCode()
    {
        if (space?.InviteCode != null)
        {
            await Clipboard.Default.SetTextAsync(space.InviteCode);
            await AlertService.ShowAlertAsync("Copied", "Invite code copied to clipboard!");
        }
    }

    private async Task HandleCsvImport(IReadOnlyList<ImportConsumptionCsvRow> rows)
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid)) return;

        try
        {
            var result = await ConsumptionService.ImportCsvAsync(spaceGuid, rows);
            if (result != null)
            {
                csvImportResult = result;
                StateHasChanged();
            }
            else
            {
                csvImportResult = new ImportConsumptionCsvResult
                {
                    TotalRows = rows.Count,
                    SuccessCount = 0,
                    ErrorCount = rows.Count,
                    Errors = [new ImportRowError(0, "Import", "Import request failed. Please try again.")]
                };
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"CSV import failed: {ex.Message}");
            showCsvImport = false;
        }
    }

    private async Task HandleCsvImportClose()
    {
        showCsvImport = false;
        csvImportResult = null;
        await LoadConsumption();
        await LoadStock();
    }

    private async Task HandleEditConsumption(ConsumptionEntryDto updated)
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid)) return;

        try
        {
            var success = await ConsumptionService.UpdateConsumptionAsync(
                updated.Id, spaceGuid, updated.ProductName, updated.ProductBrand,
                updated.ProductType, updated.QuantityGrams, updated.ConsumedAt);

            if (success)
            {
                ShowToast(false, "Success", "Consumption updated successfully!");
                await LoadConsumption();
            }
            else
            {
                ShowToast(true, "Error", "Failed to update consumption.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to update consumption: {ex.Message}");
        }
    }

    private async Task HandleDeleteConsumption(Guid consumptionId)
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid)) return;

        try
        {
            var success = await ConsumptionService.DeleteConsumptionAsync(consumptionId, spaceGuid);

            if (success)
            {
                ShowToast(false, "Success", "Consumption deleted successfully!");
                await LoadConsumption();
                await LoadStock();
            }
            else
            {
                ShowToast(true, "Error", "Failed to delete consumption.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to delete consumption: {ex.Message}");
        }
    }

    private async Task HandleQrScanned(QrConsumptionPayload payload)
    {
        showQrScanner = false;
        usingCachedQrData = false;

        if (payload.Version >= 2 && payload.QrCodeId.HasValue)
        {
            var resolved = await TryResolveQrCode(payload);
            if (!resolved) return;
        }

        scannedPayload = payload;
        showQrConfirm = true;
        StateHasChanged();
    }

    private async Task<bool> TryResolveQrCode(QrConsumptionPayload payload)
    {
        try
        {
            var resolved = await ActiveQrService.ResolveActiveQrCodeAsync(payload.QrCodeId!.Value);
            if (resolved != null)
            {
                payload.SpaceId = resolved.SpaceId;
                payload.ProductName = resolved.ProductName;
                payload.ProductBrand = resolved.ProductBrand;
                payload.ProductType = resolved.ProductType;
                payload.DefaultGrams = resolved.DefaultGrams;
                payload.QrLabel = resolved.Label;
                payload.RecipeName = resolved.RecipeName;
                payload.StockLotId = resolved.StockLotId;
                QrResolveCache.Store(payload.QrCodeId.Value, payload);
                return true;
            }

            ShowToast(true, "Error", "Could not resolve QR code. It may have been deactivated.");
            StateHasChanged();
            return false;
        }
        catch
        {
            var cached = QrResolveCache.TryGet(payload.QrCodeId!.Value);
            if (cached != null)
            {
                payload.SpaceId = cached.SpaceId;
                payload.ProductName = cached.ProductName;
                payload.ProductBrand = cached.ProductBrand;
                payload.ProductType = cached.ProductType;
                payload.DefaultGrams = cached.DefaultGrams;
                payload.QrLabel = cached.QrLabel;
                payload.RecipeName = cached.RecipeName;
                payload.StockLotId = cached.StockLotId;
                usingCachedQrData = true;
                return true;
            }

            pendingQrPayload = payload;
            qrResolutionFailed = true;
            StateHasChanged();
            return false;
        }
    }

    private async Task RetryQrResolution()
    {
        if (pendingQrPayload == null) return;
        qrResolutionFailed = false;
        var payload = pendingQrPayload;
        pendingQrPayload = null;

        if (await TryResolveQrCode(payload))
        {
            scannedPayload = payload;
            showQrConfirm = true;
            StateHasChanged();
        }
    }

    private void DismissQrRetry()
    {
        qrResolutionFailed = false;
        pendingQrPayload = null;
    }

    private async Task HandleQrConsumptionConfirm(ConsumptionFormModel model)
    {
        // Carry the bag this QR is bound to (if any) so the cup draws from it; an empty/gone bag
        // falls back to the product's open bag server-side.
        model.StockLotId = scannedPayload?.StockLotId;
        showQrConfirm = false;
        scannedPayload = null;
        usingCachedQrData = false;
        await HandleLogConsumption(model);
    }

    private void HandleFormValidationError(string message) => ShowToast(true, "Validation", message);

    private void ShowToast(bool isError, string title, string message)
    {
        isToastError = isError;
        toastTitle = title;
        toastMessage = message;
        showToast = true;
    }
}