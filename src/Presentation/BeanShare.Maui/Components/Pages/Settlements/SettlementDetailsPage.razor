@page "/spaces/{SpaceId}/settlements/{SettlementId}"
@using BeanShare.Contracts.Settlement
@using BeanShare.Application.Abstractions
@inject ISettlementService SettlementService
@inject ISpacesService SpacesService
@inject IUserContext UserContext
@inject NavigationManager Navigation
@inject IAlertService AlertService
@inject BeanShare.SharedUi.Services.IQrCodeService QrCodeService

<PageTitle>Settlement Details - BeanShare</PageTitle>

<div style="position: sticky; top: 0; z-index: 10; background: var(--bs-background-light); border-bottom: 1px solid var(--bs-border); padding: 1rem 0;">
    <div class="bs-container">
        <div class="bs-flex bs-items-center bs-justify-between" style="margin-bottom: 1rem;">
            <button class="bs-btn-sm" style="background: transparent; border: none; cursor: pointer;" @onclick='@(() => Navigation.NavigateTo($"/spaces/{SpaceId}/settlements"))'>
                <span class="material-symbols-outlined">arrow_back</span>
            </button>
            <h1 class="bs-font-bold" style="margin: 0; font-size: 1.25rem;">Settlement</h1>
            <div style="width: 2rem;"></div>
        </div>
    </div>
</div>

<div class="bs-container" style="padding: 2rem 0;">
    @if (isLoading)
    {
        <div style="text-align: center; padding: 2rem;">
            <div class="bs-skeleton" style="width: 100%; height: 10rem; margin-bottom: 1rem;"></div>
            <div class="bs-skeleton" style="width: 100%; height: 15rem;"></div>
        </div>
    }
    else if (settlement == null)
    {
        <div style="text-align: center; padding: 4rem 2rem;">
            <span class="material-symbols-outlined" style="font-size: 4rem; color: var(--bs-text-subtle); margin-bottom: 1rem;">error</span>
            <h2 style="margin: 0 0 0.5rem 0; font-size: 1.25rem; font-weight: 600;">Settlement Not Found</h2>
            <p class="bs-text-subtle">The settlement you're looking for doesn't exist.</p>
        </div>
    }
    else
    {
        <!-- Settlement Header -->
        <div class="bs-card" style="padding: 2rem; margin-bottom: 1.5rem;">
            <div class="bs-flex bs-items-center bs-justify-between" style="margin-bottom: 0.5rem;">
                <h2 style="margin: 0; font-size: 1.5rem; font-weight: 700;">@settlement.BillingPeriodName</h2>
                <span style="padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; background: @(settlement.Status == "Completed" ? "var(--bs-success-light, rgba(34, 197, 94, 0.1))" : "var(--bs-warning-light, rgba(245, 158, 11, 0.1))"); color: @(settlement.Status == "Completed" ? "var(--bs-success)" : "var(--bs-warning)");">
                    @GetStatusDisplayText(settlement.Status)
                </span>
            </div>
            <p class="bs-text-subtle" style="margin: 0 0 1.5rem 0;">
                Period: @settlement.PeriodStart.ToString("MMM dd") - @settlement.PeriodEnd.ToString("MMM dd, yyyy")
            </p>

            <!-- Payment Confirmation Progress -->
            <div style="background: var(--bs-gray-100); border-radius: 0.5rem; padding: 1rem; margin-bottom: 1.5rem;">
                <div class="bs-flex bs-items-center bs-justify-between" style="margin-bottom: 0.5rem;">
                    <span class="bs-text-subtle" style="font-size: 0.875rem;">Payment Confirmations</span>
                    <span style="font-weight: 600;">@settlement.ConfirmedLinesCount / @settlement.TotalLinesCount</span>
                </div>
                <div style="background: var(--bs-gray-200); border-radius: 9999px; height: 0.5rem; overflow: hidden;">
                    <div style="background: @(settlement.Status == "Completed" ? "var(--bs-success)" : "var(--bs-primary)"); height: 100%; width: @(settlement.TotalLinesCount > 0 ? (int)((double)settlement.ConfirmedLinesCount / settlement.TotalLinesCount * 100) : 0)%; transition: width 0.3s;"></div>
                </div>
                @if (settlement.CompletedAt.HasValue)
                {
                    <p class="bs-text-subtle" style="font-size: 0.75rem; margin: 0.5rem 0 0 0;">
                        Completed: @settlement.CompletedAt.Value.ToString("MMM dd, yyyy 'at' h:mm tt")
                    </p>
                }
            </div>

            <div class="bs-flex bs-gap-4" style="flex-wrap: wrap;">
                <div class="bs-flex-1" style="min-width: 200px;">
                    <p class="bs-text-subtle" style="font-size: 0.875rem; margin: 0 0 0.5rem 0;">Total Amount</p>
                    <p style="font-size: 2rem; font-weight: 700; margin: 0; color: var(--bs-primary);">
                        @settlement.Currency @settlement.TotalAmount.ToString("F2")
                    </p>
                </div>
                <div class="bs-flex-1" style="min-width: 200px;">
                    <p class="bs-text-subtle" style="font-size: 0.875rem; margin: 0 0 0.5rem 0;">Generated</p>
                    <p style="font-size: 1.25rem; font-weight: 600; margin: 0;">
                        @settlement.GeneratedAt.ToString("MMM dd, yyyy 'at' h:mm tt")
                    </p>
                </div>
            </div>
        </div>

        <!-- Who Owes Whom Summary -->
        @if (Debtors.Any() || Creditors.Any())
        {
            <div class="bs-card" style="padding: 1.5rem; margin-bottom: 1.5rem;">
                <h3 style="margin: 0 0 1.25rem 0; font-size: 1.125rem; font-weight: 600;">Who Owes Whom</h3>
                <div class="bs-flex bs-gap-4" style="flex-wrap: wrap;">
                    @if (Debtors.Any())
                    {
                        <div class="bs-flex-1" style="min-width: 160px;">
                            <div class="bs-flex bs-items-center bs-gap-1" style="margin-bottom: 0.75rem;">
                                <span class="material-symbols-outlined" style="color: var(--bs-error, #ef4444); font-size: 1rem;">arrow_upward</span>
                                <span style="font-weight: 600; font-size: 0.75rem; color: var(--bs-error, #ef4444);">OWE MONEY</span>
                            </div>
                            @foreach (var d in Debtors)
                            {
                                <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid var(--bs-border);">
                                    <span style="font-weight: 500; font-size: 0.875rem;">@d.UserName</span>
                                    <span style="font-weight: 700; color: var(--bs-error, #ef4444); font-size: 0.875rem;">@settlement.Currency @Math.Abs(d.NetBalance).ToString("F2")</span>
                                </div>
                            }
                        </div>
                    }
                    @if (Creditors.Any())
                    {
                        <div class="bs-flex-1" style="min-width: 160px;">
                            <div class="bs-flex bs-items-center bs-gap-1" style="margin-bottom: 0.75rem;">
                                <span class="material-symbols-outlined" style="color: var(--bs-success); font-size: 1rem;">arrow_downward</span>
                                <span style="font-weight: 600; font-size: 0.75rem; color: var(--bs-success);">ARE OWED</span>
                            </div>
                            @foreach (var c in Creditors)
                            {
                                <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid var(--bs-border);">
                                    <span style="font-weight: 500; font-size: 0.875rem;">@c.UserName</span>
                                    <span style="font-weight: 700; color: var(--bs-success); font-size: 0.875rem;">@settlement.Currency @c.NetBalance.ToString("F2")</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                @{
                    var transfers = BuildTransfers();
                }
                @if (transfers.Any())
                {
                    <div style="margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--bs-border);">
                        <p class="bs-text-subtle" style="margin: 0 0 0.75rem 0; font-size: 0.8125rem;">Suggested payments to settle up with the fewest transfers.</p>
                        <div class="bs-flex bs-flex-col" style="gap: 0.5rem;">
                            @foreach (var t in transfers)
                            {
                                var isMine = t.FromUserId == currentUserId;
                                var canPay = isMine && !string.IsNullOrEmpty(t.ToRevolutTag);
                                var link = canPay ? RevolutLink(t.ToRevolutTag!, t.Amount, settlement.Currency) : null;
                                <div>
                                    <div class="bs-flex bs-items-center" style="gap: 0.5rem; padding: 0.55rem 0.7rem; background: @(isMine ? "var(--bs-primary-light)" : "var(--bs-gray-50)"); border: 1px solid @(isMine ? "var(--bs-primary)" : "var(--bs-border)"); border-radius: 0.5rem; flex-wrap: wrap;">
                                        <span style="font-weight: 600; font-size: 0.875rem;">@t.From</span>
                                        @if (isMine)
                                        {
                                            <span class="bs-badge bs-badge-primary">You</span>
                                        }
                                        <span class="material-symbols-outlined" style="color: var(--bs-text-subtle); font-size: 1.1rem;">arrow_forward</span>
                                        <span style="font-weight: 600; font-size: 0.875rem;">@t.To</span>
                                        <span style="margin-left: auto; font-weight: 700; color: var(--bs-primary); font-size: 0.875rem;">@settlement.Currency @t.Amount.ToString("F2")</span>
                                        @if (canPay)
                                        {
                                            <button type="button" class="bs-btn bs-btn-sm bs-btn-primary" style="gap: 0.3rem;" @onclick="@(() => OpenPayment(link!))">
                                                <span class="material-symbols-outlined" style="font-size: 1rem;">send</span>
                                                Pay
                                            </button>
                                            <button type="button" class="bs-btn bs-btn-sm bs-btn-ghost" @onclick="@(() => ToggleQr(link!))" aria-label="Show payment QR">
                                                <span class="material-symbols-outlined" style="font-size: 1rem;">qr_code_2</span>
                                            </button>
                                        }
                                    </div>
                                    @if (canPay && openQrLink == link)
                                    {
                                        <div style="text-align: center; padding: 0.6rem;">
                                            <img src="@QrCodeService.GenerateQrCodeBase64ForUrl(link!)" alt="Revolut payment QR" style="width: 160px; height: 160px;" />
                                            <p class="bs-text-subtle" style="font-size: 0.7rem; margin: 0.4rem 0 0 0;">Scan to pay @t.To @settlement.Currency @t.Amount.ToString("F2")</p>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Settlement Lines -->
        <div class="bs-card" style="padding: 1.5rem;">
            <h3 style="margin: 0 0 1.5rem 0; font-size: 1.125rem; font-weight: 600;">Cost Breakdown</h3>

            <div class="bs-flex bs-flex-col bs-gap-3">
                @foreach (var line in settlement.Lines.OrderByDescending(l => l.TotalCoffeeGrams))
                {
                    <div class="bs-card" style="padding: 1.25rem; background: @(line.IsConfirmed ? "var(--bs-success-light, rgba(34, 197, 94, 0.1))" : "var(--bs-gray-50)"); border: 1px solid @(line.IsConfirmed ? "var(--bs-success)" : "var(--bs-border)");">
                        <div class="bs-flex bs-items-start bs-justify-between" style="margin-bottom: 0.75rem;">
                            <div>
                                <div class="bs-flex bs-items-center bs-gap-2" style="margin-bottom: 0.25rem;">
                                    <h4 style="margin: 0; font-size: 1rem; font-weight: 600;">@line.UserName</h4>
                                    @if (line.IsConfirmed)
                                    {
                                        <span class="material-symbols-outlined" style="color: var(--bs-success); font-size: 1.125rem;" title="Payment Confirmed">check_circle</span>
                                    }
                                </div>
                                <p class="bs-text-subtle" style="font-size: 0.75rem; margin: 0;">@line.UserEmail</p>
                            </div>
                            <div style="text-align: right;">
                                <p style="font-size: 1.25rem; font-weight: 700; margin: 0; color: @(line.IsConfirmed ? "var(--bs-success)" : "var(--bs-warning)");">
                                    @settlement.Currency @line.AmountDue.ToString("F2")
                                </p>
                                <p class="bs-text-subtle" style="font-size: 0.75rem; margin: 0;">
                                    @line.ConsumptionPercentage.ToString("F1")% of total
                                </p>
                            </div>
                        </div>

                        <div class="bs-flex bs-gap-3" style="flex-wrap: wrap; margin-bottom: 0.75rem;">
                            <div>
                                <p class="bs-text-subtle" style="font-size: 0.7rem; margin: 0 0 0.2rem 0;">Consumed</p>
                                <p style="font-size: 0.875rem; font-weight: 600; margin: 0;">@line.TotalCoffeeGrams.ToString("F0")g</p>
                            </div>
                            @if (line.TotalMilkMl.HasValue && line.TotalMilkMl.Value > 0)
                            {
                                <div>
                                    <p class="bs-text-subtle" style="font-size: 0.7rem; margin: 0 0 0.2rem 0;">Milk</p>
                                    <p style="font-size: 0.875rem; font-weight: 600; margin: 0;">@line.TotalMilkMl.Value.ToString("F0")ml</p>
                                </div>
                            }
                            <div>
                                <p class="bs-text-subtle" style="font-size: 0.7rem; margin: 0 0 0.2rem 0;">Purchased</p>
                                <p style="font-size: 0.875rem; font-weight: 600; margin: 0; color: var(--bs-success);">@settlement.Currency @line.AmountPaid.ToString("F2")</p>
                            </div>
                            <div>
                                <p class="bs-text-subtle" style="font-size: 0.7rem; margin: 0 0 0.2rem 0;">Balance</p>
                                <p style="font-size: 0.875rem; font-weight: 600; margin: 0; color: @(line.NetBalance >= 0 ? "var(--bs-success)" : "var(--bs-error, #ef4444)");">
                                    @(line.NetBalance >= 0 ? "+" : "")@settlement.Currency @line.NetBalance.ToString("F2")
                                </p>
                            </div>
                        </div>

                        <div style="text-align: right;">
                            @if (line.IsConfirmed)
                            {
                                <p class="bs-text-subtle" style="font-size: 0.75rem; margin: 0;">
                                    Confirmed @(line.ConfirmedAt.HasValue ? line.ConfirmedAt.Value.ToString("MMM dd, yyyy") : "")
                                </p>
                            }
                            else if (CanConfirmPayment(line.UserId))
                            {
                                <button class="bs-btn bs-btn-sm bs-btn-primary"
                                        style="font-size: 0.875rem;"
                                        disabled="@isConfirming"
                                        @onclick="@(() => HandleConfirmPayment(line.UserId))">
                                    @if (isConfirming && confirmingUserId == line.UserId)
                                    {
                                        <span>Confirming...</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined" style="font-size: 1rem; vertical-align: middle;">check</span>
                                        <span>Confirm Payment</span>
                                    }
                                </button>
                            }
                            else
                            {
                                <span class="bs-text-subtle" style="font-size: 0.75rem;">Awaiting confirmation</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Export Actions -->
        <div class="bs-card" style="padding: 1.5rem; margin-top: 1.5rem;">
            <h3 style="margin: 0 0 1rem 0; font-size: 1rem; font-weight: 600;">Export & Share</h3>
            <div class="bs-flex bs-gap-3" style="flex-wrap: wrap;">
                <button class="bs-btn bs-btn-secondary" disabled="@isExporting" @onclick="HandleExportPdf">
                    @if (isExporting && exportType == "pdf")
                    {
                        <span>Exporting...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined">picture_as_pdf</span>
                        <span>Export PDF</span>
                    }
                </button>
                <button class="bs-btn bs-btn-secondary" disabled="@isExporting" @onclick="HandleExportExcel">
                    @if (isExporting && exportType == "excel")
                    {
                        <span>Exporting...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined">table_chart</span>
                        <span>Export Excel</span>
                    }
                </button>
                @if (isAdmin)
                {
                    <button class="bs-btn bs-btn-primary" disabled="@isSendingEmails" @onclick="HandleSendEmails">
                        @if (isSendingEmails)
                        {
                            <span>Sending...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined">mail</span>
                            <span>Email All Members</span>
                        }
                    </button>
                }
            </div>
        </div>

        <!-- Actions -->
        <div style="margin-top: 1.5rem; text-align: center;">
            <button class="bs-btn bs-btn-secondary" @onclick='@(() => Navigation.NavigateTo($"/spaces/{SpaceId}/billing/{settlement.BillingPeriodId}"))'>
                <span class="material-symbols-outlined">calendar_month</span>
                View Billing Period
            </button>
        </div>
    }
</div>

<Toast IsVisible="@showToast"
       IsError="@isToastError"
       Title="@toastTitle"
       Message="@toastMessage"
       OnClose="@(() => showToast = false)" />

@code {
    [Parameter]
    public string SpaceId { get; set; } = "";

    [Parameter]
    public string SettlementId { get; set; } = "";

    private SettlementDto? settlement;
    private bool isLoading = true;
    private bool showToast;
    private bool isToastError;
    private string toastTitle = "";
    private string toastMessage = "";

    private Guid currentUserId;
    private bool isAdmin;
    private bool isConfirming;
    private Guid confirmingUserId;

    private List<BeanShare.Contracts.Settlement.SettlementLineDto> Debtors => settlement?.Lines.Where(l => l.NetBalance < -0.01m).OrderBy(l => l.NetBalance).ToList() ?? new();
    private List<BeanShare.Contracts.Settlement.SettlementLineDto> Creditors => settlement?.Lines.Where(l => l.NetBalance > 0.01m).OrderByDescending(l => l.NetBalance).ToList() ?? new();

    private sealed record Transfer(string From, string To, decimal Amount, string? ToRevolutTag, Guid FromUserId);

    private string? openQrLink;
    private void ToggleQr(string link) => openQrLink = openQrLink == link ? null : link;

    private static string RevolutLink(string tag, decimal amount, string currency)
    {
        var amt = amount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        var ccy = (currency ?? string.Empty).ToUpperInvariant();
        return $"https://revolut.me/{tag}/{amt}{ccy}";
    }

    private async Task OpenPayment(string link)
    {
        try
        {
            await Launcher.Default.OpenAsync(new Uri(link));
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Couldn't open Revolut: {ex.Message}");
        }
    }

    // Greedy min-transfer settlement: match the largest debtor to the largest creditor.
    private List<Transfer> BuildTransfers()
    {
        var transfers = new List<Transfer>();
        if (settlement == null)
        {
            return transfers;
        }

        var debtors = settlement.Lines
            .Where(l => l.NetBalance < -0.01m)
            .Select(l => new { l.UserName, l.UserId, Amount = -l.NetBalance })
            .OrderByDescending(x => x.Amount)
            .ToList();
        var creditors = settlement.Lines
            .Where(l => l.NetBalance > 0.01m)
            .Select(l => new { l.UserName, Amount = l.NetBalance, l.RevolutTag })
            .OrderByDescending(x => x.Amount)
            .ToList();

        int i = 0, j = 0;
        var owe = debtors.Select(d => d.Amount).ToList();
        var due = creditors.Select(c => c.Amount).ToList();
        while (i < debtors.Count && j < creditors.Count)
        {
            var pay = Math.Min(owe[i], due[j]);
            if (pay > 0.01m)
            {
                transfers.Add(new Transfer(debtors[i].UserName, creditors[j].UserName, pay, creditors[j].RevolutTag, debtors[i].UserId));
            }
            owe[i] -= pay;
            due[j] -= pay;
            if (owe[i] <= 0.01m) i++;
            if (due[j] <= 0.01m) j++;
        }

        return transfers;
    }

    private bool isExporting;
    private string exportType = "";
    private bool isSendingEmails;

    protected override async Task OnInitializedAsync()
    {
        currentUserId = UserContext.CurrentUserId.Value;
        await LoadSpace();
        await LoadSettlement();
    }

    private async Task LoadSpace()
    {
        try
        {
            var space = await SpacesService.GetSpaceByIdAsync(Guid.Parse(SpaceId));
            if (space != null)
            {
                isAdmin = space.Members.Any(m => m.UserId == currentUserId && m.Role == "Admin");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load space: {ex.Message}");
        }
    }

    private async Task LoadSettlement()
    {
        isLoading = true;
        try
        {
            settlement = await SettlementService.GetSettlementByIdAsync(Guid.Parse(SettlementId));
            if (settlement == null)
            {
                ShowToast(true, "Error", "Settlement not found");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load settlement: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool CanConfirmPayment(Guid lineUserId)
    {
        return isAdmin || lineUserId == currentUserId;
    }

    private async Task HandleConfirmPayment(Guid memberUserId)
    {
        if (settlement == null) return;

        isConfirming = true;
        confirmingUserId = memberUserId;

        try
        {
            var success = await SettlementService.ConfirmPaymentAsync(Guid.Parse(SettlementId), memberUserId);

            if (success)
            {
                ShowToast(false, "Success", "Payment confirmed successfully");
                await LoadSettlement();
            }
            else
            {
                ShowToast(true, "Error", "Failed to confirm payment");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to confirm payment: {ex.Message}");
        }
        finally
        {
            isConfirming = false;
            confirmingUserId = Guid.Empty;
        }
    }

    private string GetStatusDisplayText(string status)
    {
        return status switch
        {
            "Completed" => "Completed",
            "AwaitingConfirmation" => "Awaiting Confirmation",
            "Generated" => "Generated",
            _ => status
        };
    }

    private async Task HandleExportPdf()
    {
        if (settlement == null) return;

        isExporting = true;
        exportType = "pdf";

        try
        {
            var bytes = await SettlementService.ExportPdfAsync(Guid.Parse(SettlementId));
            if (bytes != null)
            {
                var fileName = $"Settlement_{settlement.BillingPeriodName}_{DateTime.Now:yyyyMMdd}.pdf";
                await SaveFileAsync(bytes, fileName);
                ShowToast(false, "Success", "PDF exported successfully");
            }
            else
            {
                ShowToast(true, "Error", "Failed to export PDF");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to export PDF: {ex.Message}");
        }
        finally
        {
            isExporting = false;
            exportType = "";
        }
    }

    private async Task HandleExportExcel()
    {
        if (settlement == null) return;

        isExporting = true;
        exportType = "excel";

        try
        {
            var bytes = await SettlementService.ExportExcelAsync(Guid.Parse(SettlementId));
            if (bytes != null)
            {
                var fileName = $"Settlement_{settlement.BillingPeriodName}_{DateTime.Now:yyyyMMdd}.xlsx";
                await SaveFileAsync(bytes, fileName);
                ShowToast(false, "Success", "Excel exported successfully");
            }
            else
            {
                ShowToast(true, "Error", "Failed to export Excel");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to export Excel: {ex.Message}");
        }
        finally
        {
            isExporting = false;
            exportType = "";
        }
    }

    private async Task HandleSendEmails()
    {
        if (settlement == null) return;

        isSendingEmails = true;

        try
        {
            var emailsSent = await SettlementService.SendEmailsAsync(Guid.Parse(SettlementId), attachPdf: true);
            if (emailsSent > 0)
            {
                ShowToast(false, "Success", $"Sent {emailsSent} email(s) to space members");
            }
            else
            {
                ShowToast(true, "Error", "Failed to send emails");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to send emails: {ex.Message}");
        }
        finally
        {
            isSendingEmails = false;
        }
    }

    private async Task SaveFileAsync(byte[] bytes, string fileName)
    {
        var filePath = Path.Combine(FileSystem.CacheDirectory, fileName);
        await File.WriteAllBytesAsync(filePath, bytes);

        await Share.RequestAsync(new ShareFileRequest
        {
            Title = "Share Settlement Report",
            File = new ShareFile(filePath)
        });
    }

    private void ShowToast(bool isError, string title, string message)
    {
        isToastError = isError;
        toastTitle = title;
        toastMessage = message;
        showToast = true;
    }
}
