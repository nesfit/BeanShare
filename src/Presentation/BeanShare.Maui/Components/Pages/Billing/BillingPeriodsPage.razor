@page "/spaces/{SpaceId:guid}/billing"
@using BeanShare.Contracts.Billing
@using BeanShare.Maui.Services
@inject IBillingService BillingService
@inject ISettlementService SettlementService
@inject NavigationManager Navigation
@inject IAlertService AlertService

<div class="bs-container" style="padding: 1rem 0;">
    <div class="bs-flex bs-items-center bs-justify-between" style="margin-bottom: 1.5rem;">
        <h2 class="bs-font-bold" style="margin: 0; font-size: 1.25rem;">Billing Periods</h2>
        <button class="bs-btn bs-btn-primary bs-btn-sm" @onclick="ShowCreateModal" style="gap: 0.375rem;">
            <span class="material-symbols-outlined" style="font-size: 1.125rem;">add</span>
            New Period
        </button>
    </div>

    @if (isLoading)
    {
        <BeanShare.SharedUi.Components.Common.LoadingSpinner Message="Loading billing periods..." />
    }
    else if (!billingPeriods.Any())
    {
        <div class="bs-card" style="text-align: center; padding: 2rem;">
            <span class="material-symbols-outlined" style="font-size: 3rem; color: var(--bs-text-subtle); display: block; margin-bottom: 0.75rem;">receipt_long</span>
            <p style="margin: 0; color: var(--bs-text-subtle);">No billing periods yet. Create your first one to start tracking costs!</p>
        </div>
    }
    else
    {
        <div class="bs-flex bs-flex-col bs-gap-3">
            @foreach (var period in billingPeriods)
            {
                var stateColor = period.State switch
                {
                    "Open" => "var(--bs-success)",
                    "Closed" => "var(--bs-warning, #f59e0b)",
                    "Settled" => "var(--bs-primary)",
                    _ => "var(--bs-text-subtle)"
                };

                <div class="bs-card" style="border-left: 3px solid @stateColor;">
                    <div class="bs-flex bs-items-center bs-justify-between" style="margin-bottom: 0.5rem;">
                        <h3 class="bs-font-bold" style="margin: 0; font-size: 1rem;">@period.Name</h3>
                        <span style="font-size: 0.75rem; font-weight: 600; padding: 0.125rem 0.5rem; border-radius: 999px; background: color-mix(in srgb, @stateColor 15%, transparent); color: @stateColor;">
                            @period.State
                        </span>
                    </div>

                    <p class="bs-text-subtle" style="margin: 0 0 0.75rem; font-size: 0.8125rem;">
                        @period.FormattedDateRange
                    </p>

                    <div class="bs-flex bs-gap-3" style="margin-bottom: 0.75rem;">
                        <div style="flex: 1; text-align: center; padding: 0.5rem; background: var(--bs-gray-100); border-radius: 0.5rem;">
                            <div class="bs-font-bold">@period.ConsumptionCount</div>
                            <div style="font-size: 0.6875rem; color: var(--bs-text-subtle);">Entries</div>
                        </div>
                        <div style="flex: 1; text-align: center; padding: 0.5rem; background: var(--bs-gray-100); border-radius: 0.5rem;">
                            <div class="bs-font-bold">@period.TotalCoffeeGrams g</div>
                            <div style="font-size: 0.6875rem; color: var(--bs-text-subtle);">Coffee</div>
                        </div>
                    </div>

                    @if (period.State == "Open" && period.DaysRemaining >= 0)
                    {
                        <p style="font-size: 0.8125rem; color: var(--bs-primary); margin: 0 0 0.75rem;">
                            <span class="material-symbols-outlined" style="font-size: 1rem; vertical-align: middle;">schedule</span>
                            @period.DaysRemaining days remaining
                        </p>
                    }

                    <button class="bs-btn bs-btn-sm" style="width: 100%; background: var(--bs-primary-light); color: var(--bs-primary);"
                            @onclick='@(() => Navigation.NavigateTo($"/spaces/{SpaceId}/billing/{period.Id}"))'>
                        View Details
                    </button>
                </div>
            }
        </div>
    }
</div>

@if (showCreateModal)
{
    <div class="bs-modal-backdrop" @onclick="CloseCreateModal">
        <div class="bs-modal" role="dialog" aria-label="Create billing period" aria-modal="true" @onclick:stopPropagation="true" style="max-width: 24rem;">
            <div class="bs-modal-header bs-flex bs-items-center bs-justify-between" style="margin-bottom: 1rem;">
                <h3 style="margin: 0; font-size: 1.125rem;">Create Billing Period</h3>
                <button class="bs-btn-icon" aria-label="Close" @onclick="CloseCreateModal" style="background: transparent; border: none;">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <div class="bs-flex bs-flex-col bs-gap-3">
                <div>
                    <label style="display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: 0.25rem;">Name</label>
                    <input type="text" class="bs-input" @bind="newPeriodName" placeholder="e.g., January 2025" />
                </div>
                <div>
                    <label style="display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: 0.25rem;">Start Date</label>
                    <input type="date" class="bs-input" @bind="newPeriodStart" />
                </div>
                <div>
                    <label style="display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: 0.25rem;">End Date</label>
                    <input type="date" class="bs-input" @bind="newPeriodEnd" />
                </div>
            </div>

            <div class="bs-hero-actions">
                <button type="button" class="bs-btn bs-btn-primary bs-btn-hero" @onclick="CreatePeriod" disabled="@isCreatingPeriod">Create</button>
                <button type="button" class="bs-btn bs-btn-quiet" @onclick="CloseCreateModal">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid SpaceId { get; set; }

    private bool isLoading = true;
    private List<BillingPeriodSummaryDto> billingPeriods = new();
    private bool showCreateModal = false;
    private bool isCreatingPeriod;
    private string newPeriodName = string.Empty;
    private DateTime newPeriodStart = DateTime.Today.AddDays(-DateTime.Today.Day + 1);
    private DateTime newPeriodEnd = DateTime.Today.AddDays(-DateTime.Today.Day + 1).AddMonths(1).AddDays(-1);

    protected override async Task OnParametersSetAsync()
    {
        await LoadBillingPeriods();
    }

    private async Task LoadBillingPeriods()
    {
        isLoading = true;
        try
        {
            // Imported history periods are statistics only; the app manages live periods (the web shows the history).
            billingPeriods = (await BillingService.GetSpaceBillingPeriodsAsync(SpaceId)).Where(p => !p.IsHistorical).ToList();
        }
        catch (Exception ex)
        {
            await AlertService.ShowAlertAsync("Error", $"Failed to load billing periods: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowCreateModal()
    {
        newPeriodName = $"{DateTime.Today:MMMM yyyy}";
        showCreateModal = true;
    }

    private void CloseCreateModal() => showCreateModal = false;

    private async Task CreatePeriod()
    {
        if (isCreatingPeriod) return; // a double tap would send two creates
        isCreatingPeriod = true;
        try
        {
            var dto = new CreateBillingPeriodDto
            {
                Name = newPeriodName,
                StartDate = newPeriodStart,
                EndDate = newPeriodEnd
            };

            await BillingService.CreateBillingPeriodAsync(SpaceId, dto);
            await LoadBillingPeriods();
            CloseCreateModal();
        }
        catch (Exception ex)
        {
            await AlertService.ShowAlertAsync("Error", $"Failed to create billing period: {ex.Message}");
        }
        finally
        {
            isCreatingPeriod = false;
        }
    }
}
