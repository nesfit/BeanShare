@if (IsLoading)
{
    <div class="bs-flex bs-flex-col bs-gap-2">
        @for (int i = 0; i < 3; i++)
        {
            <div class="bs-card">
                <div class="bs-flex bs-items-center bs-gap-3">
                    <div class="bs-skeleton" style="width: 3rem; height: 3rem; border-radius: 9999px;"></div>
                    <div class="bs-flex-1">
                        <div class="bs-skeleton" style="height: 1rem; width: 50%; margin-bottom: 0.5rem;"></div>
                        <div class="bs-skeleton" style="height: 0.875rem; width: 70%;"></div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else if (Members == null || !Members.Any())
{
    <EmptyState Icon="group"
                Title="No members yet"
                Message="Invite your teammates to start sharing coffee costs." />
}
else
{
    <div class="bs-flex bs-flex-col bs-gap-3">
        @foreach (var member in Members)
        {
            <MemberRow UserId="@member.UserId.ToString()"
                      Name="@member.UserName"
                      Email="@member.Email"
                      Role="@member.Role"
                      ShowActions="@IsAdmin"
                      CanManage="@IsAdmin"
                      IsLastAdmin="@(member.Role == "Admin" && AdminCount == 1)"
                      OnPromote="HandlePromote"
                      OnDemote="HandleDemote"
                      OnRemove="HandleRemove"
                      IsPlaceholder="@member.IsPlaceholder"
                      OnEditPlaceholder="OnEditPlaceholder"
                      OnMergePlaceholder="OnMergePlaceholder" />
        }
    </div>

    @if (CanLeave)
    {
        <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--bs-border);">
            <button class="bs-btn bs-btn-error"
                    style="width: 100%;"
                    @onclick="ShowLeaveConfirmation">
                <span class="material-symbols-outlined" style="font-size: 1.25rem; vertical-align: middle; margin-right: 0.5rem;">logout</span>
                Leave Space
            </button>
        </div>
    }
}

<ConfirmDialog IsVisible="@showLeaveDialog"
               Title="Leave Space"
               Message="Are you sure you want to leave this space? You will lose access to all space data, consumption history, and settlements. You can rejoin later with an invite code."
               ConfirmText="Leave Space"
               IsDestructive="true"
               IsProcessing="@isLeaving"
               OnConfirm="HandleLeaveConfirmed"
               OnCancel="@(() => showLeaveDialog = false)" />

@code {
    [Parameter]
    public IEnumerable<MembershipDto>? Members { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public bool IsAdmin { get; set; }

    [Parameter]
    public Guid CurrentUserId { get; set; }

    [Parameter]
    public EventCallback<string> OnPromoteMember { get; set; }

    [Parameter]
    public EventCallback<string> OnDemoteMember { get; set; }

    [Parameter]
    public EventCallback<string> OnRemoveMember { get; set; }

    [Parameter]
    public EventCallback OnLeaveSpace { get; set; }

    /// <summary>Optional (null hides the action): edit a placeholder's name or email.</summary>
    [Parameter]
    public EventCallback<string> OnEditPlaceholder { get; set; }

    /// <summary>Optional (null hides the action): merge a placeholder into a member.</summary>
    [Parameter]
    public EventCallback<string> OnMergePlaceholder { get; set; }

    private int AdminCount => Members?.Count(m => m.Role == "Admin") ?? 0;

    private bool CanLeave
    {
        get
        {
            if (CurrentUserId == Guid.Empty || Members == null) return false;
            var currentMember = Members.FirstOrDefault(m => m.UserId == CurrentUserId);
            return currentMember != null && currentMember.Role != "Admin";
        }
    }

    private bool showLeaveDialog;
    private bool isLeaving;

    private Task HandlePromote(string userId) => OnPromoteMember.InvokeAsync(userId);
    private Task HandleDemote(string userId) => OnDemoteMember.InvokeAsync(userId);
    private Task HandleRemove(string userId) => OnRemoveMember.InvokeAsync(userId);

    private void ShowLeaveConfirmation()
    {
        showLeaveDialog = true;
    }

    private async Task HandleLeaveConfirmed()
    {
        isLeaving = true;
        try
        {
            await OnLeaveSpace.InvokeAsync();
        }
        finally
        {
            isLeaving = false;
            showLeaveDialog = false;
        }
    }
}
