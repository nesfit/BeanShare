@if (IsVisible)
{
    <div class="bs-modal-backdrop" @onclick="Cancel">
        <div class="bs-modal" @onclick:stopPropagation="true" @ontouchend:stopPropagation="true">
            <div class="bs-modal-header">
                <h3 class="bs-modal-title">Create New Space</h3>
            </div>
            <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <div class="bs-form-group">
                    <label class="bs-label" for="spaceName">Space Name</label>
                    <InputText id="spaceName"
                              class="bs-input"
                              @bind-Value="model.Name"
                              placeholder="e.g., Engineering Team" />
                    <ValidationMessage For="@(() => model.Name)" class="bs-validation-message" />
                </div>
                <div class="bs-form-group">
                    <label class="bs-label" for="currency">Currency</label>
                    <InputSelect id="currency"
                                class="bs-input"
                                @bind-Value="model.CurrencyCode">
                        <option value="">Select currency...</option>
                        <option value="USD">USD - US Dollar ($)</option>
                        <option value="EUR">EUR - Euro (€)</option>
                        <option value="GBP">GBP - British Pound (£)</option>
                        <option value="CZK">CZK - Czech Koruna (Kč)</option>
                        <option value="JPY">JPY - Japanese Yen (¥)</option>
                        <option value="CHF">CHF - Swiss Franc (Fr)</option>
                        <option value="CAD">CAD - Canadian Dollar (C$)</option>
                        <option value="AUD">AUD - Australian Dollar (A$)</option>
                        <option value="PLN">PLN - Polish Zloty (zł)</option>
                        <option value="SEK">SEK - Swedish Krona (kr)</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => model.CurrencyCode)" class="bs-validation-message" />
                </div>
                <div class="bs-hero-actions">
                    <button type="submit" class="bs-btn bs-btn-primary bs-btn-hero" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span>Creating...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined">add_circle</span>
                            <span>Create Space</span>
                        }
                    </button>
                    <button type="button" class="bs-btn bs-btn-quiet" @onclick="Cancel">
                        Cancel
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback<(string Name, string CurrencyCode)> OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private CreateSpaceModel model = new();
    private bool isSubmitting;

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        try
        {
            await OnSubmit.InvokeAsync((model.Name, model.CurrencyCode));
            model = new CreateSpaceModel();
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task Cancel()
    {
        model = new CreateSpaceModel();
        await OnCancel.InvokeAsync();
    }

    public class CreateSpaceModel
    {
        [Required(ErrorMessage = "Space name is required")]
        [StringLength(100, MinimumLength = 2, ErrorMessage = "Name must be between 2 and 100 characters")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Currency is required")]
        public string CurrencyCode { get; set; } = "";
    }
}
