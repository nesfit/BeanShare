@using BeanShare.Application.Features.CoffeeStock.Dtos
@using BeanShare.SharedUi.Components.Consumption.Models
@using BeanShare.SharedUi.Services
@using Microsoft.JSInterop
@inject IQrCodeService QrCodeService
@inject IJSRuntime JSRuntime

@if (IsVisible && StockLevel != null)
{
    <div class="bs-modal-backdrop" @onclick="HandleBackdropClick">
        <div class="bs-modal" role="dialog" aria-label="Generate QR code" aria-modal="true" @onclick:stopPropagation="true" @ontouchend:stopPropagation="true" style="max-width: 24rem;">
            <div class="bs-modal-header bs-flex bs-items-center bs-justify-between">
                <h3 class="bs-modal-title" style="margin: 0;">Generate QR Code</h3>
                <button class="bs-btn-icon" aria-label="Close" @onclick="Close" style="background: transparent; border: none; cursor: pointer;">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <div style="text-align: center; padding: 1rem 0;">
                <p class="bs-font-bold" style="margin: 0; font-size: 1.125rem;">@StockLevel.ProductDisplayName</p>
                <p class="bs-text-subtle" style="margin: 0.25rem 0 0 0; font-size: 0.875rem;">@StockLevel.ProductType</p>
            </div>

            @if (!string.IsNullOrEmpty(qrDataUri))
            {
                <!-- QR code has been generated (Active QR was created) -->
                <div style="text-align: center; padding: 0 0 1rem 0;">
                    <img src="@qrDataUri" alt="QR Code for @StockLevel.ProductDisplayName"
                         style="max-width: 220px; margin: 0 auto 1rem; display: block;" />
                    <p class="bs-text-subtle" style="font-size: 0.75rem; margin: 0;">
                        <span class="material-symbols-outlined" style="font-size: 0.875rem; vertical-align: middle;">label</span>
                        @label
                    </p>
                </div>

                <div class="bs-modal-footer" style="display: flex; justify-content: center; gap: 0.5rem;">
                    <button class="bs-btn bs-btn-secondary" @onclick="DownloadPng">
                        <span class="material-symbols-outlined" style="font-size: 1.125rem; vertical-align: middle; margin-right: 0.25rem;">download</span>
                        Download
                    </button>
                    <button class="bs-btn bs-btn-secondary" @onclick="PrintQr">
                        <span class="material-symbols-outlined" style="font-size: 1.125rem; vertical-align: middle; margin-right: 0.25rem;">print</span>
                        Print
                    </button>
                </div>
            }
            else
            {
                <!-- Configuration form -->
                <div style="padding: 0 0 1rem 0;">
                    <div class="bs-form-group" style="margin-bottom: 1rem;">
                        <label class="bs-label">Label</label>
                        <input type="text" class="bs-input" placeholder="e.g., Kitchen, Meeting room, Break area"
                               @bind="label" @bind:event="oninput" maxlength="100" />
                    </div>

                    <div class="bs-form-group" style="margin-bottom: 1rem;">
                        <label class="bs-label">Default Recipe</label>
                        <select class="bs-input" @bind="selectedRecipe" @bind:after="OnRecipeChanged">
                            <option value="UserChooses">User chooses when scanning</option>
                            @if (QuickPresets != null)
                            {
                                @foreach (var preset in QuickPresets)
                                {
                                    <option value="@preset.Name">@preset.Name (@preset.Grams g)</option>
                                }
                            }
                            <option value="Custom">Custom...</option>
                        </select>
                    </div>

                    @if (selectedRecipe == "UserChooses")
                    {
                        <div style="background: var(--bs-gray-50); border-radius: 0.5rem; padding: 0.75rem; margin-bottom: 1rem; font-size: 0.8rem; color: var(--bs-text-subtle);">
                            <span class="material-symbols-outlined" style="font-size: 1rem; vertical-align: middle;">info</span>
                            Users will select their recipe and grams when they scan this QR code.
                        </div>
                    }
                    else if (selectedRecipe == "Custom")
                    {
                        <div class="bs-form-group" style="margin-bottom: 1rem;">
                            <label class="bs-label">Default Grams</label>
                            <input type="number" class="bs-input" min="1" max="500"
                                   @bind="customGrams" @bind:event="oninput" />
                        </div>
                    }

                    @if (NonEmptyBags.Count > 0)
                    {
                        <div class="bs-form-group" style="margin-bottom: 1rem;">
                            <label class="bs-label">Bind to bag</label>
                            <select class="bs-input" @bind="selectedLotIdString">
                                <option value="">Any open bag (recommended)</option>
                                @foreach (var bag in NonEmptyBags)
                                {
                                    <option value="@bag.Id">Bag @bag.Label — @bag.RemainingGrams.ToString("0.#") g left@(bag.IsOpen ? " · open" : "")</option>
                                }
                            </select>
                            <p style="margin: 0.25rem 0 0 0; font-size: 0.75rem; color: var(--bs-text-subtle);">
                                Scans log against this bag; if it empties, they fall back to the open bag.
                            </p>
                        </div>
                    }
                </div>

                <div class="bs-hero-actions">
                    <button type="button" class="bs-btn bs-btn-primary bs-btn-hero" @onclick="HandleGenerate" disabled="@isGenerating">
                        @if (isGenerating)
                        {
                            <span>Creating...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined">qr_code_2</span>
                            <span>Generate QR</span>
                        }
                    </button>
                    <button type="button" class="bs-btn bs-btn-quiet" @onclick="Close">Cancel</button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public StockLevelDto? StockLevel { get; set; }

    [Parameter]
    public Guid SpaceId { get; set; }

    [Parameter]
    public string SpaceName { get; set; } = "";

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<QrCodeCreateModel> OnCreate { get; set; }

    [Parameter]
    public Guid? CreatedQrCodeId { get; set; }

    [Parameter]
    public List<PresetOption>? QuickPresets { get; set; }

    // Non-empty bags of this product, so the QR can optionally be pinned to a specific one.
    [Parameter]
    public List<StockPurchaseDto>? ProductBags { get; set; }

    private string label = "";
    private string selectedRecipe = "UserChooses";
    private int customGrams = 10;
    private string selectedLotIdString = "";
    private string qrDataUri = "";
    private bool isGenerating;
    private bool _initialized;

    private List<StockPurchaseDto> NonEmptyBags => ProductBags?
        .Where(b => b.RemainingGrams > 0 && !string.Equals(b.Status, "Empty", StringComparison.OrdinalIgnoreCase))
        .OrderBy(b => LabelOrder(b.Label))
        .ToList() ?? new();

    private static int LabelOrder(string? label) =>
        int.TryParse(label?.TrimStart('#'), out var n) ? n : int.MaxValue;

    public sealed class QrCodeCreateModel
    {
        public string Label { get; set; } = "";
        public string RecipeName { get; set; } = "";
        public int DefaultGrams { get; set; }
        public Guid? StockLotId { get; set; }
    }

    protected override void OnParametersSet()
    {
        if (IsVisible && StockLevel != null && !_initialized && string.IsNullOrEmpty(qrDataUri))
        {
            _initialized = true;
            label = "";
            selectedRecipe = PickDefaultPresetName(StockLevel.ProductType);
        }

        if (IsVisible && CreatedQrCodeId.HasValue && CreatedQrCodeId.Value != Guid.Empty && string.IsNullOrEmpty(qrDataUri))
        {
            qrDataUri = QrCodeService.GenerateQrCodeBase64ForActiveQr(CreatedQrCodeId.Value);
            isGenerating = false;
        }

        if (!IsVisible)
        {
            qrDataUri = "";
            label = "";
            selectedRecipe = "UserChooses";
            customGrams = 10;
            selectedLotIdString = "";
            isGenerating = false;
            _initialized = false;
        }
    }

    private string PickDefaultPresetName(string productType)
    {
        if (QuickPresets == null || QuickPresets.Count == 0)
        {
            return "UserChooses";
        }

        var matchByType = QuickPresets.FirstOrDefault(p =>
            string.Equals(p.CoffeeType, productType, StringComparison.OrdinalIgnoreCase));
        return (matchByType ?? QuickPresets[0]).Name;
    }

    private void OnRecipeChanged()
    {
    }

    private int GetGramsForRecipe(string recipe)
    {
        if (recipe == "UserChooses") return 0;
        if (recipe == "Custom") return customGrams > 0 ? customGrams : 10;

        var preset = QuickPresets?.FirstOrDefault(p => p.Name == recipe);
        if (preset != null) return preset.Grams;

        // fallback if the saved recipe is no longer in the preset list
        return customGrams > 0 ? customGrams : 10;
    }

    private async Task HandleGenerate()
    {
        if (StockLevel == null) return;
        if (string.IsNullOrWhiteSpace(label)) label = "QR - " + StockLevel.ProductDisplayName;

        isGenerating = true;
        StateHasChanged();

        var grams = GetGramsForRecipe(selectedRecipe);
        var recipeName = selectedRecipe == "UserChooses" ? "" : (selectedRecipe == "Custom" ? "Custom" : selectedRecipe);
        Guid? lotId = Guid.TryParse(selectedLotIdString, out var parsedLot) ? parsedLot : null;

        await OnCreate.InvokeAsync(new QrCodeCreateModel
        {
            Label = label.Trim(),
            RecipeName = recipeName,
            DefaultGrams = grams,
            StockLotId = lotId
        });

        // On success the parent sets CreatedQrCodeId and OnParametersSet renders qrDataUri.
        // On failure it only shows a toast and never clears isGenerating, so re-enable the
        // button here so the user can retry without closing and reopening the modal.
        if (string.IsNullOrEmpty(qrDataUri))
        {
            isGenerating = false;
            StateHasChanged();
        }
    }

    private async Task DownloadPng()
    {
        if (string.IsNullOrEmpty(qrDataUri)) return;
        var fileName = $"BeanShare-QR-{StockLevel?.ProductName?.Replace(" ", "-") ?? "code"}.png";
        await JSRuntime.InvokeVoidAsync("beanshareQr.downloadPng", qrDataUri, fileName);
    }

    private async Task PrintQr()
    {
        if (string.IsNullOrEmpty(qrDataUri)) return;
        var labelText = StockLevel?.ProductDisplayName ?? "Coffee";
        await JSRuntime.InvokeVoidAsync("beanshareQr.printQr", qrDataUri, labelText, SpaceName);
    }

    private async Task HandleBackdropClick()
    {
        await Close();
    }

    private async Task Close()
    {
        qrDataUri = "";
        label = "";
        isGenerating = false;
        await OnClose.InvokeAsync();
    }
}
