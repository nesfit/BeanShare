@using BeanShare.Application.Features.ActiveQrCodes.Dtos
@using BeanShare.Application.Features.CoffeeStock.Dtos
@using BeanShare.SharedUi.Components.Consumption.Models
@using BeanShare.SharedUi.Services
@using Microsoft.JSInterop
@inject IQrCodeService QrCodeService
@inject IJSRuntime JSRuntime

@if (IsLoading)
{
    <div class="bs-mb-6">
        <h2 class="bs-font-bold" style="margin: 0 0 1rem 0; font-size: 1.25rem;">Active QR Codes</h2>
        <div class="bs-flex bs-flex-col bs-gap-4">
            @for (int i = 0; i < 3; i++)
            {
                <div class="bs-card">
                    <div class="bs-flex bs-items-center bs-justify-between">
                        <div style="flex: 1;">
                            <div class="bs-skeleton" style="height: 1rem; width: 40%; margin-bottom: 0.5rem;"></div>
                            <div class="bs-skeleton" style="height: 0.875rem; width: 60%; margin-bottom: 0.25rem;"></div>
                            <div class="bs-skeleton" style="height: 0.75rem; width: 30%;"></div>
                        </div>
                        <div class="bs-flex bs-gap-2">
                            <div class="bs-skeleton" style="width: 2rem; height: 2rem; border-radius: 0.375rem;"></div>
                            <div class="bs-skeleton" style="width: 2rem; height: 2rem; border-radius: 0.375rem;"></div>
                            <div class="bs-skeleton" style="width: 2rem; height: 2rem; border-radius: 0.375rem;"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
else if (ActiveQrCodes == null || !ActiveQrCodes.Any())
{
    <div class="bs-mb-6">
        <h2 class="bs-font-bold" style="margin: 0 0 1rem 0; font-size: 1.25rem;">Active QR Codes</h2>
        <p class="bs-text-subtle" style="margin: 0; font-size: 0.875rem;">No active QR codes. Generate one from a stock item above.</p>
    </div>
}
else
{
    <div class="bs-mb-6">
        <div class="bs-flex bs-items-center bs-justify-between" style="margin-bottom: 1rem;">
            <h2 class="bs-font-bold" style="margin: 0; font-size: 1.25rem;">Active QR Codes</h2>
            @if (ActiveQrCodes.Count > 1)
            {
                <button class="bs-btn bs-btn-secondary bs-btn-sm" style="gap: 0.375rem;" @onclick="HandlePrintAll">
                    <span class="material-symbols-outlined" style="font-size: 1rem;">print</span>
                    Print All
                </button>
            }
        </div>
        <div class="bs-flex bs-flex-col bs-gap-4">
            @foreach (var qr in ActiveQrCodes)
            {
                <div class="bs-card">
                    @if (reassigningQrId == qr.Id)
                    {
                        <!-- Inline reassign form -->
                        <div>
                            <p class="bs-font-bold" style="margin: 0 0 0.75rem 0; font-size: 1rem;">
                                Reassign: @qr.Label
                            </p>

                            <div class="bs-form-group" style="margin-bottom: 0.75rem;">
                                <label class="bs-label">Product</label>
                                <select class="bs-input" @bind="reassignSelectedProductIndex" @bind:after="OnReassignProductChanged">
                                    <option value="-1">Select a product...</option>
                                    @if (StockLevels != null)
                                    {
                                        @for (int i = 0; i < StockLevels.Count; i++)
                                        {
                                            var stock = StockLevels[i];
                                            <option value="@i">@stock.ProductDisplayName (@stock.ProductType)</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="bs-form-group" style="margin-bottom: 0.75rem;">
                                <label class="bs-label">Default Recipe</label>
                                <select class="bs-input" @bind="reassignRecipe" @bind:after="OnReassignRecipeChanged">
                                    <option value="UserChooses">User chooses when scanning</option>
                                    @if (QuickPresets != null)
                                    {
                                        @foreach (var preset in QuickPresets)
                                        {
                                            <option value="@preset.Name">@preset.Name (@preset.Grams g)</option>
                                        }
                                    }
                                    <option value="Custom">Custom...</option>
                                </select>
                            </div>

                            @if (reassignRecipe == "Custom")
                            {
                                <div class="bs-form-group" style="margin-bottom: 0.75rem;">
                                    <label class="bs-label">Default Grams</label>
                                    <input type="number" class="bs-input" min="1" max="500"
                                           @bind="reassignCustomGrams" @bind:event="oninput" />
                                </div>
                            }

                            <div class="bs-flex bs-gap-2" style="justify-content: flex-end;">
                                <button class="bs-btn bs-btn-secondary bs-btn-sm" @onclick="CancelReassign">
                                    Cancel
                                </button>
                                <button class="bs-btn bs-btn-primary bs-btn-sm"
                                        disabled="@(reassignSelectedProductIndex < 0)"
                                        @onclick="@(() => HandleReassign(qr.Id))">
                                    Save
                                </button>
                            </div>
                        </div>
                    }
                    else if (renamingQrId == qr.Id)
                    {
                        <!-- Inline rename form -->
                        <div>
                            <p class="bs-font-bold" style="margin: 0 0 0.75rem 0; font-size: 1rem;">
                                Rename QR code
                            </p>

                            <div class="bs-form-group" style="margin-bottom: 0.75rem;">
                                <label class="bs-label">Label</label>
                                <input type="text" class="bs-input" maxlength="100"
                                       placeholder="e.g., Kitchen, Meeting room, Break area"
                                       @bind="renameLabel" @bind:event="oninput" />
                            </div>

                            <div class="bs-flex bs-gap-2" style="justify-content: flex-end;">
                                <button class="bs-btn bs-btn-secondary bs-btn-sm" @onclick="CancelRename">
                                    Cancel
                                </button>
                                <button class="bs-btn bs-btn-primary bs-btn-sm"
                                        disabled="@(string.IsNullOrWhiteSpace(renameLabel))"
                                        @onclick="@(() => HandleRename(qr.Id))">
                                    Save
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Normal display -->
                        <div class="bs-flex bs-items-center bs-justify-between">
                            <div style="min-width: 0; flex: 1;">
                                <p class="bs-font-bold" style="margin: 0; font-size: 1rem;">@qr.Label</p>
                                <p class="bs-text-subtle" style="margin: 0.25rem 0 0 0; font-size: 0.875rem;">@qr.ProductDisplayName</p>
                                <p class="bs-text-subtle" style="margin: 0.125rem 0 0 0; font-size: 0.75rem;">
                                    @if (qr.DefaultGrams == 0)
                                    {
                                        <span style="color: var(--bs-primary);">User chooses recipe</span>
                                    }
                                    else
                                    {
                                        @qr.RecipeName @:&middot; @(qr.DefaultGrams)g
                                    }
                                </p>
                            </div>
                            <div class="bs-flex bs-items-center bs-gap-2">
                                <button class="bs-btn bs-btn-secondary bs-btn-sm"
                                        @onclick="@(() => OnShowQr.InvokeAsync(qr.Id))"
                                        title="Show QR code"
                                        aria-label="Show QR code">
                                    <span class="material-symbols-outlined" style="font-size: 1rem;">qr_code_2</span>
                                </button>
                                <button class="bs-btn bs-btn-secondary bs-btn-sm"
                                        @onclick="@(() => StartRename(qr))"
                                        title="Rename QR code"
                                        aria-label="Rename QR code">
                                    <span class="material-symbols-outlined" style="font-size: 1rem;">edit</span>
                                </button>
                                <button class="bs-btn bs-btn-secondary bs-btn-sm"
                                        @onclick="@(() => StartReassign(qr))"
                                        title="Reassign to different product"
                                        aria-label="Reassign to different product">
                                    <span class="material-symbols-outlined" style="font-size: 1rem;">swap_horiz</span>
                                </button>
                                @if (qr.IsActive)
                                {
                                    <button class="bs-btn bs-btn-secondary bs-btn-sm"
                                            @onclick="@(() => OnDeactivate.InvokeAsync(qr.Id))"
                                            title="Deactivate QR code"
                                            aria-label="Deactivate QR code"
                                            style="color: var(--bs-error);">
                                        <span class="material-symbols-outlined" style="font-size: 1rem;">delete</span>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public List<ActiveQrCodeDto> ActiveQrCodes { get; set; } = new();

    [Parameter]
    public List<StockLevelDto> StockLevels { get; set; } = new();

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public EventCallback<ReassignModel> OnReassign { get; set; }

    [Parameter]
    public EventCallback<RenameModel> OnRename { get; set; }

    [Parameter]
    public EventCallback<Guid> OnDeactivate { get; set; }

    [Parameter]
    public EventCallback<Guid> OnShowQr { get; set; }

    [Parameter]
    public string SpaceName { get; set; } = "";

    [Parameter]
    public List<PresetOption>? QuickPresets { get; set; }

    private Guid? reassigningQrId;
    private int reassignSelectedProductIndex = -1;
    private string reassignRecipe = "UserChooses";
    private int reassignCustomGrams = 10;

    private Guid? renamingQrId;
    private string renameLabel = "";

    public sealed class ReassignModel
    {
        public Guid QrCodeId { get; set; }
        public string ProductName { get; set; } = "";
        public string ProductBrand { get; set; } = "";
        public string ProductType { get; set; } = "";
        public string RecipeName { get; set; } = "";
        public int DefaultGrams { get; set; }
    }

    public sealed class RenameModel
    {
        public Guid QrCodeId { get; set; }
        public string Label { get; set; } = "";
    }

    private void StartRename(ActiveQrCodeDto qr)
    {
        reassigningQrId = null;
        renamingQrId = qr.Id;
        renameLabel = qr.Label;
    }

    private void CancelRename()
    {
        renamingQrId = null;
        renameLabel = "";
    }

    private async Task HandleRename(Guid qrCodeId)
    {
        var label = renameLabel?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(label))
            return;

        await OnRename.InvokeAsync(new RenameModel
        {
            QrCodeId = qrCodeId,
            Label = label
        });

        CancelRename();
    }

    private void StartReassign(ActiveQrCodeDto qr)
    {
        renamingQrId = null;
        reassigningQrId = qr.Id;
        reassignSelectedProductIndex = -1;
        if (qr.DefaultGrams == 0)
        {
            reassignRecipe = "UserChooses";
            reassignCustomGrams = 10;
        }
        else if (QuickPresets != null && QuickPresets.Any(p => p.Name == qr.RecipeName))
        {
            reassignRecipe = qr.RecipeName;
            reassignCustomGrams = qr.DefaultGrams;
        }
        else
        {
            // Saved recipe is no longer in this space's preset list
            // (renamed, deleted, or created via a different path).
            // Fall back to Custom while preserving the saved grams so
            // the user can re-save without losing data.
            reassignRecipe = "Custom";
            reassignCustomGrams = qr.DefaultGrams;
        }

        if (StockLevels != null)
        {
            for (int i = 0; i < StockLevels.Count; i++)
            {
                if (StockLevels[i].ProductName == qr.ProductName
                    && StockLevels[i].ProductBrand == qr.ProductBrand
                    && StockLevels[i].ProductType == qr.ProductType)
                {
                    reassignSelectedProductIndex = i;
                    break;
                }
            }
        }
    }

    private void CancelReassign()
    {
        reassigningQrId = null;
        reassignSelectedProductIndex = -1;
        reassignRecipe = "UserChooses";
        reassignCustomGrams = 10;
    }

    private void OnReassignProductChanged()
    {
    }

    private void OnReassignRecipeChanged()
    {
    }

    private int GetGramsForRecipe(string recipe)
    {
        if (recipe == "UserChooses") return 0;
        if (recipe == "Custom") return reassignCustomGrams > 0 ? reassignCustomGrams : 10;

        var preset = QuickPresets?.FirstOrDefault(p => p.Name == recipe);
        if (preset != null) return preset.Grams;

        return reassignCustomGrams > 0 ? reassignCustomGrams : 10;
    }

    private async Task HandleReassign(Guid qrCodeId)
    {
        if (reassignSelectedProductIndex < 0 || StockLevels == null || reassignSelectedProductIndex >= StockLevels.Count)
            return;

        var selectedProduct = StockLevels[reassignSelectedProductIndex];
        var recipeName = reassignRecipe == "UserChooses" ? "" : (reassignRecipe == "Custom" ? "Custom" : reassignRecipe);
        var grams = GetGramsForRecipe(reassignRecipe);

        await OnReassign.InvokeAsync(new ReassignModel
        {
            QrCodeId = qrCodeId,
            ProductName = selectedProduct.ProductName,
            ProductBrand = selectedProduct.ProductBrand,
            ProductType = selectedProduct.ProductType,
            RecipeName = recipeName,
            DefaultGrams = grams
        });

        CancelReassign();
    }

    private async Task HandlePrintAll()
    {
        var qrCodes = ActiveQrCodes.Select(qr => new
        {
            base64 = QrCodeService.GenerateQrCodeBase64ForActiveQr(qr.Id),
            label = qr.Label,
            product = qr.ProductDisplayName
        }).ToArray();

        await JSRuntime.InvokeVoidAsync("beanshareQr.printAllQr", qrCodes, SpaceName);
    }
}
