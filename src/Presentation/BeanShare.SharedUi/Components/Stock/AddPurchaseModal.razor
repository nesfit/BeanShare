@if (IsVisible)
{
    <div class="bs-modal-backdrop" @onclick="HandleBackdropClick">
        <div class="bs-modal" @onclick:stopPropagation="true" @ontouchend:stopPropagation="true">
            <div class="bs-modal-header">
                <h3 class="bs-modal-title">Add Stock Purchase</h3>
            </div>
            @if (showDiscardConfirm)
            {
                <div style="padding: 1rem;">
                    <p style="margin: 0 0 1rem 0;">Discard unsaved changes?</p>
                    @* Discard holds the hero slot: it is the advancing action for this
                       confirm, and the emphasis rule stays uniform across all dialogs. *@
                    <div class="bs-hero-actions">
                        <button type="button" class="bs-btn bs-btn-error bs-btn-hero" @onclick="DiscardChanges">
                            Discard
                        </button>
                        <button type="button" class="bs-btn bs-btn-quiet" @onclick="@(() => showDiscardConfirm = false)">
                            Keep Editing
                        </button>
                    </div>
                </div>
            }
            else
            {
            <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                @if (OnBarcodeScanned.HasDelegate)
                {
                    <div class="bs-form-group">
                        @if (string.IsNullOrEmpty(model.Barcode))
                        {
                            <button type="button" class="bs-btn bs-btn-outline bs-w-full" @onclick="OpenScanner" style="gap: 0.5rem;">
                                <span class="material-symbols-outlined">barcode_scanner</span>
                                Scan barcode to fill in
                            </button>
                        }
                        else
                        {
                            <div class="bs-flex bs-items-center bs-justify-between" style="gap: 0.5rem; background: var(--bs-gray-50); border: 1px solid var(--bs-border); border-radius: 0.5rem; padding: 0.5rem 0.75rem;">
                                <span class="bs-flex bs-items-center" style="gap: 0.4rem; font-size: 0.8125rem; min-width: 0;">
                                    <span class="material-symbols-outlined" style="font-size: 1.1rem; color: var(--bs-primary); flex-shrink: 0;">barcode_scanner</span>
                                    <span style="font-family: monospace; overflow: hidden; text-overflow: ellipsis;">@model.Barcode</span>
                                </span>
                                <div class="bs-flex" style="gap: 0.25rem; flex-shrink: 0;">
                                    <button type="button" class="bs-btn bs-btn-sm bs-btn-ghost" @onclick="OpenScanner" title="Rescan">Rescan</button>
                                    <button type="button" class="bs-btn bs-btn-sm bs-btn-ghost" @onclick="@(() => model.Barcode = null)" aria-label="Remove barcode" title="Remove">
                                        <span class="material-symbols-outlined" style="font-size: 1rem;">close</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="bs-form-group">
                    <label class="bs-label" for="productBrand">Brand</label>
                    <InputText id="productBrand"
                              class="bs-input"
                              @bind-Value="model.ProductBrand"
                              placeholder="e.g., Starbucks, Lavazza" />
                    <ValidationMessage For="@(() => model.ProductBrand)" class="bs-validation-message" />
                </div>

                <div class="bs-form-group">
                    <label class="bs-label" for="productName">Product Name</label>
                    <InputText id="productName"
                              class="bs-input"
                              @bind-Value="model.ProductName"
                              placeholder="e.g., Pike Place, Super Crema" />
                    <ValidationMessage For="@(() => model.ProductName)" class="bs-validation-message" />
                </div>

                <div class="bs-form-group">
                    <label class="bs-label" for="quantity">Bag size (grams)</label>
                    <InputNumber id="quantity"
                                class="bs-input"
                                @bind-Value="model.QuantityGrams"
                                placeholder="250" />
                    <ValidationMessage For="@(() => model.QuantityGrams)" class="bs-validation-message" />
                </div>

                <div class="bs-form-group">
                    <label class="bs-label" for="bagCount">Number of bags</label>
                    <InputNumber id="bagCount"
                                class="bs-input"
                                @bind-Value="model.BagCount"
                                placeholder="1" />
                    <p style="margin: 0.25rem 0 0 0; font-size: 0.75rem; color: var(--bs-text-subtle);">
                        Each bag is tracked separately (same size &amp; price).
                    </p>
                    <ValidationMessage For="@(() => model.BagCount)" class="bs-validation-message" />
                </div>

                <div class="bs-form-group">
                    <label class="bs-label" for="totalCost">Cost per bag</label>
                    <InputNumber id="totalCost"
                                class="bs-input"
                                @bind-Value="model.TotalCost"
                                placeholder="15.99" />
                    <ValidationMessage For="@(() => model.TotalCost)" class="bs-validation-message" />
                </div>

                <div class="bs-form-group">
                    <label class="bs-label" for="coffeeType">Coffee Type</label>
                    <InputSelect id="coffeeType" class="bs-input" @bind-Value="model.CoffeeType">
                        <option value="Espresso">Espresso</option>
                        <option value="Filter">Filter</option>
                        <option value="Instant">Instant</option>
                        <option value="Decaf">Decaf</option>
                        <option value="Specialty">Specialty</option>
                    </InputSelect>
                </div>

                @if (PayerOptions is { Count: > 0 })
                {
                    <div class="bs-form-group">
                        <label class="bs-label" for="paidBy">Paid by</label>
                        <select id="paidBy" class="bs-input" value="@(model.PaidByUserId?.ToString() ?? "")" @onchange="OnPayerChanged">
                            <option value="">Me (the recorder)</option>
                            @foreach (var payer in PayerOptions)
                            {
                                <option value="@payer.UserId">@payer.Name</option>
                            }
                        </select>
                        <div class="bs-text-subtle" style="font-size: 0.75rem;">Whoever paid gets the bags' cost as credit at the next settlement.</div>
                    </div>
                }

                <div class="bs-form-group">
                    <label class="bs-label" for="purchaseDate">Purchase Date</label>
                    <InputDate id="purchaseDate"
                              class="bs-input"
                              @bind-Value="model.PurchasedAt" />
                    <ValidationMessage For="@(() => model.PurchasedAt)" class="bs-validation-message" />
                </div>

                <div class="bs-hero-actions">
                    <button type="submit" class="bs-btn bs-btn-primary bs-btn-hero" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span>Adding...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined">add</span>
                            <span>Add Purchase</span>
                        }
                    </button>
                    <button type="button" class="bs-btn bs-btn-quiet" @onclick="Cancel">
                        Cancel
                    </button>
                </div>
            </EditForm>
            }
        </div>
    </div>

    <BarcodeScannerModal IsVisible="@showBarcodeScanner"
                         OnScanned="HandleBarcodeScanned"
                         OnClose="@(() => showBarcodeScanner = false)" />
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback<AddPurchaseModel> OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public string CurrencyCode { get; set; } = "USD";

    [Parameter]
    public PurchasePrefill? PrefillFrom { get; set; }

    /// <summary>Raised with the raw scanned barcode; the parent looks it up and pushes a fresh
    /// <see cref="PrefillFrom"/>. When not provided, the scan affordance is hidden.</summary>
    [Parameter]
    public EventCallback<string> OnBarcodeScanned { get; set; }

    /// <summary>Members who may have paid for the bags; null hides the "Paid by" field.</summary>
    [Parameter]
    public IReadOnlyList<PayerOption>? PayerOptions { get; set; }

    private AddPurchaseModel model = new();

    private void OnPayerChanged(ChangeEventArgs e) =>
        model.PaidByUserId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
    private bool isSubmitting;
    private bool showDiscardConfirm;
    private bool showBarcodeScanner;
    private PurchasePrefill? appliedPrefill;

    protected override void OnParametersSet()
    {
        // The form has no currency input — the model must always mirror the parameter.
        // The parent may pass a fallback first and the real space currency only after
        // its async load, so a one-shot copy in OnInitialized goes stale.
        if (!string.IsNullOrEmpty(CurrencyCode))
            model.Currency = CurrencyCode;

        // Re-apply whenever a NEW prefill instance arrives (e.g. after a barcode lookup),
        // not just the first time.
        if (PrefillFrom != null && !ReferenceEquals(PrefillFrom, appliedPrefill))
        {
            model.ProductBrand = PrefillFrom.ProductBrand;
            model.ProductName = PrefillFrom.ProductName;
            model.QuantityGrams = PrefillFrom.QuantityGrams;
            model.TotalCost = PrefillFrom.CostAmount;
            model.CoffeeType = PrefillFrom.CoffeeType;
            model.PurchasedAt = DateTime.UtcNow;
            if (!string.IsNullOrWhiteSpace(PrefillFrom.Barcode))
            {
                model.Barcode = PrefillFrom.Barcode;
            }
            appliedPrefill = PrefillFrom;
        }

        if (PrefillFrom == null)
            appliedPrefill = null;
    }

    private void OpenScanner()
    {
        showBarcodeScanner = true;
    }

    private async Task HandleBarcodeScanned(string code)
    {
        showBarcodeScanner = false;
        var trimmed = code?.Trim();
        if (string.IsNullOrWhiteSpace(trimmed))
        {
            return;
        }

        // Remember the code on the model immediately (saved even if the lookup finds nothing),
        // then let the parent resolve product + price and push a prefill back.
        model.Barcode = trimmed;
        await OnBarcodeScanned.InvokeAsync(trimmed);
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        try
        {
            await OnSubmit.InvokeAsync(model);
            model = new AddPurchaseModel { Currency = CurrencyCode };
            showDiscardConfirm = false;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private bool IsDirty =>
        !string.IsNullOrEmpty(model.ProductBrand) ||
        !string.IsNullOrEmpty(model.ProductName) ||
        model.QuantityGrams != 0 ||
        model.TotalCost != 0;

    private async Task HandleBackdropClick()
    {
        if (IsDirty)
            showDiscardConfirm = true;
        else
            await DiscardChanges();
    }

    private async Task Cancel()
    {
        if (IsDirty)
            showDiscardConfirm = true;
        else
            await DiscardChanges();
    }

    private async Task DiscardChanges()
    {
        model = new AddPurchaseModel { Currency = CurrencyCode };
        showDiscardConfirm = false;
        await OnCancel.InvokeAsync();
    }

    public class PurchasePrefill
    {
        public string ProductBrand { get; set; } = "";
        public string ProductName { get; set; } = "";
        public int QuantityGrams { get; set; }
        public decimal CostAmount { get; set; }
        public string CoffeeType { get; set; } = "Espresso";
        public string? Barcode { get; set; }
    }

    public class AddPurchaseModel
    {
        [Required(ErrorMessage = "Brand is required")]
        [StringLength(200, MinimumLength = 1, ErrorMessage = "Brand must be between 1 and 200 characters")]
        public string ProductBrand { get; set; } = "";

        [Required(ErrorMessage = "Product name is required")]
        [StringLength(200, MinimumLength = 2, ErrorMessage = "Product name must be between 2 and 200 characters")]
        public string ProductName { get; set; } = "";

        [Required(ErrorMessage = "Quantity is required")]
        [Range(1, 10000, ErrorMessage = "Quantity must be between 1 and 10000 grams")]
        public int QuantityGrams { get; set; }

        [Range(1, 100, ErrorMessage = "Number of bags must be between 1 and 100")]
        public int BagCount { get; set; } = 1;

        [Required(ErrorMessage = "Total cost is required")]
        [Range(0.01, 100000, ErrorMessage = "Total cost must be greater than 0")]
        public decimal TotalCost { get; set; }

        [Required]
        public string CoffeeType { get; set; } = "Espresso";

        [Required(ErrorMessage = "Purchase date is required")]
        public DateTime PurchasedAt { get; set; } = DateTime.UtcNow;

        public string Currency { get; set; } = "USD";

        [StringLength(64)]
        public string? Barcode { get; set; }

        /// <summary>Who paid for the bags; null means the recorder.</summary>
        public Guid? PaidByUserId { get; set; }
    }

    public sealed record PayerOption(Guid UserId, string Name);
}
