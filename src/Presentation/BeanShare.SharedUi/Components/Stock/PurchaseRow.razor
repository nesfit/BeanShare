@if (isEditing)
{
    <div class="bs-card" style="padding: 1rem;">
        <div class="bs-flex bs-flex-col bs-gap-3">
            <div class="bs-flex bs-gap-3">
                <div style="flex: 1;">
                    <label class="bs-text-subtle" style="font-size: 0.75rem;">Brand</label>
                    <input type="text" class="bs-input" @bind="editBrand" style="margin-top: 0.25rem;" />
                </div>
                <div style="flex: 1;">
                    <label class="bs-text-subtle" style="font-size: 0.75rem;">Product Name</label>
                    <input type="text" class="bs-input" @bind="editProductName" style="margin-top: 0.25rem;" />
                </div>
            </div>
            <div class="bs-flex bs-gap-3">
                <div style="flex: 1;">
                    <label class="bs-text-subtle" style="font-size: 0.75rem;">Grams</label>
                    <input type="number" min="1" class="bs-input" @bind="editQuantity" style="margin-top: 0.25rem;" />
                </div>
                <div style="flex: 1;">
                    <label class="bs-text-subtle" style="font-size: 0.75rem;">Cost</label>
                    <input type="number" step="0.01" min="0.01" class="bs-input" @bind="editCost" style="margin-top: 0.25rem;" />
                </div>
            </div>
            <div>
                <label class="bs-text-subtle" style="font-size: 0.75rem;">Purchase Date</label>
                <input type="date" class="bs-input" @bind="editDate" style="margin-top: 0.25rem;" />
            </div>
            <div class="bs-flex bs-gap-2 bs-justify-end">
                <button class="bs-btn bs-btn-secondary bs-btn-sm" @onclick="CancelEdit">Cancel</button>
                <button class="bs-btn bs-btn-primary bs-btn-sm" @onclick="SaveEdit" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save")
                </button>
            </div>
        </div>
    </div>
}
else if (isConfirmingDelete)
{
    <div class="bs-card" style="padding: 1rem;">
        <p style="margin: 0 0 0.75rem 0;">Delete <strong>@ProductName</strong>? This cannot be undone.</p>
        <div class="bs-flex bs-gap-2 bs-justify-end">
            <button class="bs-btn bs-btn-secondary bs-btn-sm" @onclick="@(() => isConfirmingDelete = false)">Cancel</button>
            <button class="bs-btn bs-btn-error bs-btn-sm" @onclick="ConfirmDelete" disabled="@isDeleting">
                @(isDeleting ? "Deleting..." : "Delete")
            </button>
        </div>
    </div>
}
else
{
    <div class="bs-card" style="cursor: pointer;" @onclick="StartEdit">
        <div class="bs-flex bs-items-start bs-justify-between">
            <div>
                <p class="bs-font-bold" style="margin: 0;">@ProductName</p>
                <p class="bs-text-subtle" style="margin: 0.25rem 0 0 0; font-size: 0.875rem;">
                    @PurchasedAt.ToLocalTime().ToString("MMM dd, yyyy")
                </p>
            </div>
            <div style="text-align: right;">
                <p class="bs-font-bold" style="margin: 0;">@FormatCurrency(TotalCost)</p>
                <p class="bs-text-subtle" style="margin: 0.25rem 0 0 0; font-size: 0.875rem;">
                    @QuantityGrams g
                </p>
            </div>
        </div>
        <div class="bs-flex bs-items-center bs-justify-between bs-mt-2" style="font-size: 0.875rem;">
            <span class="bs-pill" style="background: var(--bs-primary-light); color: var(--bs-primary);">
                @CoffeeType
            </span>
            <div class="bs-flex bs-items-center bs-gap-2">
                <span class="bs-text-subtle">by @PurchasedByInitials</span>
                <button class="bs-btn-icon" style="color: var(--bs-text-subtle);"
                        title="Clone purchase"
                        @onclick="HandleClone" @onclick:stopPropagation="true">
                    <span class="material-symbols-outlined" style="font-size: 1rem;">content_copy</span>
                </button>
                <button class="bs-btn-icon" style="color: var(--bs-text-subtle);"
                        title="Edit purchase"
                        @onclick="StartEdit" @onclick:stopPropagation="true">
                    <span class="material-symbols-outlined" style="font-size: 1rem;">edit</span>
                </button>
                <button class="bs-btn-icon" style="color: var(--bs-error);"
                        title="Delete purchase"
                        @onclick="StartDelete" @onclick:stopPropagation="true">
                    <span class="material-symbols-outlined" style="font-size: 1rem;">delete</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid PurchaseId { get; set; }
    [Parameter] public string ProductName { get; set; } = "";
    [Parameter] public string ProductBrand { get; set; } = "";
    [Parameter] public decimal TotalCost { get; set; }
    [Parameter] public string CurrencyCode { get; set; } = "USD";
    [Parameter] public int QuantityGrams { get; set; }
    [Parameter] public string CoffeeType { get; set; } = "Ground";
    [Parameter] public DateTime PurchasedAt { get; set; }
    [Parameter] public string PurchasedByName { get; set; } = "";
    [Parameter] public EventCallback<PurchaseEditModel> OnEdit { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
    [Parameter] public EventCallback<PurchaseCloneModel> OnClone { get; set; }

    private bool isEditing;
    private bool isSaving;
    private bool isConfirmingDelete;
    private bool isDeleting;
    private string editBrand = "";
    private string editProductName = "";
    private decimal editQuantity;
    private decimal editCost;
    private DateTime editDate;

    private async Task HandleClone()
    {
        await OnClone.InvokeAsync(new PurchaseCloneModel
        {
            ProductBrand = ProductBrand,
            ProductName = ProductName,
            QuantityGrams = QuantityGrams,
            CostAmount = TotalCost,
            CoffeeType = CoffeeType
        });
    }

    private void StartEdit()
    {
        editBrand = ProductBrand;
        editProductName = ProductName;
        editQuantity = QuantityGrams;
        editCost = TotalCost;
        editDate = PurchasedAt;
        isEditing = true;
    }

    private void CancelEdit()
    {
        isEditing = false;
    }

    private void StartDelete()
    {
        isConfirmingDelete = true;
    }

    private async Task ConfirmDelete()
    {
        isDeleting = true;
        try
        {
            await OnDelete.InvokeAsync(PurchaseId);
            isConfirmingDelete = false;
        }
        catch
        {
        }
        finally
        {
            isDeleting = false;
        }
    }

    private async Task SaveEdit()
    {
        if (editQuantity <= 0 || editCost <= 0)
            return;

        isSaving = true;
        try
        {
            await OnEdit.InvokeAsync(new PurchaseEditModel
            {
                PurchaseId = PurchaseId,
                ProductName = editProductName.Trim(),
                ProductBrand = editBrand.Trim(),
                CoffeeType = CoffeeType,
                QuantityGrams = editQuantity,
                CostAmount = editCost,
                PurchasedAt = editDate
            });
            isEditing = false;
        }
        catch
        {
        }
        finally
        {
            isSaving = false;
        }
    }

    private string PurchasedByInitials
    {
        get
        {
            if (string.IsNullOrEmpty(PurchasedByName)) return "?";
            var parts = PurchasedByName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 2)
                return $"{parts[0][0]}{parts[1][0]}".ToUpper();
            return PurchasedByName.Length >= 2 ? PurchasedByName.Substring(0, 2).ToUpper() : PurchasedByName.ToUpper();
        }
    }

    private string FormatCurrency(decimal amount)
    {
        try
        {
            var currency = BeanShare.Domain.ValueObjects.Currency.Create(CurrencyCode);
            return currency.FormatAmount(amount);
        }
        catch
        {
            return $"{amount:N2}";
        }
    }

    public class PurchaseEditModel
    {
        public Guid PurchaseId { get; set; }
        public string ProductName { get; set; } = "";
        public string ProductBrand { get; set; } = "";
        public string CoffeeType { get; set; } = "";
        public decimal QuantityGrams { get; set; }
        public decimal CostAmount { get; set; }
        public DateTime PurchasedAt { get; set; }
    }

    public class PurchaseCloneModel
    {
        public string ProductBrand { get; set; } = "";
        public string ProductName { get; set; } = "";
        public int QuantityGrams { get; set; }
        public decimal CostAmount { get; set; }
        public string CoffeeType { get; set; } = "Espresso";
    }
}
