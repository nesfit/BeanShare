@if (IsVisible)
{
    <div class="bs-modal-backdrop" @onclick="OnCancel">
        <div class="bs-modal" @onclick:stopPropagation="true" @ontouchend:stopPropagation="true" style="max-width: 30rem;">
            <div class="bs-modal-header">
                <h3 class="bs-modal-title">Restock settings</h3>
            </div>

            <div style="padding: 0 1.25rem;">
                <p class="bs-text-subtle" style="font-size: 0.8125rem; margin: 0 0 1.25rem 0;">
                    Tune the restock planner and low-stock alerts to how you order.
                </p>

                <div class="bs-form-group">
                    <label class="bs-label" for="restock-lead">Delivery lead time (days)</label>
                    <input id="restock-lead" class="bs-input" type="number" min="0" max="90" step="1"
                           @bind="leadTimeDays" @bind:event="oninput" />
                    <p class="bs-text-subtle" style="font-size: 0.75rem; margin: 0.35rem 0 0 0;">
                        How long an order takes to arrive. Alerts fire this far ahead of running out.
                    </p>
                </div>

                <div class="bs-form-group">
                    <label class="bs-label" for="restock-min">Minimum order value (@CurrencyCode)</label>
                    <input id="restock-min" class="bs-input" type="number" min="0" max="1000000" step="0.01"
                           @bind="minOrderValue" @bind:event="oninput" />
                    <p class="bs-text-subtle" style="font-size: 0.75rem; margin: 0.35rem 0 0 0;">
                        The planner flags a basket as "worth ordering" once it reaches this total.
                    </p>
                </div>

                @if (!string.IsNullOrEmpty(error))
                {
                    <p style="color: var(--bs-error); font-size: 0.8125rem; margin: 0 0 0.75rem 0;">@error</p>
                }
            </div>

            <div class="bs-hero-actions">
                <button type="button" class="bs-btn bs-btn-primary bs-btn-hero" @onclick="Save" disabled="@IsProcessing">
                    @if (IsProcessing)
                    {
                        <span>Saving…</span>
                    }
                    else
                    {
                        <span>Save</span>
                    }
                </button>
                <button type="button" class="bs-btn bs-btn-quiet" @onclick="OnCancel" disabled="@IsProcessing">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public int LeadTimeDays { get; set; } = 7;
    [Parameter] public decimal MinOrderValue { get; set; } = 2000m;
    [Parameter] public string CurrencyCode { get; set; } = "USD";
    [Parameter] public bool IsProcessing { get; set; }
    [Parameter] public EventCallback<(int LeadTimeDays, decimal MinOrderValue)> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private int leadTimeDays;
    private decimal minOrderValue;
    private string? error;
    private bool wasVisible;

    protected override void OnParametersSet()
    {
        // Re-seed the form from the current settings each time the modal opens.
        if (IsVisible && !wasVisible)
        {
            leadTimeDays = LeadTimeDays;
            minOrderValue = MinOrderValue;
            error = null;
        }
        wasVisible = IsVisible;
    }

    private async Task Save()
    {
        if (leadTimeDays < 0 || leadTimeDays > 90)
        {
            error = "Lead time must be between 0 and 90 days.";
            return;
        }

        if (minOrderValue < 0 || minOrderValue > 1_000_000m)
        {
            error = "Minimum order value must be between 0 and 1,000,000.";
            return;
        }

        error = null;
        await OnSave.InvokeAsync((leadTimeDays, minOrderValue));
    }
}
