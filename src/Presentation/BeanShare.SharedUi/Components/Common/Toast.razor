@if (IsVisible)
{
    @* role/aria-live so screen readers announce it; errors are assertive since
       they interrupt a failed action, successes are polite. *@
    <div class="bs-toast @(IsError ? "bs-toast-error" : "bs-toast-success")"
         role="@(IsError ? "alert" : "status")"
         aria-live="@(IsError ? "assertive" : "polite")">
        <div class="bs-flex bs-gap-2" style="align-items: flex-start;">
            <span class="material-symbols-outlined" aria-hidden="true">
                @(IsError ? "error" : "check_circle")
            </span>
            <div class="bs-flex-1" style="min-width: 0;">
                <p class="bs-font-bold bs-m-0">@Title</p>
                @if (!string.IsNullOrEmpty(Message))
                {
                    <p class="bs-m-0" style="font-size: 0.875rem; overflow-wrap: anywhere;">@Message</p>
                }
            </div>
            <button type="button" class="bs-toast-close" aria-label="Dismiss" @onclick="HandleClose">
                <span class="material-symbols-outlined" aria-hidden="true">close</span>
            </button>
        </div>
    </div>
}

@implements IDisposable

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public bool IsError { get; set; }

    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public string Message { get; set; } = "";

    [Parameter]
    public EventCallback OnClose { get; set; }

    private CancellationTokenSource? _autoCloseCts;

    protected override void OnParametersSet()
    {
        if (IsVisible)
        {
            // Cancel any previous timer to prevent stacking
            _autoCloseCts?.Cancel();
            _autoCloseCts?.Dispose();
            _autoCloseCts = new CancellationTokenSource();
            var token = _autoCloseCts.Token;

            _ = Task.Delay(3000, token).ContinueWith(_ =>
            {
                if (!token.IsCancellationRequested)
                {
                    InvokeAsync(async () =>
                    {
                        IsVisible = false;
                        await OnClose.InvokeAsync();
                        StateHasChanged();
                    });
                }
            }, TaskContinuationOptions.OnlyOnRanToCompletion);
        }
        else
        {
            _autoCloseCts?.Cancel();
        }
    }

    // Cancels the pending auto-dismiss first, so the timer can't fire a second
    // OnClose after the user has already dismissed manually.
    private async Task HandleClose()
    {
        _autoCloseCts?.Cancel();
        IsVisible = false;
        await OnClose.InvokeAsync();
    }

    public void Dispose()
    {
        _autoCloseCts?.Cancel();
        _autoCloseCts?.Dispose();
    }
}
