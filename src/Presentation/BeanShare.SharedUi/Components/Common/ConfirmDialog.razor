@if (IsVisible)
{
    <div class="bs-modal-backdrop" @onclick="OnCancel">
        <div class="bs-modal" @onclick:stopPropagation="true" @ontouchend:stopPropagation="true">
            <div class="bs-modal-header">
                <h3 class="bs-modal-title">@Title</h3>
            </div>
            <div>
                <p>@Message</p>
            </div>
            @* Confirm first in the DOM: it is the action the dialog exists to offer,
               and the hero slot always goes to the advancing action so muscle memory
               never has to branch between destructive and non-destructive dialogs. *@
            <div class="bs-hero-actions">
                <button type="button"
                        class="bs-btn @(IsDestructive ? "bs-btn-error" : "bs-btn-primary") bs-btn-hero"
                        @onclick="OnConfirmClick"
                        disabled="@IsProcessing">
                    @(IsProcessing ? "Processing..." : ConfirmText)
                </button>
                <button type="button" class="bs-btn bs-btn-quiet" @onclick="OnCancel">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public string Title { get; set; } = "Confirm Action";

    [Parameter]
    public string Message { get; set; } = "Are you sure?";

    [Parameter]
    public string ConfirmText { get; set; } = "Confirm";

    [Parameter]
    public bool IsDestructive { get; set; }

    [Parameter]
    public bool IsProcessing { get; set; }

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private async Task OnConfirmClick()
    {
        await OnConfirm.InvokeAsync();
    }
}
