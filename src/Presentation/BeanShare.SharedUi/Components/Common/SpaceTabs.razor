<nav class="bs-tabs">
    <a class="bs-tab @(ActiveTab == "consumption" ? "bs-tab-active" : "")"
       href="@GetTabUrl("consumption")"
       @onclick="@(() => HandleTabClick("consumption"))"
       @onclick:preventDefault="@PreventNavigation">
        Consumption
    </a>
    <a class="bs-tab @(ActiveTab == "stock" ? "bs-tab-active" : "")"
       href="@GetTabUrl("stock")"
       @onclick="@(() => HandleTabClick("stock"))"
       @onclick:preventDefault="@PreventNavigation">
        Stock
    </a>
    <a class="bs-tab @(ActiveTab == "ledger" ? "bs-tab-active" : "")"
       href="@GetTabUrl("ledger")"
       @onclick="@(() => HandleTabClick("ledger"))"
       @onclick:preventDefault="@PreventNavigation">
        Ledger
    </a>
    <a class="bs-tab @(ActiveTab == "members" ? "bs-tab-active" : "")"
       href="@GetTabUrl("members")"
       @onclick="@(() => HandleTabClick("members"))"
       @onclick:preventDefault="@PreventNavigation">
        Members
    </a>
    <a class="bs-tab @(ActiveTab == "billing" ? "bs-tab-active" : "")"
       href="@GetTabUrl("billing")"
       @onclick="@(() => HandleTabClick("billing"))"
       @onclick:preventDefault="@PreventNavigation">
        Billing
    </a>
    <a class="bs-tab @(ActiveTab == "settlements" ? "bs-tab-active" : "")"
       href="@GetTabUrl("settlements")"
       @onclick="@(() => HandleTabClick("settlements"))"
       @onclick:preventDefault="@PreventNavigation">
        Settlements
    </a>
    @if (ShowBalances)
    {
        <a class="bs-tab @(ActiveTab == "balances" ? "bs-tab-active" : "")"
           href="@GetTabUrl("balances")"
           @onclick="@(() => HandleTabClick("balances"))"
           @onclick:preventDefault="@PreventNavigation">
            Balances
        </a>
    }
    <a class="bs-tab @(ActiveTab == "presets" ? "bs-tab-active" : "")"
       href="@GetTabUrl("presets")"
       @onclick="@(() => HandleTabClick("presets"))"
       @onclick:preventDefault="@PreventNavigation">
        Presets
    </a>
    <a class="bs-tab @(ActiveTab == "analytics" ? "bs-tab-active" : "")"
       href="@GetTabUrl("analytics")"
       @onclick="@(() => HandleTabClick("analytics"))"
       @onclick:preventDefault="@PreventNavigation">
        Analytics
    </a>
</nav>

@code {
    [Parameter]
    public string SpaceId { get; set; } = "";

    [Parameter]
    public string ActiveTab { get; set; } = "members";

    [Parameter]
    public EventCallback<string> OnTabChange { get; set; }

    [Parameter]
    public bool PreventNavigation { get; set; } = true;

    /// <summary>Shows the Balances tab (money ledger); hosts without that page leave it off.</summary>
    [Parameter]
    public bool ShowBalances { get; set; }

    private string GetTabUrl(string tab)
    {
        return string.IsNullOrEmpty(SpaceId) ? "#" : $"/spaces/{SpaceId}/{tab}";
    }

    private async Task HandleTabClick(string tab)
    {
        await OnTabChange.InvokeAsync(tab);
    }
}
