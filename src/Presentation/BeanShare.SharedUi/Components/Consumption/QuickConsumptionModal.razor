@using BeanShare.Application.Features.CoffeeStock.Dtos
@using BeanShare.Application.Features.Spaces.Dtos
@using BeanShare.SharedUi.Components.Consumption.Models

@if (IsVisible)
{
    <div class="quick-modal-backdrop" @onclick="HandleBackdropClick">
        <div class="quick-modal" role="dialog" aria-label="Log coffee consumption" aria-modal="true" @onclick:stopPropagation="true">
            <div class="quick-modal-header">
                <h2>Log Coffee</h2>
                <button type="button" class="quick-modal-close" aria-label="Close" @onclick="HandleCancel">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <div class="quick-modal-body">
                <button type="button" class="quick-btn quick-btn-qr" @onclick="HandleScanQr">
                    <span class="material-symbols-outlined">qr_code_scanner</span>
                    Scan QR Code
                </button>

                <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
                    <div style="flex: 1; height: 1px; background: var(--bs-border);"></div>
                    <span style="font-size: 0.75rem; color: var(--bs-text-subtle);">or log manually</span>
                    <div style="flex: 1; height: 1px; background: var(--bs-border);"></div>
                </div>

                @if (Spaces == null || !Spaces.Any())
                {
                    <div class="quick-modal-empty">
                        <span class="material-symbols-outlined">coffee_maker</span>
                        <p>No spaces available. Create or join a space first.</p>
                    </div>
                }
                else
                {
                    <div class="quick-form-group">
                        <label class="quick-label">Space</label>
                        <select class="quick-select" @onchange="OnSpaceChanged" value="@selectedSpaceId">
                            <option value="">Select a space...</option>
                            @foreach (var space in Spaces)
                            {
                                <option value="@space.Id">@space.Name</option>
                            }
                        </select>
                    </div>

                    @if (!string.IsNullOrEmpty(selectedSpaceId))
                    {
                        @if (isLoadingStock)
                        {
                            <div class="quick-loading">
                                <div class="quick-spinner"></div>
                                <span>Loading products...</span>
                            </div>
                        }
                        else if (stockProducts == null || !stockProducts.Any())
                        {
                            <div class="quick-modal-empty">
                                <span class="material-symbols-outlined">inventory_2</span>
                                <p>No coffee in stock for this space.</p>
                            </div>
                        }
                        else
                        {
                            <div class="quick-form-group">
                                <label class="quick-label">Coffee Product</label>
                                <select class="quick-select" @onchange="OnProductChanged" value="@selectedProductId">
                                    <option value="">Select coffee...</option>
                                    @foreach (var product in stockProducts)
                                    {
                                        <option value="@product.Id">
                                            @product.ProductDisplayName (@product.CurrentStockGrams g)
                                        </option>
                                    }
                                </select>
                            </div>

                            @if (SpaceMembers != null && SpaceMembers.Count > 1)
                            {
                                <div class="quick-form-group">
                                    <label class="quick-label">Log for</label>
                                    <div role="group" aria-label="Select who to log coffee for and how many cups each" style="display: flex; flex-direction: column; gap: 0.25rem; padding: 0.5rem; background: var(--bs-gray-50); border-radius: 0.5rem; max-height: 10rem; overflow-y: auto;">
                                        <div style="display: flex; align-items: center; gap: 0.5rem; padding: 0.25rem;">
                                            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.875rem; flex: 1; min-width: 0;">
                                                <input type="checkbox" checked="@logForMyself" @onchange="ToggleMyself" aria-label="Log for myself" />
                                                <span style="font-weight: 500;">Myself</span>
                                            </label>
                                            <div class="bs-stepper-group" style="opacity: @(logForMyself ? "1" : "0.4");">
                                                <button type="button" class="bs-stepper-btn" disabled="@(!logForMyself || myselfCount <= 1)" @onclick="() => AdjustMyself(-1)" aria-label="One fewer cup for myself">&minus;</button>
                                                <span class="bs-stepper-value" aria-live="polite">@myselfCount</span>
                                                <button type="button" class="bs-stepper-btn" disabled="@(!logForMyself || myselfCount >= MaxCupsPerPerson)" @onclick="() => AdjustMyself(1)" aria-label="One more cup for myself">+</button>
                                            </div>
                                        </div>
                                        @foreach (var member in SpaceMembers.Where(m => !CurrentUserId.HasValue || m.UserId != CurrentUserId.Value))
                                        {
                                            var memberId = member.UserId;
                                            var isSelected = selectedMemberIds.Contains(memberId);
                                            var count = memberCounts.TryGetValue(memberId, out var c) ? c : 1;
                                            <div style="display: flex; align-items: center; gap: 0.5rem; padding: 0.25rem;">
                                                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.875rem; flex: 1; min-width: 0;">
                                                    <input type="checkbox" checked="@isSelected" @onchange="() => ToggleMember(memberId)" />
                                                    <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@member.UserName</span>
                                                </label>
                                                <div class="bs-stepper-group" style="opacity: @(isSelected ? "1" : "0.4");">
                                                    <button type="button" class="bs-stepper-btn" disabled="@(!isSelected || count <= 1)" @onclick="() => AdjustMember(memberId, -1)" aria-label="One fewer cup">&minus;</button>
                                                    <span class="bs-stepper-value">@count</span>
                                                    <button type="button" class="bs-stepper-btn" disabled="@(!isSelected || count >= MaxCupsPerPerson)" @onclick="() => AdjustMember(memberId, 1)" aria-label="One more cup">+</button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <p style="margin: 0.375rem 0 0 0; font-size: 0.75rem; color: var(--bs-text-subtle);">
                                        <span class="material-symbols-outlined" style="font-size: 0.875rem; vertical-align: middle;">group_add</span>
                                        Colleague brought a guest? Add extra cups to whoever's treating them.
                                    </p>
                                    @if (TotalCups >= 2)
                                    {
                                        <div style="margin-top: 0.5rem; padding: 0.5rem 0.75rem; background: var(--bs-primary-light, #e0e7ff); border-radius: 0.5rem; font-size: 0.8125rem; color: var(--bs-primary); font-weight: 600;">
                                            <span class="material-symbols-outlined" style="font-size: 1rem; vertical-align: middle; margin-right: 0.25rem;">coffee</span>
                                            @CupsSummary
                                        </div>
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(selectedProductId))
                            {
                                <div class="quick-form-group">
                                    <label class="quick-label">Amount</label>
                                    @if (presets != null && presets.Any())
                                    {
                                        <div class="quick-presets">
                                            @foreach (var preset in presets.Where(p => p.IsFavorite).Take(4))
                                            {
                                                <button type="button"
                                                        class="quick-preset-btn @(selectedGrams == preset.Grams && selectedPresetName == preset.Name ? "active" : "")"
                                                        @onclick="() => SelectPreset(preset)">
                                                    @preset.Name (@preset.Grams g)
                                                </button>
                                            }
                                            @if (!presets.Any(p => p.IsFavorite))
                                            {
                                                @foreach (var preset in presets.Take(4))
                                                {
                                                    <button type="button"
                                                            class="quick-preset-btn @(selectedGrams == preset.Grams && selectedPresetName == preset.Name ? "active" : "")"
                                                            @onclick="() => SelectPreset(preset)">
                                                        @preset.Name (@preset.Grams g)
                                                    </button>
                                                }
                                            }
                                            <button type="button"
                                                    class="quick-preset-btn @(isCustomMode ? "active" : "")"
                                                    @onclick="SelectCustomMode">
                                                Custom
                                            </button>
                                        </div>
                                    }

                                    @if (isCustomMode || presets == null || !presets.Any())
                                    {
                                        <div class="quick-custom-input">
                                            <input type="number"
                                                   class="quick-input"
                                                   @bind="customGrams"
                                                   @bind:event="oninput"
                                                   min="1"
                                                   max="500"
                                                   placeholder="Enter grams" />
                                            <span class="quick-input-suffix">g</span>
                                        </div>
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="quick-error">@errorMessage</div>
                            }

                            @* Retagged off .quick-modal-actions/.quick-btn onto the shared
                               hero footer — this modal was their only consumer, so the
                               parallel vocabulary is gone rather than merely restyled. *@
                            <div class="bs-hero-actions">
                                <button type="button"
                                        class="bs-btn bs-btn-primary bs-btn-hero"
                                        @onclick="HandleSubmit"
                                        disabled="@isSubmitting">
                                    @if (isSubmitting)
                                    {
                                        <span>Logging...</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined">coffee</span>
                                        <span>Log Coffee</span>
                                    }
                                </button>
                                <button type="button" class="bs-btn bs-btn-quiet" @onclick="HandleCancel">
                                    Cancel
                                </button>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public List<SpaceSummaryDto>? Spaces { get; set; }

    [Parameter]
    public string? DefaultSpaceId { get; set; }

    [Parameter]
    public EventCallback<Guid> OnSpaceSelected { get; set; }

    [Parameter]
    public EventCallback<QuickConsumptionRequest> OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback OnScanQr { get; set; }

    [Parameter]
    public List<StockLevelDto>? StockProducts { get; set; }

    [Parameter]
    public List<PresetOption>? Presets { get; set; }

    [Parameter]
    public bool IsLoadingStock { get; set; }

    [Parameter]
    public List<MembershipDto>? SpaceMembers { get; set; }

    [Parameter]
    public Guid? CurrentUserId { get; set; }

    private string selectedSpaceId = "";
    private string selectedProductId = "";
    private List<StockLevelDto>? stockProducts;
    private List<PresetOption>? presets;
    private bool isLoadingStock;
    private int selectedGrams;
    private string? selectedPresetName;
    private bool isCustomMode;
    private int customGrams;
    private bool isSubmitting;
    private string? errorMessage;
    private HashSet<Guid> selectedMemberIds = new();
    private Dictionary<Guid, int> memberCounts = new();
    private bool logForMyself = true;
    private int myselfCount = 1;

    private const int MaxCupsPerPerson = 20;

    // Compact stepper button style; dimmed + non-interactive when disabled.

    private int TotalCups
        => (logForMyself ? myselfCount : 0)
           + selectedMemberIds.Sum(id => memberCounts.TryGetValue(id, out var c) ? c : 1);

    private string CupsSummary
    {
        get
        {
            var parts = new List<string>();
            if (logForMyself) parts.Add($"You ×{myselfCount}");
            foreach (var m in SpaceMembers?.Where(m => selectedMemberIds.Contains(m.UserId)) ?? Enumerable.Empty<MembershipDto>())
            {
                var c = memberCounts.TryGetValue(m.UserId, out var v) ? v : 1;
                parts.Add($"{m.UserName} ×{c}");
            }
            var total = TotalCups;
            return $"Logging {total} cup{(total == 1 ? "" : "s")} · {string.Join(", ", parts)}";
        }
    }

    protected override void OnParametersSet()
    {
        stockProducts = StockProducts;
        presets = Presets;
        isLoadingStock = IsLoadingStock;

        if (IsVisible && string.IsNullOrEmpty(selectedSpaceId))
        {
            // Pre-select a space so a single-space user skips the picker entirely.
            var initialSpaceId = !string.IsNullOrEmpty(DefaultSpaceId)
                ? DefaultSpaceId
                : (Spaces != null && Spaces.Count == 1 ? Spaces[0].Id.ToString() : null);

            if (!string.IsNullOrEmpty(initialSpaceId))
            {
                selectedSpaceId = initialSpaceId;
                _ = LoadSpaceData();
            }
        }

        // Once stock has loaded, pre-select the product (open bag → most stock) and its
        // default preset, so the common case is "open modal, tap Log Coffee".
        if (!string.IsNullOrEmpty(selectedSpaceId) && string.IsNullOrEmpty(selectedProductId)
            && stockProducts != null && stockProducts.Any())
        {
            var def = stockProducts.FirstOrDefault(s => s.IsCurrentlyUsed)
                      ?? stockProducts.OrderByDescending(s => s.CurrentStockGrams).FirstOrDefault();
            if (def != null)
            {
                selectedProductId = def.Id.ToString();
                if (presets != null && presets.Any())
                {
                    var defaultPreset = presets.FirstOrDefault(p => p.IsFavorite) ?? presets.FirstOrDefault();
                    if (defaultPreset != null)
                        SelectPreset(defaultPreset);
                }
            }
        }
    }

    private async Task OnSpaceChanged(ChangeEventArgs e)
    {
        selectedSpaceId = e.Value?.ToString() ?? "";
        selectedProductId = "";
        stockProducts = null;
        presets = null;
        selectedGrams = 0;
        selectedPresetName = null;
        isCustomMode = false;
        customGrams = 0;
        errorMessage = null;
        selectedMemberIds.Clear();

        if (!string.IsNullOrEmpty(selectedSpaceId))
        {
            await LoadSpaceData();
        }
    }

    private async Task LoadSpaceData()
    {
        if (Guid.TryParse(selectedSpaceId, out var spaceGuid))
        {
            isLoadingStock = true;
            StateHasChanged();

            await OnSpaceSelected.InvokeAsync(spaceGuid);
        }
    }

    private void OnProductChanged(ChangeEventArgs e)
    {
        selectedProductId = e.Value?.ToString() ?? "";
        errorMessage = null;

        if (!string.IsNullOrEmpty(selectedProductId) && presets != null && presets.Any())
        {
            var defaultPreset = presets.FirstOrDefault(p => p.IsFavorite) ?? presets.FirstOrDefault();
            if (defaultPreset != null)
            {
                SelectPreset(defaultPreset);
            }
        }
    }

    private void SelectPreset(PresetOption preset)
    {
        isCustomMode = false;
        selectedGrams = preset.Grams;
        selectedPresetName = preset.Name;
        customGrams = 0;
    }

    private void SelectCustomMode()
    {
        isCustomMode = true;
        selectedPresetName = null;
        selectedGrams = 0;
    }

    private int GetSelectedGrams()
    {
        return isCustomMode ? customGrams : selectedGrams;
    }

    private void ToggleMyself()
    {
        logForMyself = !logForMyself;
        if (logForMyself && myselfCount < 1)
            myselfCount = 1;
    }

    private void AdjustMyself(int delta)
    {
        myselfCount = Math.Clamp(myselfCount + delta, 1, MaxCupsPerPerson);
    }

    private void ToggleMember(Guid memberId)
    {
        if (selectedMemberIds.Contains(memberId))
        {
            selectedMemberIds.Remove(memberId);
        }
        else
        {
            selectedMemberIds.Add(memberId);
            if (!memberCounts.ContainsKey(memberId))
                memberCounts[memberId] = 1;
        }
    }

    private void AdjustMember(Guid memberId, int delta)
    {
        var count = memberCounts.TryGetValue(memberId, out var c) ? c : 1;
        memberCounts[memberId] = Math.Clamp(count + delta, 1, MaxCupsPerPerson);
    }

    private async Task HandleSubmit()
    {
        errorMessage = null;
        var grams = GetSelectedGrams();

        if (grams <= 0)
        {
            errorMessage = "Please select or enter an amount.";
            return;
        }

        if (string.IsNullOrEmpty(selectedProductId))
        {
            errorMessage = "Please select a coffee product.";
            return;
        }

        if (!Guid.TryParse(selectedSpaceId, out var spaceGuid))
        {
            errorMessage = "Please select a space.";
            return;
        }

        var selectedProduct = stockProducts?.FirstOrDefault(p => p.Id.ToString() == selectedProductId);
        if (selectedProduct == null)
        {
            errorMessage = "Selected product not found.";
            return;
        }

        if (grams > selectedProduct.CurrentStockGrams)
        {
            errorMessage = $"Not enough stock. Only {selectedProduct.CurrentStockGrams}g available.";
            return;
        }

        // Validate that at least one person is selected
        if (!logForMyself && !selectedMemberIds.Any())
        {
            errorMessage = "Please select at least one member.";
            return;
        }

        isSubmitting = true;
        StateHasChanged();

        try
        {
            // Expand per-person cup counts into a flat target list. A repeated id means that
            // many identical cups for that person (the parent logs one entry per id), which
            // covers "a colleague brought a guest" — bump the host's count.
            List<Guid>? forUserIds = null;
            if (SpaceMembers != null && SpaceMembers.Count > 1)
            {
                var targetIds = new List<Guid>();
                if (logForMyself && CurrentUserId.HasValue)
                {
                    for (var i = 0; i < myselfCount; i++)
                        targetIds.Add(CurrentUserId.Value);
                }
                foreach (var memberId in selectedMemberIds)
                {
                    var count = memberCounts.TryGetValue(memberId, out var c) ? c : 1;
                    for (var i = 0; i < count; i++)
                        targetIds.Add(memberId);
                }

                if (targetIds.Count > 0)
                    forUserIds = targetIds;
            }

            var request = new QuickConsumptionRequest
            {
                SpaceId = spaceGuid,
                Grams = grams,
                ProductName = selectedProduct.ProductName,
                ProductBrand = selectedProduct.ProductBrand,
                ProductType = selectedProduct.ProductType,
                PresetName = isCustomMode ? null : selectedPresetName,
                ConsumedAt = DateTime.UtcNow,
                ForUserIds = forUserIds
            };

            await OnSubmit.InvokeAsync(request);

            // Reset form after successful submission
            ResetForm();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to log consumption: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task HandleScanQr()
    {
        ResetForm();
        await OnScanQr.InvokeAsync();
    }

    private async Task HandleBackdropClick()
    {
        await HandleCancel();
    }

    private async Task HandleCancel()
    {
        ResetForm();
        await OnCancel.InvokeAsync();
    }

    private void ResetForm()
    {
        selectedSpaceId = DefaultSpaceId ?? "";
        selectedProductId = "";
        stockProducts = null;
        presets = null;
        selectedGrams = 0;
        selectedPresetName = null;
        isCustomMode = false;
        customGrams = 0;
        errorMessage = null;
        selectedMemberIds.Clear();
        memberCounts.Clear();
        logForMyself = true;
        myselfCount = 1;
    }
}
