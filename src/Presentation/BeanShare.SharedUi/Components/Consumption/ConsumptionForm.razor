@using BeanShare.Application.Features.CoffeeStock.Dtos
@using BeanShare.Application.Features.Presets.Queries
@using BeanShare.Application.Features.Spaces.Dtos
@using BeanShare.SharedUi.Components.Consumption.Models

<div class="bs-card">
    <EditForm EditContext="editContext" OnSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        @if (StockProducts == null || !StockProducts.Any())
        {
            <div style="padding: 1rem; background: var(--bs-warning-light); border-radius: 0.5rem; margin-bottom: 1rem;">
                <p style="margin: 0 0 0.75rem 0; color: var(--bs-warning-dark); font-size: 0.875rem;">
                    No coffee in stock yet. Add a bag before logging cups.
                </p>
                @if (OnAddStock.HasDelegate)
                {
                    <button type="button" class="bs-btn bs-btn-sm bs-btn-primary" @onclick="OnAddStock">
                        <span class="material-symbols-outlined" style="font-size: 1.1rem;">add</span>
                        Add coffee to stock
                    </button>
                }
            </div>
        }
        else
        {
            <div class="bs-form-group">
                <label class="bs-label" for="productSelect">Coffee Product</label>
                <select id="productSelect"
                        class="bs-input"
                        @onchange="OnProductSelected"
                        value="@selectedProductId">
                    <option value="">-- Select a coffee product --</option>
                    @foreach (var product in StockProducts)
                    {
                        <option value="@product.Id">
                            @product.ProductDisplayName (@product.ProductType, @product.CurrentStockGrams g available)
                        </option>
                    }
                </select>
            </div>

            @if (SpaceMembers != null && SpaceMembers.Count > 1)
            {
                <div class="bs-form-group">
                    <label class="bs-label">Log for</label>
                    <div role="group" aria-label="Select who to log coffee for and how many cups each" style="display: flex; flex-direction: column; gap: 0.25rem; padding: 0.5rem; background: var(--bs-gray-50); border-radius: 0.5rem; max-height: 14rem; overflow-y: auto;">
                        <div style="display: flex; align-items: center; gap: 0.5rem; padding: 0.25rem;">
                            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.875rem; flex: 1; min-width: 0;">
                                <input type="checkbox" checked="@logForMyself" @onchange="ToggleMyself" aria-label="Log for myself" />
                                <span style="font-weight: 500;">Myself</span>
                            </label>
                            <div style="display: flex; align-items: center; gap: 0.25rem; opacity: @(logForMyself ? "1" : "0.4"); transition: opacity 0.15s;">
                                <button type="button" style="@StepBtn(!logForMyself || myselfCount <= 1)" disabled="@(!logForMyself || myselfCount <= 1)" @onclick="() => AdjustMyself(-1)" aria-label="One fewer cup for myself">&minus;</button>
                                <span style="min-width: 1.25rem; text-align: center; font-weight: 600; font-size: 0.875rem;" aria-live="polite">@myselfCount</span>
                                <button type="button" style="@StepBtn(!logForMyself || myselfCount >= MaxCupsPerPerson)" disabled="@(!logForMyself || myselfCount >= MaxCupsPerPerson)" @onclick="() => AdjustMyself(1)" aria-label="One more cup for myself">+</button>
                            </div>
                        </div>
                        @foreach (var member in SpaceMembers.Where(m => !CurrentUserId.HasValue || m.UserId != CurrentUserId.Value))
                        {
                            var memberId = member.UserId;
                            var isSelected = selectedMemberIds.Contains(memberId);
                            var count = memberCounts.TryGetValue(memberId, out var c) ? c : 1;
                            <div style="display: flex; align-items: center; gap: 0.5rem; padding: 0.25rem;">
                                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.875rem; flex: 1; min-width: 0;">
                                    <input type="checkbox" checked="@isSelected" @onchange="() => ToggleMember(memberId)" />
                                    <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@member.UserName</span>
                                </label>
                                <div style="display: flex; align-items: center; gap: 0.25rem; opacity: @(isSelected ? "1" : "0.4"); transition: opacity 0.15s;">
                                    <button type="button" style="@StepBtn(!isSelected || count <= 1)" disabled="@(!isSelected || count <= 1)" @onclick="() => AdjustMember(memberId, -1)" aria-label="One fewer cup">&minus;</button>
                                    <span style="min-width: 1.25rem; text-align: center; font-weight: 600; font-size: 0.875rem;">@count</span>
                                    <button type="button" style="@StepBtn(!isSelected || count >= MaxCupsPerPerson)" disabled="@(!isSelected || count >= MaxCupsPerPerson)" @onclick="() => AdjustMember(memberId, 1)" aria-label="One more cup">+</button>
                                </div>
                            </div>
                        }
                    </div>
                    <p style="margin: 0.375rem 0 0 0; font-size: 0.75rem; color: var(--bs-text-subtle);">
                        <span class="material-symbols-outlined" style="font-size: 0.875rem; vertical-align: middle;">group_add</span>
                        Colleague brought a guest? Add extra cups to whoever's treating them.
                    </p>
                    @if (TotalCups >= 2)
                    {
                        <div style="margin-top: 0.5rem; padding: 0.5rem 0.75rem; background: var(--bs-primary-light, #e0e7ff); border-radius: 0.5rem; font-size: 0.8125rem; color: var(--bs-primary); font-weight: 600;">
                            <span class="material-symbols-outlined" style="font-size: 1rem; vertical-align: middle; margin-right: 0.25rem;">coffee</span>
                            @CupsSummary
                        </div>
                    }
                </div>
            }

            <div class="bs-form-group">
                <label class="bs-label">Quick Presets</label>
                @if (QuickPresets == null || !QuickPresets.Any())
                {
                    <div style="padding: 0.5rem; background: var(--bs-gray-100); border-radius: 0.5rem; font-size: 0.875rem; color: var(--bs-text-subtle);">
                        Loading presets...
                    </div>
                }
                else
                {
                    var favorites = QuickPresets.Where(p => p.IsFavorite).ToList();
                    var nonFavorites = QuickPresets.Where(p => !p.IsFavorite).ToList();

                    @if (favorites.Any())
                    {
                        <div style="margin-bottom: 0.5rem;">
                            <span style="font-size: 0.75rem; color: var(--bs-text-subtle); font-weight: 600;">FAVORITES</span>
                        </div>
                        <div class="bs-flex bs-gap-2" style="flex-wrap: wrap; margin-bottom: 1rem;">
                            @foreach (var preset in favorites)
                            {
                                <button type="button"
                                        class="bs-btn bs-btn-sm @(IsPresetSelected(preset) ? "bs-btn-primary" : "bs-btn-secondary")"
                                        style="position: relative;"
                                        @onclick="() => SelectPreset(preset)">
                                    <span class="material-symbols-outlined" style="font-size: 0.875rem; margin-right: 0.25rem; vertical-align: middle;">star</span>
                                    @preset.Name · @preset.Grams g
                                </button>
                            }
                        </div>
                    }

                    @if (nonFavorites.Any())
                    {
                        @if (favorites.Any())
                        {
                            <div style="margin-bottom: 0.5rem;">
                                <span style="font-size: 0.75rem; color: var(--bs-text-subtle); font-weight: 600;">ALL PRESETS</span>
                            </div>
                        }
                        <div class="bs-flex bs-gap-2" style="flex-wrap: wrap;">
                            @foreach (var preset in nonFavorites)
                            {
                                <button type="button"
                                        class="bs-btn bs-btn-sm @(IsPresetSelected(preset) ? "bs-btn-primary" : "bs-btn-secondary")"
                                        @onclick="() => SelectPreset(preset)">
                                    @preset.Name · @preset.Grams g
                                </button>
                            }
                            <button type="button"
                                    class="bs-btn bs-btn-sm @(isCustomMode ? "bs-btn-primary" : "bs-btn-secondary")"
                                    @onclick="SelectCustom">
                                Custom
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="bs-flex bs-gap-2" style="flex-wrap: wrap;">
                            <button type="button"
                                    class="bs-btn bs-btn-sm @(isCustomMode ? "bs-btn-primary" : "bs-btn-secondary")"
                                    @onclick="SelectCustom">
                                Custom
                            </button>
                        </div>
                    }
                }
            </div>

            @if (isCustomMode)
            {
                <div class="bs-form-group">
                    <label class="bs-label" for="gramsInput">Coffee (grams)</label>
                    <div style="position: relative;">
                        <InputNumber id="gramsInput"
                                    class="bs-input"
                                    @bind-Value="model.Grams"
                                    placeholder="12" />
                        <span style="position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--bs-text-subtle); font-size: 0.875rem;">
                            g
                        </span>
                    </div>
                    <ValidationMessage For="@(() => model.Grams)" class="bs-validation-message" />
                </div>
            }

            <div class="bs-form-group">
                <label class="bs-label" for="dateTimeInput">Date & Time</label>
                <InputDate Type="InputDateType.DateTimeLocal"
                          id="dateTimeInput"
                          class="bs-input"
                          @bind-Value="model.ConsumedAt" />
                <p style="margin: 0.25rem 0 0 0; font-size: 0.75rem; color: var(--bs-text-subtle);">
                    Defaults to now.
                </p>
            </div>

            @* Already primary-first, so only the emphasis classes change. Reset is a
               peer rather than a dismiss, but the same ratio is what's wanted: it
               wipes the whole form, so it should not look like a co-equal button. *@
            <div class="bs-hero-actions">
                <button type="submit" class="bs-btn bs-btn-primary bs-btn-hero" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span>Logging...</span>
                    }
                    else
                    {
                        <span>Log Coffee</span>
                    }
                </button>
                <button type="button" class="bs-btn bs-btn-quiet" @onclick="Reset">
                    Reset
                </button>
            </div>
        }
    </EditForm>
</div>

@code {
    [Parameter]
    public EventCallback<ConsumptionFormModel> OnSubmit { get; set; }

    [Parameter]
    public EventCallback<string> OnValidationError { get; set; }

    [Parameter]
    public List<StockLevelDto> StockProducts { get; set; } = new();

    [Parameter]
    public PresetDto? PresetData { get; set; }

    [Parameter]
    public List<PresetOption>? QuickPresets { get; set; }

    [Parameter]
    public EventCallback<(PresetOption Preset, bool IsFavorite)> OnToggleFavorite { get; set; }

    [Parameter]
    public List<MembershipDto>? SpaceMembers { get; set; }

    [Parameter]
    public Guid? CurrentUserId { get; set; }

    [Parameter]
    public Guid? DefaultStockLevelId { get; set; }

    [Parameter]
    public EventCallback OnAddStock { get; set; }

    private ConsumptionFormModel model = new() { ConsumedAt = DateTime.Now };
    private EditContext editContext = default!;
    private bool isSubmitting;
    private bool isCustomMode = false;
    private PresetOption? selectedPresetOption;
    private StockLevelDto? selectedProduct;
    private string selectedProductId = "";

    private HashSet<Guid> selectedMemberIds = new();
    private Dictionary<Guid, int> memberCounts = new();
    private bool logForMyself = true;
    private int myselfCount = 1;

    private const int MaxCupsPerPerson = 20;

    // Compact stepper button style; dimmed + non-interactive when disabled.
    private const string StepperBtnStyle = "width: 1.75rem; height: 1.75rem; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--bs-border); background: var(--bs-background-light, #fff); border-radius: 0.375rem; font-size: 1rem; line-height: 1; padding: 0; color: var(--bs-text);";
    private static string StepBtn(bool disabled) => StepperBtnStyle + (disabled ? " opacity: 0.4; cursor: default;" : " cursor: pointer;");

    private int TotalCups
        => (logForMyself ? myselfCount : 0)
           + selectedMemberIds.Sum(id => memberCounts.TryGetValue(id, out var c) ? c : 1);

    private string CupsSummary
    {
        get
        {
            var parts = new List<string>();
            if (logForMyself) parts.Add($"You ×{myselfCount}");
            foreach (var m in SpaceMembers?.Where(m => selectedMemberIds.Contains(m.UserId)) ?? Enumerable.Empty<MembershipDto>())
            {
                var c = memberCounts.TryGetValue(m.UserId, out var v) ? v : 1;
                parts.Add($"{m.UserName} ×{c}");
            }
            var total = TotalCups;
            return $"Logging {total} cup{(total == 1 ? "" : "s")} · {string.Join(", ", parts)}";
        }
    }

    protected override void OnInitialized()
    {
        editContext = new EditContext(model);
    }

    protected override void OnParametersSet()
    {
        if (PresetData != null)
        {
            model.Grams = (int)PresetData.DefaultGrams;
            model.PresetId = PresetData.Id;
            model.PresetName = PresetData.Name;

            isCustomMode = true;
            selectedPresetOption = null;
        }
        else if (model.Grams == 0 && !isCustomMode && selectedPresetOption == null)
        {
            // Select first favorite or first preset by default
            var defaultPreset = QuickPresets?.FirstOrDefault(p => p.IsFavorite) ?? QuickPresets?.FirstOrDefault();
            if (defaultPreset != null)
            {
                SelectPreset(defaultPreset);
            }
            else
            {
                model.Grams = 8; // Fallback default
            }
        }

        // Pre-select currently used product if no product is selected yet
        if (string.IsNullOrEmpty(selectedProductId) && DefaultStockLevelId.HasValue)
        {
            var defaultProduct = StockProducts.FirstOrDefault(p => p.Id == DefaultStockLevelId.Value);
            if (defaultProduct != null)
            {
                selectedProductId = defaultProduct.Id.ToString();
                selectedProduct = defaultProduct;
                model.ProductName = defaultProduct.ProductName;
                model.ProductBrand = defaultProduct.ProductBrand;
                model.ProductType = defaultProduct.ProductType;
            }
        }
    }

    private bool IsPresetSelected(PresetOption preset)
    {
        if (selectedPresetOption == null) return false;

        if (preset.GlobalPresetId.HasValue && selectedPresetOption.GlobalPresetId.HasValue)
            return preset.GlobalPresetId == selectedPresetOption.GlobalPresetId;

        if (preset.SpacePresetId.HasValue && selectedPresetOption.SpacePresetId.HasValue)
            return preset.SpacePresetId == selectedPresetOption.SpacePresetId;

        return preset.Name == selectedPresetOption.Name && preset.Grams == selectedPresetOption.Grams;
    }

    private void OnProductSelected(ChangeEventArgs e)
    {
        selectedProductId = e.Value?.ToString() ?? "";

        if (string.IsNullOrEmpty(selectedProductId))
        {
            selectedProduct = null;
            model.ProductName = "";
            model.ProductBrand = "";
            model.ProductType = "";
        }
        else
        {
            selectedProduct = StockProducts.FirstOrDefault(p => p.Id.ToString() == selectedProductId);
            if (selectedProduct != null)
            {
                model.ProductName = selectedProduct.ProductName;
                model.ProductBrand = selectedProduct.ProductBrand;
                model.ProductType = selectedProduct.ProductType;
            }
        }
    }

    private void ToggleMyself()
    {
        logForMyself = !logForMyself;
        if (logForMyself && myselfCount < 1)
            myselfCount = 1;
    }

    private void AdjustMyself(int delta)
    {
        myselfCount = Math.Clamp(myselfCount + delta, 1, MaxCupsPerPerson);
    }

    private void ToggleMember(Guid memberId)
    {
        if (selectedMemberIds.Contains(memberId))
        {
            selectedMemberIds.Remove(memberId);
        }
        else
        {
            selectedMemberIds.Add(memberId);
            if (!memberCounts.ContainsKey(memberId))
                memberCounts[memberId] = 1;
        }
    }

    private void AdjustMember(Guid memberId, int delta)
    {
        var count = memberCounts.TryGetValue(memberId, out var c) ? c : 1;
        memberCounts[memberId] = Math.Clamp(count + delta, 1, MaxCupsPerPerson);
    }

    private void SelectPreset(PresetOption preset)
    {
        isCustomMode = false;
        selectedPresetOption = preset;
        model.Grams = preset.Grams;
        model.PresetName = preset.Name;

        model.GlobalPresetId = preset.GlobalPresetId;
        model.SpacePresetId = preset.SpacePresetId;
    }

    private void SelectCustom()
    {
        isCustomMode = true;
        selectedPresetOption = null;
        model.PresetName = null;
        model.GlobalPresetId = null;
        model.SpacePresetId = null;
        model.Grams = 0;
    }

    private async Task HandleSubmit()
    {
        if (selectedProduct == null)
        {
            await OnValidationError.InvokeAsync("Please select a coffee product.");
            return;
        }

        if (!editContext.Validate())
            return;

        if (!logForMyself && !selectedMemberIds.Any())
        {
            await OnValidationError.InvokeAsync("Please select at least one person to log coffee for.");
            return;
        }

        // Expand per-person cup counts into a flat target list. A repeated id means that many
        // identical cups for that person (the downstream handler logs one entry per id), which
        // covers "a colleague brought a guest" — bump the host's count.
        var targetIds = new List<Guid>();
        if (logForMyself && CurrentUserId.HasValue)
        {
            for (var i = 0; i < myselfCount; i++)
                targetIds.Add(CurrentUserId.Value);
        }
        foreach (var memberId in selectedMemberIds)
        {
            var count = memberCounts.TryGetValue(memberId, out var c) ? c : 1;
            for (var i = 0; i < count; i++)
                targetIds.Add(memberId);
        }

        if (targetIds.Count > 0)
        {
            model.ForUserIds = targetIds;
            model.ForUserId = null;
        }
        else
        {
            // Only reachable when logging solely for myself with an unknown CurrentUserId:
            // fall back to the null-target path (the handler resolves it to the current user).
            model.ForUserIds = null;
            model.ForUserId = null;
        }

        isSubmitting = true;
        try
        {
            await OnSubmit.InvokeAsync(model);
            Reset();
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Reset()
    {
        var defaultPreset = QuickPresets?.FirstOrDefault(p => p.IsFavorite) ?? QuickPresets?.FirstOrDefault();

        model = new ConsumptionFormModel
        {
            ConsumedAt = DateTime.Now,
            Grams = defaultPreset?.Grams ?? 8
        };
        editContext = new EditContext(model);

        isCustomMode = false;
        selectedPresetOption = defaultPreset;

        if (defaultPreset != null)
        {
            model.PresetName = defaultPreset.Name;
            model.GlobalPresetId = defaultPreset.GlobalPresetId;
            model.SpacePresetId = defaultPreset.SpacePresetId;
        }

        selectedProduct = null;
        selectedProductId = "";
        selectedMemberIds.Clear();
        memberCounts.Clear();
        logForMyself = true;
        myselfCount = 1;

        // Re-apply the default product so logging several cups in a row stays one tap
        // (OnParametersSet won't fire again after an internal reset).
        if (DefaultStockLevelId.HasValue)
        {
            var defaultProduct = StockProducts?.FirstOrDefault(p => p.Id == DefaultStockLevelId.Value);
            if (defaultProduct != null)
            {
                selectedProductId = defaultProduct.Id.ToString();
                selectedProduct = defaultProduct;
                model.ProductName = defaultProduct.ProductName;
                model.ProductBrand = defaultProduct.ProductBrand;
                model.ProductType = defaultProduct.ProductType;
            }
        }
    }
}
