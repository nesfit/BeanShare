<div>
    @if (!HideHeader)
    {
        <h2 class="bs-font-bold" style="margin: 0 0 1rem 0; font-size: 1.125rem;">Recent Logs</h2>
    }

    @if (IsLoading)
    {
        <div class="bs-flex bs-flex-col bs-gap-2">
            @for (int i = 0; i < 3; i++)
            {
                <div class="bs-card">
                    <div class="bs-skeleton" style="height: 1rem; width: 50%; margin-bottom: 0.5rem;"></div>
                    <div class="bs-skeleton" style="height: 0.875rem; width: 30%;"></div>
                </div>
            }
        </div>
    }
    else if (RecentLogs == null || !RecentLogs.Any())
    {
        <EmptyState Icon="local_cafe"
                    Title="No consumption logged yet"
                    Message="Log your first coffee to start tracking your consumption." />
    }
    else
    {
        <div class="bs-flex bs-flex-col bs-gap-2">
            @foreach (var log in RecentLogs.Take(10))
            {
                <div class="bs-card">
                    @if (editingId == log.Id)
                    {
                        <div class="bs-flex bs-flex-col bs-gap-2">
                            <div class="bs-flex bs-gap-2">
                                <input type="text" class="bs-input" placeholder="Product name" @bind="editProductName" style="flex: 1;" />
                                <input type="text" class="bs-input" placeholder="Brand" @bind="editProductBrand" style="flex: 1;" />
                            </div>
                            <div class="bs-flex bs-gap-2">
                                <select class="bs-input" @bind="editProductType" style="flex: 1;">
                                    <option value="Espresso">Espresso</option>
                                    <option value="Filter">Filter</option>
                                    <option value="Instant">Instant</option>
                                    <option value="Decaf">Decaf</option>
                                    <option value="Specialty">Specialty</option>
                                </select>
                                <input type="number" class="bs-input" placeholder="Grams" @bind="editQuantity" min="1" style="width: 5rem;" />
                            </div>
                            <div class="bs-flex bs-gap-2">
                                <input type="datetime-local" class="bs-input" @bind="editConsumedAt" style="flex: 1;" />
                            </div>
                            <div class="bs-flex bs-gap-2 bs-justify-end">
                                <button class="bs-btn-sm" style="background: var(--bs-gray-100); border: none; cursor: pointer;" @onclick="CancelEdit">
                                    Cancel
                                </button>
                                <button class="bs-btn-sm" style="background: var(--bs-primary); color: white; border: none; cursor: pointer;" @onclick="() => SaveEdit(log)">
                                    Save
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="bs-flex bs-justify-between bs-items-center">
                            <div style="flex: 1; min-width: 0;">
                                <p class="bs-font-medium" style="margin: 0;">
                                    @(GetLogDisplayName(log)) · @log.CoffeeGrams g
                                </p>
                                <p class="bs-text-subtle" style="margin: 0.25rem 0 0 0; font-size: 0.75rem;">
                                    @log.UserName · @FormatDate(log.ConsumedAt)
                                </p>
                            </div>
                            <div class="bs-flex bs-items-center bs-gap-2">
                                <div class="bs-flex bs-flex-col" style="align-items: flex-end;">
                                    <span class="bs-font-semibold" style="text-align: right; color: var(--bs-text); white-space: nowrap;">
                                        −@log.CoffeeGrams g
                                    </span>
                                    @if (log.CostAmount.HasValue)
                                    {
                                        <span class="bs-text-subtle" style="font-size: 0.75rem; white-space: nowrap;" title="Cost of this cup, from its bag's price">
                                            @FormatCost(log.CostAmount.Value, log.CostCurrency)
                                        </span>
                                    }
                                </div>
                                @* A page that binds no handler (MAUI's SpacePage) shows no action for it. *@
                                @if (log.CanEdit && OnEdit.HasDelegate)
                                {
                                    <button type="button" class="bs-btn-icon" style="color: var(--bs-text-subtle);" title="Edit" aria-label="Edit" @onclick="() => StartEdit(log)">
                                        <span class="material-symbols-outlined" style="font-size: 1rem;">edit</span>
                                    </button>
                                }
                                @if (log.CanDelete && OnDelete.HasDelegate)
                                {
                                    <button type="button" class="bs-btn-icon" style="color: var(--bs-error, #dc3545);" title="Delete" aria-label="Delete" @onclick="() => ConfirmDelete(log)">
                                        <span class="material-symbols-outlined" style="font-size: 1rem;">delete</span>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @* Was an ad-hoc fixed overlay that bypassed every modal system in the app and
       duplicated ConsumptionHistoryList's identical dialog. Both now use
       ConfirmDialog. *@
    <ConfirmDialog IsVisible="@showDeleteConfirm"
                   Title="Delete consumption?"
                   Message="This action cannot be undone."
                   ConfirmText="Delete"
                   IsDestructive="true"
                   OnConfirm="ExecuteDelete"
                   OnCancel="CancelDelete" />
</div>

@code {
    [Parameter]
    public IEnumerable<ConsumptionEntryDto>? RecentLogs { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public EventCallback<ConsumptionEntryDto> OnEdit { get; set; }

    [Parameter]
    public EventCallback<Guid> OnDelete { get; set; }

    [Parameter]
    public bool HideHeader { get; set; }

    private Guid? editingId;
    private string editProductName = "";
    private string editProductBrand = "";
    private string editProductType = "Espresso";
    private decimal editQuantity;
    private DateTime editConsumedAt;

    private bool showDeleteConfirm;
    private ConsumptionEntryDto? deleteTarget;

    private void StartEdit(ConsumptionEntryDto log)
    {
        editingId = log.Id;
        editProductName = log.ProductName;
        editProductBrand = log.ProductBrand;
        editProductType = log.ProductType;
        editQuantity = log.QuantityGrams;
        editConsumedAt = log.ConsumedAt;
    }

    private void CancelEdit()
    {
        editingId = null;
    }

    private async Task SaveEdit(ConsumptionEntryDto log)
    {
        var updated = new ConsumptionEntryDto
        {
            Id = log.Id,
            SpaceId = log.SpaceId,
            UserId = log.UserId,
            UserName = log.UserName,
            ProductName = editProductName,
            ProductBrand = editProductBrand,
            ProductType = editProductType,
            QuantityGrams = editQuantity,
            RemainingGrams = 0,
            ConsumedAt = editConsumedAt,
            CreatedAt = log.CreatedAt,
            CanEdit = log.CanEdit,
            CanDelete = log.CanDelete,
            PresetId = log.PresetId,
            PresetName = log.PresetName
        };

        await OnEdit.InvokeAsync(updated);
        editingId = null;
    }

    private void ConfirmDelete(ConsumptionEntryDto log)
    {
        deleteTarget = log;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        deleteTarget = null;
    }

    private async Task ExecuteDelete()
    {
        if (deleteTarget != null)
        {
            await OnDelete.InvokeAsync(deleteTarget.Id);
        }
        showDeleteConfirm = false;
        deleteTarget = null;
    }

    private string GetLogDisplayName(ConsumptionEntryDto log)
    {
        if (!string.IsNullOrEmpty(log.PresetName))
            return log.PresetName;

        if (!string.IsNullOrEmpty(log.ProductName) && log.ProductName != "Unknown")
        {
            if (!string.IsNullOrEmpty(log.ProductBrand) && log.ProductBrand != "Unknown" && log.ProductBrand != "Generic")
                return $"{log.ProductBrand} {log.ProductName}";
            return log.ProductName;
        }

        return "Custom log";
    }

    private static string FormatCost(decimal amount, string? currencyCode)
    {
        if (string.IsNullOrEmpty(currencyCode))
            return amount.ToString("0.00");
        try
        {
            return BeanShare.Domain.ValueObjects.Currency.Create(currencyCode).FormatAmount(amount);
        }
        catch
        {
            return $"{amount:0.00} {currencyCode}";
        }
    }

    private string FormatDate(DateTime date)
    {
        var local = date.ToLocalTime();
        var now = DateTime.Now;
        if (local.Date == now.Date)
            return $"Today, {local:h:mm tt}";
        if (local.Date == now.Date.AddDays(-1))
            return $"Yesterday, {local:h:mm tt}";
        return local.ToString("MMM dd, h:mm tt");
    }
}
