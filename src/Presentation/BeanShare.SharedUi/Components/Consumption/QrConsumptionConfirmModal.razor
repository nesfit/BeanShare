@using BeanShare.SharedUi.Services
@using BeanShare.SharedUi.Components.Consumption.Models
@using BeanShare.Application.Features.Spaces.Dtos

@if (IsVisible && Payload != null)
{
    <div class="bs-modal-backdrop" @onclick="HandleCancel">
        <div class="bs-modal" role="dialog" aria-label="Confirm QR consumption" aria-modal="true" @onclick:stopPropagation="true" @ontouchend:stopPropagation="true" style="max-width: 26rem;">
            <div class="bs-modal-header bs-flex bs-items-center bs-justify-between" style="margin-bottom: 1rem;">
                <h3 class="bs-modal-title" style="margin: 0;">
                    <span class="material-symbols-outlined bs-qr-scan-title">check_circle</span>
                    QR Scanned
                </h3>
                <button class="bs-btn-icon" aria-label="Close" @onclick="HandleCancel" style="background: transparent; border: none; cursor: pointer;">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <div style="background: var(--bs-gray-50); border-radius: 0.5rem; padding: 1rem; margin-bottom: 1rem;">
                <p class="bs-font-bold" style="margin: 0; font-size: 1.125rem;">@Payload.ProductBrand @Payload.ProductName</p>
                <p class="bs-text-subtle" style="margin: 0.25rem 0 0 0; font-size: 0.875rem;">@Payload.ProductType</p>
                @if (!hasOpenRecipe && !string.IsNullOrWhiteSpace(Payload.RecipeName))
                {
                    <p class="bs-text-subtle" style="margin: 0.25rem 0 0 0; font-size: 0.875rem;">
                        <span class="material-symbols-outlined" style="font-size: 0.875rem; vertical-align: middle;">coffee</span>
                        <span style="font-weight: 600;">@Payload.RecipeName</span>
                        <span> · @Payload.DefaultGrams g</span>
                    </p>
                }
                @if (!string.IsNullOrEmpty(Payload.QrLabel))
                {
                    <p class="bs-qr-location">
                        <span class="material-symbols-outlined" style="font-size: 0.875rem; vertical-align: middle;">location_on</span>
                        @Payload.QrLabel
                    </p>
                }
            </div>

            @if (hasOpenRecipe)
            {
                <div class="bs-form-group" style="margin-bottom: 1rem;">
                    <label class="bs-label">Recipe</label>
                    @if (QuickPresets != null && QuickPresets.Count > 0)
                    {
                        <div style="display: flex; flex-wrap: wrap; gap: 0.375rem; margin-bottom: 0.5rem;">
                            @foreach (var preset in QuickPresets)
                            {
                                var isSelected = selectedRecipe == preset.Name;
                                <button type="button"
                                        class="bs-btn bs-btn-sm @(isSelected ? "bs-btn-primary" : "bs-btn-secondary")"
                                        style="font-size: 0.75rem; padding: 0.25rem 0.5rem;"
                                        @onclick="() => SelectPreset(preset.Name, preset.Grams)">
                                    @preset.Name @($"· {preset.Grams}g")
                                </button>
                            }
                            <button type="button"
                                    class="bs-btn bs-btn-sm @(selectedRecipe == "Custom" ? "bs-btn-primary" : "bs-btn-secondary")"
                                    style="font-size: 0.75rem; padding: 0.25rem 0.5rem;"
                                    @onclick='() => SelectPreset("Custom", grams)'>
                                Custom
                            </button>
                        </div>
                    }
                    else
                    {
                        <select class="bs-input" aria-label="Recipe" @bind="selectedRecipe" @bind:after="OnRecipeChanged">
                            <option value="Espresso">Espresso (8g)</option>
                            <option value="Double Espresso">Double Espresso (16g)</option>
                            <option value="Filter Coffee">Filter Coffee (15g)</option>
                            <option value="Pour Over">Pour Over (18g)</option>
                            <option value="French Press">French Press (12g)</option>
                            <option value="Cold Brew">Cold Brew (20g)</option>
                            <option value="Custom">Custom...</option>
                        </select>
                    }
                </div>
            }

            <div class="bs-form-group" style="margin-bottom: 1rem;">
                <label class="bs-label">Grams</label>
                <div style="position: relative;">
                    <input type="number" class="bs-input" min="1" max="500"
                           aria-label="Grams of coffee"
                           @bind="grams" @bind:event="oninput" />
                    <span style="position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--bs-text-subtle); font-size: 0.875rem;">g</span>
                </div>
            </div>

            @if (SpaceMembers != null && SpaceMembers.Count > 1)
            {
                <div class="bs-form-group" style="margin-bottom: 1rem;">
                    <label class="bs-label">Log for</label>

                    <div style="display: flex; gap: 0.5rem; margin-bottom: 0.75rem;">
                        <button type="button"
                                class="bs-btn bs-btn-sm @(mode == LogMode.Self ? "bs-btn-primary" : "bs-btn-secondary")"
                                style="flex: 1;"
                                @onclick="() => SetMode(LogMode.Self)">
                            <span class="material-symbols-outlined" style="font-size: 1rem; vertical-align: middle; margin-right: 0.25rem;">person</span>
                            Myself
                        </button>
                        <button type="button"
                                class="bs-btn bs-btn-sm @(mode == LogMode.Others ? "bs-btn-primary" : "bs-btn-secondary")"
                                style="flex: 1;"
                                @onclick="() => SetMode(LogMode.Others)">
                            <span class="material-symbols-outlined" style="font-size: 1rem; vertical-align: middle; margin-right: 0.25rem;">group</span>
                            Select Members
                        </button>
                    </div>

                    @if (mode == LogMode.Self)
                    {
                        <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0.5rem 0.75rem; background: var(--bs-gray-50); border-radius: 0.5rem;">
                            <span style="font-size: 0.875rem; font-weight: 500;">Cups</span>
                            <div class="bs-stepper-group">
                                <button type="button" class="bs-stepper-btn" disabled="@(selfCups <= 1)" @onclick="() => AdjustSelf(-1)" aria-label="One fewer cup">&minus;</button>
                                <span class="bs-stepper-value" aria-live="polite">@selfCups</span>
                                <button type="button" class="bs-stepper-btn" disabled="@(selfCups >= MaxCupsPerPerson)" @onclick="() => AdjustSelf(1)" aria-label="One more cup">+</button>
                            </div>
                        </div>
                        <p style="margin: 0.375rem 0 0 0; font-size: 0.75rem; color: var(--bs-text-subtle);">
                            <span class="material-symbols-outlined" style="font-size: 0.875rem; vertical-align: middle;">group_add</span>
                            Treating a guest? Add a cup — it's billed to you.
                        </p>
                    }
                    else
                    {
                        <div style="display: flex; flex-direction: column; gap: 0.25rem; padding: 0.5rem; background: var(--bs-gray-50); border-radius: 0.5rem; max-height: 12rem; overflow-y: auto;">
                            <div style="display: flex; align-items: center; gap: 0.5rem; padding: 0.25rem;">
                                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.875rem; flex: 1; min-width: 0;">
                                    <input type="checkbox" checked="@includeSelf" @onchange="ToggleSelf" />
                                    <span style="font-weight: 500;">Myself</span>
                                </label>
                                <div class="bs-stepper-group" style="opacity: @(includeSelf ? "1" : "0.4");">
                                    <button type="button" class="bs-stepper-btn" disabled="@(!includeSelf || selfCups <= 1)" @onclick="() => AdjustSelf(-1)" aria-label="One fewer cup for myself">&minus;</button>
                                    <span class="bs-stepper-value">@selfCups</span>
                                    <button type="button" class="bs-stepper-btn" disabled="@(!includeSelf || selfCups >= MaxCupsPerPerson)" @onclick="() => AdjustSelf(1)" aria-label="One more cup for myself">+</button>
                                </div>
                            </div>
                            @foreach (var member in SpaceMembers.Where(m => !CurrentUserId.HasValue || m.UserId != CurrentUserId.Value))
                            {
                                var memberId = member.UserId;
                                var isSelected = selectedMemberIds.Contains(memberId);
                                var count = memberCounts.TryGetValue(memberId, out var c) ? c : 1;
                                <div style="display: flex; align-items: center; gap: 0.5rem; padding: 0.25rem;">
                                    <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.875rem; flex: 1; min-width: 0;">
                                        <input type="checkbox" checked="@isSelected" @onchange="() => ToggleMember(memberId)" />
                                        <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@member.UserName</span>
                                    </label>
                                    <div class="bs-stepper-group" style="opacity: @(isSelected ? "1" : "0.4");">
                                        <button type="button" class="bs-stepper-btn" disabled="@(!isSelected || count <= 1)" @onclick="() => AdjustMember(memberId, -1)" aria-label="One fewer cup">&minus;</button>
                                        <span class="bs-stepper-value">@count</span>
                                        <button type="button" class="bs-stepper-btn" disabled="@(!isSelected || count >= MaxCupsPerPerson)" @onclick="() => AdjustMember(memberId, 1)" aria-label="One more cup">+</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    @if (TotalCups >= 2)
                    {
                        <div style="margin-top: 0.5rem; padding: 0.5rem 0.75rem; background: var(--bs-primary-light, #e0e7ff); border-radius: 0.5rem; font-size: 0.8125rem; color: var(--bs-primary); font-weight: 600;">
                            <span class="material-symbols-outlined" style="font-size: 1rem; vertical-align: middle; margin-right: 0.25rem;">coffee</span>
                            @CupsSummary
                        </div>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(validationError))
            {
                <div style="color: var(--bs-danger); font-size: 0.875rem; margin-bottom: 0.75rem;">
                    @validationError
                </div>
            }

            <div class="bs-hero-actions">
                <button type="button" class="bs-btn bs-btn-primary bs-btn-hero" @onclick="HandleConfirm" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span>Logging...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined">coffee</span>
                        <span>Log Coffee</span>
                    }
                </button>
                <button type="button" class="bs-btn bs-btn-quiet" @onclick="HandleCancel">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public QrConsumptionPayload? Payload { get; set; }

    [Parameter]
    public EventCallback<ConsumptionFormModel> OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public List<MembershipDto>? SpaceMembers { get; set; }

    [Parameter]
    public Guid? CurrentUserId { get; set; }

    [Parameter]
    public List<PresetOption>? QuickPresets { get; set; }

    private enum LogMode { Self, Others }

    private LogMode mode = LogMode.Self;
    private int grams;
    private bool includeSelf = true;
    private HashSet<Guid> selectedMemberIds = new();
    private Dictionary<Guid, int> memberCounts = new();
    private int selfCups = 1;
    private string validationError = "";
    private bool isSubmitting;
    private bool hasOpenRecipe;
    private string selectedRecipe = "Espresso";

    private const int MaxCupsPerPerson = 20;

    // Compact stepper button style; dimmed + non-interactive when disabled.

    private int TotalCups
    {
        get
        {
            if (mode == LogMode.Self) return selfCups;
            var total = includeSelf ? selfCups : 0;
            total += selectedMemberIds.Sum(id => memberCounts.TryGetValue(id, out var c) ? c : 1);
            return total;
        }
    }

    private string CupsSummary
    {
        get
        {
            var parts = new List<string>();
            if (mode == LogMode.Self || includeSelf) parts.Add($"You ×{selfCups}");
            if (mode == LogMode.Others)
            {
                foreach (var m in SpaceMembers?.Where(m => selectedMemberIds.Contains(m.UserId)) ?? Enumerable.Empty<MembershipDto>())
                {
                    var c = memberCounts.TryGetValue(m.UserId, out var v) ? v : 1;
                    parts.Add($"{m.UserName} ×{c}");
                }
            }
            var total = TotalCups;
            return $"Logging {total} cup{(total == 1 ? "" : "s")} · {string.Join(", ", parts)}";
        }
    }

    protected override void OnParametersSet()
    {
        if (IsVisible && Payload != null && grams == 0)
        {
            hasOpenRecipe = Payload.DefaultGrams == 0;
            selectedRecipe = "Espresso";
            grams = Payload.DefaultGrams > 0 ? Payload.DefaultGrams : 8;
            mode = LogMode.Self;
            includeSelf = true;
            selectedMemberIds.Clear();
            memberCounts.Clear();
            selfCups = 1;
            validationError = "";
        }

        if (!IsVisible)
        {
            grams = 0;
            validationError = "";
            isSubmitting = false;
            hasOpenRecipe = false;
            selectedRecipe = "Espresso";
        }
    }

    private void SelectPreset(string name, int presetGrams)
    {
        selectedRecipe = name;
        if (name != "Custom")
            grams = presetGrams;
    }

    private void OnRecipeChanged()
    {
        if (selectedRecipe != "Custom")
            grams = CoffeeRecipeDefaults.GetGrams(selectedRecipe);
    }

    private void SetMode(LogMode newMode)
    {
        mode = newMode;
        validationError = "";
    }

    private void ToggleSelf()
    {
        includeSelf = !includeSelf;
    }

    private void AdjustSelf(int delta)
    {
        selfCups = Math.Clamp(selfCups + delta, 1, MaxCupsPerPerson);
    }

    private void ToggleMember(Guid memberId)
    {
        if (selectedMemberIds.Contains(memberId))
        {
            selectedMemberIds.Remove(memberId);
        }
        else
        {
            selectedMemberIds.Add(memberId);
            if (!memberCounts.ContainsKey(memberId))
                memberCounts[memberId] = 1;
        }
    }

    private void AdjustMember(Guid memberId, int delta)
    {
        var count = memberCounts.TryGetValue(memberId, out var c) ? c : 1;
        memberCounts[memberId] = Math.Clamp(count + delta, 1, MaxCupsPerPerson);
    }

    private async Task HandleConfirm()
    {
        if (Payload == null) return;

        if (mode == LogMode.Others && !includeSelf && !selectedMemberIds.Any())
        {
            validationError = "Please select at least one member.";
            return;
        }

        isSubmitting = true;
        StateHasChanged();

        try
        {
            var presetName = hasOpenRecipe
                ? (selectedRecipe == "Custom" ? null : selectedRecipe)
                : (string.IsNullOrWhiteSpace(Payload.RecipeName) ? null : Payload.RecipeName);
            var model = new ConsumptionFormModel
            {
                ProductName = Payload.ProductName,
                ProductBrand = Payload.ProductBrand,
                ProductType = Payload.ProductType,
                Grams = grams,
                ConsumedAt = DateTime.UtcNow,
                PresetName = presetName
            };

            // Expand per-person cup counts into a flat target list — a repeated id means that many
            // identical cups for that person (one entry logged per id downstream), so a colleague
            // can cover a guest by bumping their count.
            var ids = new List<Guid>();
            if (mode == LogMode.Self)
            {
                if (CurrentUserId.HasValue)
                    for (var i = 0; i < selfCups; i++)
                        ids.Add(CurrentUserId.Value);
            }
            else
            {
                if (includeSelf && CurrentUserId.HasValue)
                    for (var i = 0; i < selfCups; i++)
                        ids.Add(CurrentUserId.Value);
                foreach (var memberId in selectedMemberIds)
                {
                    var count = memberCounts.TryGetValue(memberId, out var c) ? c : 1;
                    for (var i = 0; i < count; i++)
                        ids.Add(memberId);
                }
            }

            if (ids.Count > 0)
            {
                model.ForUserIds = ids;
                model.ForUserId = null;
            }
            else
            {
                // Solely myself with an unknown CurrentUserId: null-target path resolves to me.
                model.ForUserId = null;
                model.ForUserIds = null;
            }

            await OnConfirm.InvokeAsync(model);
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task HandleCancel()
    {
        grams = 0;
        mode = LogMode.Self;
        includeSelf = true;
        selectedMemberIds.Clear();
        memberCounts.Clear();
        selfCups = 1;
        validationError = "";
        await OnCancel.InvokeAsync();
    }
}
