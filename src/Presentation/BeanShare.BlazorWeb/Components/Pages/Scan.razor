@page "/scan/{QrCodeId}"
@rendermode InteractiveServer
@using MediatR
@using BeanShare.Application.Common
@using BeanShare.Application.Features.ActiveQrCodes.Queries
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IScopedSender Mediator
@inject NavigationManager Navigation

<PageTitle>Scan QR - BeanShare</PageTitle>

<div class="bs-container" style="padding: 4rem 1rem;">
    @if (isLoading)
    {
        <div class="bs-card" style="max-width: 28rem; margin: 0 auto; text-align: center; padding: 2.5rem 2rem;">
            <span class="material-symbols-outlined" style="font-size: 3.5rem; color: var(--bs-primary); display: block; margin-bottom: 1rem;">qr_code_scanner</span>
            <h1 style="font-size: 1.5rem; margin-bottom: 0.5rem;">Resolving QR code&hellip;</h1>
            <p class="bs-text-subtle" style="margin-bottom: 1.25rem;">Please wait while we look up this QR code.</p>
            <div class="bs-spinner" style="margin: 0 auto;"></div>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="bs-card" style="max-width: 28rem; margin: 0 auto; text-align: center; padding: 2.5rem 2rem;">
            <span class="material-symbols-outlined" style="font-size: 3.5rem; color: var(--bs-error); display: block; margin-bottom: 1rem;">error</span>
            <h1 style="font-size: 1.5rem; margin-bottom: 0.5rem;">QR code error</h1>
            <p class="bs-text-subtle" style="margin-bottom: 1.5rem;">@errorMessage</p>
            <div class="bs-flex bs-gap-3 bs-justify-center" style="flex-wrap: wrap;">
                @if (canRetry)
                {
                    <button type="button" class="bs-btn bs-btn-primary" @onclick="ResolveAsync">
                        <span class="material-symbols-outlined">refresh</span>
                        Try again
                    </button>
                    <a href="/spaces" class="bs-btn bs-btn-outline">Go to spaces</a>
                }
                else
                {
                    <a href="/spaces" class="bs-btn bs-btn-primary">Go to spaces</a>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string QrCodeId { get; set; } = "";

    private bool isLoading = true;
    private string errorMessage = "";
    private bool canRetry;

    protected override async Task OnParametersSetAsync()
    {
        await ResolveAsync();
    }

    private async Task ResolveAsync()
    {
        isLoading = true;
        errorMessage = "";
        canRetry = false;
        StateHasChanged();

        if (!Guid.TryParse(QrCodeId, out var qrId))
        {
            errorMessage = "This QR code link is invalid.";
            isLoading = false;
            return;
        }

        try
        {
            // Guard against a hung resolve so the page doesn't spin forever.
            using var cts = new System.Threading.CancellationTokenSource(TimeSpan.FromSeconds(20));
            var result = await Mediator.Send(new ResolveActiveQrCodeQuery(qrId), cts.Token);
            if (result.IsSuccess)
            {
                var dto = result.Value;
                Navigation.NavigateTo($"/spaces/{dto.SpaceId}/consumption?qrCodeId={qrId}");
                return;
            }

            errorMessage = "This QR code could not be found or has been deactivated.";
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[BeanShare] QR resolve error: {ex.Message}");
            errorMessage = "We couldn't resolve this QR code right now. Please try again.";
            canRetry = true;
        }

        isLoading = false;
    }
}
