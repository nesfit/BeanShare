@page "/spaces/{SpaceId}/presets"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using ContractPresets = BeanShare.Contracts.Presets
@using BeanShare.Application.Features.Presets.Queries
@using BeanShare.Application.Features.Presets.Commands
@using System.ComponentModel.DataAnnotations
@using MediatR
@attribute [Authorize]
@inject NavigationManager Navigation
@inject IMediator Mediator
@inject ILogger<Presets> Logger

<PageTitle>Presets - BeanShare</PageTitle>

<div style="position: sticky; top: 0; z-index: 10; background: var(--bs-background-light); border-bottom: 1px solid var(--bs-border); padding: 1rem 0;">
    <div class="bs-container">
        <div class="bs-flex bs-items-center bs-justify-between" style="margin-bottom: 1rem;">
            <button class="bs-btn bs-btn-sm bs-btn-ghost" aria-label="Back to spaces" @onclick='@(() => Navigation.NavigateTo("/spaces"))'>
                <span class="material-symbols-outlined">arrow_back</span>
            </button>
            <h1 class="bs-font-bold" style="margin: 0; font-size: 1.25rem;">Preset Recipes</h1>
            <button class="bs-btn bs-btn-sm bs-btn-primary" aria-label="Create preset recipe" @onclick="ShowCreateModal">
                <span class="material-symbols-outlined">add</span>
            </button>
        </div>
        <SpaceTabs SpaceId="@SpaceId" ActiveTab="presets" PreventNavigation="false" />
    </div>
</div>

<div style="background: var(--bs-background); border-bottom: 1px solid var(--bs-border); padding: 1rem 0;">
    <div class="bs-container">
        <div class="bs-flex bs-items-center bs-justify-between" style="cursor: pointer;" @onclick="ToggleGlobalPresetsSection">
            <div class="bs-flex bs-items-center bs-gap-2">
                <span class="material-symbols-outlined" style="color: var(--bs-primary);">language</span>
                <h3 style="margin: 0; font-size: 1rem; font-weight: 600;">Built-in Quick Presets</h3>
                <span class="bs-badge" style="background: var(--bs-gray-100); color: var(--bs-text-subtle); font-size: 0.75rem; padding: 0.25rem 0.5rem; border-radius: 9999px;">
                    @(globalPresets?.Count(p => p.IsEnabled) ?? 0) enabled
                </span>
            </div>
            <span class="material-symbols-outlined">@(isGlobalPresetsSectionOpen ? "expand_less" : "expand_more")</span>
        </div>

        @if (isGlobalPresetsSectionOpen)
        {
            <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--bs-border);">
                <p style="color: var(--bs-text-subtle); font-size: 0.875rem; margin-bottom: 1rem;">
                    Enable or disable built-in quick presets for this space. Disabled presets won't appear in the consumption form.
                </p>

                @if (isLoadingGlobalPresets)
                {
                    <div class="bs-flex bs-items-center bs-justify-center" style="padding: 1rem;">
                        <div class="bs-spinner"></div>
                    </div>
                }
                else if (globalPresets == null || !globalPresets.Any())
                {
                    <p style="color: var(--bs-text-subtle); text-align: center; padding: 1rem;">No built-in presets available.</p>
                }
                else
                {
                    <div class="bs-grid bs-gap-2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
                        @foreach (var preset in globalPresets)
                        {
                            <div class="bs-card" style="padding: 1rem; opacity: @(preset.IsEnabled ? "1" : "0.6"); transition: opacity 0.2s;">
                                <div class="bs-flex bs-justify-between bs-items-start">
                                    <div style="flex: 1;">
                                        <div class="bs-flex bs-items-center bs-gap-2" style="margin-bottom: 0.25rem;">
                                            <span style="font-weight: 600;">@preset.Name</span>
                                            <span style="color: var(--bs-text-subtle); font-size: 0.875rem;">@preset.DefaultGrams g</span>
                                        </div>
                                        <p style="color: var(--bs-text-subtle); font-size: 0.75rem; margin: 0;">
                                            @preset.CoffeeType · @preset.Preparation
                                        </p>
                                    </div>
                                    <label class="toggle-switch">
                                        <input type="checkbox" checked="@preset.IsEnabled" @onchange="() => ToggleGlobalPreset(preset)" disabled="@isTogglingPreset" aria-label="@($"Toggle built-in preset {preset.Name}")" />
                                        <span class="toggle-slider"></span>
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

<div class="bs-container" style="padding: 2rem 0;">
    @if (isLoading)
    {
        <div class="bs-card" style="text-align: center; padding: 3rem;">
            <div class="bs-spinner"></div>
            <p style="margin-top: 1rem;">Loading presets...</p>
        </div>
    }
    else if (presets == null || !presets.Any())
    {
        <div class="bs-card" style="text-align: center; padding: 3rem;">
            <span class="material-symbols-outlined" style="font-size: 4rem; color: var(--bs-text-subtle); margin-bottom: 1rem;">coffee</span>
            <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem;">No Preset Recipes Yet</h3>
            <p style="color: var(--bs-text-subtle); margin-bottom: 1.5rem;">
                Create preset recipes for your favorite coffee configurations to log consumption faster.
            </p>
            <button class="bs-btn bs-btn-primary" @onclick="ShowCreateModal">
                <span class="material-symbols-outlined">add</span>
                Create Your First Preset
            </button>
        </div>
    }
    else
    {
        <div class="bs-grid bs-gap-4" style="grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));">
            @foreach (var preset in presets)
            {
                <div class="bs-card">
                    <div class="bs-flex bs-justify-between bs-items-start" style="margin-bottom: 1rem;">
                        <div>
                            <h3 style="font-size: 1.125rem; font-weight: 600; margin-bottom: 0.25rem;">@preset.Name</h3>
                            <p style="color: var(--bs-text-subtle); font-size: 0.875rem; margin: 0;">
                                @preset.CoffeeType
                            </p>
                        </div>
                        @if (preset.IsShared)
                        {
                            <span class="material-symbols-outlined" style="color: var(--bs-primary);" title="Shared with space">
                                group
                            </span>
                        }
                    </div>

                    <div style="border-left: 3px solid var(--bs-primary); padding-left: 1rem; margin-bottom: 1rem;">
                        <div class="bs-flex bs-gap-4" style="margin-bottom: 0.5rem;">
                            <div>
                                <span style="color: var(--bs-text-subtle); font-size: 0.75rem;">Preparation</span>
                                <p style="margin: 0; font-weight: 500;">@preset.Preparation</p>
                            </div>
                            <div>
                                <span style="color: var(--bs-text-subtle); font-size: 0.75rem;">Default Amount</span>
                                <p style="margin: 0; font-weight: 500;">@preset.DefaultGrams g</p>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(preset.Notes))
                        {
                            <p style="color: var(--bs-text-subtle); font-size: 0.875rem; margin-top: 0.5rem; margin-bottom: 0;">
                                @preset.Notes
                            </p>
                        }
                    </div>

                    <div style="border-top: 1px solid var(--bs-border); padding-top: 1rem; margin-top: 1rem;">
                        <div class="bs-flex bs-justify-between bs-items-center">
                            <div style="font-size: 0.75rem; color: var(--bs-text-subtle);">
                                @if (preset.LastUsedAt.HasValue)
                                {
                                    <span>Used @preset.UsageCount times · Last: @preset.LastUsedAt.Value.ToString("MMM d")</span>
                                }
                                else
                                {
                                    <span>Never used</span>
                                }
                            </div>
                            <div class="bs-flex bs-gap-2">
                                <button class="bs-btn bs-btn-sm bs-btn-primary" @onclick="() => UsePreset(preset)">
                                    Use
                                </button>
                                @if (preset.IsOwner)
                                {
                                    <button class="bs-btn bs-btn-sm bs-btn-secondary" @onclick="() => ShowEditModal(preset)">
                                        Edit
                                    </button>
                                    <button class="bs-btn bs-btn-sm bs-btn-danger" @onclick="() => RequestDeletePreset(preset)">
                                        Delete
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (showCreateModal || showEditModal)
{
    <div class="bs-modal-overlay" @onclick="CloseModal">
        <div class="bs-modal" @onclick:stopPropagation="true" @ontouchend:stopPropagation="true">
            <div class="bs-modal-header">
                <h2 class="bs-modal-title">@(showEditModal ? "Edit" : "Create") Preset Recipe</h2>
                <button class="bs-modal-close" aria-label="Close" @onclick="CloseModal">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <EditForm Model="@presetForm" OnValidSubmit="SavePreset">
                <DataAnnotationsValidator />
                <div class="bs-modal-body">
                    <div class="bs-form-group">
                        <label class="bs-label">Name</label>
                        <InputText class="bs-input" @bind-Value="presetForm.Name" placeholder="Morning Espresso" />
                        <ValidationMessage For="@(() => presetForm.Name)" class="bs-validation-message" />
                    </div>

                    <div class="bs-form-group">
                        <label class="bs-label">Coffee Type</label>
                        <InputText class="bs-input" @bind-Value="presetForm.CoffeeType" placeholder="Arabica" />
                        <ValidationMessage For="@(() => presetForm.CoffeeType)" class="bs-validation-message" />
                    </div>

                    <div class="bs-form-group">
                        <label class="bs-label">Preparation Method</label>
                        <InputSelect class="bs-input" @bind-Value="presetForm.Preparation">
                            <option value="">-- Select --</option>
                            <option value="Espresso">Espresso</option>
                            <option value="Filter">Filter</option>
                            <option value="French Press">French Press</option>
                            <option value="Aeropress">Aeropress</option>
                            <option value="V60">V60</option>
                            <option value="Chemex">Chemex</option>
                            <option value="Moka Pot">Moka Pot</option>
                            <option value="Cold Brew">Cold Brew</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => presetForm.Preparation)" class="bs-validation-message" />
                    </div>

                    <div class="bs-form-group">
                        <label class="bs-label">Default Amount (grams)</label>
                        <InputNumber class="bs-input" @bind-Value="presetForm.DefaultGrams" placeholder="18" />
                        <ValidationMessage For="@(() => presetForm.DefaultGrams)" class="bs-validation-message" />
                    </div>

                    <div class="bs-form-group">
                        <label class="bs-label">Notes (optional)</label>
                        <InputTextArea class="bs-input" @bind-Value="presetForm.Notes" rows="3"
                                       placeholder="Double shot, 1:2 ratio, 25 seconds extraction" />
                    </div>

                    <div class="bs-form-group">
                        <label class="bs-checkbox">
                            <InputCheckbox @bind-Value="presetForm.IsShared" />
                            <span>Share with space members</span>
                        </label>
                    </div>
                </div>
                <div class="bs-modal-footer">
                    <button type="button" class="bs-btn bs-btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button type="submit" class="bs-btn bs-btn-primary" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Save</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<ConfirmDialog IsVisible="@showDeleteDialog"
               Title="Delete preset?"
               Message="@($"Delete preset '{pendingDeleteName}'? This can't be undone.")"
               ConfirmText="Delete"
               IsDestructive="true"
               IsProcessing="@isDeleting"
               OnConfirm="ConfirmDeletePreset"
               OnCancel="@(() => showDeleteDialog = false)" />

<Toast IsVisible="@showToast"
       IsError="@isToastError"
       Title="@toastTitle"
       Message="@toastMessage"
       OnClose="@(() => showToast = false)" />


@code {
    [Parameter] public string SpaceId { get; set; } = "";

    private List<ContractPresets.PresetDto>? presets;
    private List<ContractPresets.SpaceGlobalPresetDto>? globalPresets;
    private bool isLoading = true;
    private bool isLoadingGlobalPresets = false;
    private bool isGlobalPresetsSectionOpen = false;
    private bool isTogglingPreset = false;
    private bool showCreateModal = false;
    private bool showEditModal = false;
    private bool isSaving = false;
    private PresetFormModel presetForm = new();
    private ContractPresets.PresetDto? editingPreset;

    private bool showToast;
    private bool isToastError;
    private string toastTitle = "";
    private string toastMessage = "";

    private bool showDeleteDialog;
    private bool isDeleting;
    private Guid pendingDeleteId;
    private string pendingDeleteName = "this preset";

    protected override async Task OnInitializedAsync()
    {
        await LoadPresets();
        await LoadGlobalPresets();
    }

    private async Task LoadPresets()
    {
        try
        {
            isLoading = true;

            var query = new GetSpacePresetsQuery(Guid.Parse(SpaceId));
            var result = await Mediator.Send(query);

            if (result.IsSuccess)
            {
                presets = result.Value.Presets.Select(p => new ContractPresets.PresetDto
                {
                    Id = p.Id,
                    UserId = p.UserId,
                    UserName = p.UserName,
                    Name = p.Name,
                    CoffeeType = p.CoffeeType,
                    Preparation = p.Preparation,
                    DefaultGrams = p.DefaultGrams,
                    Notes = p.Notes,
                    IsShared = p.IsShared,
                    IsOwner = p.IsOwner,
                    CreatedAt = p.CreatedAt,
                    LastUsedAt = p.LastUsedAt,
                    UsageCount = p.UsageCount
                }).ToList();
            }
            else
            {
                presets = new List<ContractPresets.PresetDto>();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading presets");
            presets = new List<ContractPresets.PresetDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowCreateModal()
    {
        presetForm = new PresetFormModel { SpaceId = Guid.Parse(SpaceId) };
        showCreateModal = true;
        showEditModal = false;
    }

    private void ShowEditModal(ContractPresets.PresetDto preset)
    {
        editingPreset = preset;
        presetForm = new PresetFormModel
        {
            SpaceId = Guid.Parse(SpaceId),
            Name = preset.Name,
            CoffeeType = preset.CoffeeType,
            Preparation = preset.Preparation,
            DefaultGrams = preset.DefaultGrams,
            Notes = preset.Notes,
            IsShared = preset.IsShared
        };
        showEditModal = true;
        showCreateModal = false;
    }

    private void CloseModal()
    {
        showCreateModal = false;
        showEditModal = false;
        presetForm = new();
        editingPreset = null;
    }

    private async Task SavePreset()
    {
        try
        {
            isSaving = true;

            if (showEditModal && editingPreset != null)
            {
                var command = new UpdatePresetCommand(
                    editingPreset.Id,
                    presetForm.Name,
                    presetForm.CoffeeType,
                    presetForm.Preparation,
                    presetForm.DefaultGrams,
                    presetForm.Notes,
                    presetForm.IsShared);

                var result = await Mediator.Send(command);
                if (result.IsFailure)
                {
                    var message = string.Join(", ", result.Errors.Select(e => e.Message));
                    Logger.LogError("Failed to update preset: {Errors}", message);
                    ShowToast(true, "Error", string.IsNullOrWhiteSpace(message) ? "Failed to update preset." : message);
                    return;
                }

                CloseModal();
                await LoadPresets();
                ShowToast(false, "Success", "Preset updated.");
            }
            else
            {
                var command = new CreatePresetCommand(
                    presetForm.SpaceId,
                    presetForm.Name,
                    presetForm.CoffeeType,
                    presetForm.Preparation,
                    presetForm.DefaultGrams,
                    presetForm.Notes,
                    presetForm.IsShared);

                var result = await Mediator.Send(command);
                if (result.IsFailure)
                {
                    var message = string.Join(", ", result.Errors.Select(e => e.Message));
                    Logger.LogError("Failed to create preset: {Errors}", message);
                    ShowToast(true, "Error", string.IsNullOrWhiteSpace(message) ? "Failed to create preset." : message);
                    return;
                }

                CloseModal();
                await LoadPresets();
                ShowToast(false, "Success", "Preset created.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving preset");
            ShowToast(true, "Error", $"Failed to save preset: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void RequestDeletePreset(ContractPresets.PresetDto preset)
    {
        if (!preset.IsOwner)
            return;

        pendingDeleteId = preset.Id;
        pendingDeleteName = preset.Name;
        showDeleteDialog = true;
    }

    private async Task ConfirmDeletePreset()
    {
        isDeleting = true;
        try
        {
            var command = new DeletePresetCommand(pendingDeleteId);
            var result = await Mediator.Send(command);

            if (result.IsFailure)
            {
                var message = string.Join(", ", result.Errors.Select(e => e.Message));
                Logger.LogError("Failed to delete preset: {Errors}", message);
                ShowToast(true, "Error", string.IsNullOrWhiteSpace(message) ? "Failed to delete preset." : message);
                return;
            }

            await LoadPresets();
            ShowToast(false, "Success", "Preset deleted.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting preset");
            ShowToast(true, "Error", $"Failed to delete preset: {ex.Message}");
        }
        finally
        {
            isDeleting = false;
            showDeleteDialog = false;
        }
    }

    private async Task UsePreset(ContractPresets.PresetDto preset)
    {
        Navigation.NavigateTo($"/spaces/{SpaceId}/consumption?presetId={preset.Id}");
    }

    private void ToggleGlobalPresetsSection()
    {
        isGlobalPresetsSectionOpen = !isGlobalPresetsSectionOpen;
    }

    private async Task LoadGlobalPresets()
    {
        try
        {
            isLoadingGlobalPresets = true;

            var query = new GetSpaceGlobalPresetsQuery(Guid.Parse(SpaceId));
            var result = await Mediator.Send(query);

            if (result.IsSuccess)
            {
                globalPresets = result.Value.Presets.Select(p => new ContractPresets.SpaceGlobalPresetDto
                {
                    GlobalPresetId = p.GlobalPresetId,
                    Name = p.Name,
                    CoffeeType = p.CoffeeType,
                    Preparation = p.Preparation,
                    DefaultGrams = p.DefaultGrams,
                    Description = p.Description,
                    IsEnabled = p.IsEnabled,
                    DisplayOrder = p.DisplayOrder
                }).ToList();
            }
            else
            {
                globalPresets = new List<ContractPresets.SpaceGlobalPresetDto>();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading global presets");
            globalPresets = new List<ContractPresets.SpaceGlobalPresetDto>();
        }
        finally
        {
            isLoadingGlobalPresets = false;
        }
    }

    private async Task ToggleGlobalPreset(ContractPresets.SpaceGlobalPresetDto preset)
    {
        try
        {
            isTogglingPreset = true;
            StateHasChanged();

            var command = new ToggleGlobalPresetCommand(
                Guid.Parse(SpaceId),
                preset.GlobalPresetId,
                !preset.IsEnabled);

            var result = await Mediator.Send(command);

            if (result.IsFailure)
            {
                var message = string.Join(", ", result.Errors.Select(e => e.Message));
                Logger.LogError("Failed to toggle global preset: {Errors}", message);
                ShowToast(true, "Error", string.IsNullOrWhiteSpace(message) ? "Failed to update built-in preset." : message);
                return;
            }

            var index = globalPresets?.FindIndex(p => p.GlobalPresetId == preset.GlobalPresetId) ?? -1;
            if (index >= 0 && globalPresets != null)
            {
                globalPresets[index] = new ContractPresets.SpaceGlobalPresetDto
                {
                    GlobalPresetId = preset.GlobalPresetId,
                    Name = preset.Name,
                    CoffeeType = preset.CoffeeType,
                    Preparation = preset.Preparation,
                    DefaultGrams = preset.DefaultGrams,
                    Description = preset.Description,
                    IsEnabled = !preset.IsEnabled,
                    DisplayOrder = preset.DisplayOrder
                };
            }

            ShowToast(false, "Success", $"{preset.Name} {(!preset.IsEnabled ? "enabled" : "disabled")}.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error toggling global preset");
            ShowToast(true, "Error", $"Failed to update built-in preset: {ex.Message}");
        }
        finally
        {
            isTogglingPreset = false;
            StateHasChanged();
        }
    }

    private void ShowToast(bool isError, string title, string message)
    {
        isToastError = isError;
        toastTitle = title;
        toastMessage = message;
        showToast = true;
    }

    private class PresetFormModel
    {
        public Guid SpaceId { get; set; }

        [Required(ErrorMessage = "Name is required")]
        [MaxLength(100, ErrorMessage = "Name cannot exceed 100 characters")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Coffee type is required")]
        public string CoffeeType { get; set; } = "";

        [Required(ErrorMessage = "Preparation method is required")]
        public string Preparation { get; set; } = "";

        [Required(ErrorMessage = "Default amount is required")]
        [Range(1, 1000, ErrorMessage = "Amount must be between 1 and 1000 grams")]
        public decimal DefaultGrams { get; set; } = 18;

        public string? Notes { get; set; }
        public bool IsShared { get; set; }
    }
}