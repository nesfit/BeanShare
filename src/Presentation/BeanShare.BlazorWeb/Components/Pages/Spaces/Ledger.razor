@page "/spaces/{SpaceId}/ledger"
@rendermode InteractiveServer
@using MediatR
@using BeanShare.Application.Common
@using BeanShare.Application.Features.Spaces.Queries
@using BeanShare.Application.Features.CoffeeStock.Queries
@using BeanShare.Application.Features.CoffeeStock.Queries.GetSpaceLedger
@using BeanShare.Application.Features.Consumption.Commands
@using BeanShare.Application.Abstractions
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IScopedSender Mediator
@inject NavigationManager Navigation
@inject IUserContext UserContext

<PageTitle>Ledger - @spaceName - BeanShare</PageTitle>

@if (space == null)
{
    <div class="bs-container" style="padding-top: 4rem; text-align: center;">
        <div class="bs-skeleton" style="width: 12rem; height: 2rem; margin: 0 auto 1rem;"></div>
        <div class="bs-skeleton" style="width: 20rem; height: 1rem; margin: 0 auto;"></div>
    </div>
}
else
{
    <div style="position: sticky; top: 0; z-index: 10; background: var(--bs-background-light); border-bottom: 1px solid var(--bs-border); padding: 1rem 0;">
        <div class="bs-container">
            <div class="bs-flex bs-items-center" style="margin-bottom: 1rem; gap: 0.5rem;">
                <button class="bs-btn-sm" style="background: transparent; border: none; cursor: pointer; flex-shrink: 0;" @onclick='@(() => Navigation.NavigateTo("/spaces"))'>
                    <span class="material-symbols-outlined">arrow_back</span>
                </button>
                <h1 class="bs-font-bold" style="margin: 0; font-size: 1.25rem; flex: 1; min-width: 0; text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@space.Name</h1>
                <div style="width: 2rem; flex-shrink: 0;"></div>
            </div>
            <SpaceTabs SpaceId="@SpaceId" ActiveTab="ledger" PreventNavigation="false" />
        </div>
    </div>

    <div class="bs-container" style="padding: 2rem 0;">
        <h2 class="bs-font-bold" style="margin: 0 0 1rem 0; font-size: 1.25rem;">Ledger</h2>

        @if (ledger != null)
        {
            var t = ledger.Totals;
            <div class="stock-stats-grid" style="margin-bottom: 1rem;">
                <div class="bs-card">
                    <p class="bs-text-subtle stock-stat-label">Purchased</p>
                    <p class="bs-font-bold stock-stat-value" style="color: var(--bs-success);">@FormatGrams(t.PurchasedGrams)</p>
                    <p class="bs-text-subtle" style="font-size: 0.75rem;">@Money(t.PurchasedCost) · @t.PurchaseCount bags</p>
                </div>
                <div class="bs-card">
                    <p class="bs-text-subtle stock-stat-label">Consumed</p>
                    <p class="bs-font-bold stock-stat-value" style="color: var(--bs-warning-dark);">@FormatGrams(t.ConsumedGrams)</p>
                    <p class="bs-text-subtle" style="font-size: 0.75rem;">@Money(t.ConsumedCost) · @t.CupCount cups</p>
                </div>
                @if (t.DiscardCount > 0)
                {
                    <div class="bs-card">
                        <p class="bs-text-subtle stock-stat-label">Discarded</p>
                        <p class="bs-font-bold stock-stat-value" style="color: var(--bs-error);">@FormatGrams(t.DiscardedGrams)</p>
                        <p class="bs-text-subtle" style="font-size: 0.75rem;">@Money(t.DiscardedCost) sunk · @t.DiscardCount bag@(t.DiscardCount == 1 ? "" : "s") · billed to nobody</p>
                    </div>
                }
                <div class="bs-card">
                    <p class="bs-text-subtle stock-stat-label">Net on hand</p>
                    <p class="bs-font-bold stock-stat-value">@FormatGrams(t.NetGrams)</p>
                    <p class="bs-text-subtle" style="font-size: 0.75rem;">in this filter</p>
                </div>
            </div>
        }

        <div class="bs-flex bs-items-center" style="flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem;">
            <button class="bs-btn bs-btn-sm @(kind == null ? "bs-btn-primary" : "bs-btn-secondary")" @onclick="@(() => SetKind(null))">All</button>
            <button class="bs-btn bs-btn-sm @(kind == "purchase" ? "bs-btn-primary" : "bs-btn-secondary")" @onclick="@(() => SetKind("purchase"))">Purchases</button>
            <button class="bs-btn bs-btn-sm @(kind == "cup" ? "bs-btn-primary" : "bs-btn-secondary")" @onclick="@(() => SetKind("cup"))">Cups</button>
            <button class="bs-btn bs-btn-sm @(kind == "discard" ? "bs-btn-primary" : "bs-btn-secondary")" @onclick="@(() => SetKind("discard"))">Discards</button>

            <span style="width: 1px; height: 1.5rem; background: var(--bs-border);"></span>

            <select class="bs-input" style="width: auto; font-size: 0.8125rem;" @bind="productFilter" @bind:after="ApplyFilters">
                <option value="">All products</option>
                @foreach (var p in productOptions)
                {
                    <option value="@p">@p</option>
                }
            </select>

            @if (space.Members != null && space.Members.Count > 1)
            {
                <select class="bs-input" style="width: auto; font-size: 0.8125rem;" @bind="memberFilter" @bind:after="ApplyFilters">
                    <option value="">All members</option>
                    @foreach (var m in space.Members)
                    {
                        <option value="@m.UserId">@m.UserName</option>
                    }
                </select>
            }

            <label class="bs-flex bs-items-center" style="gap: 0.35rem; font-size: 0.75rem; color: var(--bs-text-subtle);">From
                <input type="date" class="bs-input" style="width: auto; font-size: 0.8125rem;" @bind="startDate" @bind:after="ApplyFilters" aria-label="From date" />
            </label>
            <label class="bs-flex bs-items-center" style="gap: 0.35rem; font-size: 0.75rem; color: var(--bs-text-subtle);">To
                <input type="date" class="bs-input" style="width: auto; font-size: 0.8125rem;" @bind="endDate" @bind:after="ApplyFilters" aria-label="To date" />
            </label>

            <button class="bs-btn bs-btn-sm bs-btn-secondary" @onclick="ClearFilters">Clear</button>
        </div>

        @if (isLoading)
        {
            <div style="text-align: center; padding: 2rem;">
                <span class="material-symbols-outlined" style="font-size: 2rem; animation: spin 1s linear infinite; color: var(--bs-primary);">progress_activity</span>
            </div>
        }
        else if (ledger == null || ledger.Entries.Count == 0)
        {
            <EmptyState Icon="receipt_long" Title="No movements" Message="No purchases or cups match this filter yet." />
        }
        else
        {
            <div style="overflow-x: auto; border: 1px solid var(--bs-border); border-radius: 0.5rem;">
                <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem; min-width: 780px;">
                    <thead>
                        <tr>
                            @Header("ts", "When")
                            @Header("kind", "Type")
                            @Header("product", "Product")
                            @Header("bag", "Bag", sortable: false)
                            @Header("delta", "± g", right: true)
                            @Header("balance", "Balance", right: true)
                            @Header("who", "Member")
                            @Header("cost", "Cost", right: true)
                            @Header("note", "Detail", sortable: false)
                            @Header("actions", "", sortable: false)
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in ledger.Entries)
                        {
                            <tr style="border-top: 1px solid var(--bs-border);">
                                <td style="padding: 0.5rem 0.75rem; white-space: nowrap;">@e.Timestamp.ToLocalTime().ToString("dd MMM, HH:mm")</td>
                                <td style="padding: 0.5rem 0.75rem;">
                                    @if (e.Kind == "Purchase")
                                    {
                                        <span class="bs-pill" style="background: var(--bs-success-light); color: var(--bs-success);">+ Purchase</span>
                                    }
                                    else if (e.Kind == "Discard")
                                    {
                                        <span class="bs-pill" style="background: var(--bs-error-light); color: var(--bs-error);" title="Thrown away by an admin; billed to nobody">− Discard</span>
                                    }
                                    else
                                    {
                                        <span class="bs-pill" style="background: var(--bs-warning-light); color: var(--bs-warning-dark);">− Cup</span>
                                    }
                                </td>
                                <td style="padding: 0.5rem 0.75rem; font-weight: 600;">@e.ProductDisplayName</td>
                                <td style="padding: 0.5rem 0.75rem; font-family: monospace;">@e.BagLabel</td>
                                <td style="padding: 0.5rem 0.75rem; text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; color: @(e.DeltaGrams >= 0 ? "var(--bs-success)" : "var(--bs-warning-dark)");">
                                    @(e.DeltaGrams >= 0 ? "+" : "")@e.DeltaGrams.ToString("0.#")
                                </td>
                                <td style="padding: 0.5rem 0.75rem; text-align: right; font-variant-numeric: tabular-nums; color: var(--bs-text-subtle);">@e.RunningBalanceGrams.ToString("0.#")</td>
                                <td style="padding: 0.5rem 0.75rem;">@e.UserName</td>
                                <td style="padding: 0.5rem 0.75rem; text-align: right; font-variant-numeric: tabular-nums;">@(e.CostAmount.HasValue ? MoneyIn(e.CostAmount.Value, e.CostCurrency) : "—")</td>
                                <td style="padding: 0.5rem 0.75rem; color: var(--bs-text-subtle);">@e.Note</td>
                                <td style="padding: 0.5rem 0.5rem; text-align: right; white-space: nowrap;">
                                    @if (e.Kind == "Cup" && e.CanEdit && e.ConsumptionEntryId.HasValue)
                                    {
                                        <button class="bs-btn bs-btn-sm bs-btn-ghost" aria-label="Edit cup" title="Edit" @onclick="@(() => OpenEdit(e))">
                                            <span class="material-symbols-outlined" style="font-size: 1rem;">edit</span>
                                        </button>
                                        <button class="bs-btn bs-btn-sm bs-btn-ghost" aria-label="Delete cup" title="Delete" @onclick="@(() => RequestDelete(e))">
                                            <span class="material-symbols-outlined" style="font-size: 1rem; color: var(--bs-error);">delete</span>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="bs-flex bs-items-center bs-justify-between" style="margin-top: 1rem;">
                <span class="bs-text-subtle" style="font-size: 0.8125rem;">
                    @(((page - 1) * pageSize) + 1)–@(Math.Min(page * pageSize, ledger.TotalCount)) of @ledger.TotalCount
                </span>
                <div class="bs-flex bs-gap-2">
                    <button class="bs-btn bs-btn-sm bs-btn-secondary" @onclick="PrevPage" disabled="@(page <= 1)">Previous</button>
                    <button class="bs-btn bs-btn-sm bs-btn-secondary" @onclick="NextPage" disabled="@(page * pageSize >= ledger.TotalCount)">Next</button>
                </div>
            </div>
        }
    </div>
}

@if (showEditModal && editEntry != null)
{
    <div class="bs-modal-backdrop" @onclick="CloseEdit">
        <div class="bs-modal" @onclick:stopPropagation="true" @ontouchend:stopPropagation="true">
            <div class="bs-modal-header">
                <h3 class="bs-modal-title">Edit cup</h3>
            </div>
            <div class="bs-flex bs-flex-col" style="gap: 1rem;">
                <div>
                    <div class="bs-text-subtle" style="font-size: 0.8125rem;">Product</div>
                    <div style="font-weight: 600; margin-top: 0.15rem;">@editEntry.ProductDisplayName</div>
                    <div class="bs-text-subtle" style="font-size: 0.75rem;">To change the coffee, delete this cup and log a new one.</div>
                </div>
                <div class="bs-flex bs-flex-col" style="gap: 0.35rem;">
                    <label for="editGrams" class="bs-text-subtle" style="font-size: 0.8125rem; font-weight: 500;">Amount (g)</label>
                    <input id="editGrams" type="number" class="bs-input" step="0.1" min="0.1" @bind="editGrams" />
                </div>
                <div class="bs-flex bs-flex-col" style="gap: 0.35rem;">
                    <label for="editWhen" class="bs-text-subtle" style="font-size: 0.8125rem; font-weight: 500;">When</label>
                    <input id="editWhen" type="datetime-local" class="bs-input" @bind="editWhen" />
                </div>
            </div>
            <div class="bs-hero-actions">
                <button type="button" class="bs-btn bs-btn-primary bs-btn-hero" @onclick="SaveEdit" disabled="@isSavingEdit">@(isSavingEdit ? "Saving..." : "Save")</button>
                <button type="button" class="bs-btn bs-btn-quiet" @onclick="CloseEdit">Cancel</button>
            </div>
        </div>
    </div>
}

<ConfirmDialog IsVisible="@showDeleteConfirm"
               Title="Delete this cup?"
               Message="This removes the logged cup and returns its grams to the bag it was drawn from. This can't be undone."
               ConfirmText="Delete"
               IsDestructive="true"
               IsProcessing="@isDeleting"
               OnConfirm="ConfirmDelete"
               OnCancel="@(() => showDeleteConfirm = false)" />

<Toast IsVisible="@showToast"
       IsError="@isToastError"
       Title="@toastTitle"
       Message="@toastMessage"
       OnClose="@(() => showToast = false)" />

@code {
    [Parameter] public string SpaceId { get; set; } = "";

    private SpaceDto? space;
    private string spaceName => space?.Name ?? "Loading...";
    private LedgerPageDto? ledger;
    private List<string> productOptions = new();
    private bool isLoading;
    private bool _loaded;

    private string? kind;
    private string productFilter = "";
    private string memberFilter = "";
    private DateTime? startDate;
    private DateTime? endDate;
    private string sortBy = "ts";
    private bool sortDesc = true;
    private int page = 1;
    private const int pageSize = 25;

    private bool showEditModal;
    private LedgerEntryDto? editEntry;
    private decimal editGrams;
    private DateTime editWhen;
    private bool isSavingEdit;

    private bool showDeleteConfirm;
    private LedgerEntryDto? deleteEntry;
    private bool isDeleting;

    private bool showToast;
    private bool isToastError;
    private string toastTitle = "";
    private string toastMessage = "";

    private void OpenEdit(LedgerEntryDto e)
    {
        editEntry = e;
        editGrams = -e.DeltaGrams; // a cup's delta is stored negative
        editWhen = e.Timestamp.ToLocalTime();
        showEditModal = true;
    }

    private void CloseEdit()
    {
        showEditModal = false;
        editEntry = null;
    }

    private async Task SaveEdit()
    {
        if (editEntry?.ConsumptionEntryId is not { } entryId)
        {
            return;
        }

        isSavingEdit = true;
        try
        {
            var result = await Mediator.Send(new UpdateConsumptionCommand(
                entryId,
                Guid.Parse(SpaceId),
                editEntry.ProductName,
                editEntry.ProductBrand,
                editEntry.ProductType,
                editGrams,
                editWhen.ToUniversalTime()));

            if (result.IsSuccess)
            {
                ShowToast(false, "Saved", "Cup updated.");
                showEditModal = false;
                editEntry = null;
                await LoadLedger();
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Couldn't update the cup.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", ex.Message);
        }
        finally
        {
            isSavingEdit = false;
        }
    }

    private void RequestDelete(LedgerEntryDto e)
    {
        deleteEntry = e;
        showDeleteConfirm = true;
    }

    private async Task ConfirmDelete()
    {
        if (deleteEntry?.ConsumptionEntryId is not { } entryId)
        {
            showDeleteConfirm = false;
            return;
        }

        isDeleting = true;
        try
        {
            var result = await Mediator.Send(new DeleteConsumptionCommand(entryId, Guid.Parse(SpaceId)));
            if (result.IsSuccess)
            {
                ShowToast(false, "Deleted", "Cup removed and its grams returned to the bag.");
                await LoadLedger();
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Couldn't delete the cup.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", ex.Message);
        }
        finally
        {
            isDeleting = false;
            showDeleteConfirm = false;
            deleteEntry = null;
        }
    }

    private void ShowToast(bool isError, string title, string message)
    {
        isToastError = isError;
        toastTitle = title;
        toastMessage = message;
        showToast = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded || string.IsNullOrEmpty(SpaceId)) return;
        _loaded = true;
        await LoadSpace();
        await LoadProducts();
        await LoadLedger();
    }

    private async Task LoadSpace()
    {
        var result = await Mediator.Send(new GetSpaceByIdQuery(Guid.Parse(SpaceId)));
        if (result.IsSuccess) space = result.Value;
    }

    private async Task LoadProducts()
    {
        var result = await Mediator.Send(new GetSpaceStockQuery(Guid.Parse(SpaceId)));
        if (result.IsSuccess)
            productOptions = result.Value.StockLevels.Select(s => s.ProductDisplayName).Distinct().OrderBy(x => x).ToList();
    }

    private async Task LoadLedger()
    {
        isLoading = true;
        try
        {
            Guid? member = Guid.TryParse(memberFilter, out var g) ? g : null;
            var result = await Mediator.Send(new GetSpaceLedgerQuery(
                Guid.Parse(SpaceId),
                Kind: kind,
                Product: string.IsNullOrWhiteSpace(productFilter) ? null : productFilter,
                MemberUserId: member,
                StartDate: startDate?.ToUniversalTime(),
                EndDate: endDate?.ToUniversalTime(),
                SortBy: sortBy,
                SortDescending: sortDesc,
                Page: page,
                PageSize: pageSize));
            if (result.IsSuccess) ledger = result.Value;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SetKind(string? k)
    {
        kind = k;
        page = 1;
        await LoadLedger();
    }

    private async Task ApplyFilters()
    {
        page = 1;
        await LoadLedger();
    }

    private async Task ClearFilters()
    {
        kind = null;
        productFilter = "";
        memberFilter = "";
        startDate = null;
        endDate = null;
        page = 1;
        await LoadLedger();
    }

    private async Task ToggleSort(string column)
    {
        if (sortBy == column) sortDesc = !sortDesc;
        else { sortBy = column; sortDesc = true; }
        await LoadLedger();
    }

    private async Task PrevPage()
    {
        if (page <= 1) return;
        page--;
        await LoadLedger();
    }

    private async Task NextPage()
    {
        if (ledger == null || page * pageSize >= ledger.TotalCount) return;
        page++;
        await LoadLedger();
    }

    private RenderFragment Header(string col, string label, bool right = false, bool sortable = true) => builder =>
    {
        var isSorted = sortBy == col;
        var align = right ? "right" : "left";
        var style = $"padding: 0.5rem 0.75rem; text-align: {align}; text-transform: uppercase; font-size: 0.6875rem; letter-spacing: 0.05em; color: var(--bs-text-subtle); font-weight: 650; background: var(--bs-gray-100); white-space: nowrap; {(sortable ? "cursor: pointer;" : "")}";
        builder.OpenElement(0, "th");
        builder.AddAttribute(1, "style", style);
        if (sortable)
            builder.AddAttribute(2, "onclick", EventCallback.Factory.Create(this, () => ToggleSort(col)));
        builder.AddContent(3, label);
        if (isSorted)
        {
            builder.AddContent(4, sortDesc ? " ▾" : " ▴");
        }
        else if (sortable)
        {
            builder.OpenElement(5, "span");
            builder.AddAttribute(6, "style", "opacity: 0.3;");
            builder.AddContent(7, " ⇅");
            builder.CloseElement();
        }
        builder.CloseElement();
    };


    private string FormatGrams(decimal g) => $"{g.ToString("0.#")} g";

    private string Money(decimal amount) => MoneyIn(amount, space?.CurrencyCode ?? "USD");

    private string MoneyIn(decimal amount, string? currencyCode)
    {
        try
        {
            var currency = BeanShare.Domain.ValueObjects.Currency.Create(currencyCode ?? "USD");
            return currency.FormatAmount(amount);
        }
        catch
        {
            return amount.ToString("0.00");
        }
    }
}
