@page "/spaces/{SpaceId}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject NavigationManager Navigation

@* The space root now redirects to the Consumption view — the primary daily action.
   The old all-in-one hub (inline tabs with PreventNavigation="true") has been retired in
   favour of the dedicated per-tab pages (Consumption / Stock / Ledger / Members / …), which
   the SpaceTabs bar navigates to directly. Members lives at /spaces/{id}/members. *@

<PageTitle>BeanShare</PageTitle>

@code {
    [Parameter]
    public string SpaceId { get; set; } = "";

    protected override void OnInitialized()
    {
        Navigation.NavigateTo($"/spaces/{SpaceId}/consumption", forceLoad: false, replace: true);
    }
}
