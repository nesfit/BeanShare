@page "/spaces/{SpaceId}/members"
@rendermode InteractiveServer
@using MediatR
@using BeanShare.Application.Common
@using BeanShare.Application.Features.Spaces.Queries
@using BeanShare.Application.Features.Spaces.Commands
@using Microsoft.AspNetCore.Authorization
@using BeanShare.Application.Abstractions
@attribute [Authorize]
@inject IScopedSender Mediator
@inject NavigationManager Navigation
@inject IUserContext UserContext
@inject IJSRuntime JSRuntime

<PageTitle>Members - @spaceName - BeanShare</PageTitle>

@if (!hasSpace || space == null)
{
    <div class="bs-container" style="padding-top: 4rem; text-align: center;">
        <div class="bs-skeleton" style="width: 12rem; height: 2rem; margin: 0 auto 1rem;"></div>
        <div class="bs-skeleton" style="width: 20rem; height: 1rem; margin: 0 auto;"></div>
    </div>
}
else
{
    <div style="position: sticky; top: 0; z-index: 10; background: var(--bs-background-light); border-bottom: 1px solid var(--bs-border); padding: 1rem 0;">
        <div class="bs-container">
            <div class="bs-flex bs-items-center" style="margin-bottom: 1rem; gap: 0.5rem;">
                <button class="bs-btn-sm" style="background: transparent; border: none; cursor: pointer; flex-shrink: 0;" @onclick='@(() => Navigation.NavigateTo("/spaces"))'>
                    <span class="material-symbols-outlined">arrow_back</span>
                </button>
                <h1 class="bs-font-bold" style="margin: 0; font-size: 1.25rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; min-width: 0; text-align: center;">@space.Name</h1>
                <div style="width: 2rem; flex-shrink: 0;"></div>
            </div>

            <div style="background: var(--bs-gray-100); border-radius: 0.5rem; padding: 0.75rem; margin-bottom: 1rem;">
                <div class="bs-flex bs-items-center bs-justify-between">
                    <span class="bs-text-subtle" style="font-size: 0.75rem; font-weight: 600;">INVITE CODE</span>
                    <div class="bs-flex bs-items-center bs-gap-2">
                        <span style="font-family: monospace; font-size: 0.875rem; font-weight: 700;">@space.InviteCode</span>
                        <button class="bs-btn-sm" style="background: var(--bs-primary-light); color: var(--bs-primary); border: none; padding: 0.25rem 0.5rem;" title="Copy invite code" @onclick="CopyInviteCode">
                            <span class="material-symbols-outlined" style="font-size: 1rem;">content_copy</span>
                        </button>
                    </div>
                </div>
            </div>

            <SpaceTabs SpaceId="@SpaceId" ActiveTab="members" PreventNavigation="false" ShowBalances="true" />
        </div>
    </div>

    <div class="bs-container" style="padding: 2rem 0;">
        @if (isAdmin)
        {
            <div style="margin-bottom: 1rem;">
                <button class="bs-btn bs-btn-secondary" @onclick="OpenAddPlaceholder">
                    <span class="material-symbols-outlined">person_add</span>
                    Add placeholder
                </button>
                <span class="bs-text-subtle" style="font-size: 0.8125rem; margin-left: 0.5rem;">A member without an account (e.g. from the old spreadsheet); they can claim it later by signing in with the same email.</span>
            </div>
        }
        <SpaceMembers Members="@space.Members"
                     IsLoading="@isLoadingMembers"
                     IsAdmin="@isAdmin"
                     CurrentUserId="@UserContext.CurrentUserId.Value"
                     OnPromoteMember="HandlePromoteMember"
                     OnDemoteMember="HandleDemoteMember"
                     OnRemoveMember="RequestRemoveMember"
                     OnLeaveSpace="HandleLeaveSpace"
                     OnEditPlaceholder="OpenEditPlaceholder"
                     OnMergePlaceholder="OpenMergePlaceholder" />
    </div>
}

@if (showPlaceholderModal)
{
    <div class="bs-modal-backdrop" @onclick="ClosePlaceholderModal">
        <div class="bs-modal" @onclick:stopPropagation="true" @ontouchend:stopPropagation="true">
            <div class="bs-modal-header">
                <h3 class="bs-modal-title">@(editingPlaceholderId is null ? "Add placeholder member" : "Edit placeholder")</h3>
            </div>
            <div class="bs-flex bs-flex-col" style="gap: 1rem;">
                <div class="bs-flex bs-flex-col" style="gap: 0.35rem;">
                    <label for="placeholderName" class="bs-text-subtle" style="font-size: 0.8125rem; font-weight: 500;">Name</label>
                    <input id="placeholderName" type="text" class="bs-input" maxlength="100" @bind="placeholderName" />
                </div>
                <div class="bs-flex bs-flex-col" style="gap: 0.35rem;">
                    <label for="placeholderEmail" class="bs-text-subtle" style="font-size: 0.8125rem; font-weight: 500;">Email (optional; used when they sign in)</label>
                    <input id="placeholderEmail" type="email" class="bs-input" maxlength="254" @bind="placeholderEmail" />
                </div>
            </div>
            <div class="bs-hero-actions">
                <button type="button" class="bs-btn bs-btn-primary bs-btn-hero" @onclick="SavePlaceholder" disabled="@isSavingPlaceholder">@(isSavingPlaceholder ? "Saving..." : "Save")</button>
                <button type="button" class="bs-btn bs-btn-quiet" @onclick="ClosePlaceholderModal">Cancel</button>
            </div>
        </div>
    </div>
}

@if (showMergeModal)
{
    <div class="bs-modal-backdrop" @onclick="CloseMergeModal">
        <div class="bs-modal" @onclick:stopPropagation="true" @ontouchend:stopPropagation="true">
            <div class="bs-modal-header">
                <h3 class="bs-modal-title">Merge @mergePlaceholderName into a member</h3>
            </div>
            <p class="bs-text-subtle" style="font-size: 0.875rem;">
                The placeholder's balance, history and the bags it paid for move to the member you choose, now and in
                every later settlement. The placeholder is then hidden. This cannot be undone.
            </p>
            <div class="bs-flex bs-flex-col" style="gap: 0.35rem;">
                <label for="mergeTarget" class="bs-text-subtle" style="font-size: 0.8125rem; font-weight: 500;">Member</label>
                <select id="mergeTarget" class="bs-input" value="@(mergeTargetId ?? "")" @onchange="@(e => mergeTargetId = e.Value?.ToString())">
                    <option value="">Choose a member</option>
                    @foreach (var m in MergeTargets)
                    {
                        <option value="@m.UserId">@m.UserName</option>
                    }
                </select>
            </div>
            <div class="bs-hero-actions">
                <button type="button" class="bs-btn bs-btn-primary bs-btn-hero" @onclick="ExecuteMerge" disabled="@(isMerging || string.IsNullOrEmpty(mergeTargetId))">@(isMerging ? "Merging..." : "Merge")</button>
                <button type="button" class="bs-btn bs-btn-quiet" @onclick="CloseMergeModal">Cancel</button>
            </div>
        </div>
    </div>
}

<ConfirmDialog IsVisible="@showRemoveDialog"
               Title="Remove member?"
               Message="@($"Remove {pendingRemoveName} from this space? They'll lose access to its data and can only rejoin with an invite code. Their past consumption stays in the records.")"
               ConfirmText="Remove"
               IsDestructive="true"
               IsProcessing="@isRemoving"
               OnConfirm="ExecuteRemoveMember"
               OnCancel="@(() => showRemoveDialog = false)" />

<Toast IsVisible="@showToast"
       IsError="@isToastError"
       Title="@toastTitle"
       Message="@toastMessage"
       OnClose="@(() => showToast = false)" />

@code {
    [Parameter]
    public string SpaceId { get; set; } = "";

    private SpaceDto? space;
    private string spaceName => space?.Name ?? "Loading...";
    private bool hasSpace => !string.IsNullOrEmpty(SpaceId) && space != null;
    private bool isAdmin;
    private bool isLoadingMembers;

    private bool showToast;
    private bool isToastError;
    private string toastTitle = "";
    private string toastMessage = "";

    private bool showRemoveDialog;
    private bool isRemoving;
    private string pendingRemoveUserId = "";
    private string pendingRemoveName = "this member";

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(SpaceId))
        {
            if (!Guid.TryParse(SpaceId, out _))
            {
                Navigation.NavigateTo("/spaces");
                return;
            }
            await LoadSpace();
        }
    }

    private async Task LoadSpace()
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid))
        {
            Navigation.NavigateTo("/spaces");
            return;
        }

        isLoadingMembers = true;
        try
        {
            var result = await Mediator.Send(new GetSpaceByIdQuery(spaceGuid));
            if (result.IsSuccess)
            {
                space = result.Value;
                var currentUserId = UserContext.CurrentUserId.Value;
                isAdmin = space.Members.Any(m => m.UserId == currentUserId && m.Role == "Admin");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load space: {ex.Message}");
        }
        finally
        {
            isLoadingMembers = false;
        }
    }

    private async Task HandlePromoteMember(string userId)
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid) || !Guid.TryParse(userId, out var userGuid))
            return;

        try
        {
            var result = await Mediator.Send(new PromoteMemberCommand(spaceGuid, userGuid));
            if (result.IsSuccess)
            {
                ShowToast(false, "Success", "Member promoted to admin.");
                await LoadSpace();
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to promote member.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to promote member: {ex.Message}");
        }
    }

    private async Task HandleDemoteMember(string userId)
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid) || !Guid.TryParse(userId, out var userGuid))
            return;

        try
        {
            var result = await Mediator.Send(new DemoteMemberCommand(spaceGuid, userGuid));
            if (result.IsSuccess)
            {
                ShowToast(false, "Success", "Member demoted to regular member.");
                await LoadSpace();
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to demote member.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to demote member: {ex.Message}");
        }
    }

    private void RequestRemoveMember(string userId)
    {
        pendingRemoveUserId = userId;
        pendingRemoveName = space?.Members
            .FirstOrDefault(m => m.UserId.ToString() == userId)?.UserName ?? "this member";
        showRemoveDialog = true;
    }

    private async Task ExecuteRemoveMember()
    {
        isRemoving = true;
        try
        {
            await HandleRemoveMember(pendingRemoveUserId);
        }
        finally
        {
            isRemoving = false;
            showRemoveDialog = false;
        }
    }

    private async Task HandleRemoveMember(string userId)
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid) || !Guid.TryParse(userId, out var userGuid))
            return;

        try
        {
            var result = await Mediator.Send(new RemoveMemberCommand(spaceGuid, userGuid));
            if (result.IsSuccess)
            {
                ShowToast(false, "Success", "Member removed from space.");
                await LoadSpace();
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to remove member.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to remove member: {ex.Message}");
        }
    }

    private async Task HandleLeaveSpace()
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid))
            return;

        try
        {
            var result = await Mediator.Send(new LeaveSpaceCommand(spaceGuid));
            if (result.IsSuccess)
            {
                Navigation.NavigateTo("/spaces");
                return;
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to leave space.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to leave space: {ex.Message}");
        }
    }

    private async Task CopyInviteCode()
    {
        if (space?.InviteCode != null)
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", space.InviteCode);
            ShowToast(false, "Copied!", "Invite code copied to clipboard");
        }
    }

    // ---- placeholders (D21, DS-32) ----

    private bool showPlaceholderModal;
    private Guid? editingPlaceholderId;
    private string placeholderName = "";
    private string placeholderEmail = "";
    private bool isSavingPlaceholder;

    private bool showMergeModal;
    private Guid mergePlaceholderId;
    private string mergePlaceholderName = "";
    private string? mergeTargetId;
    private bool isMerging;

    private IEnumerable<BeanShare.Application.Features.Spaces.Dtos.MembershipDto> MergeTargets =>
        (space?.Members ?? []).Where(m => !m.IsPlaceholder).OrderBy(m => m.UserName);

    private void OpenAddPlaceholder()
    {
        editingPlaceholderId = null;
        placeholderName = "";
        placeholderEmail = "";
        showPlaceholderModal = true;
    }

    private void OpenEditPlaceholder(string userId)
    {
        var member = space?.Members.FirstOrDefault(m => m.UserId.ToString() == userId);
        if (member is null) return;
        editingPlaceholderId = member.UserId;
        placeholderName = member.UserName;
        placeholderEmail = member.Email;
        showPlaceholderModal = true;
    }

    private void ClosePlaceholderModal() => showPlaceholderModal = false;

    private async Task SavePlaceholder()
    {
        isSavingPlaceholder = true;
        try
        {
            var email = string.IsNullOrWhiteSpace(placeholderEmail) ? null : placeholderEmail.Trim();
            var result = editingPlaceholderId is { } id
                ? await Mediator.Send(new UpdatePlaceholderMemberCommand(Guid.Parse(SpaceId), id, placeholderName, email))
                : await Mediator.Send(new CreatePlaceholderMemberCommand(Guid.Parse(SpaceId), placeholderName, email));
            if (result.IsSuccess)
            {
                showPlaceholderModal = false;
                ShowToast(false, "Saved", $"{result.Value.UserName} saved.");
                await LoadSpace();
            }
            else
            {
                await HandleFailure(result.Errors);
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", ex.Message);
        }
        finally
        {
            isSavingPlaceholder = false;
        }
    }

    private void OpenMergePlaceholder(string userId)
    {
        var member = space?.Members.FirstOrDefault(m => m.UserId.ToString() == userId);
        if (member is null) return;
        mergePlaceholderId = member.UserId;
        mergePlaceholderName = member.UserName;
        mergeTargetId = null;
        showMergeModal = true;
    }

    private void CloseMergeModal() => showMergeModal = false;

    private async Task ExecuteMerge()
    {
        if (!Guid.TryParse(mergeTargetId, out var targetId)) return;

        isMerging = true;
        try
        {
            var result = await Mediator.Send(new MergePlaceholderCommand(Guid.Parse(SpaceId), mergePlaceholderId, targetId));
            if (result.IsSuccess)
            {
                showMergeModal = false;
                ShowToast(false, "Merged", $"{mergePlaceholderName} was merged.");
                await LoadSpace();
            }
            else
            {
                await HandleFailure(result.Errors);
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", ex.Message);
        }
        finally
        {
            isMerging = false;
        }
    }

    private async Task HandleFailure(IReadOnlyList<Error> errors)
    {
        if (errors.Any(e => e.Code == Error.Codes.ConcurrencyConflict))
        {
            showMergeModal = false;
            showPlaceholderModal = false;
            ShowToast(true, "Changed meanwhile", "The members changed in the meantime and were reloaded. Please check and try again.");
            await LoadSpace();
            return;
        }

        ShowToast(true, "Error", string.Join(", ", errors.Select(e => e.Message)));
    }

    private void ShowToast(bool isError, string title, string message)
    {
        isToastError = isError;
        toastTitle = title;
        toastMessage = message;
        showToast = true;
    }
}
