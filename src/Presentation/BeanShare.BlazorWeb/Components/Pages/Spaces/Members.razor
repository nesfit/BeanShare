@page "/spaces/{SpaceId}/members"
@rendermode InteractiveServer
@using MediatR
@using BeanShare.Application.Features.Spaces.Queries
@using BeanShare.Application.Features.Spaces.Commands
@using Microsoft.AspNetCore.Authorization
@using BeanShare.Application.Abstractions
@attribute [Authorize]
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject IUserContext UserContext
@inject IJSRuntime JSRuntime

<PageTitle>Members - @spaceName - BeanShare</PageTitle>

@if (!hasSpace || space == null)
{
    <div class="bs-container" style="padding-top: 4rem; text-align: center;">
        <div class="bs-skeleton" style="width: 12rem; height: 2rem; margin: 0 auto 1rem;"></div>
        <div class="bs-skeleton" style="width: 20rem; height: 1rem; margin: 0 auto;"></div>
    </div>
}
else
{
    <div style="position: sticky; top: 0; z-index: 10; background: var(--bs-background-light); border-bottom: 1px solid var(--bs-border); padding: 1rem 0;">
        <div class="bs-container">
            <div class="bs-flex bs-items-center" style="margin-bottom: 1rem; gap: 0.5rem;">
                <button class="bs-btn-sm" style="background: transparent; border: none; cursor: pointer; flex-shrink: 0;" @onclick='@(() => Navigation.NavigateTo("/spaces"))'>
                    <span class="material-symbols-outlined">arrow_back</span>
                </button>
                <h1 class="bs-font-bold" style="margin: 0; font-size: 1.25rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; min-width: 0; text-align: center;">@space.Name</h1>
                <div style="width: 2rem; flex-shrink: 0;"></div>
            </div>

            <div style="background: var(--bs-gray-100); border-radius: 0.5rem; padding: 0.75rem; margin-bottom: 1rem;">
                <div class="bs-flex bs-items-center bs-justify-between">
                    <span class="bs-text-subtle" style="font-size: 0.75rem; font-weight: 600;">INVITE CODE</span>
                    <div class="bs-flex bs-items-center bs-gap-2">
                        <span style="font-family: monospace; font-size: 0.875rem; font-weight: 700;">@space.InviteCode</span>
                        <button class="bs-btn-sm" style="background: var(--bs-primary-light); color: var(--bs-primary); border: none; padding: 0.25rem 0.5rem;" title="Copy invite code" @onclick="CopyInviteCode">
                            <span class="material-symbols-outlined" style="font-size: 1rem;">content_copy</span>
                        </button>
                    </div>
                </div>
            </div>

            <SpaceTabs SpaceId="@SpaceId" ActiveTab="members" PreventNavigation="false" />
        </div>
    </div>

    <div class="bs-container" style="padding: 2rem 0;">
        <SpaceMembers Members="@space.Members"
                     IsLoading="@isLoadingMembers"
                     IsAdmin="@isAdmin"
                     CurrentUserId="@UserContext.CurrentUserId.Value"
                     OnPromoteMember="HandlePromoteMember"
                     OnDemoteMember="HandleDemoteMember"
                     OnRemoveMember="RequestRemoveMember"
                     OnLeaveSpace="HandleLeaveSpace" />
    </div>
}

<ConfirmDialog IsVisible="@showRemoveDialog"
               Title="Remove member?"
               Message="@($"Remove {pendingRemoveName} from this space? They'll lose access to its data and can only rejoin with an invite code. Their past consumption stays in the records.")"
               ConfirmText="Remove"
               IsDestructive="true"
               IsProcessing="@isRemoving"
               OnConfirm="ExecuteRemoveMember"
               OnCancel="@(() => showRemoveDialog = false)" />

<Toast IsVisible="@showToast"
       IsError="@isToastError"
       Title="@toastTitle"
       Message="@toastMessage"
       OnClose="@(() => showToast = false)" />

@code {
    [Parameter]
    public string SpaceId { get; set; } = "";

    private SpaceDto? space;
    private string spaceName => space?.Name ?? "Loading...";
    private bool hasSpace => !string.IsNullOrEmpty(SpaceId) && space != null;
    private bool isAdmin;
    private bool isLoadingMembers;

    private bool showToast;
    private bool isToastError;
    private string toastTitle = "";
    private string toastMessage = "";

    private bool showRemoveDialog;
    private bool isRemoving;
    private string pendingRemoveUserId = "";
    private string pendingRemoveName = "this member";

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(SpaceId))
        {
            if (!Guid.TryParse(SpaceId, out _))
            {
                Navigation.NavigateTo("/spaces");
                return;
            }
            await LoadSpace();
        }
    }

    private async Task LoadSpace()
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid))
        {
            Navigation.NavigateTo("/spaces");
            return;
        }

        isLoadingMembers = true;
        try
        {
            var result = await Mediator.Send(new GetSpaceByIdQuery(spaceGuid));
            if (result.IsSuccess)
            {
                space = result.Value;
                var currentUserId = UserContext.CurrentUserId.Value;
                isAdmin = space.Members.Any(m => m.UserId == currentUserId && m.Role == "Admin");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load space: {ex.Message}");
        }
        finally
        {
            isLoadingMembers = false;
        }
    }

    private async Task HandlePromoteMember(string userId)
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid) || !Guid.TryParse(userId, out var userGuid))
            return;

        try
        {
            var result = await Mediator.Send(new PromoteMemberCommand(spaceGuid, userGuid));
            if (result.IsSuccess)
            {
                ShowToast(false, "Success", "Member promoted to admin.");
                await LoadSpace();
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to promote member.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to promote member: {ex.Message}");
        }
    }

    private async Task HandleDemoteMember(string userId)
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid) || !Guid.TryParse(userId, out var userGuid))
            return;

        try
        {
            var result = await Mediator.Send(new DemoteMemberCommand(spaceGuid, userGuid));
            if (result.IsSuccess)
            {
                ShowToast(false, "Success", "Member demoted to regular member.");
                await LoadSpace();
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to demote member.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to demote member: {ex.Message}");
        }
    }

    private void RequestRemoveMember(string userId)
    {
        pendingRemoveUserId = userId;
        pendingRemoveName = space?.Members
            .FirstOrDefault(m => m.UserId.ToString() == userId)?.UserName ?? "this member";
        showRemoveDialog = true;
    }

    private async Task ExecuteRemoveMember()
    {
        isRemoving = true;
        try
        {
            await HandleRemoveMember(pendingRemoveUserId);
        }
        finally
        {
            isRemoving = false;
            showRemoveDialog = false;
        }
    }

    private async Task HandleRemoveMember(string userId)
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid) || !Guid.TryParse(userId, out var userGuid))
            return;

        try
        {
            var result = await Mediator.Send(new RemoveMemberCommand(spaceGuid, userGuid));
            if (result.IsSuccess)
            {
                ShowToast(false, "Success", "Member removed from space.");
                await LoadSpace();
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to remove member.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to remove member: {ex.Message}");
        }
    }

    private async Task HandleLeaveSpace()
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid))
            return;

        try
        {
            var result = await Mediator.Send(new LeaveSpaceCommand(spaceGuid));
            if (result.IsSuccess)
            {
                Navigation.NavigateTo("/spaces");
                return;
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to leave space.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to leave space: {ex.Message}");
        }
    }

    private async Task CopyInviteCode()
    {
        if (space?.InviteCode != null)
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", space.InviteCode);
            ShowToast(false, "Copied!", "Invite code copied to clipboard");
        }
    }

    private void ShowToast(bool isError, string title, string message)
    {
        isToastError = isError;
        toastTitle = title;
        toastMessage = message;
        showToast = true;
    }
}
