@page "/spaces/{SpaceId}/stock"
@rendermode InteractiveServer
@using MediatR
@using BeanShare.Application.Common
@using BeanShare.Application.Features.Spaces.Queries
@using BeanShare.Application.Features.Spaces.Commands
@using BeanShare.Application.Features.CoffeeStock.Queries
@using BeanShare.Application.Features.CoffeeStock.Queries.LookupBarcode
@using BeanShare.Application.Features.CoffeeStock.Queries.GetRestockForecast
@using BeanShare.Application.Features.CoffeeStock.Commands
@using BeanShare.Application.Features.CoffeeStock.Dtos
@using BeanShare.Application.Features.ActiveQrCodes.Queries
@using BeanShare.Application.Features.ActiveQrCodes.Commands
@using BeanShare.Application.Features.ActiveQrCodes.Dtos
@using BeanShare.Application.Features.Presets.Queries
@using BeanShare.SharedUi.Components.Consumption.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using BeanShare.Application.Abstractions
@inject IScopedSender Mediator
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IUserContext UserContext
@inject BeanShare.SharedUi.Services.QrCodeResolveCache QrResolveCache

<PageTitle>Stock - @spaceName - BeanShare</PageTitle>

@if (!hasSpace || space == null)
{
    <div class="bs-container" style="padding-top: 4rem; text-align: center;">
        <div class="bs-skeleton" style="width: 12rem; height: 2rem; margin: 0 auto 1rem;"></div>
        <div class="bs-skeleton" style="width: 20rem; height: 1rem; margin: 0 auto;"></div>
    </div>
}
else
{
    <div style="position: sticky; top: 0; z-index: 10; background: var(--bs-background-light); border-bottom: 1px solid var(--bs-border); padding: 1rem 0;">
        <div class="bs-container">
            <div class="bs-flex bs-items-center" style="margin-bottom: 1rem; gap: 0.5rem;">
                <button class="bs-btn-sm" style="background: transparent; border: none; cursor: pointer; flex-shrink: 0;" @onclick='@(() => Navigation.NavigateTo("/spaces"))'>
                    <span class="material-symbols-outlined">arrow_back</span>
                </button>
                <h1 class="bs-font-bold" style="margin: 0; font-size: 1.25rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; min-width: 0; text-align: center;">@space.Name</h1>
                <div style="width: 2rem; flex-shrink: 0;"></div>
            </div>

            <div style="background: var(--bs-gray-100); border-radius: 0.5rem; padding: 0.75rem; margin-bottom: 1rem;">
                <div class="bs-flex bs-items-center bs-justify-between">
                    <span class="bs-text-subtle" style="font-size: 0.75rem; font-weight: 600;">INVITE CODE</span>
                    <div class="bs-flex bs-items-center bs-gap-2">
                        <span style="font-family: monospace; font-size: 0.875rem; font-weight: 700;">@space.InviteCode</span>
                        <button class="bs-btn-sm" style="background: var(--bs-primary-light); color: var(--bs-primary); border: none; padding: 0.25rem 0.5rem;" title="Copy invite code" @onclick="CopyInviteCode">
                            <span class="material-symbols-outlined" style="font-size: 1rem;">content_copy</span>
                        </button>
                    </div>
                </div>
            </div>

            <SpaceTabs SpaceId="@SpaceId"
                      ActiveTab="stock"
                      PreventNavigation="false"
                      ShowBalances="true" />
        </div>
    </div>

    <div class="bs-container" style="padding: 2rem 0 6rem 0;">
        <div>
            @if (isAdmin && restockForecast is not null)
            {
                <div class="bs-flex bs-items-center bs-justify-between" style="gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem; padding: 0.5rem 0.75rem; background: var(--bs-gray-50); border: 1px solid var(--bs-border); border-radius: 0.5rem;">
                    <span class="bs-text-subtle" style="font-size: 0.8125rem;">
                        <span class="material-symbols-outlined" style="font-size: 1rem; vertical-align: middle;">tune</span>
                        Alerts ~@restockForecast.LeadTimeDays days ahead · order at @(restockForecast.MinOrderValue.ToString("0")) @(space?.CurrencyCode ?? "")
                    </span>
                    <button class="bs-btn bs-btn-sm bs-btn-ghost" @onclick="@(() => showRestockSettings = true)">
                        <span class="material-symbols-outlined" style="font-size: 1rem;">settings</span>
                        Restock settings
                    </button>
                </div>
            }

            <RestockPanel Forecast="@restockForecast" />

            <StockBagsGrid Purchases="@purchases"
                           StockLevels="@stockLevels"
                           IsAdmin="@isAdmin"
                           OnOpenBag="HandleOpenBag"
                           OnMarkBagEmpty="HandleMarkBagEmpty"
                           OnUndoBagEmpty="HandleUndoBagEmpty"
                           OnDiscardBag="HandleDiscardBag"
                           OnDeleteBag="HandleDeletePurchase"
                           OnShowQr="ShowQrModal" />

            <ActiveQrCodesSection ActiveQrCodes="@activeQrCodes"
                                 StockLevels="@stockLevels"
                                 IsLoading="@isLoadingActiveQrs"
                                 OnReassign="HandleReassignQr"
                                 OnRename="HandleRenameQr"
                                 OnDeactivate="HandleDeactivateQr"
                                 OnShowQr="HandleShowExistingQr"
                                 SpaceName="@spaceName"
                                 QuickPresets="@quickPresets" />

            <StockPurchaseHistory @key="SpaceId"
                           Purchases="@purchases"
                           IsLoading="@isLoadingStock"
                           CurrencyCode="@(space?.CurrencyCode ?? "USD")"
                           IsAdmin="@isAdmin"
                           TotalPurchaseCount="@totalPurchaseCount"
                           OnEditPurchase="HandleEditPurchase"
                           OnDeletePurchase="HandleDeletePurchase"
                           OnClonePurchase="HandleClonePurchase" />

            @if (isAdmin)
            {
                <button class="bs-fab"
                        @onclick="@(() => showAddPurchaseModal = true)"
                        title="Add Stock Purchase"
                        aria-label="Add Stock Purchase">
                    <span class="material-symbols-outlined">add</span>
                </button>
            }
        </div>
    </div>
}

<AddPurchaseModal IsVisible="@showAddPurchaseModal"
                 OnSubmit="HandleAddPurchase"
                 OnCancel="HandleAddPurchaseCancel"
                 CurrencyCode="@(space?.CurrencyCode ?? "USD")"
                 PrefillFrom="@purchasePrefill"
                 PayerOptions="@payerOptions"
                 OnBarcodeScanned="HandleBarcodeScanned" />

<QrCodeModal IsVisible="@showQrModal"
            StockLevel="@selectedQrStockLevel"
            SpaceId="@(Guid.TryParse(SpaceId, out var sid) ? sid : Guid.Empty)"
            SpaceName="@spaceName"
            OnClose="HandleQrModalClose"
            OnCreate="HandleQrCreate"
            CreatedQrCodeId="@createdQrCodeId"
            QuickPresets="@quickPresets"
            ProductBags="@BagsForSelectedQr()" />

<RestockSettingsModal IsVisible="@showRestockSettings"
                     LeadTimeDays="@(restockForecast?.LeadTimeDays ?? 7)"
                     MinOrderValue="@(restockForecast?.MinOrderValue ?? 2000m)"
                     CurrencyCode="@(space?.CurrencyCode ?? "USD")"
                     IsProcessing="@isSavingRestockSettings"
                     OnSave="HandleSaveRestockSettings"
                     OnCancel="@(() => showRestockSettings = false)" />

<Toast IsVisible="@showToast"
       IsError="@isToastError"
       Title="@toastTitle"
       Message="@toastMessage"
       OnClose="@(() => showToast = false)" />

@code {
    [Parameter]
    public string SpaceId { get; set; } = "";

    private SpaceDto? space;
    private string spaceName => space?.Name ?? "Loading...";
    private bool hasSpace => !string.IsNullOrEmpty(SpaceId) && space != null;
    private bool isAdmin;
    private bool isLoadingStock;

    private List<StockPurchaseDto> purchases = new();
    private List<StockLevelDto> stockLevels = new();
    private RestockForecastDto? restockForecast;
    // The stock aggregate loads all its bags (Purchases) into memory server-side, and Blazor renders
    // in-process, so we fetch them all in one query. Bags also feed the current-stock grid and the QR
    // bag pickers, which must be complete (not capped). This value is an "effectively unbounded" cap.
    private const int AllPurchasesPageSize = 100_000;
    // Server-side total, so the history view can flag if it ever exceeds the load cap above.
    private int totalPurchaseCount;

    private bool showAddPurchaseModal;
    private AddPurchaseModal.PurchasePrefill? purchasePrefill;
    private IReadOnlyList<AddPurchaseModal.PayerOption>? payerOptions;
    private bool showQrModal;
    private StockLevelDto? selectedQrStockLevel;
    private List<ActiveQrCodeDto> activeQrCodes = new();
    private bool isLoadingActiveQrs;
    private Guid? createdQrCodeId;
    private List<PresetOption> quickPresets = new();

    private bool showRestockSettings;
    private bool isSavingRestockSettings;

    private bool showToast;
    private bool isToastError;
    private string toastTitle = "";
    private string toastMessage = "";
    private bool _isLoading;

    protected override async Task OnParametersSetAsync()
    {
        if (_isLoading || string.IsNullOrEmpty(SpaceId)) return;
        _isLoading = true;
        try
        {
            await LoadSpace();
            await LoadStock();
            await LoadActiveQrCodes();
            await LoadQuickPresets();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadSpace()
    {
        try
        {
            var result = await Mediator.Send(new GetSpaceByIdQuery(Guid.Parse(SpaceId)));
            if (result.IsSuccess)
            {
                space = result.Value;
                var currentUserId = UserContext.CurrentUserId.Value;
                isAdmin = space.Members.Any(m => m.UserId == currentUserId && m.Role == "Admin");
                payerOptions = space.Members
                    .Where(m => m.UserId != currentUserId)
                    .Select(m => new AddPurchaseModal.PayerOption(m.UserId, m.UserName))
                    .OrderBy(p => p.Name)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load space: {ex.Message}");
        }
    }

    private async Task LoadStock()
    {
        isLoadingStock = true;

        try
        {
            var result = await Mediator.Send(new GetSpaceStockQuery(Guid.Parse(SpaceId), 1, AllPurchasesPageSize));
            if (result.IsSuccess)
            {
                purchases = result.Value.RecentPurchases.ToList();
                stockLevels = result.Value.StockLevels.ToList();
                totalPurchaseCount = result.Value.TotalPurchaseCount;
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load stock: {ex.Message}");
        }
        finally
        {
            isLoadingStock = false;
        }

        await LoadRestock();
    }

    private async Task LoadRestock()
    {
        // Best-effort planning aid — never block the stock view if it fails.
        try
        {
            var result = await Mediator.Send(new GetRestockForecastQuery(Guid.Parse(SpaceId)));
            if (result.IsSuccess)
            {
                restockForecast = result.Value;
            }
        }
        catch
        {
            restockForecast = null;
        }
    }

    private async Task HandleSaveRestockSettings((int LeadTimeDays, decimal MinOrderValue) settings)
    {
        isSavingRestockSettings = true;
        try
        {
            var result = await Mediator.Send(new SetRestockSettingsCommand(Guid.Parse(SpaceId), settings.LeadTimeDays, settings.MinOrderValue));
            if (result.IsSuccess)
            {
                showRestockSettings = false;
                await LoadRestock();
                ShowToast(false, "Saved", "Restock settings updated.");
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to save settings: {ex.Message}");
        }
        finally
        {
            isSavingRestockSettings = false;
        }
    }

    private async Task HandleBarcodeScanned(string code)
    {
        try
        {
            var result = await Mediator.Send(new LookupBarcodeQuery(Guid.Parse(SpaceId), code));
            if (result.IsSuccess && result.Value.Found)
            {
                var v = result.Value;
                purchasePrefill = new AddPurchaseModal.PurchasePrefill
                {
                    ProductName = v.ProductName ?? "",
                    ProductBrand = v.ProductBrand ?? "",
                    QuantityGrams = v.QuantityGrams ?? 0,
                    CostAmount = v.CostAmount ?? 0m,
                    CoffeeType = string.IsNullOrWhiteSpace(v.ProductType) ? "Espresso" : v.ProductType,
                    Barcode = code
                };
                var msg = v.Source == "history"
                    ? "Filled in from your last purchase of this bag — check the price."
                    : "Filled in from the product catalog — add the price.";
                ShowToast(false, "Barcode recognised", msg);
            }
            else
            {
                ShowToast(false, "New barcode", "Not recognised yet — fill it in and we'll remember it next time.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Barcode lookup failed: {ex.Message}");
        }
    }

    private async Task HandleAddPurchase(AddPurchaseModal.AddPurchaseModel model)
    {
        try
        {
            var result = await Mediator.Send(new AddStockPurchaseCommand(
                Guid.Parse(SpaceId),
                model.ProductName,
                model.ProductBrand,
                model.CoffeeType,
                model.QuantityGrams,
                model.TotalCost,
                model.Currency,
                "Store",
                model.PurchasedAt.ToUniversalTime(),
                model.BagCount,
                model.Barcode,
                model.PaidByUserId
            ));

            if (result.IsSuccess)
            {
                showAddPurchaseModal = false;
                purchasePrefill = null;
                ShowToast(false, "Success", "Stock purchase added successfully!");
                await LoadStock();
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to add purchase: {ex.Message}");
        }
    }

    private void HandleAddPurchaseCancel()
    {
        showAddPurchaseModal = false;
        purchasePrefill = null;
    }

    private void HandleClonePurchase(PurchaseRow.PurchaseCloneModel model)
    {
        purchasePrefill = new AddPurchaseModal.PurchasePrefill
        {
            ProductBrand = model.ProductBrand,
            ProductName = model.ProductName,
            QuantityGrams = model.QuantityGrams,
            CostAmount = model.CostAmount,
            CoffeeType = model.CoffeeType
        };
        showAddPurchaseModal = true;
    }

    private async Task HandleEditPurchase(BeanShare.SharedUi.Components.Stock.PurchaseRow.PurchaseEditModel model)
    {
        try
        {
            var result = await Mediator.Send(new UpdateStockPurchaseCommand(
                Guid.Parse(SpaceId),
                model.PurchaseId,
                model.QuantityGrams,
                model.CostAmount,
                model.PurchasedAt.ToUniversalTime(),
                model.ProductName,
                model.ProductBrand,
                model.CoffeeType));

            if (result.IsSuccess)
            {
                ShowToast(false, "Success", "Purchase updated successfully!");
                await LoadStock();
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to update purchase: {ex.Message}");
        }
    }

    private async Task HandleDeletePurchase(Guid purchaseId)
    {
        try
        {
            var result = await Mediator.Send(new DeleteStockPurchaseCommand(
                Guid.Parse(SpaceId),
                purchaseId));

            if (result.IsSuccess)
            {
                ShowToast(false, "Deleted", "Purchase deleted successfully.");
                await LoadStock();
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to delete purchase: {ex.Message}");
        }
    }

    private async Task CopyInviteCode()
    {
        if (space?.InviteCode != null)
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", space.InviteCode);
            ShowToast(false, "Copied!", "Invite code copied to clipboard");
        }
    }

    private void ShowToast(bool isError, string title, string message)
    {
        isToastError = isError;
        toastTitle = title;
        toastMessage = message;
        showToast = true;
    }

    private async Task HandleOpenBag(Guid bagId)
    {
        try
        {
            var result = await Mediator.Send(new OpenBagCommand(Guid.Parse(SpaceId), bagId));
            if (result.IsSuccess)
            {
                ShowToast(false, "Opened", "Bag opened — cups now draw from it.");
                await LoadStock();
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to open bag: {ex.Message}");
        }
    }

    private async Task HandleMarkBagEmpty(Guid bagId)
    {
        try
        {
            var result = await Mediator.Send(new MarkBagEmptyCommand(Guid.Parse(SpaceId), bagId));
            if (result.IsSuccess)
            {
                var r = result.Value;
                ShowToast(false, "Emptied", $"{r.ProductDisplayName} {r.BagLabel} emptied — {r.DistributedGrams:0.#} g billed to {r.MemberCount} member(s).");
                await LoadStock();
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to empty bag: {ex.Message}");
        }
    }

    private async Task HandleUndoBagEmpty(Guid bagId)
    {
        try
        {
            var result = await Mediator.Send(new UndoBagEmptyCommand(Guid.Parse(SpaceId), bagId));
            if (result.IsSuccess)
            {
                var r = result.Value;
                ShowToast(false, "Restored", $"{r.ProductDisplayName} {r.BagLabel} is {r.NewStatus.ToLowerInvariant()} again — {r.RestoredGrams:0.#} g put back, {r.RemovedEntries} billed cup(s) removed.");
                await LoadStock();
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to undo emptying the bag: {ex.Message}");
        }
    }

    private async Task HandleDiscardBag(Guid bagId)
    {
        try
        {
            var result = await Mediator.Send(new DiscardBagCommand(Guid.Parse(SpaceId), bagId));
            if (result.IsSuccess)
            {
                var r = result.Value;
                ShowToast(false, "Discarded", $"{r.ProductDisplayName} {r.BagLabel}: {r.DiscardedGrams:0.#} g thrown away (worth {r.SunkCostAmount:0.##} {r.Currency}); nobody was billed.");
                await LoadStock();
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to discard bag: {ex.Message}");
        }
    }

    private async Task LoadActiveQrCodes()
    {
        isLoadingActiveQrs = true;
        try
        {
            var result = await Mediator.Send(new GetActiveQrCodesQuery(Guid.Parse(SpaceId)));
            if (result.IsSuccess)
            {
                activeQrCodes = result.Value.ToList();
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load QR codes: {ex.Message}");
        }
        finally
        {
            isLoadingActiveQrs = false;
        }
    }

    private async Task LoadQuickPresets()
    {
        try
        {
            var result = await Mediator.Send(new GetQuickPresetsQuery(Guid.Parse(SpaceId)));
            if (result.IsSuccess)
            {
                quickPresets = result.Value.Presets.Select(p => new PresetOption
                {
                    GlobalPresetId = p.GlobalPresetId,
                    SpacePresetId = p.SpacePresetId,
                    Name = p.Name,
                    CoffeeType = p.CoffeeType,
                    Preparation = p.Preparation,
                    Grams = (int)p.DefaultGrams,
                    Description = p.Description,
                    IsFavorite = p.IsFavorite,
                    IsGlobal = p.IsGlobal,
                    DisplayOrder = p.DisplayOrder
                }).ToList();
            }
        }
        catch
        {
            // Presets are optional context; the dropdown will fall back to UserChooses + Custom
        }
    }

    private void ShowQrModal(StockLevelDto stockLevel)
    {
        selectedQrStockLevel = stockLevel;
        showQrModal = true;
    }

    // Bags of the product the QR modal is open for, so the modal can offer a bind-to-bag picker.
    private List<StockPurchaseDto>? BagsForSelectedQr()
    {
        if (selectedQrStockLevel == null) return null;
        return purchases
            .Where(p =>
                string.Equals(p.ProductName, selectedQrStockLevel.ProductName, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(p.ProductBrand, selectedQrStockLevel.ProductBrand, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(p.ProductType, selectedQrStockLevel.ProductType, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void HandleQrModalClose()
    {
        showQrModal = false;
        selectedQrStockLevel = null;
        createdQrCodeId = null;
    }

    private async Task HandleQrCreate(QrCodeModal.QrCodeCreateModel model)
    {
        if (selectedQrStockLevel == null) return;

        try
        {
            var result = await Mediator.Send(new CreateActiveQrCodeCommand(
                Guid.Parse(SpaceId),
                model.Label,
                selectedQrStockLevel.ProductName,
                selectedQrStockLevel.ProductBrand,
                selectedQrStockLevel.ProductType,
                model.RecipeName,
                model.DefaultGrams,
                model.StockLotId));

            if (result.IsSuccess)
            {
                createdQrCodeId = result.Value.Id;
                await LoadActiveQrCodes();
                StateHasChanged();
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to create QR code: {ex.Message}");
        }
    }

    private async Task HandleReassignQr(ActiveQrCodesSection.ReassignModel model)
    {
        try
        {
            var result = await Mediator.Send(new ReassignActiveQrCodeCommand(
                model.QrCodeId,
                model.ProductName,
                model.ProductBrand,
                model.ProductType,
                model.RecipeName,
                model.DefaultGrams));

            if (result.IsSuccess)
            {
                // The scan payload (product/recipe) changed; drop any cached resolution.
                QrResolveCache.Remove(model.QrCodeId);
                ShowToast(false, "Success", "QR code reassigned successfully!");
                await LoadActiveQrCodes();
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to reassign QR code: {ex.Message}");
        }
    }

    private async Task HandleRenameQr(ActiveQrCodesSection.RenameModel model)
    {
        try
        {
            var result = await Mediator.Send(new RenameActiveQrCodeCommand(model.QrCodeId, model.Label));

            if (result.IsSuccess)
            {
                // The scan payload label changed; drop any cached resolution.
                QrResolveCache.Remove(model.QrCodeId);
                ShowToast(false, "Success", "QR code renamed successfully!");
                await LoadActiveQrCodes();
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to rename QR code: {ex.Message}");
        }
    }

    private async Task HandleDeactivateQr(Guid qrCodeId)
    {
        try
        {
            var result = await Mediator.Send(new DeactivateActiveQrCodeCommand(qrCodeId));

            if (result.IsSuccess)
            {
                QrResolveCache.Remove(qrCodeId);
                ShowToast(false, "Success", "QR code deactivated.");
                await LoadActiveQrCodes();
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to deactivate QR code: {ex.Message}");
        }
    }

    private void HandleShowExistingQr(Guid qrCodeId)
    {
        var activeQr = activeQrCodes.FirstOrDefault(q => q.Id == qrCodeId);
        if (activeQr != null)
        {
            selectedQrStockLevel = stockLevels.FirstOrDefault(s =>
                s.ProductName == activeQr.ProductName &&
                s.ProductBrand == activeQr.ProductBrand);
            if (selectedQrStockLevel == null)
            {
                selectedQrStockLevel = new StockLevelDto
                {
                    Id = Guid.Empty,
                    ProductName = activeQr.ProductName,
                    ProductBrand = activeQr.ProductBrand,
                    ProductType = activeQr.ProductType,
                    ProductDisplayName = activeQr.ProductDisplayName,
                    TotalPurchasedGrams = 0,
                    TotalConsumedGrams = 0,
                    CurrentStockGrams = 0,
