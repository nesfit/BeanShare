@page "/spaces/{SpaceId}/billing"
@rendermode InteractiveServer
@using MediatR
@using BeanShare.Application.Common
@using BeanShare.Application.Features.Billing.Queries.GetSpaceBillingPeriods
@using BeanShare.Application.Features.Billing.Commands.CreateBillingPeriod
@using BeanShare.Application.Features.Billing.Commands.DeleteBillingPeriod
@using BeanShare.Application.Features.Billing.Dtos
@using BeanShare.Application.Features.History.Dtos
@using BeanShare.Application.Features.History.Queries.PreviewHistoryImport
@using BeanShare.Application.Features.History.Queries.GetSpaceHistory
@using BeanShare.Application.Features.History.Commands.CommitHistoryImport
@using BeanShare.Application.Features.History.Commands.DeleteHistoryImport
@using BeanShare.SharedUi.Components.Billing
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IScopedSender Mediator
@inject NavigationManager Navigation
@inject BeanShare.Application.Abstractions.IUserContext UserContext

<PageTitle>Billing Periods - BeanShare</PageTitle>

<div style="position: sticky; top: 0; z-index: 10; background: var(--bs-background-light); border-bottom: 1px solid var(--bs-border); padding: 1rem 0;">
    <div class="bs-container">
        <div class="bs-flex bs-items-center bs-justify-between" style="margin-bottom: 1rem;">
            <button class="bs-btn bs-btn-sm bs-btn-ghost" aria-label="Back to spaces" @onclick='@(() => Navigation.NavigateTo("/spaces"))'>
                <span class="material-symbols-outlined">arrow_back</span>
            </button>
            <h1 class="bs-font-bold" style="margin: 0; font-size: 1.25rem;">Billing Periods</h1>
            <div style="width: 2rem;"></div>
        </div>
        <SpaceTabs SpaceId="@SpaceId" ActiveTab="billing" PreventNavigation="false" ShowBalances="true" />
    </div>
</div>

<div class="bs-container" style="padding: 2rem 0;">
    @if (isLoading)
    {
        <div style="text-align: center; padding: 2rem;">
            <div class="bs-skeleton" style="width: 100%; height: 6rem; margin-bottom: 1rem;"></div>
            <div class="bs-skeleton" style="width: 100%; height: 6rem; margin-bottom: 1rem;"></div>
            <div class="bs-skeleton" style="width: 100%; height: 6rem;"></div>
        </div>
    }
    else if (periods == null || !periods.Any())
    {
        <div style="text-align: center; padding: 4rem 2rem;">
            <span class="material-symbols-outlined" style="font-size: 4rem; color: var(--bs-text-subtle); margin-bottom: 1rem;">calendar_month</span>
            <h2 style="margin: 0 0 0.5rem 0; font-size: 1.25rem; font-weight: 600;">No Billing Periods Yet</h2>
            <p class="bs-text-subtle" style="margin-bottom: 2rem;">Create your first billing period to start tracking coffee costs.</p>
            <button class="bs-btn bs-btn-primary" @onclick="() => showCreateModal = true">
                <span class="material-symbols-outlined">add_circle</span>
                Create Billing Period
            </button>
        </div>
    }
    else
    {
        <div style="margin-bottom: 1rem;">
            <button class="bs-btn bs-btn-primary" @onclick="() => showCreateModal = true">
                <span class="material-symbols-outlined">add_circle</span>
                Create Billing Period
            </button>
            @if (isAdmin)
            {
                <button class="bs-btn bs-btn-secondary" @onclick="OpenImport">
                    <span class="material-symbols-outlined">history</span>
                    Import history
                </button>
            }
        </div>

        <div class="bs-flex bs-items-center bs-gap-4" style="flex-wrap: wrap; margin-bottom: 1.25rem; font-size: 0.75rem; color: var(--bs-text-subtle);">
            <span style="font-weight: 600;">Lifecycle:</span>
            <span class="bs-flex bs-items-center" style="gap: 0.35rem;"><span class="bs-badge bs-badge-secondary">Draft</span> being set up</span>
            <span class="bs-flex bs-items-center" style="gap: 0.35rem;"><span class="bs-badge bs-badge-success">Open</span> collecting cups</span>
            <span class="bs-flex bs-items-center" style="gap: 0.35rem;"><span class="bs-badge bs-badge-warning">Closed</span> locked for settlement</span>
            <span class="bs-flex bs-items-center" style="gap: 0.35rem;"><span class="bs-badge bs-badge-primary">Settled</span> paid out</span>
        </div>

        <div class="bs-flex bs-flex-col bs-gap-4">
            @foreach (var period in periods)
            {
                <div class="bs-card" style="padding: 1.5rem; cursor: pointer; transition: all 0.2s;" role="button" tabindex="0" @onclick="() => HandlePeriodSelected(period.Id)" @onkeydown="@(e => HandlePeriodKey(e, period.Id))">
                    <div class="bs-flex bs-items-start bs-justify-between" style="margin-bottom: 1rem;">
                        <div>
                            <h3 style="margin: 0 0 0.25rem 0; font-size: 1.125rem; font-weight: 600;">@period.Name</h3>
                            <p class="bs-text-subtle" style="font-size: 0.875rem; margin: 0;">
                                @period.FormattedDateRange
                            </p>
                        </div>
                        <div class="bs-flex bs-items-center" style="gap: 0.5rem;">
                            @if (period.IsHistorical)
                            {
                                <span class="bs-badge bs-badge-secondary" title="Imported from the old spreadsheet; statistics only">Historical</span>
                            }
                            @if (period.State == "Draft" && isAdmin)
                            {
                                <button class="bs-btn bs-btn-sm bs-btn-ghost" aria-label="Delete draft period" title="Delete draft"
                                        @onclick="@(() => RequestDelete(period))" @onclick:stopPropagation="true">
                                    <span class="material-symbols-outlined" style="font-size: 1rem; color: var(--bs-error);">delete</span>
                                </button>
                            }
                            <span class="bs-badge @GetStateBadgeClass(period.State)">
                                @period.State
                            </span>
                        </div>
                    </div>

                    <div class="bs-flex bs-gap-4" style="margin-top: 1rem;">
                        <div>
                            <p class="bs-text-subtle" style="font-size: 0.75rem; margin: 0 0 0.25rem 0;">Consumption Entries</p>
                            <p style="font-size: 1.25rem; font-weight: 700; margin: 0;">@period.ConsumptionCount</p>
                        </div>
                        <div>
                            <p class="bs-text-subtle" style="font-size: 0.75rem; margin: 0 0 0.25rem 0;">Total Coffee</p>
                            <p style="font-size: 1.25rem; font-weight: 700; margin: 0;">@period.TotalCoffeeGrams.ToString("F0")g</p>
                        </div>
                        @if (period.State == "Open")
                        {
                            <div>
                                <p class="bs-text-subtle" style="font-size: 0.75rem; margin: 0 0 0.25rem 0;">Days Remaining</p>
                                @if (period.IsOpenEnded)
                                {
                                    <p style="font-size: 1.25rem; font-weight: 700; margin: 0;">Open-ended</p>
                                }
                                else
                                {
                                    <p style="font-size: 1.25rem; font-weight: 700; margin: 0;">@period.DaysRemaining days</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<ConfirmDialog IsVisible="@showDeleteConfirm"
               Title="Delete this draft period?"
               Message="@DeleteMessage"
               ConfirmText="Delete"
               IsDestructive="true"
               IsProcessing="@isDeleting"
               OnConfirm="ConfirmDelete"
               OnCancel="@(() => showDeleteConfirm = false)" />

@if (showImportModal)
{
    <div class="bs-modal-backdrop" @onclick="CloseImport">
        <div class="bs-modal" style="max-width: 48rem;" @onclick:stopPropagation="true" @ontouchend:stopPropagation="true">
            <div class="bs-modal-header">
                <h3 class="bs-modal-title">Import history</h3>
            </div>
            <div class="bs-flex bs-flex-col" style="gap: 1rem;">
                <p class="bs-text-subtle" style="font-size: 0.8125rem; margin: 0;">
                    Statistics only: imported periods never change balances, and they must end before the ledger start date.
                </p>
                <div class="bs-flex bs-flex-col" style="gap: 0.35rem;">
                    <label for="historyCups" class="bs-text-subtle" style="font-size: 0.8125rem; font-weight: 500;">Cups: period;start;end;member;cups (dates yyyy-MM-dd)</label>
                    <textarea id="historyCups" class="bs-input" rows="6" style="font-family: monospace;" maxlength="@MaxPasteLength" @bind="historyCups" @bind:after="InvalidateImportPreview"></textarea>
                    @if (historyCups.Length >= MaxPasteLength)
                    {
                        <p style="margin: 0; font-size: 0.75rem; color: var(--bs-error, #ef4444);">The text reached the limit and may be cut; paste fewer rows.</p>
                    }
                </div>
                <div class="bs-flex bs-flex-col" style="gap: 0.35rem;">
                    <label for="historyPurchases" class="bs-text-subtle" style="font-size: 0.8125rem; font-weight: 500;">Purchases (optional): period;date;paidBy;description;grams;cost</label>
                    <textarea id="historyPurchases" class="bs-input" rows="4" style="font-family: monospace;" maxlength="@MaxPasteLength" @bind="historyPurchases" @bind:after="InvalidateImportPreview"></textarea>
                    @if (historyPurchases.Length >= MaxPasteLength)
                    {
                        <p style="margin: 0; font-size: 0.75rem; color: var(--bs-error, #ef4444);">The text reached the limit and may be cut; paste fewer rows.</p>
                    }
                </div>
                <div class="bs-flex bs-flex-col" style="gap: 0.35rem;">
                    <label for="historyNote" class="bs-text-subtle" style="font-size: 0.8125rem; font-weight: 500;">Note (optional)</label>
                    <input id="historyNote" type="text" class="bs-input" maxlength="500" @bind="historyNote" />
                </div>
                <label class="bs-flex bs-items-center" style="gap: 0.5rem; font-size: 0.875rem;">
                    <input type="checkbox" @bind="historyCreatePlaceholders" @bind:after="InvalidateImportPreview" />
                    Create unknown members as placeholders
                </label>

                @if (importPreview != null)
                {
                    @foreach (var error in importPreview.Errors)
                    {
                        <div style="color: var(--bs-error);">@error</div>
                    }
                    @foreach (var row in importPreview.RowErrors)
                    {
                        <div style="color: var(--bs-error); font-size: 0.8125rem;">@row.Block line @row.LineNumber: @string.Join("; ", row.Errors)</div>
                    }
                    <p style="margin: 0; font-size: 0.875rem;">
                        @importPreview.Periods.Count period(s)@(importPreview.FirstStart is { } first ? $" from {first:yyyy-MM-dd} to {importPreview.LastEnd:yyyy-MM-dd}" : ""),
                        @importPreview.TotalCups cups, @importPreview.TotalCost.ToString("0.00") @importPreview.Currency.
                        @if (importPreview.PlaceholdersToCreate.Count > 0)
                        {
                            <br /><span>New placeholder members: @string.Join(", ", importPreview.PlaceholdersToCreate).</span>
                        }
                    </p>
                    <div style="overflow-x: auto; max-height: 14rem;">
                        <table style="width: 100%; border-collapse: collapse; font-size: 0.8125rem;">
                            <thead>
                                <tr style="color: var(--bs-text-subtle); text-align: left;">
                                    <th style="padding: 0.25rem 0.5rem 0.25rem 0;">Period</th>
                                    <th style="padding: 0.25rem 0.5rem;">Dates</th>
                                    <th style="padding: 0.25rem 0.5rem; text-align: right;">Cups</th>
                                    <th style="padding: 0.25rem 0; text-align: right;">Cost</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in importPreview.Periods)
                                {
                                    <tr style="border-top: 1px solid var(--bs-border);">
                                        <td style="padding: 0.25rem 0.5rem 0.25rem 0;">@p.Label</td>
                                        <td style="padding: 0.25rem 0.5rem;">@p.StartDate.ToString("yyyy-MM-dd") – @p.EndDate.ToString("yyyy-MM-dd")</td>
                                        <td style="padding: 0.25rem 0.5rem; text-align: right;">@p.Cups</td>
                                        <td style="padding: 0.25rem 0; text-align: right;">@p.Cost.ToString("0.00")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (history is { Imports.Count: > 0 })
                {
                    <div>
                        <div class="bs-text-subtle" style="font-size: 0.8125rem; font-weight: 600; margin-bottom: 0.25rem;">Earlier imports</div>
                        @foreach (var imp in history.Imports)
                        {
                            <div class="bs-flex bs-items-center bs-justify-between" style="font-size: 0.8125rem; padding: 0.25rem 0; border-top: 1px solid var(--bs-border);">
                                <span>@imp.ImportedAt.ToString("yyyy-MM-dd") by @imp.ImportedByName: @imp.PeriodCount period(s), @imp.Cups cups@(string.IsNullOrEmpty(imp.Note) ? "" : $" ({imp.Note})")</span>
                                <button class="bs-btn bs-btn-sm bs-btn-ghost" title="Delete this import" @onclick="@(() => DeleteImport(imp.Id))" disabled="@isImporting">
                                    <span class="material-symbols-outlined" style="font-size: 1rem; color: var(--bs-error);">delete</span>
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="bs-hero-actions">
                <button type="button" class="bs-btn bs-btn-primary bs-btn-hero" @onclick="CommitImport" disabled="@(isImporting || importPreview?.CanCommit != true)">@(isImporting ? "Importing..." : "Import")</button>
                <button type="button" class="bs-btn bs-btn-secondary" @onclick="PreviewImport" disabled="@(isImporting || string.IsNullOrWhiteSpace(historyCups))">Preview</button>
                <button type="button" class="bs-btn bs-btn-quiet" @onclick="CloseImport">Close</button>
            </div>
        </div>
    </div>
}

<CreateBillingPeriodModal IsVisible="@showCreateModal"
                          OnSubmit="HandleCreateBillingPeriod"
                          OnCancel="@(() => showCreateModal = false)" />

<Toast IsVisible="@showToast"
       IsError="@isToastError"
       Title="@toastTitle"
       Message="@toastMessage"
       OnClose="@(() => showToast = false)" />

@code {
    [Parameter]
    public string SpaceId { get; set; } = "";

    private List<BillingPeriodSummaryDto>? periods;
    private bool isLoading = true;
    private bool showCreateModal = false;
    private bool showToast;
    private bool isToastError;
    private string toastTitle = "";
    private string toastMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadAdmin();
        await LoadBillingPeriods();
    }

    private bool isAdmin;

    private async Task LoadAdmin()
    {
        var result = await Mediator.Send(new BeanShare.Application.Features.Spaces.Queries.GetSpaceByIdQuery(Guid.Parse(SpaceId)));
        if (result.IsSuccess)
            isAdmin = result.Value.Members.Any(m => m.UserId == UserContext.CurrentUserId.Value && m.Role == "Admin");
    }

    // ---- history import ----

    private const int MaxPasteLength = PasteLimits.MaxLength;
    private bool showImportModal;
    private string historyCups = "";
    private string historyPurchases = "";
    private string historyNote = "";
    private bool historyCreatePlaceholders;
    private bool isImporting;
    private HistoryImportPreviewDto? importPreview;
    private SpaceHistoryDto? history;

    private async Task OpenImport()
    {
        historyCups = "";
        historyPurchases = "";
        historyNote = "";
        historyCreatePlaceholders = false;
        importPreview = null;
        showImportModal = true;
        await LoadHistory();
    }

    private void CloseImport() => showImportModal = false;

    private void InvalidateImportPreview() => importPreview = null;

    private async Task LoadHistory()
    {
        var result = await Mediator.Send(new GetSpaceHistoryQuery(Guid.Parse(SpaceId)));
        history = result.IsSuccess ? result.Value : null;
    }

    private async Task PreviewImport()
    {
        isImporting = true;
        try
        {
            var result = await Mediator.Send(new PreviewHistoryImportQuery(Guid.Parse(SpaceId), historyCups, historyPurchases, historyCreatePlaceholders));
            if (result.IsSuccess)
                importPreview = result.Value;
            else
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
        }
        finally
        {
            isImporting = false;
        }
    }

    private async Task CommitImport()
    {
        if (importPreview?.CanCommit != true)
            return;

        isImporting = true;
        try
        {
            var result = await Mediator.Send(new CommitHistoryImportCommand(
                Guid.Parse(SpaceId), historyCups, historyPurchases, historyNote, historyCreatePlaceholders));
            if (result.IsSuccess)
            {
                showImportModal = false;
                ShowToast(false, "Imported", $"{result.Value.PeriodCount} historical period(s) with {result.Value.TotalCups} cups imported.");
                await LoadBillingPeriods();
            }
            else
            {
                importPreview = null;
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        finally
        {
            isImporting = false;
        }
    }

    private async Task DeleteImport(Guid importId)
    {
        isImporting = true;
        try
        {
            var result = await Mediator.Send(new DeleteHistoryImportCommand(Guid.Parse(SpaceId), importId));
            if (result.IsSuccess)
            {
                ShowToast(false, "Deleted", "The history import was deleted.");
                await LoadHistory();
                await LoadBillingPeriods();
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        finally
        {
            isImporting = false;
        }
    }

    private async Task LoadBillingPeriods()
    {
        isLoading = true;
        try
        {
            var query = new GetSpaceBillingPeriodsQuery(Guid.Parse(SpaceId));
            var result = await Mediator.Send(query);

            if (result.IsSuccess)
            {
                periods = result.Value;
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load billing periods: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool showDeleteConfirm;
    private bool isDeleting;
    private BillingPeriodSummaryDto? deletePeriod;

    private string DeleteMessage =>
        $"{deletePeriod?.Name} has not been opened yet, so nothing is lost but the period itself.";

    private void RequestDelete(BillingPeriodSummaryDto period)
    {
        deletePeriod = period;
        showDeleteConfirm = true;
    }

    private async Task ConfirmDelete()
    {
        if (deletePeriod == null)
        {
            showDeleteConfirm = false;
            return;
        }

        isDeleting = true;
        try
        {
            var result = await Mediator.Send(new DeleteBillingPeriodCommand(deletePeriod.Id));
            if (result.IsSuccess)
            {
                ShowToast(false, "Deleted", $"Billing period '{deletePeriod.Name}' deleted.");
            }
            else if (result.Errors.Any(e => e.Code == Error.Codes.ConcurrencyConflict))
            {
                ShowToast(true, "Changed meanwhile", "The billing periods changed in the meantime and were reloaded.");
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
            await LoadBillingPeriods();
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to delete billing period: {ex.Message}");
        }
        finally
        {
            isDeleting = false;
            showDeleteConfirm = false;
            deletePeriod = null;
        }
    }

    private void HandlePeriodSelected(Guid periodId)
    {
        Navigation.NavigateTo($"/spaces/{SpaceId}/billing/{periodId}");
    }

    private void HandlePeriodKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, Guid periodId)
    {
        if (e.Key == "Enter" || e.Key == " " || e.Key == "Spacebar")
        {
            HandlePeriodSelected(periodId);
        }
    }

    private async Task HandleCreateBillingPeriod(CreateBillingPeriodModal.CreateBillingPeriodModel model)
    {
        try
        {
            var command = new CreateBillingPeriodCommand(
                Guid.Parse(SpaceId),
                model.Name,
                model.StartDate.ToUniversalTime(),
                model.IsOpenEnded ? null : model.EndDate.ToUniversalTime()
            );

            var result = await Mediator.Send(command);

            if (result.IsSuccess)
            {
                showCreateModal = false;
                ShowToast(false, "Success", $"Billing period '{model.Name}' created successfully!");
                await LoadBillingPeriods();
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to create billing period: {ex.Message}");
        }
    }

    private string GetStateBadgeClass(string state)
    {
        return state switch
        {
            "Draft" => "bs-badge-secondary",
            "Open" => "bs-badge-success",
            "Closed" => "bs-badge-warning",
            "Settled" => "bs-badge-primary",
            _ => "bs-badge-secondary"
        };
    }

    private void ShowToast(bool isError, string title, string message)
    {
        isToastError = isError;
        toastTitle = title;
        toastMessage = message;
        showToast = true;
    }
}
