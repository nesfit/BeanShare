@page "/spaces/{SpaceId}/analytics"
@rendermode InteractiveServer
@using MediatR
@using BeanShare.Application.Common
@using BeanShare.Application.Features.Analytics.Queries.GetSpaceAnalytics
@using BeanShare.SharedUi.Components.Analytics
@using BeanShare.SharedUi.Components.Common
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IScopedSender Mediator
@inject NavigationManager Navigation

<PageTitle>Analytics - BeanShare</PageTitle>

<div style="position: sticky; top: 0; z-index: 10; background: var(--bs-background-light); border-bottom: 1px solid var(--bs-border); padding: 1rem 0;">
    <div class="bs-container">
        <div class="bs-flex bs-items-center bs-justify-between" style="margin-bottom: 1rem;">
            <button class="bs-btn bs-btn-sm bs-btn-ghost" aria-label="Back to spaces" @onclick='@(() => Navigation.NavigateTo("/spaces"))'>
                <span class="material-symbols-outlined">arrow_back</span>
            </button>
            <h1 class="bs-font-bold" style="margin: 0; font-size: 1.25rem;">Analytics</h1>
            <div style="width: 2rem;"></div>
        </div>
        <SpaceTabs SpaceId="@SpaceId" ActiveTab="analytics" PreventNavigation="false" ShowBalances="true" />
    </div>
</div>

<div class="bs-container" style="padding: 2rem 0;">
    <div class="bs-flex bs-items-center bs-justify-between" style="margin-bottom: 1.25rem; gap: 1rem; flex-wrap: wrap;">
        <h2 class="bs-font-bold" style="margin: 0; font-size: 1.15rem;">Space insights</h2>
        <label class="bs-flex bs-items-center" style="gap: 0.5rem; font-size: 0.875rem; color: var(--bs-text-subtle);">
            Period
            <select class="bs-input" style="width: auto; padding: 0.4rem 0.6rem;" @bind="rangeDays" @bind:after="LoadAnalytics">
                <option value="30">Last 30 days</option>
                <option value="90">Last 90 days</option>
                <option value="365">Last 12 months</option>
                <option value="3650">All time</option>
            </select>
        </label>
    </div>

    <SpaceAnalytics Analytics="@spaceAnalytics"
                   IsLoading="@isLoading" />

    @if (history is { Periods.Count: > 0 })
    {
        <div class="bs-card" style="padding: 1.5rem; margin-top: 1.5rem;">
            <h3 style="margin: 0 0 0.25rem 0; font-size: 1.05rem; font-weight: 600;">History</h3>
            <p class="bs-text-subtle" style="margin: 0 0 1rem 0; font-size: 0.8125rem;">
                @history.Periods.Count imported period(s) up to @history.HistoryEnd?.ToString("yyyy-MM-dd"), plus cups logged in BeanShare since.
            </p>
            <div class="bs-flex bs-gap-4" style="flex-wrap: wrap; align-items: flex-start;">
                <div style="flex: 1; min-width: 16rem;">
                    <div class="bs-text-subtle" style="font-size: 0.75rem; font-weight: 600; margin-bottom: 0.25rem;">ALL-TIME CUPS</div>
                    @foreach (var member in history.MemberCups)
                    {
                        <div class="bs-flex bs-justify-between" style="padding: 0.25rem 0; border-top: 1px solid var(--bs-border); font-size: 0.875rem;">
                            <span>@member.UserName</span>
                            <span style="font-weight: 600;" title="@($"{member.HistoricalCups} from the spreadsheet, {member.LiveCups} in BeanShare")">@member.TotalCups</span>
                        </div>
                    }
                </div>
                <div style="flex: 1; min-width: 12rem;">
                    <div class="bs-text-subtle" style="font-size: 0.75rem; font-weight: 600; margin-bottom: 0.25rem;">COFFEE BOUGHT PER YEAR</div>
                    @foreach (var year in history.Years)
                    {
                        <div class="bs-flex bs-justify-between" style="padding: 0.25rem 0; border-top: 1px solid var(--bs-border); font-size: 0.875rem;">
                            <span>@year.Year</span>
                            <span style="font-weight: 600;">@year.Cost.ToString("0.00") @history.Currency</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<Toast IsVisible="@showToast" IsError="true" Title="Error" Message="@toastMessage" OnClose="@(() => showToast = false)" />

@code {
    [Parameter]
    public string SpaceId { get; set; } = "";

    private SpaceAnalyticsDto? spaceAnalytics;
    private BeanShare.Application.Features.History.Dtos.SpaceHistoryDto? history;
    private bool isLoading = true;
    private int rangeDays = 30;

    private bool showToast;
    private string toastMessage = "";

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(SpaceId))
        {
            await LoadAnalytics();
            var historyResult = await Mediator.Send(new BeanShare.Application.Features.History.Queries.GetSpaceHistory.GetSpaceHistoryQuery(Guid.Parse(SpaceId)));
            history = historyResult.IsSuccess ? historyResult.Value : null;
        }
    }

    private async Task LoadAnalytics()
    {
        isLoading = true;
        try
        {
            var result = await Mediator.Send(new GetSpaceAnalyticsQuery(
                new BeanShare.Domain.ValueObjects.SpaceId(Guid.Parse(SpaceId)),
                DateTime.UtcNow.AddDays(-rangeDays),
                DateTime.UtcNow
            ));
            spaceAnalytics = result;
        }
        catch (Exception ex)
        {
            spaceAnalytics = null;
            toastMessage = $"Couldn't load analytics: {ex.Message}";
            showToast = true;
        }
        finally
        {
            isLoading = false;
        }
    }
}
