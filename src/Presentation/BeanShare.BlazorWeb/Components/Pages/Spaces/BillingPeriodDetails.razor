@page "/spaces/{SpaceId}/billing/{PeriodId}"
@rendermode InteractiveServer
@using MediatR
@using BeanShare.Application.Common
@using BeanShare.Application.Features.Billing.Queries.GetBillingPeriodById
@using BeanShare.Application.Features.Billing.Commands.OpenBillingPeriod
@using BeanShare.Application.Features.Billing.Commands.CloseBillingPeriod
@using BeanShare.Application.Features.Settlement.Commands.GenerateSettlement
@using BeanShare.Application.Features.Settlement.Queries.GetSpaceSettlements
@using BeanShare.Application.Features.Billing.Commands.ReopenBillingPeriod
@using BeanShare.Application.Features.Billing.Commands.DeleteBillingPeriod
@using BeanShare.Application.Features.Settlement.Queries.GetSettlementPreview
@using BeanShare.Application.Features.Settlement.Dtos
@using BeanShare.Application.Features.Billing.Dtos
@using BeanShare.Domain.ValueObjects
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IScopedSender Mediator
@inject NavigationManager Navigation

<PageTitle>@(period?.Name ?? "Billing Period") - BeanShare</PageTitle>

<div style="position: sticky; top: 0; z-index: 10; background: var(--bs-background-light); border-bottom: 1px solid var(--bs-border); padding: 1rem 0;">
    <div class="bs-container">
        <div class="bs-flex bs-items-center bs-justify-between" style="margin-bottom: 1rem;">
            <button class="bs-btn bs-btn-sm bs-btn-ghost" aria-label="Back to billing periods" @onclick='@(() => Navigation.NavigateTo($"/spaces/{SpaceId}/billing"))'>
                <span class="material-symbols-outlined">arrow_back</span>
            </button>
            <h1 class="bs-font-bold" style="margin: 0; font-size: 1.25rem;">@(period?.Name ?? "Loading...")</h1>
            <div style="width: 2rem;"></div>
        </div>
    </div>
</div>

<div class="bs-container" style="padding: 2rem 0;">
    @if (isLoading)
    {
        <div style="text-align: center; padding: 2rem;">
            <div class="bs-skeleton" style="width: 100%; height: 10rem; margin-bottom: 1rem;"></div>
            <div class="bs-skeleton" style="width: 100%; height: 6rem;"></div>
        </div>
    }
    else if (period == null)
    {
        <div style="text-align: center; padding: 4rem 2rem;">
            <span class="material-symbols-outlined" style="font-size: 4rem; color: var(--bs-text-subtle); margin-bottom: 1rem;">error</span>
            <h2 style="margin: 0 0 0.5rem 0; font-size: 1.25rem; font-weight: 600;">Period Not Found</h2>
            <p class="bs-text-subtle">The billing period you're looking for doesn't exist.</p>
        </div>
    }
    else
    {
        <!-- Period Header -->
        <div class="bs-card" style="padding: 2rem; margin-bottom: 1.5rem;">
            <div class="bs-flex bs-items-start bs-justify-between" style="margin-bottom: 1.5rem;">
                <div>
                    <span class="bs-badge @GetStateBadgeClass(period.State)">
                        @period.State
                    </span>
                    <h2 style="margin: 1rem 0 0.5rem 0; font-size: 1.5rem; font-weight: 700;">@period.Name</h2>
                    <p class="bs-text-subtle" style="margin: 0;">
                        @period.FormattedDateRangeLong
                    </p>
                </div>
            </div>

            <!-- KPIs -->
            <div class="bs-flex bs-gap-4" style="margin-bottom: 1.5rem; flex-wrap: wrap;">
                <div class="bs-flex-1" style="min-width: 200px;">
                    <p class="bs-text-subtle" style="font-size: 0.875rem; margin: 0 0 0.5rem 0;">Consumption Entries</p>
                    <p style="font-size: 2rem; font-weight: 700; margin: 0; color: var(--bs-primary);">@period.ConsumptionCount</p>
                </div>
                <div class="bs-flex-1" style="min-width: 200px;">
                    <p class="bs-text-subtle" style="font-size: 0.875rem; margin: 0 0 0.5rem 0;">Total Coffee</p>
                    <p style="font-size: 2rem; font-weight: 700; margin: 0; color: var(--bs-success);">@period.TotalCoffeeGrams.ToString("F0")g</p>
                </div>
                @if (period.EstimatedCost.HasValue)
                {
                    <div class="bs-flex-1" style="min-width: 200px;">
                        <p class="bs-text-subtle" style="font-size: 0.875rem; margin: 0 0 0.5rem 0;">Estimated Cost</p>
                        <p style="font-size: 2rem; font-weight: 700; margin: 0; color: var(--bs-warning);">@period.Currency @period.EstimatedCost.Value.ToString("F2")</p>
                    </div>
                }
            </div>

            <!-- Action Buttons -->
            <div class="bs-flex bs-gap-3">
                @if (period.IsHistorical)
                {
                    <p class="bs-text-subtle" style="margin: 0;">Imported from the old spreadsheet: statistics only, never part of a settlement.</p>
                }
                else if (period.State == "Draft")
                {
                    <button class="bs-btn bs-btn-primary" @onclick="HandleOpenPeriod" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span>Opening...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined">play_circle</span>
                            <span>Open Period</span>
                        }
                    </button>
                    <button class="bs-btn bs-btn-secondary" @onclick="RequestDelete" disabled="@isProcessing">
                        <span class="material-symbols-outlined">delete</span>
                        <span>Delete</span>
                    </button>
                }
                else if (period.State == "Open")
                {
                    <button class="bs-btn bs-btn-secondary" @onclick="RequestClose" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span>Closing...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined">lock</span>
                            <span>Close Period</span>
                        }
                    </button>
                }
                else if (period.State == "Closed" && !period.SettledAt.HasValue)
                {
                    <button class="bs-btn bs-btn-primary" @onclick="RequestGenerate" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span>Generating...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined">receipt_long</span>
                            <span>Generate Settlement</span>
                        }
                    </button>
                    <button class="bs-btn bs-btn-secondary" @onclick="RequestReopen" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span>Reopening...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined">lock_open</span>
                            <span>Reopen</span>
                        }
                    </button>
                }
                else if (period.State == "Settled" || period.SettledAt.HasValue)
                {
                    <button class="bs-btn bs-btn-primary" @onclick="ViewSettlement">
                        <span class="material-symbols-outlined">visibility</span>
                        <span>View Settlement</span>
                    </button>
                }
            </div>
        </div>

        @if (historicalPeriod != null)
        {
            <div class="bs-card" style="padding: 2rem; margin-bottom: 1.5rem;">
                <h3 style="margin: 0 0 1rem 0; font-size: 1.25rem; font-weight: 600;">Cups (@historicalPeriod.TotalCups)</h3>
                @foreach (var cups in historicalPeriod.Cups)
                {
                    <div class="bs-flex bs-justify-between" style="padding: 0.25rem 0; border-top: 1px solid var(--bs-border);">
                        <span>@cups.UserName</span>
                        <span style="font-weight: 600;">@cups.Cups</span>
                    </div>
                }
                @if (historicalPeriod.Purchases.Count > 0)
                {
                    <h3 style="margin: 1.5rem 0 1rem 0; font-size: 1.25rem; font-weight: 600;">Purchases (@historicalPeriod.TotalCost.ToString("0.00") @period.Currency)</h3>
                    @foreach (var purchase in historicalPeriod.Purchases)
                    {
                        <div class="bs-flex bs-justify-between" style="padding: 0.25rem 0; border-top: 1px solid var(--bs-border); gap: 1rem;">
                            <span>@(purchase.PurchasedAt?.ToString("yyyy-MM-dd") ?? "undated") · @(purchase.Description)@(purchase.PaidByName is { } payer ? $" · paid by {payer}" : "")</span>
                            <span style="font-weight: 600; white-space: nowrap;">@purchase.Cost.ToString("0.00")</span>
                        </div>
                    }
                }
            </div>
        }

        <!-- Timeline -->
        <div class="bs-card" style="padding: 2rem;">
            <h3 style="margin: 0 0 1.5rem 0; font-size: 1.25rem; font-weight: 600;">Timeline</h3>

            <div style="border-left: 2px solid var(--bs-border); padding-left: 1.5rem;">
                <div style="position: relative; margin-bottom: 2rem;">
                    <div style="position: absolute; left: -1.75rem; width: 1rem; height: 1rem; border-radius: 9999px; background: var(--bs-primary); border: 2px solid var(--bs-background-light);"></div>
                    <p style="font-weight: 600; margin: 0 0 0.25rem 0;">Created</p>
                    <p class="bs-text-subtle" style="font-size: 0.875rem; margin: 0;">
                        @period.CreatedAt.ToString("MMM dd, yyyy 'at' h:mm tt")
                    </p>
                </div>

                @if (period.OpenedAt.HasValue)
                {
                    <div style="position: relative; margin-bottom: 2rem;">
                        <div style="position: absolute; left: -1.75rem; width: 1rem; height: 1rem; border-radius: 9999px; background: var(--bs-success); border: 2px solid var(--bs-background-light);"></div>
                        <p style="font-weight: 600; margin: 0 0 0.25rem 0;">Opened</p>
                        <p class="bs-text-subtle" style="font-size: 0.875rem; margin: 0;">
                            @period.OpenedAt.Value.ToString("MMM dd, yyyy 'at' h:mm tt")
                        </p>
                    </div>
                }

                @if (period.ClosedAt.HasValue)
                {
                    <div style="position: relative; margin-bottom: 2rem;">
                        <div style="position: absolute; left: -1.75rem; width: 1rem; height: 1rem; border-radius: 9999px; background: var(--bs-warning); border: 2px solid var(--bs-background-light);"></div>
                        <p style="font-weight: 600; margin: 0 0 0.25rem 0;">Closed</p>
                        <p class="bs-text-subtle" style="font-size: 0.875rem; margin: 0;">
                            @period.ClosedAt.Value.ToString("MMM dd, yyyy 'at' h:mm tt")
                        </p>
                    </div>
                }

                @if (period.SettledAt.HasValue)
                {
                    <div style="position: relative;">
                        <div style="position: absolute; left: -1.75rem; width: 1rem; height: 1rem; border-radius: 9999px; background: var(--bs-primary); border: 2px solid var(--bs-background-light);"></div>
                        <p style="font-weight: 600; margin: 0 0 0.25rem 0;">Settled</p>
                        <p class="bs-text-subtle" style="font-size: 0.875rem; margin: 0;">
                            @period.SettledAt.Value.ToString("MMM dd, yyyy 'at' h:mm tt")
                        </p>
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (showGenerateModal)
{
    <div class="bs-modal-backdrop" @onclick="CloseGenerate">
        <div class="bs-modal" style="max-width: 44rem;" @onclick:stopPropagation="true" @ontouchend:stopPropagation="true">
            <div class="bs-modal-header">
                <h3 class="bs-modal-title">Generate settlement?</h3>
            </div>
            @if (isLoadingPreview)
            {
                <div class="bs-skeleton" style="width: 100%; height: 8rem;"></div>
            }
            else if (preview == null)
            {
                <p style="margin: 0 0 0.75rem 0;">@previewError</p>
                @if (previewNeedsTreasurer)
                {
                    <a class="bs-btn bs-btn-sm bs-btn-secondary" href="@($"/spaces/{SpaceId}/balances")">Set a treasurer in Balances</a>
                }
            }
            else
            {
                <p style="margin: 0 0 0.75rem 0;">Treasurer: <strong>@preview.TreasurerName</strong>. Every payment goes through the treasurer.</p>
                @if (preview.FallbackRateMissing)
                {
                    <div style="margin: 0 0 0.75rem 0; padding: 0.75rem; border-radius: 0.5rem; font-size: 0.8125rem; background: var(--bs-warning-light); color: var(--bs-warning-dark);">
                        Some cups have no bag price and there is no purchase to take an average price from, so they cost nothing in this settlement.
                        Record the missing purchases, or check the bags marked Paid in Excel on the Balances page, before generating.
                    </div>
                }
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.8125rem;">
                        <thead>
                            <tr style="color: var(--bs-text-subtle); text-align: right;">
                                <th style="text-align: left; padding: 0.25rem 0.5rem 0.25rem 0;">Member</th>
                                <th style="padding: 0.25rem 0.5rem;">Cost</th>
                                <th style="padding: 0.25rem 0.5rem;">Credit</th>
                                <th style="padding: 0.25rem 0.5rem;">Carried</th>
                                <th style="padding: 0.25rem 0.5rem;">Adj.</th>
                                @if (preview.Lines.Any(l => (l.Rounding ?? 0) != 0))
                                {
                                    <th style="padding: 0.25rem 0.5rem;">Rounding</th>
                                }
                                <th style="padding: 0.25rem 0 0.25rem 0.5rem;">Net</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in preview.Lines)
                            {
                                <tr style="border-top: 1px solid var(--bs-border); text-align: right; font-variant-numeric: tabular-nums;">
                                    <td style="text-align: left; padding: 0.375rem 0.5rem 0.375rem 0;">@line.UserName@(line.IsTreasurer ? " (treasurer)" : "")</td>
                                    <td style="padding: 0.375rem 0.5rem;">@line.AmountDue.ToString("F2")</td>
                                    <td style="padding: 0.375rem 0.5rem;">@((line.Credit ?? 0).ToString("F2"))</td>
                                    <td style="padding: 0.375rem 0.5rem;">@((line.CarriedIn ?? 0).ToString("F2"))</td>
                                    <td style="padding: 0.375rem 0.5rem;">@((line.Adjustments ?? 0).ToString("F2"))</td>
                                    @if (preview.Lines.Any(l => (l.Rounding ?? 0) != 0))
                                    {
                                        <td style="padding: 0.375rem 0.5rem;">@((line.Rounding ?? 0) != 0 ? (line.Rounding ?? 0).ToString("F2") : "")</td>
                                    }
                                    <td style="padding: 0.375rem 0 0.375rem 0.5rem; font-weight: 700;">@line.NetBalance.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (preview.Transfers.Count > 0)
                {
                    <div style="margin-top: 0.75rem; font-size: 0.8125rem;">
                        @foreach (var t in preview.Transfers)
                        {
                            <div>@t.FromName → @t.ToName: @preview.Currency @t.Amount.ToString("F2")</div>
                        }
                    </div>
                }
                <p class="bs-text-subtle" style="font-size: 0.8125rem; margin: 0.75rem 0 0 0;">
                    A settlement is final; corrections go in as balance entries.
                </p>
            }
            <div class="bs-hero-actions">
                <button type="button" class="bs-btn bs-btn-primary bs-btn-hero" @onclick="ConfirmGenerate" disabled="@(isProcessing || preview == null)">
                    @(isProcessing ? "Generating..." : "Generate settlement")
                </button>
                <button type="button" class="bs-btn bs-btn-quiet" @onclick="CloseGenerate">Cancel</button>
            </div>
        </div>
    </div>
}

<ConfirmDialog IsVisible="@showConfirm"
               Title="@confirmTitle"
               Message="@confirmMessage"
               ConfirmText="@confirmText"
               IsDestructive="@confirmDestructive"
               IsProcessing="@isProcessing"
               OnConfirm="ExecuteConfirm"
               OnCancel="@(() => showConfirm = false)" />

<Toast IsVisible="@showToast"
       IsError="@isToastError"
       Title="@toastTitle"
       Message="@toastMessage"
       OnClose="@(() => showToast = false)" />

@code {
    [Parameter]
    public string SpaceId { get; set; } = "";

    [Parameter]
    public string PeriodId { get; set; } = "";

    private BillingPeriodDto? period;
    private BeanShare.Application.Features.History.Dtos.HistoricalPeriodDto? historicalPeriod;
    private bool isLoading = true;
    private bool isProcessing = false;
    private bool showToast;
    private bool isToastError;
    private string toastTitle = "";
    private string toastMessage = "";

    private bool showConfirm;
    private string confirmTitle = "";
    private string confirmMessage = "";
    private string confirmText = "Confirm";
    private bool confirmDestructive;
    private Func<Task>? confirmCallback;

    private void RequestClose()
    {
        confirmTitle = "Close billing period?";
        confirmMessage = "Closing locks every consumption entry in this period so a settlement can be generated. You can reopen it later if you need to make changes.";
        confirmText = "Close period";
        confirmDestructive = false;
        confirmCallback = HandleClosePeriod;
        showConfirm = true;
    }

    private bool showGenerateModal;
    private bool isLoadingPreview;
    private SettlementPreviewDto? preview;
    private string previewError = "";
    private bool previewNeedsTreasurer;

    private async Task RequestGenerate()
    {
        showGenerateModal = true;
        await LoadPreview();
    }

    private async Task LoadPreview()
    {
        isLoadingPreview = true;
        preview = null;
        previewNeedsTreasurer = false;
        try
        {
            var result = await Mediator.Send(new GetSettlementPreviewQuery(Guid.Parse(PeriodId)));
            if (result.IsSuccess)
            {
                preview = result.Value;
            }
            else
            {
                previewNeedsTreasurer = result.Errors.Any(e => e.Code == Error.Codes.TreasurerRequired);
                previewError = string.Join(", ", result.Errors.Select(e => e.Message));
            }
        }
        catch (Exception ex)
        {
            previewError = $"Failed to preview the settlement: {ex.Message}";
        }
        finally
        {
            isLoadingPreview = false;
        }
    }

    private void CloseGenerate()
    {
        showGenerateModal = false;
        preview = null;
    }

    private async Task ConfirmGenerate()
    {
        await HandleGenerateSettlement();
    }

    private void RequestDelete()
    {
        confirmTitle = "Delete this draft period?";
        confirmMessage = "The period has not been opened yet, so nothing is lost but the period itself.";
        confirmText = "Delete";
        confirmDestructive = true;
        confirmCallback = HandleDeletePeriod;
        showConfirm = true;
    }

    private async Task HandleDeletePeriod()
    {
        isProcessing = true;
        try
        {
            var result = await Mediator.Send(new DeleteBillingPeriodCommand(Guid.Parse(PeriodId)));
            if (result.IsSuccess)
            {
                Navigation.NavigateTo($"/spaces/{SpaceId}/billing");
            }
            else if (IsConflict(result.Errors))
            {
                ShowToast(true, "Changed meanwhile", "This period changed in the meantime and was reloaded.");
                await LoadPeriod();
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to delete billing period: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private static bool IsConflict(IEnumerable<Error> errors) =>
        errors.Any(e => e.Code == Error.Codes.ConcurrencyConflict);

    private void RequestReopen()
    {
        confirmTitle = "Reopen billing period?";
        confirmMessage = "Reopening unlocks entries for editing. Any settlement already generated for this period may become out of date.";
        confirmText = "Reopen";
        confirmDestructive = true;
        confirmCallback = HandleReopenPeriod;
        showConfirm = true;
    }

    private async Task ExecuteConfirm()
    {
        showConfirm = false;
        if (confirmCallback != null)
        {
            await confirmCallback();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPeriod();
    }

    private async Task LoadPeriod()
    {
        isLoading = true;
        try
        {
            var query = new GetBillingPeriodByIdQuery(new BillingPeriodId(Guid.Parse(PeriodId)));
            var result = await Mediator.Send(query);

            if (result.IsSuccess)
            {
                period = result.Value;
                if (period.IsHistorical)
                {
                    var history = await Mediator.Send(new BeanShare.Application.Features.History.Queries.GetSpaceHistory.GetSpaceHistoryQuery(Guid.Parse(SpaceId)));
                    historicalPeriod = history.IsSuccess ? history.Value.Periods.FirstOrDefault(p => p.Id == period.Id) : null;
                }
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load billing period: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleOpenPeriod()
    {
        isProcessing = true;
        try
        {
            var command = new OpenBillingPeriodCommand(Guid.Parse(PeriodId));
            var result = await Mediator.Send(command);

            if (result.IsSuccess)
            {
                ShowToast(false, "Success", "Billing period opened successfully!");
                await LoadPeriod();
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to open billing period: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task HandleClosePeriod()
    {
        isProcessing = true;
        try
        {
            var command = new CloseBillingPeriodCommand(Guid.Parse(PeriodId));
            var result = await Mediator.Send(command);

            if (result.IsSuccess)
            {
                ShowToast(false, "Success", "Billing period closed successfully!");
                await LoadPeriod();
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to close billing period: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task HandleReopenPeriod()
    {
        isProcessing = true;
        try
        {
            var command = new ReopenBillingPeriodCommand(Guid.Parse(PeriodId));
            var result = await Mediator.Send(command);

            if (result.IsSuccess)
            {
                ShowToast(false, "Success", "Billing period reopened successfully!");
                await LoadPeriod();
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to reopen billing period: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task HandleGenerateSettlement()
    {
        isProcessing = true;
        try
        {
            var command = new GenerateSettlementCommand(Guid.Parse(PeriodId));
            var result = await Mediator.Send(command);

            if (result.IsSuccess)
            {
                Navigation.NavigateTo($"/spaces/{SpaceId}/settlements/{result.Value.Id}");
            }
            else if (IsConflict(result.Errors))
            {
                ShowToast(true, "Changed meanwhile", "Something changed while generating; the preview was refreshed. Check it and generate again.");
                await LoadPeriod();
                if (showGenerateModal)
                    await LoadPreview();
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to generate settlement: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ViewSettlement()
    {
        // The billing-period DTO doesn't carry the settlement id, so resolve it from the
        // space's settlements by matching this period (latest generated wins).
        try
        {
            var result = await Mediator.Send(new GetSpaceSettlementsQuery(new SpaceId(Guid.Parse(SpaceId))));
            if (result.IsSuccess && period != null)
            {
                var match = result.Value
                    .Where(s => s.BillingPeriodName == period.Name)
                    .OrderByDescending(s => s.GeneratedAt)
                    .FirstOrDefault();
                if (match != null)
                {
                    Navigation.NavigateTo($"/spaces/{SpaceId}/settlements/{match.Id}");
                    return;
                }
            }
        }
        catch
        {
            // fall through to the list
        }

        Navigation.NavigateTo($"/spaces/{SpaceId}/settlements");
    }

    private string GetStateBadgeClass(string state)
    {
        return state switch
        {
            "Draft" => "bs-badge-secondary",
            "Open" => "bs-badge-success",
            "Closed" => "bs-badge-warning",
            "Settled" => "bs-badge-primary",
            _ => "bs-badge-secondary"
        };
    }

    private void ShowToast(bool isError, string title, string message)
    {
        isToastError = isError;
        toastTitle = title;
        toastMessage = message;
        showToast = true;
    }
}
