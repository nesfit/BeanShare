@page "/spaces"
@rendermode InteractiveServer
@using MediatR
@using BeanShare.Application.Features.Spaces.Commands
@using BeanShare.Application.Features.Spaces.Queries
@using BeanShare.Application.Features.CoffeeStock.Queries
@using BeanShare.Application.Features.CoffeeStock.Dtos
@using BeanShare.Application.Features.Presets.Queries
@using BeanShare.Application.Features.Consumption.Commands
@using BeanShare.Application.Features.Consumption.Queries.GetUserConsumptionHistory
@using BeanShare.Application.Features.Consumption.Queries.GetBagSuggestions
@using BeanShare.Application.Features.Consumption.Dtos
@using BeanShare.Application.Features.ActiveQrCodes.Queries
@using BeanShare.Application.Features.Analytics.Queries.GetUserStatistics
@using BeanShare.SharedUi.Components.Consumption.Models
@using BeanShare.SharedUi.Services
@using Microsoft.AspNetCore.Authorization
@using BeanShare.Application.Abstractions
@attribute [Authorize]
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject IQrCodeService QrCodeService
@inject IUserContext UserContext

<PageTitle>My Spaces - BeanShare</PageTitle>

<div class="bs-container" style="padding-top: 2rem; padding-bottom: 2rem;">
    <div style="max-width: 48rem; margin: 0 auto;">
        @if (spaces.Any())
        {
            <div class="bs-card" style="margin-bottom: 1.5rem;">
                <div class="bs-flex bs-items-center bs-justify-between" style="gap: 1rem; flex-wrap: wrap;">
                    <div style="min-width: 0;">
                        <h1 class="bs-font-bold" style="margin: 0 0 0.25rem 0; font-size: 1.5rem;">Log your coffee</h1>
                        <p class="bs-text-subtle" style="margin: 0;">One tap to record a cup — choose who and how many.</p>
                    </div>
                    <button class="bs-btn bs-btn-primary" style="font-size: 1rem; padding: 0.875rem 1.5rem; gap: 0.5rem;" @onclick="OpenQuickConsumption">
                        <span class="material-symbols-outlined">coffee</span>
                        Log Coffee
                    </button>
                </div>
                @if (statistics != null)
                {
                    <div class="bs-flex bs-gap-3" style="margin-top: 1rem; flex-wrap: wrap;">
                        <div style="flex: 1; min-width: 6rem; background: var(--bs-gray-50); border-radius: 0.5rem; padding: 0.625rem 0.875rem;">
                            <div style="font-size: 0.75rem; color: var(--bs-text-subtle); font-weight: 600;">TODAY</div>
                            <div style="font-size: 1.25rem; font-weight: 700;">@statistics.CupsToday</div>
                        </div>
                        <div style="flex: 1; min-width: 6rem; background: var(--bs-gray-50); border-radius: 0.5rem; padding: 0.625rem 0.875rem;">
                            <div style="font-size: 0.75rem; color: var(--bs-text-subtle); font-weight: 600;">THIS WEEK</div>
                            <div style="font-size: 1.25rem; font-weight: 700;">@statistics.CupsThisWeek</div>
                        </div>
                        @if (statistics.TotalCost != null)
                        {
                            <div style="flex: 1; min-width: 6rem; background: var(--bs-gray-50); border-radius: 0.5rem; padding: 0.625rem 0.875rem;">
                                <div style="font-size: 0.75rem; color: var(--bs-text-subtle); font-weight: 600;">TOTAL SPENT</div>
                                <div style="font-size: 1.25rem; font-weight: 700;">@statistics.TotalCost.Currency.FormatAmount(statistics.TotalCost.Amount)</div>
                            </div>
                        }
                    </div>
                }
                @if (recentActivity.Any())
                {
                    <div style="margin-top: 1rem; border-top: 1px solid var(--bs-border); padding-top: 0.875rem;">
                        <div style="font-size: 0.75rem; color: var(--bs-text-subtle); font-weight: 600; margin-bottom: 0.5rem;">RECENT ACTIVITY</div>
                        <div class="bs-flex bs-flex-col" style="gap: 0.375rem;">
                            @foreach (var item in recentActivity)
                            {
                                <button type="button" class="bs-flex bs-items-center bs-justify-between"
                                        style="width: 100%; background: transparent; border: none; padding: 0.15rem 0; cursor: pointer; text-align: left; color: inherit; font-size: 0.8125rem; gap: 0.5rem;"
                                        @onclick="@(() => Navigation.NavigateTo($"/spaces/{item.SpaceId}/consumption"))"
                                        title="Open @item.SpaceName">
                                    <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0;">
                                        <span style="font-weight: 600;">@item.ProductName</span>
                                        <span style="color: var(--bs-text-subtle);"> · @item.QuantityGrams g · @item.SpaceName</span>
                                    </span>
                                    <span style="color: var(--bs-text-subtle); white-space: nowrap; flex-shrink: 0;">@FormatWhen(item.ConsumedAt)</span>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            @if (statistics != null && (statistics.DailyConsumptionTrend.Any() || statistics.CoffeeTypeBreakdown.Any()))
            {
                <div class="bs-card" style="margin-bottom: 1.5rem;">
                    <button type="button" class="bs-flex bs-items-center bs-justify-between"
                            style="width: 100%; background: transparent; border: none; cursor: pointer; padding: 0; color: inherit;"
                            @onclick="() => showInsights = !showInsights" aria-expanded="@showInsights">
                        <span class="bs-flex bs-items-center" style="gap: 0.5rem;">
                            <span class="material-symbols-outlined" style="color: var(--bs-primary);">insights</span>
                            <span class="bs-font-bold" style="font-size: 1.05rem;">Your insights</span>
                        </span>
                        <span class="material-symbols-outlined bs-text-subtle">@(showInsights ? "expand_less" : "expand_more")</span>
                    </button>

                    @if (showInsights)
                    {
                        <div style="margin-top: 1.25rem;">
                            <div class="bs-flex bs-gap-3" style="flex-wrap: wrap; margin-bottom: 1.5rem;">
                                <div style="flex: 1; min-width: 7rem; background: var(--bs-gray-50); border-radius: 0.5rem; padding: 0.65rem 0.85rem;">
                                    <div style="font-size: 0.7rem; color: var(--bs-text-subtle); font-weight: 600;">TOTAL CUPS</div>
                                    <div style="font-size: 1.25rem; font-weight: 700;">@statistics.TotalCups</div>
                                </div>
                                <div style="flex: 1; min-width: 7rem; background: var(--bs-gray-50); border-radius: 0.5rem; padding: 0.65rem 0.85rem;">
                                    <div style="font-size: 0.7rem; color: var(--bs-text-subtle); font-weight: 600;">DAILY AVG</div>
                                    <div style="font-size: 1.25rem; font-weight: 700;">@statistics.AverageCupsPerDay.ToString("F1")</div>
                                </div>
                                <div style="flex: 1; min-width: 7rem; background: var(--bs-gray-50); border-radius: 0.5rem; padding: 0.65rem 0.85rem;">
                                    <div style="font-size: 0.7rem; color: var(--bs-text-subtle); font-weight: 600;">THIS MONTH</div>
                                    <div style="font-size: 1.25rem; font-weight: 700;">@statistics.CupsThisMonth</div>
                                </div>
                                @if (!string.IsNullOrEmpty(statistics.MostConsumedCoffeeType))
                                {
                                    <div style="flex: 1; min-width: 7rem; background: var(--bs-gray-50); border-radius: 0.5rem; padding: 0.65rem 0.85rem;">
                                        <div style="font-size: 0.7rem; color: var(--bs-text-subtle); font-weight: 600;">FAVORITE</div>
                                        <div style="font-size: 0.95rem; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@statistics.MostConsumedCoffeeType</div>
                                    </div>
                                }
                            </div>

                            @if (statistics.DailyConsumptionTrend.Any())
                            {
                                <div style="margin-bottom: 1.5rem;">
                                    <div style="font-size: 0.8rem; font-weight: 600; color: var(--bs-text-subtle); margin-bottom: 0.5rem;">Last 30 days</div>
                                    <div style="display: flex; align-items: flex-end; gap: 2px; height: 72px;">
                                        @{
                                            var maxTrend = statistics.DailyConsumptionTrend.Values.DefaultIfEmpty(0).Max();
                                            var trendDays = Enumerable.Range(0, 30).Select(i => DateTime.UtcNow.Date.AddDays(-29 + i));
                                        }
                                        @foreach (var day in trendDays)
                                        {
                                            var cups = statistics.DailyConsumptionTrend.TryGetValue(day, out var v) ? v : 0;
                                            var barH = maxTrend > 0 ? (int)(cups * 100.0 / maxTrend) : 0;
                                            <div style="flex: 1; display: flex; flex-direction: column; justify-content: flex-end; height: 100%;" title="@day.ToString("MMM dd"): @cups cups">
                                                <div style="height: @(barH)%; min-height: @(cups > 0 ? "3px" : "0"); background: var(--bs-primary); border-radius: 2px;"></div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @if (statistics.CoffeeTypeBreakdown.Any())
                            {
                                <div>
                                    <div style="font-size: 0.8rem; font-weight: 600; color: var(--bs-text-subtle); margin-bottom: 0.5rem;">Favorite coffee types</div>
                                    @{
                                        var typeTotal = statistics.CoffeeTypeBreakdown.Values.Sum();
                                    }
                                    <div class="bs-flex bs-flex-col" style="gap: 0.5rem;">
                                        @foreach (var (typeName, typeCount) in statistics.CoffeeTypeBreakdown.OrderByDescending(k => k.Value).Take(5))
                                        {
                                            var typePct = typeTotal > 0 ? typeCount * 100.0 / typeTotal : 0;
                                            <div>
                                                <div class="bs-flex bs-justify-between" style="font-size: 0.8125rem; margin-bottom: 0.2rem;">
                                                    <span style="font-weight: 600;">@typeName</span>
                                                    <span class="bs-text-subtle">@typeCount cups · @typePct.ToString("F0")%</span>
                                                </div>
                                                <div style="height: 6px; background: var(--bs-gray-200); border-radius: 9999px; overflow: hidden;">
                                                    <div style="height: 100%; width: @(typePct)%; background: var(--bs-primary);"></div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @if (statistics.CostBreakdown.Count > 1)
                            {
                                <div style="margin-top: 1.5rem;">
                                    <div style="font-size: 0.8rem; font-weight: 600; color: var(--bs-text-subtle); margin-bottom: 0.5rem;">Spending by currency</div>
                                    <div class="bs-flex bs-flex-col" style="gap: 0.35rem;">
                                        @foreach (var b in statistics.CostBreakdown)
                                        {
                                            <div class="bs-flex bs-justify-between" style="font-size: 0.8125rem;">
                                                <span style="font-weight: 600;">@b.CurrencyCode</span>
                                                <span class="bs-text-subtle">@b.OriginalAmount.ToString("N2") @b.CurrencyCode</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <div style="margin-bottom: 1rem;">
                @if (!string.IsNullOrWhiteSpace(Query))
                {
                    <div class="bs-flex bs-items-center bs-justify-between" style="gap: 0.5rem; flex-wrap: wrap;">
                        <div style="min-width: 0;">
                            <h2 class="bs-font-bold" style="margin: 0 0 0.25rem 0; font-size: 1.25rem;">Search results</h2>
                            <p class="bs-text-subtle" style="margin: 0;">Spaces matching &ldquo;@Query&rdquo;.</p>
                        </div>
                        <a class="bs-btn bs-btn-sm bs-btn-ghost" href="/spaces">Clear</a>
                    </div>
                }
                else
                {
                    <h2 class="bs-font-bold" style="margin: 0 0 0.25rem 0; font-size: 1.25rem;">Your spaces</h2>
                    <p class="bs-text-subtle" style="margin: 0;">Select a space to manage coffee consumption and costs.</p>
                }
            </div>
        }

        <SpacesList Spaces="@FilteredSpaces"
                   IsLoading="@isLoading"
                   OnSpaceSelected="HandleSpaceSelected"
                   OnCreateSpace="() => showCreateModal = true" />

        <div class="bs-flex bs-gap-3" style="margin-top: 1.5rem;">
            <button class="bs-btn bs-btn-primary bs-flex-1" @onclick="() => showCreateModal = true">
                <span class="material-symbols-outlined">add_circle</span>
                Create New Space
            </button>
            <button class="bs-btn bs-btn-secondary bs-flex-1" @onclick="() => showJoinModal = true">
                <span class="material-symbols-outlined">login</span>
                Join with Invite Code
            </button>
        </div>
    </div>
</div>

@if (spaces.Any())
{
    <button class="quick-consumption-fab" @onclick="OpenQuickConsumption" title="Log Coffee" aria-label="Log coffee consumption">
        <span class="material-symbols-outlined">coffee</span>
    </button>
}

<CreateSpaceModal IsVisible="@showCreateModal"
                 OnSubmit="HandleCreateSpace"
                 OnCancel="() => showCreateModal = false" />

<JoinSpaceModal IsVisible="@showJoinModal"
               OnSubmit="HandleJoinSpace"
               OnCancel="() => showJoinModal = false" />

<BeanShare.SharedUi.Components.Consumption.QuickConsumptionModal
    IsVisible="@showQuickConsumptionModal"
    Spaces="@spaces"
    StockProducts="@quickConsumptionStock"
    BagOptions="@quickConsumptionBags"
    Presets="@quickConsumptionPresets"
    SpaceMembers="@quickConsumptionMembers"
    IsLoadingStock="@isLoadingQuickConsumptionData"
    OnSpaceSelected="HandleQuickConsumptionSpaceSelected"
    OnSubmit="HandleQuickConsumptionSubmit"
    OnCancel="CloseQuickConsumption"
    OnScanQr="HandleQuickScanQr"
    CurrentUserId="@UserContext.CurrentUserId.Value" />

<QrScannerModal IsVisible="@showQuickQrScanner"
               OnScanned="HandleQuickQrScanned"
               OnClose="@(() => showQuickQrScanner = false)" />

<Toast IsVisible="@showToast"
       IsError="@isToastError"
       Title="@toastTitle"
       Message="@toastMessage"
       OnClose="() => showToast = false" />


@code {
    [SupplyParameterFromQuery(Name = "action")]
    public string? Action { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    private bool showInsights;

    private List<SpaceSummaryDto> spaces = new();

    private List<SpaceSummaryDto> FilteredSpaces =>
        string.IsNullOrWhiteSpace(Query)
            ? spaces
            : spaces.Where(s => s.Name.Contains(Query, StringComparison.OrdinalIgnoreCase)).ToList();
    private UserStatisticsDto? statistics;
    private List<ConsumptionHistoryItemDto> recentActivity = new();
    private bool isLoading = true;
    private bool showCreateModal;
    private bool showJoinModal;
    private bool showQuickConsumptionModal;
    private bool showQuickQrScanner;
    private bool showToast;
    private bool isToastError;
    private string toastTitle = "";
    private string toastMessage = "";

    private List<StockLevelDto>? quickConsumptionStock;
    private List<BagSuggestionDto>? quickConsumptionBags;
    private List<PresetOption>? quickConsumptionPresets;
    private List<MembershipDto>? quickConsumptionMembers;
    private bool isLoadingQuickConsumptionData;

    protected override async Task OnInitializedAsync()
    {
        await LoadSpaces();
        await LoadStatistics();
        await LoadRecentActivity();

        if (string.Equals(Action, "create", StringComparison.OrdinalIgnoreCase))
        {
            showCreateModal = true;
        }
    }

    private async Task LoadStatistics()
    {
        // Best-effort: the hero KPI strip is informational, so a failure here must never
        // block the spaces list from rendering.
        try
        {
            var currentUserId = UserContext.CurrentUserId;
            if (currentUserId.Value != Guid.Empty)
            {
                statistics = await Mediator.Send(new GetUserStatisticsQuery(currentUserId));
            }
        }
        catch
        {
            statistics = null;
        }
    }

    private async Task LoadRecentActivity()
    {
        // My most recent cups across all my spaces — shown under the hero KPIs.
        // Best-effort like the KPI strip.
        try
        {
            var result = await Mediator.Send(new GetUserConsumptionHistoryQuery(PageSize: 5));
            if (result.IsSuccess)
            {
                recentActivity = result.Value.Items.ToList();
            }
        }
        catch
        {
            recentActivity = new();
        }
    }

    // Compact relative time for the recent-activity list. Converts UTC-stamped entries to
    // local time; entries stored as local/unspecified are shown as-is.
    private static string FormatWhen(DateTime dt)
    {
        var local = dt.Kind == DateTimeKind.Utc ? dt.ToLocalTime() : dt;
        var now = DateTime.Now;
        var span = now - local;

        if (span.TotalSeconds < 60) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (local.Date == now.Date) return local.ToString("HH:mm");
        if (local.Date == now.Date.AddDays(-1)) return "Yesterday";
        return local.ToString("MMM d");
    }

    private async Task LoadSpaces()
    {
        isLoading = true;
        try
        {
            var result = await Mediator.Send(new GetUserSpacesQuery());
            if (result.IsSuccess)
            {
                spaces = result.Value.Spaces.ToList();
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load spaces: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleCreateSpace((string Name, string CurrencyCode) spaceData)
    {
        try
        {
            var result = await Mediator.Send(new CreateSpaceCommand(spaceData.Name, spaceData.CurrencyCode));
            if (result.IsSuccess)
            {
                showCreateModal = false;
                ShowToast(false, "Success", $"Space '{spaceData.Name}' created successfully!");
                await LoadSpaces();
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to create space: {ex.Message}");
        }
    }

    private async Task HandleJoinSpace(string inviteCode)
    {
        try
        {
            var result = await Mediator.Send(new JoinSpaceCommand(inviteCode));
            if (result.IsSuccess)
            {
                showJoinModal = false;
                ShowToast(false, "Success", "Joined space successfully!");
                await LoadSpaces();
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to join space: {ex.Message}");
        }
    }

    private void HandleSpaceSelected(string spaceId)
    {
        // Land directly on the Consumption view — logging is the primary daily action,
        // so we skip the Members roster that used to be the space's default tab.
        Navigation.NavigateTo($"/spaces/{spaceId}/consumption");
    }

    private void OpenQuickConsumption()
    {
        quickConsumptionStock = null;
        quickConsumptionBags = null;
        quickConsumptionPresets = null;
        quickConsumptionMembers = null;
        showQuickConsumptionModal = true;
    }

    private void CloseQuickConsumption()
    {
        showQuickConsumptionModal = false;
        quickConsumptionStock = null;
        quickConsumptionBags = null;
        quickConsumptionPresets = null;
        quickConsumptionMembers = null;
    }

    private async Task HandleQuickConsumptionSpaceSelected(Guid spaceId)
    {
        isLoadingQuickConsumptionData = true;
        quickConsumptionStock = null;
        quickConsumptionBags = null;
        quickConsumptionPresets = null;
        quickConsumptionMembers = null;
        StateHasChanged();

        try
        {
            var stockResult = await Mediator.Send(new GetSpaceStockQuery(spaceId));
            var bagsResult = await Mediator.Send(new GetBagSuggestionsQuery(spaceId));
            var presetsResult = await Mediator.Send(new GetQuickPresetsQuery(spaceId));
            var spaceResult = await Mediator.Send(new GetSpaceByIdQuery(spaceId));

            if (stockResult.IsSuccess)
            {
                quickConsumptionStock = stockResult.Value.StockLevels.ToList();
            }

            // Ranked bags — the modal preselects whichever the space has been pouring from.
            if (bagsResult.IsSuccess)
            {
                quickConsumptionBags = bagsResult.Value.Bags.ToList();
            }

            if (presetsResult.IsSuccess)
            {
                quickConsumptionPresets = presetsResult.Value.Presets.Select(p => new PresetOption
                {
                    GlobalPresetId = p.GlobalPresetId,
                    SpacePresetId = p.SpacePresetId,
                    Name = p.Name,
                    CoffeeType = p.CoffeeType,
                    Preparation = p.Preparation,
                    Grams = (int)p.DefaultGrams,
                    Description = p.Description,
                    IsFavorite = p.IsFavorite,
                    IsGlobal = p.IsGlobal,
                    DisplayOrder = p.DisplayOrder
                }).ToList();
            }

            if (spaceResult.IsSuccess)
            {
                quickConsumptionMembers = spaceResult.Value.Members.ToList();
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load space data: {ex.Message}");
        }
        finally
        {
            isLoadingQuickConsumptionData = false;
            StateHasChanged();
        }
    }

    private async Task HandleQuickConsumptionSubmit(QuickConsumptionRequest request)
    {
        try
        {
            var targetUserIds = new List<Guid?>();
            if (request.ForUserIds != null && request.ForUserIds.Count > 0)
            {
                targetUserIds.AddRange(request.ForUserIds.Select(id => (Guid?)id));
            }
            else
            {
                targetUserIds.Add(null); // null = myself
            }

            var successCount = 0;
            var errors = new List<string>();

            foreach (var targetUserId in targetUserIds)
            {
                var command = new RecordConsumptionCommand(
                    request.SpaceId,
                    request.ProductName,
                    request.ProductBrand,
                    request.ProductType,
                    request.Grams,
                    request.ConsumedAt,
                    request.PresetName,
                    targetUserId,
                    request.StockLotId
                );

                var result = await Mediator.Send(command);
                if (result.IsSuccess)
                    successCount++;
                else
                    errors.AddRange(result.Errors.Select(e => e.Message));
            }

            if (successCount > 0)
            {
                showQuickConsumptionModal = false;
                var msg = successCount == 1
                    ? $"Logged {request.Grams}g of coffee!"
                    : $"Logged {successCount} cups!";
                ShowToast(false, "Success", msg);

                // Keep the hero KPIs + recent activity in sync with what was just logged.
                await LoadStatistics();
                await LoadRecentActivity();
            }

            if (errors.Any())
            {
                ShowToast(true, "Error", string.Join(", ", errors));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to log consumption: {ex.Message}");
        }
    }

    private void HandleQuickScanQr()
    {
        showQuickConsumptionModal = false;
        showQuickQrScanner = true;
    }

    private async Task HandleQuickQrScanned(QrConsumptionPayload payload)
    {
        showQuickQrScanner = false;

        if (payload.Version >= 2 && payload.QrCodeId.HasValue)
        {
            try
            {
                var result = await Mediator.Send(new ResolveActiveQrCodeQuery(payload.QrCodeId.Value));
                if (result.IsSuccess)
                {
                    var dto = result.Value;
                    Navigation.NavigateTo($"/spaces/{dto.SpaceId}/consumption?qrCodeId={payload.QrCodeId}");
                    return;
                }

                ShowToast(true, "Error", "Could not resolve QR code. It may have been deactivated.");
            }
            catch
            {
                ShowToast(true, "Error", "Failed to resolve QR code.");
            }
        }
        else
        {
            Navigation.NavigateTo($"/spaces/{payload.SpaceId}/consumption");
        }

        StateHasChanged();
    }

    private void ShowToast(bool isError, string title, string message)
    {
        isToastError = isError;
        toastTitle = title;
        toastMessage = message;
        showToast = true;
    }
}
