@page "/spaces/{SpaceId}/settlements/{SettlementId}"
@rendermode InteractiveServer
@using MediatR
@using BeanShare.Application.Features.Settlement.Queries.GetSettlementById
@using BeanShare.Application.Features.Settlement.Commands.SendSettlementEmails
@using BeanShare.Application.Features.Settlement.Commands.ConfirmPayment
@using BeanShare.Application.Features.Settlement.Dtos
@using BeanShare.Application.Features.Spaces.Queries
@using BeanShare.Domain.ValueObjects
@using BeanShare.Application.Abstractions
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject IUserContext UserContext
@inject IJSRuntime JSRuntime
@inject BeanShare.SharedUi.Services.IQrCodeService QrCodeService

<PageTitle>Settlement Details - BeanShare</PageTitle>

<div style="position: sticky; top: 0; z-index: 10; background: var(--bs-background-light); border-bottom: 1px solid var(--bs-border); padding: 1rem 0;">
    <div class="bs-container">
        <div class="bs-flex bs-items-center bs-justify-between" style="margin-bottom: 1rem;">
            <button class="bs-btn bs-btn-sm bs-btn-ghost" aria-label="Back to settlements" @onclick='@(() => Navigation.NavigateTo($"/spaces/{SpaceId}/settlements"))'>
                <span class="material-symbols-outlined">arrow_back</span>
            </button>
            <h1 class="bs-font-bold" style="margin: 0; font-size: 1.25rem;">Settlement</h1>
            <div style="width: 2rem;"></div>
        </div>
    </div>
</div>

<div class="bs-container" style="padding: 2rem 0;">
    @if (isLoading)
    {
        <div style="text-align: center; padding: 2rem;">
            <div class="bs-skeleton" style="width: 100%; height: 10rem; margin-bottom: 1rem;"></div>
            <div class="bs-skeleton" style="width: 100%; height: 15rem;"></div>
        </div>
    }
    else if (settlement == null)
    {
        <div style="text-align: center; padding: 4rem 2rem;">
            <span class="material-symbols-outlined" style="font-size: 4rem; color: var(--bs-text-subtle); margin-bottom: 1rem;">error</span>
            <h2 style="margin: 0 0 0.5rem 0; font-size: 1.25rem; font-weight: 600;">Settlement Not Found</h2>
            <p class="bs-text-subtle">The settlement you're looking for doesn't exist.</p>
        </div>
    }
    else
    {
        <!-- Settlement Header -->
        <div class="bs-card" style="padding: 2rem; margin-bottom: 1.5rem;">
            <div class="bs-flex bs-items-center bs-justify-between" style="margin-bottom: 0.5rem;">
                <h2 style="margin: 0; font-size: 1.5rem; font-weight: 700;">@settlement.BillingPeriodName</h2>
                <span class="bs-badge @GetStatusBadgeClass(settlement.Status)">
                    @GetStatusDisplayText(settlement.Status)
                </span>
            </div>
            <p class="bs-text-subtle" style="margin: 0 0 1.5rem 0;">
                Period: @settlement.PeriodStart.ToString("MMM dd") - @settlement.PeriodEnd.ToString("MMM dd, yyyy")
            </p>

            <!-- Payment Confirmation Progress -->
            <div style="background: var(--bs-gray-100); border-radius: 0.5rem; padding: 1rem; margin-bottom: 1.5rem;">
                <div class="bs-flex bs-items-center bs-justify-between" style="margin-bottom: 0.5rem;">
                    <span class="bs-text-subtle" style="font-size: 0.875rem;">Payment Confirmations</span>
                    <span style="font-weight: 600;">@settlement.ConfirmedLinesCount / @settlement.TotalLinesCount</span>
                </div>
                <div style="background: var(--bs-gray-200); border-radius: 9999px; height: 0.5rem; overflow: hidden;">
                    <div style="background: @(settlement.Status == "Completed" ? "var(--bs-success)" : "var(--bs-primary)"); height: 100%; width: @(settlement.TotalLinesCount > 0 ? (int)((double)settlement.ConfirmedLinesCount / settlement.TotalLinesCount * 100) : 0)%; transition: width 0.3s;"></div>
                </div>
                @if (settlement.CompletedAt.HasValue)
                {
                    <p class="bs-text-subtle" style="font-size: 0.75rem; margin: 0.5rem 0 0 0;">
                        Completed: @settlement.CompletedAt.Value.ToString("MMM dd, yyyy 'at' h:mm tt")
                    </p>
                }
            </div>

            <div class="bs-flex bs-gap-4" style="flex-wrap: wrap;">
                <div class="bs-flex-1" style="min-width: 200px;">
                    <p class="bs-text-subtle" style="font-size: 0.875rem; margin: 0 0 0.5rem 0;">Total Amount</p>
                    <p style="font-size: 2rem; font-weight: 700; margin: 0; color: var(--bs-primary);">
                        @settlement.Currency @settlement.TotalAmount.ToString("F2")
                    </p>
                </div>
                <div class="bs-flex-1" style="min-width: 200px;">
                    <p class="bs-text-subtle" style="font-size: 0.875rem; margin: 0 0 0.5rem 0;">Generated</p>
                    <p style="font-size: 1.25rem; font-weight: 600; margin: 0;">
                        @settlement.GeneratedAt.ToString("MMM dd, yyyy 'at' h:mm tt")
                    </p>
                </div>
            </div>
        </div>

        <!-- Who Owes Whom Summary -->
        @if (Debtors.Any() || Creditors.Any())
        {
            <div class="bs-card" style="padding: 2rem; margin-bottom: 1.5rem;">
                <h3 style="margin: 0 0 0.25rem 0; font-size: 1.25rem; font-weight: 600;">Who owes whom</h3>
                <p class="bs-text-subtle" style="margin: 0 0 1.25rem 0; font-size: 0.875rem;">Suggested payments to settle everyone up with the fewest transfers.</p>
                @{
                    var transfers = BuildTransfers();
                }
                @if (transfers.Any())
                {
                    <div class="bs-flex bs-flex-col" style="gap: 0.5rem;">
                        @foreach (var t in transfers)
                        {
                            var isMine = t.FromUserId == currentUserId;
                            var canPay = isMine && !string.IsNullOrEmpty(t.ToRevolutTag);
                            <div>
                                <div class="bs-flex bs-items-center" style="gap: 0.6rem; padding: 0.65rem 0.85rem; background: @(isMine ? "var(--bs-primary-light)" : "var(--bs-gray-50)"); border: 1px solid @(isMine ? "var(--bs-primary)" : "var(--bs-border)"); border-radius: 0.5rem; flex-wrap: wrap;">
                                    <span style="font-weight: 600;">@t.From</span>
                                    @if (isMine)
                                    {
                                        <span class="bs-badge bs-badge-primary">You</span>
                                    }
                                    <span class="material-symbols-outlined" style="color: var(--bs-text-subtle); font-size: 1.15rem;" title="pays">arrow_forward</span>
                                    <span style="font-weight: 600;">@t.To</span>
                                    <span style="margin-left: auto; font-weight: 700; color: var(--bs-primary); font-variant-numeric: tabular-nums;">@t.Currency @t.Amount.ToString("F2")</span>
                                    @if (canPay)
                                    {
                                        var link = RevolutLink(t.ToRevolutTag!, t.Amount, t.Currency);
                                        <a class="bs-btn bs-btn-sm bs-btn-primary" href="@link" target="_blank" rel="noopener" style="gap: 0.3rem;" title="@($"Pay {t.To} with Revolut")">
                                            <span class="material-symbols-outlined" style="font-size: 1rem;">send</span>
                                            Pay
                                        </a>
                                        <button type="button" class="bs-btn bs-btn-sm bs-btn-ghost" @onclick="@(() => ToggleQr(link))" aria-label="@($"Show payment QR for {t.To}")" title="Show QR">
                                            <span class="material-symbols-outlined" style="font-size: 1rem;">qr_code_2</span>
                                        </button>
                                    }
                                </div>
                                @if (canPay && openQrLink == RevolutLink(t.ToRevolutTag!, t.Amount, t.Currency))
                                {
                                    <div style="text-align: center; padding: 0.75rem;">
                                        <img src="@QrCodeService.GenerateQrCodeBase64ForUrl(openQrLink)" alt="Revolut payment QR" style="width: 176px; height: 176px;" />
                                        <p class="bs-text-subtle" style="font-size: 0.75rem; margin: 0.5rem 0 0 0;">Scan to pay @t.To @t.Currency @t.Amount.ToString("F2")</p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="bs-flex bs-items-center" style="gap: 0.5rem; color: var(--bs-success);">
                        <span class="material-symbols-outlined">check_circle</span>
                        <span style="font-weight: 600;">Everyone's square — no payments needed.</span>
                    </div>
                }
            </div>
        }

        <!-- Settlement Lines -->
        <div class="bs-card" style="padding: 2rem;">
            <h3 style="margin: 0 0 1.5rem 0; font-size: 1.25rem; font-weight: 600;">Cost Breakdown</h3>

            <div class="bs-flex bs-flex-col bs-gap-3">
                @foreach (var line in settlement.Lines.OrderByDescending(l => l.TotalCoffeeGrams))
                {
                    <div class="bs-card" style="padding: 1.5rem; background: @(line.IsConfirmed ? "var(--bs-success-light, rgba(34, 197, 94, 0.1))" : "var(--bs-gray-50)"); border: 1px solid @(line.IsConfirmed ? "var(--bs-success)" : "var(--bs-border)");">
                        <div class="bs-flex bs-items-start bs-justify-between" style="margin-bottom: 1rem;">
                            <div>
                                <div class="bs-flex bs-items-center bs-gap-2" style="margin-bottom: 0.25rem;">
                                    <h4 style="margin: 0; font-size: 1.125rem; font-weight: 600;">@line.UserName</h4>
                                    @if (line.IsConfirmed)
                                    {
                                        <span class="material-symbols-outlined" style="color: var(--bs-success); font-size: 1.25rem;" title="Payment Confirmed">check_circle</span>
                                    }
                                </div>
                                <p class="bs-text-subtle" style="font-size: 0.875rem; margin: 0;">@line.UserEmail</p>
                            </div>
                            <div style="text-align: right;">
                                <p style="font-size: 1.5rem; font-weight: 700; margin: 0; color: @(line.IsConfirmed ? "var(--bs-success)" : "var(--bs-warning)");">
                                    @line.Currency @line.AmountDue.ToString("F2")
                                </p>
                                <p class="bs-text-subtle" style="font-size: 0.75rem; margin: 0;">
                                    @line.ConsumptionPercentage.ToString("F1")% of total
                                </p>
                            </div>
                        </div>

                        <div class="bs-flex bs-gap-4" style="margin-bottom: 1rem; flex-wrap: wrap;">
                            <div>
                                <p class="bs-text-subtle" style="font-size: 0.75rem; margin: 0 0 0.25rem 0;">Coffee Consumed</p>
                                <p style="font-size: 1.125rem; font-weight: 600; margin: 0;">@line.TotalCoffeeGrams.ToString("F0")g</p>
                            </div>
                            @if (line.TotalMilkMl.HasValue && line.TotalMilkMl.Value > 0)
                            {
                                <div>
                                    <p class="bs-text-subtle" style="font-size: 0.75rem; margin: 0 0 0.25rem 0;">Milk Used</p>
                                    <p style="font-size: 1.125rem; font-weight: 600; margin: 0;">@line.TotalMilkMl.Value.ToString("F0")ml</p>
                                </div>
                            }
                            <div>
                                <p class="bs-text-subtle" style="font-size: 0.75rem; margin: 0 0 0.25rem 0;">Purchased</p>
                                <p style="font-size: 1.125rem; font-weight: 600; margin: 0; color: var(--bs-success);">@line.Currency @line.AmountPaid.ToString("F2")</p>
                            </div>
                            <div>
                                <p class="bs-text-subtle" style="font-size: 0.75rem; margin: 0 0 0.25rem 0;">Balance</p>
                                <p style="font-size: 1.125rem; font-weight: 600; margin: 0; color: @(line.NetBalance >= 0 ? "var(--bs-success)" : "var(--bs-error, #ef4444)");">
                                    @(line.NetBalance >= 0 ? "+" : "")@line.Currency @line.NetBalance.ToString("F2")
                                </p>
                            </div>
                        </div>

                        <div style="text-align: right;">
                            @if (line.IsConfirmed)
                            {
                                <p class="bs-text-subtle" style="font-size: 0.75rem; margin: 0;">
                                    Confirmed @(line.ConfirmedAt.HasValue ? line.ConfirmedAt.Value.ToString("MMM dd, yyyy") : "")
                                </p>
                            }
                            else if (CanConfirmPayment(line.UserId))
                            {
                                <button class="bs-btn bs-btn-sm bs-btn-primary"
                                        style="font-size: 0.875rem;"
                                        disabled="@isConfirming"
                                        @onclick="@(() => RequestConfirmPayment(line.UserId, line.UserName))">
                                    @if (isConfirming && confirmingUserId == line.UserId)
                                    {
                                        <span>Confirming...</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined" style="font-size: 1rem; vertical-align: middle;">check</span>
                                        <span>Confirm Payment</span>
                                    }
                                </button>
                            }
                            else
                            {
                                <span class="bs-text-subtle" style="font-size: 0.75rem;">Awaiting confirmation</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Export Actions -->
        <div class="bs-card" style="padding: 1.5rem; margin-top: 1.5rem;">
            <h3 style="margin: 0 0 1rem 0; font-size: 1rem; font-weight: 600;">Export & Share</h3>
            <div class="bs-flex bs-gap-3" style="flex-wrap: wrap;">
                <button class="bs-btn bs-btn-secondary" @onclick="DownloadPdf">
                    <span class="material-symbols-outlined">picture_as_pdf</span>
                    Export PDF
                </button>
                <button class="bs-btn bs-btn-secondary" @onclick="DownloadExcel">
                    <span class="material-symbols-outlined">table_chart</span>
                    Export Excel
                </button>
                @if (isAdmin)
                {
                    <button class="bs-btn bs-btn-primary" disabled="@isSendingEmails" @onclick="HandleSendEmails">
                        @if (isSendingEmails)
                        {
                            <span>Sending...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined">mail</span>
                            <span>Email All Members</span>
                        }
                    </button>
                }
            </div>
        </div>

        <!-- Actions -->
        <div style="margin-top: 1.5rem; text-align: center;">
            <button class="bs-btn bs-btn-secondary" @onclick='@(() => Navigation.NavigateTo($"/spaces/{SpaceId}/billing/{settlement.BillingPeriodId}"))'>
                <span class="material-symbols-outlined">calendar_month</span>
                View Billing Period
            </button>
        </div>
    }
</div>

<ConfirmDialog IsVisible="@showConfirmPayment"
               Title="Confirm payment?"
               Message="@confirmPaymentMessage"
               ConfirmText="Mark as paid"
               IsProcessing="@isConfirming"
               OnConfirm="ExecuteConfirmPayment"
               OnCancel="@(() => showConfirmPayment = false)" />

<Toast IsVisible="@showToast"
       IsError="@isToastError"
       Title="@toastTitle"
       Message="@toastMessage"
       OnClose="@(() => showToast = false)" />

@code {
    [Parameter]
    public string SpaceId { get; set; } = "";

    [Parameter]
    public string SettlementId { get; set; } = "";

    private SettlementDto? settlement;
    private bool isLoading = true;
    private bool showToast;
    private bool isToastError;
    private string toastTitle = "";
    private string toastMessage = "";

    private Guid currentUserId;
    private bool isAdmin;
    private bool isConfirming;
    private Guid confirmingUserId;
    private bool isSendingEmails;

    private bool showConfirmPayment;
    private Guid pendingPaymentUserId;
    private string confirmPaymentMessage = "";

    private sealed record Transfer(string From, string To, decimal Amount, string Currency, string? ToRevolutTag, Guid FromUserId);

    private string? openQrLink;

    private void ToggleQr(string link) => openQrLink = openQrLink == link ? null : link;

    private static string RevolutLink(string tag, decimal amount, string currency)
    {
        var amt = amount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        var ccy = (currency ?? string.Empty).ToUpperInvariant();
        return $"https://revolut.me/{tag}/{amt}{ccy}";
    }

    private List<SettlementLineDto> Debtors => settlement?.Lines.Where(l => l.NetBalance < -0.01m).OrderBy(l => l.NetBalance).ToList() ?? new();
    private List<SettlementLineDto> Creditors => settlement?.Lines.Where(l => l.NetBalance > 0.01m).OrderByDescending(l => l.NetBalance).ToList() ?? new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUserId = UserContext.CurrentUserId.Value;
        }
        catch
        {
            currentUserId = Guid.Empty;
        }
        await LoadSpace();
        await LoadSettlement();
    }

    // Greedy min-transfer settlement: match the largest debtor to the largest creditor.
    private List<Transfer> BuildTransfers()
    {
        var transfers = new List<Transfer>();
        if (settlement == null)
        {
            return transfers;
        }

        var debtors = settlement.Lines
            .Where(l => l.NetBalance < -0.01m)
            .Select(l => new { l.UserName, l.UserId, Amount = -l.NetBalance, l.Currency })
            .OrderByDescending(x => x.Amount)
            .ToList();
        var creditors = settlement.Lines
            .Where(l => l.NetBalance > 0.01m)
            .Select(l => new { l.UserName, Amount = l.NetBalance, l.Currency, l.RevolutTag })
            .OrderByDescending(x => x.Amount)
            .ToList();

        int i = 0, j = 0;
        var owe = debtors.Select(d => d.Amount).ToList();
        var due = creditors.Select(c => c.Amount).ToList();
        while (i < debtors.Count && j < creditors.Count)
        {
            var pay = Math.Min(owe[i], due[j]);
            if (pay > 0.01m)
            {
                transfers.Add(new Transfer(debtors[i].UserName, creditors[j].UserName, pay, debtors[i].Currency, creditors[j].RevolutTag, debtors[i].UserId));
            }
            owe[i] -= pay;
            due[j] -= pay;
            if (owe[i] <= 0.01m) i++;
            if (due[j] <= 0.01m) j++;
        }

        return transfers;
    }

    private async Task LoadSpace()
    {
        try
        {
            var result = await Mediator.Send(new GetSpaceByIdQuery(Guid.Parse(SpaceId)));
            if (result.IsSuccess)
            {
                isAdmin = result.Value.Members.Any(m => m.UserId == currentUserId && m.Role == "Admin");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load space: {ex.Message}");
        }
    }

    private async Task LoadSettlement()
    {
        isLoading = true;
        try
        {
            var query = new GetSettlementByIdQuery(new SettlementId(Guid.Parse(SettlementId)));
            var result = await Mediator.Send(query);

            if (result.IsSuccess)
            {
                settlement = result.Value;
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load settlement: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool CanConfirmPayment(Guid lineUserId)
    {
        return isAdmin || lineUserId == currentUserId;
    }

    private void RequestConfirmPayment(Guid memberUserId, string memberName)
    {
        pendingPaymentUserId = memberUserId;
        confirmPaymentMessage = memberUserId == currentUserId
            ? "This marks your share of this settlement as paid. Only do this once you've actually settled up."
            : $"This marks {memberName}'s share as paid.";
        showConfirmPayment = true;
    }

    private async Task ExecuteConfirmPayment()
    {
        showConfirmPayment = false;
        await HandleConfirmPayment(pendingPaymentUserId);
    }

    private async Task HandleConfirmPayment(Guid memberUserId)
    {
        if (settlement == null) return;

        isConfirming = true;
        confirmingUserId = memberUserId;

        try
        {
            var command = new ConfirmPaymentCommand(Guid.Parse(SettlementId), memberUserId);
            var result = await Mediator.Send(command);

            if (result.IsSuccess)
            {
                ShowToast(false, "Success", "Payment confirmed successfully");
                await LoadSettlement();
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to confirm payment: {ex.Message}");
        }
        finally
        {
            isConfirming = false;
            confirmingUserId = Guid.Empty;
        }
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Completed" => "bs-badge-success",
            "AwaitingConfirmation" => "bs-badge-warning",
            _ => "bs-badge-secondary"
        };
    }

    private string GetStatusDisplayText(string status)
    {
        return status switch
        {
            "Completed" => "Completed",
            "AwaitingConfirmation" => "Awaiting Confirmation",
            "Generated" => "Generated",
            _ => status
        };
    }

    private async Task HandleSendEmails()
    {
        if (settlement == null) return;

        isSendingEmails = true;

        try
        {
            var command = new SendSettlementEmailsCommand(new SettlementId(Guid.Parse(SettlementId)), AttachPdf: true);
            var result = await Mediator.Send(command);

            if (result.IsSuccess)
            {
                ShowToast(false, "Success", $"Sent {result.Value} email(s) to space members");
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to send emails: {ex.Message}");
        }
        finally
        {
            isSendingEmails = false;
        }
    }

    private async Task DownloadPdf()
    {
        await JSRuntime.InvokeVoidAsync("open", $"/api/settlements/{SettlementId}/export/pdf", "_blank");
    }

    private async Task DownloadExcel()
    {
        await JSRuntime.InvokeVoidAsync("open", $"/api/settlements/{SettlementId}/export/excel", "_blank");
    }

    private void ShowToast(bool isError, string title, string message)
    {
        isToastError = isError;
        toastTitle = title;
        toastMessage = message;
        showToast = true;
    }
}
