@page "/spaces/{SpaceId}/settlements"
@rendermode InteractiveServer
@using MediatR
@using BeanShare.Application.Common
@using BeanShare.Application.Features.Settlement.Queries.GetSpaceSettlements
@using BeanShare.Application.Features.Settlement.Dtos
@using BeanShare.Domain.ValueObjects
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IScopedSender Mediator
@inject NavigationManager Navigation

<PageTitle>Settlements - BeanShare</PageTitle>

<div style="position: sticky; top: 0; z-index: 10; background: var(--bs-background-light); border-bottom: 1px solid var(--bs-border); padding: 1rem 0;">
    <div class="bs-container">
        <div class="bs-flex bs-items-center bs-justify-between" style="margin-bottom: 1rem;">
            <button class="bs-btn bs-btn-sm bs-btn-ghost" aria-label="Back to spaces" @onclick='@(() => Navigation.NavigateTo("/spaces"))'>
                <span class="material-symbols-outlined">arrow_back</span>
            </button>
            <h1 class="bs-font-bold" style="margin: 0; font-size: 1.25rem;">Settlements</h1>
            <div style="width: 2rem;"></div>
        </div>
        <SpaceTabs SpaceId="@SpaceId" ActiveTab="settlements" PreventNavigation="false" />
    </div>
</div>

<div class="bs-container" style="padding: 2rem 0;">
    @if (isLoading)
    {
        <div style="text-align: center; padding: 2rem;">
            <div class="bs-skeleton" style="width: 100%; height: 6rem; margin-bottom: 1rem;"></div>
            <div class="bs-skeleton" style="width: 100%; height: 6rem; margin-bottom: 1rem;"></div>
            <div class="bs-skeleton" style="width: 100%; height: 6rem;"></div>
        </div>
    }
    else if (settlements == null || !settlements.Any())
    {
        <div style="text-align: center; padding: 4rem 2rem;">
            <span class="material-symbols-outlined" style="font-size: 4rem; color: var(--bs-text-subtle); margin-bottom: 1rem;">receipt_long</span>
            <h2 style="margin: 0 0 0.5rem 0; font-size: 1.25rem; font-weight: 600;">No Settlements Yet</h2>
            <p class="bs-text-subtle" style="margin-bottom: 2rem;">Settlements are generated from closed billing periods.</p>
            <button class="bs-btn bs-btn-primary" @onclick='@(() => Navigation.NavigateTo($"/spaces/{SpaceId}/billing"))'>
                <span class="material-symbols-outlined">calendar_month</span>
                View Billing Periods
            </button>
        </div>
    }
    else
    {
        <div class="bs-flex bs-flex-col bs-gap-4">
            @foreach (var settlement in settlements)
            {
                <div class="bs-card" style="padding: 1.5rem; cursor: pointer; transition: all 0.2s; border-left: 4px solid @(settlement.Status == "Completed" ? "var(--bs-success)" : "var(--bs-warning)");" role="button" tabindex="0" @onclick="() => HandleSettlementSelected(settlement.Id)" @onkeydown="@(e => HandleCardKey(e, settlement.Id))">
                    <div class="bs-flex bs-items-start bs-justify-between" style="margin-bottom: 1rem;">
                        <div>
                            <div class="bs-flex bs-items-center bs-gap-2" style="margin-bottom: 0.25rem;">
                                <h3 style="margin: 0; font-size: 1.125rem; font-weight: 600;">@settlement.BillingPeriodName</h3>
                                <span class="bs-badge @(settlement.Status == "Completed" ? "bs-badge-success" : "bs-badge-warning")">
                                    @(settlement.Status == "Completed" ? "Completed" : "Awaiting confirmation")
                                </span>
                            </div>
                            <p class="bs-text-subtle" style="font-size: 0.875rem; margin: 0;">
                                Generated @settlement.GeneratedAt.ToString("MMM dd, yyyy")
                            </p>
                        </div>
                        <div style="text-align: right;">
                            <p style="font-size: 1.5rem; font-weight: 700; margin: 0; color: var(--bs-primary);">
                                @settlement.Currency @settlement.TotalAmount.ToString("F2")
                            </p>
                            <p class="bs-text-subtle" style="font-size: 0.75rem; margin: 0;">
                                @settlement.ConfirmedLinesCount/@settlement.TotalLinesCount confirmed
                            </p>
                        </div>
                    </div>

                    <!-- Progress bar -->
                    <div style="background: var(--bs-gray-200); border-radius: 9999px; height: 0.375rem; overflow: hidden; margin-bottom: 1rem;">
                        <div style="background: @(settlement.Status == "Completed" ? "var(--bs-success)" : "var(--bs-primary)"); height: 100%; width: @(settlement.TotalLinesCount > 0 ? (int)((double)settlement.ConfirmedLinesCount / settlement.TotalLinesCount * 100) : 0)%; transition: width 0.3s;"></div>
                    </div>

                    <div class="bs-flex bs-gap-4">
                        <div>
                            <p class="bs-text-subtle" style="font-size: 0.75rem; margin: 0 0 0.25rem 0;">Users</p>
                            <p style="font-size: 1.25rem; font-weight: 700; margin: 0;">@settlement.UserCount</p>
                        </div>
                        <div>
                            <p class="bs-text-subtle" style="font-size: 0.75rem; margin: 0 0 0.25rem 0;" title="Your coffee cost for this period">You owe</p>
                            <p style="font-size: 1.25rem; font-weight: 700; margin: 0; color: var(--bs-warning);">
                                @settlement.Currency @settlement.YourShare.ToString("F2")
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<Toast IsVisible="@showToast"
       IsError="@isToastError"
       Title="@toastTitle"
       Message="@toastMessage"
       OnClose="@(() => showToast = false)" />

@code {
    [Parameter]
    public string SpaceId { get; set; } = "";

    private List<SettlementSummaryDto>? settlements;
    private bool isLoading = true;
    private bool showToast;
    private bool isToastError;
    private string toastTitle = "";
    private string toastMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadSettlements();
    }

    private async Task LoadSettlements()
    {
        isLoading = true;
        try
        {
            var query = new GetSpaceSettlementsQuery(new SpaceId(Guid.Parse(SpaceId)));
            var result = await Mediator.Send(query);

            if (result.IsSuccess)
            {
                settlements = result.Value;
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load settlements: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void HandleSettlementSelected(Guid settlementId)
    {
        Navigation.NavigateTo($"/spaces/{SpaceId}/settlements/{settlementId}");
    }

    private void HandleCardKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, Guid settlementId)
    {
        if (e.Key == "Enter" || e.Key == " " || e.Key == "Spacebar")
        {
            HandleSettlementSelected(settlementId);
        }
    }

    private void ShowToast(bool isError, string title, string message)
    {
        isToastError = isError;
        toastTitle = title;
        toastMessage = message;
        showToast = true;
    }
}
