@page "/Error"
@using System.Diagnostics

<PageTitle>Error - BeanShare</PageTitle>

<div class="bs-container" style="display: flex; justify-content: center; padding: 4rem 1rem;">
    <div class="bs-card" style="max-width: 30rem; width: 100%; text-align: center; padding: 2.5rem 2rem;">
        <span class="material-symbols-outlined" style="font-size: 3.5rem; color: var(--bs-error); display: block; margin-bottom: 1rem;">error</span>
        <h1 style="font-size: 1.75rem; margin-bottom: 0.5rem;">Something went wrong</h1>
        <p class="bs-text-subtle" style="margin-bottom: 1.75rem;">
            An unexpected error occurred while processing your request. It's not you &mdash; you can head back home or try again.
        </p>
        <div class="bs-flex bs-gap-3 bs-justify-center" style="flex-wrap: wrap;">
            <a href="/" class="bs-btn bs-btn-primary">
                <span class="material-symbols-outlined">home</span>
                Go to home
            </a>
            <button type="button" class="bs-btn bs-btn-outline" onclick="location.reload()">
                <span class="material-symbols-outlined">refresh</span>
                Try again
            </button>
        </div>
        @if (ShowRequestId)
        {
            <p class="bs-text-subtle" style="margin-top: 1.75rem; font-size: 0.8125rem;">
                Reference: <code>@RequestId</code>
            </p>
        }
    </div>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
