@page "/profile"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using MediatR
@using BeanShare.Application.Abstractions
@using BeanShare.Application.Features.Spaces.Queries
@using BeanShare.Application.Features.Analytics.Queries.GetUserStatistics
@using BeanShare.Application.Features.Users.Commands.UpdateProfile
@using BeanShare.Application.Features.Users.Commands.SetRevolutTag
@using BeanShare.Application.Services
@using BeanShare.Infrastructure.Services
@using BeanShare.Domain.Common
@using System.Linq
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IMediator Mediator
@inject IUserContext UserContext
@inject IUserService UserService
@inject AvatarStorageService AvatarStorageService
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<PageTitle>My Profile - BeanShare</PageTitle>

<div class="bs-container" style="padding: 2rem 0;">
    <div class="profile-header">
        <div class="profile-header-content">
            <div class="profile-avatar-section">
                <div class="avatar-container">
                    @if (!string.IsNullOrEmpty(userProfile?.PictureUrl))
                    {
                        <img src="@GetAvatarUrl()" alt="@userProfile.Name" class="profile-avatar" />
                    }
                    else
                    {
                        <div class="profile-avatar-placeholder">
                            <span class="material-symbols-outlined">account_circle</span>
                        </div>
                    }
                    <button type="button"
                            class="bs-btn bs-btn-primary"
                            style="position: absolute; bottom: 0; right: 0; width: 2.25rem; height: 2.25rem; min-width: 0; padding: 0; border-radius: 50%; border: 3px solid white; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);"
                            title="Change photo"
                            aria-label="Change profile photo"
                            @onclick="TriggerFileUpload">
                        <span class="material-symbols-outlined" style="font-size: 1.125rem;">photo_camera</span>
                    </button>
                    <InputFile id="avatarInput" OnChange="HandleAvatarUpload" accept="image/png,image/jpeg,image/gif,image/webp" style="display: none; position: absolute; width: 0; height: 0; overflow: hidden;" />
                </div>
                @if (isUploadingAvatar)
                {
                    <div class="avatar-upload-status">Uploading...</div>
                }
                @if (!string.IsNullOrEmpty(avatarUploadError))
                {
                    <div class="avatar-upload-error">@avatarUploadError</div>
                }
            </div>
            <div class="profile-info">
                <h1>@(userProfile?.Name ?? "Loading...")</h1>
                <p class="profile-email">@(userProfile?.Email ?? "")</p>
                <p class="profile-joined">Member since @(userProfile?.JoinedDate.ToString("MMMM yyyy") ?? "")</p>
            </div>
        </div>
    </div>

    <div class="bs-flex bs-flex-col bs-gap-6">
        <div class="bs-card">
            <h2 class="bs-mb-4" style="font-size: 1.5rem; font-weight: 600; margin-top: 0;">Coffee Statistics</h2>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem;">
                <div class="bs-card bs-flex bs-items-center bs-gap-3">
                    <span class="material-symbols-outlined" style="font-size: 2.5rem; color: var(--bs-primary);">local_cafe</span>
                    <div>
                        <div style="font-size: 2rem; font-weight: 700;">@(statistics?.TotalCups ?? 0)</div>
                        <div class="bs-text-subtle" style="font-size: 0.875rem;">Total Cups</div>
                    </div>
                </div>
                <div class="bs-card bs-flex bs-items-center bs-gap-3">
                    <span class="material-symbols-outlined" style="font-size: 2.5rem; color: var(--bs-primary);">calendar_month</span>
                    <div>
                        <div style="font-size: 2rem; font-weight: 700;">@(statistics?.CupsThisMonth ?? 0)</div>
                        <div class="bs-text-subtle" style="font-size: 0.875rem;">This Month</div>
                    </div>
                </div>
                <div class="bs-card bs-flex bs-items-center bs-gap-3">
                    <span class="material-symbols-outlined" style="font-size: 2.5rem; color: var(--bs-primary);">groups</span>
                    <div>
                        <div style="font-size: 2rem; font-weight: 700;">@(statistics?.ActiveSpacesCount ?? 0)</div>
                        <div class="bs-text-subtle" style="font-size: 0.875rem;">Active Spaces</div>
                    </div>
                </div>
                <div class="bs-card bs-flex bs-items-center bs-gap-3">
                    <span class="material-symbols-outlined" style="font-size: 2.5rem; color: var(--bs-primary);">trending_up</span>
                    <div>
                        <div style="font-size: 2rem; font-weight: 700;">@(statistics?.AverageCupsPerDay.ToString("F1") ?? "0.0")</div>
                        <div class="bs-text-subtle" style="font-size: 0.875rem;">Daily Average</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="bs-card">
            <div class="bs-flex bs-items-center bs-justify-between bs-mb-4">
                <h2 style="font-size: 1.5rem; font-weight: 600; margin: 0;">My Spaces</h2>
                <button class="bs-btn bs-btn-primary bs-btn-sm" @onclick="NavigateToCreateSpace">
                    <span class="material-symbols-outlined">add</span>
                    Create New Space
                </button>
            </div>
            <div class="bs-flex bs-flex-col bs-gap-3">
                @if (userSpaces != null && userSpaces.Any())
                {
                    @foreach (var space in userSpaces)
                    {
                        <button type="button"
                                class="bs-card bs-flex bs-items-center bs-gap-4"
                                style="width: 100%; text-align: left; cursor: pointer; font: inherit; color: inherit;"
                                @onclick="() => NavigateToSpace(space.Id)">
                            <span class="material-symbols-outlined" style="color: var(--bs-primary); font-size: 1.75rem; flex-shrink: 0;">
                                @(space.Role == "Admin" ? "admin_panel_settings" : "groups")
                            </span>
                            <div class="bs-flex-1" style="min-width: 0;">
                                <h3 style="font-size: 1.125rem; font-weight: 600; margin: 0 0 0.5rem 0;">@space.Name</h3>
                                <div class="bs-flex bs-items-center bs-gap-3">
                                    <span class="bs-badge @(space.Role == "Admin" ? "bs-badge-warning" : "bs-badge-primary")">@space.Role</span>
                                    <span class="bs-text-subtle" style="font-size: 0.875rem;">@space.MemberCount members</span>
                                </div>
                            </div>
                            <span class="material-symbols-outlined bs-text-subtle" style="flex-shrink: 0;">chevron_right</span>
                        </button>
                    }
                }
                else
                {
                    <div class="bs-flex bs-flex-col bs-items-center bs-gap-3" style="padding: 2rem; text-align: center;">
                        <span class="material-symbols-outlined" style="font-size: 3rem; color: var(--bs-text-subtle);">coffee</span>
                        <p class="bs-text-subtle bs-m-0">You haven't joined any spaces yet</p>
                        <button class="bs-btn bs-btn-primary" @onclick="NavigateToSpaces">Browse Spaces</button>
                    </div>
                }
            </div>
        </div>

        <div class="bs-card">
            <h2 class="bs-mb-4" style="font-size: 1.5rem; font-weight: 600; margin-top: 0;">Account Information</h2>
            <div class="bs-grid bs-grid-cols-1 md:bs-grid-cols-2 bs-gap-4">
                <div class="bs-flex bs-flex-col bs-gap-2">
                    <label for="profileName" class="bs-text-subtle" style="font-size: 0.875rem; font-weight: 500;">Full Name</label>
                    <input id="profileName" type="text" class="bs-input" @bind="editName" disabled="@(!isEditing)" />
                </div>
                <div class="bs-flex bs-flex-col bs-gap-2">
                    <label for="profileEmail" class="bs-text-subtle" style="font-size: 0.875rem; font-weight: 500;">Email Address</label>
                    <div class="bs-flex bs-items-center bs-gap-2">
                        <input id="profileEmail" type="email" class="bs-input" value="@userProfile?.Email" disabled aria-describedby="profileEmailHint" />
                        <span class="bs-badge bs-badge-success" title="Verified">
                            <span class="material-symbols-outlined" style="font-size: 1rem;">verified</span>
                            Verified
                        </span>
                    </div>
                    <p id="profileEmailHint" class="bs-text-subtle bs-m-0" style="font-size: 0.75rem;">
                        Email is managed by your sign-in and can't be changed here.
                    </p>
                </div>
                <div class="bs-flex bs-flex-col bs-gap-2">
                    <label for="profileRevolutTag" class="bs-text-subtle" style="font-size: 0.875rem; font-weight: 500;">Revolut username</label>
                    <div class="bs-flex bs-items-center bs-gap-2">
                        <span class="bs-text-subtle" style="font-size: 0.875rem; white-space: nowrap;">revolut.me/</span>
                        <input id="profileRevolutTag" type="text" class="bs-input" @bind="editRevolutTag" disabled="@(!isEditing)" placeholder="username" aria-describedby="profileRevolutTagHint" />
                    </div>
                    <p id="profileRevolutTagHint" class="bs-text-subtle bs-m-0" style="font-size: 0.75rem;">
                        Used for 'Pay me' links on settlements — just your handle (revolut.me/&lt;handle&gt;).
                    </p>
                </div>
            </div>
            <div class="bs-flex bs-gap-3 bs-mt-4" style="justify-content: flex-end;">
                @if (isEditing)
                {
                    <button class="bs-btn bs-btn-outline" @onclick="CancelEdit">Cancel</button>
                    <button class="bs-btn bs-btn-primary" @onclick="SaveProfile">Save Changes</button>
                }
                else
                {
                    <button class="bs-btn bs-btn-secondary" @onclick="StartEdit">
                        <span class="material-symbols-outlined">edit</span>
                        Edit Profile
                    </button>
                }
            </div>
        </div>

    </div>
</div>

<Toast IsVisible="@showToast"
       IsError="@isToastError"
       Title="@toastTitle"
       Message="@toastMessage"
       OnClose="@(() => showToast = false)" />


@code {
    private UserProfile? userProfile;
    private List<UserSpace>? userSpaces;
    private UserStatisticsDto? statistics;

    private bool isEditing = false;
    private string editName = "";
    private string editRevolutTag = "";
    private string loadedRevolutTag = "";

    private bool isUploadingAvatar = false;
    private string? avatarUploadError;
    private int avatarCacheBuster = 0;

    private bool showToast;
    private bool isToastError;
    private string toastTitle = "";
    private string toastMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadUserProfile();
        await LoadUserSpaces();
        await LoadStatistics();
    }

    private async Task LoadUserProfile()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            // Get Name, PictureUrl, and CreatedAt from database (most up-to-date) instead of claims
            string? pictureUrl = authState.User.FindFirst("picture")?.Value;
            string displayName = authState.User.Identity.Name ?? "User";
            DateTime joinedDate = DateTime.Now;
            var userId = UserContext.CurrentUserId;
            if (userId.Value != Guid.Empty)
            {
                try
                {
                    var user = await UserService.GetByIdAsync(userId);
                    if (user is not null)
                    {
                        if (!string.IsNullOrEmpty(user.Name))
                            displayName = user.Name;
                        if (user.PictureUrl is not null)
                            pictureUrl = user.PictureUrl;
                        joinedDate = user.CreatedAt;
                        loadedRevolutTag = user.RevolutTag ?? "";
                        editRevolutTag = loadedRevolutTag;
                    }
                }
                catch
                {
                    // Fall back to claims if database lookup fails
                }
            }

            userProfile = new UserProfile
            {
                Name = displayName,
                Email = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "",
                PictureUrl = pictureUrl,
                JoinedDate = joinedDate
            };

            editName = userProfile.Name;
        }
    }

    private async Task LoadUserSpaces()
    {
        try
        {
            var result = await Mediator.Send(new GetUserSpacesQuery());
            if (result.IsSuccess)
            {
                userSpaces = result.Value.Spaces.Select(s => new UserSpace
                {
                    Id = s.Id,
                    Name = s.Name,
                    Role = s.Role,
                    MemberCount = s.MemberCount
                }).ToList();
            }
        }
        catch
        {
            userSpaces = new List<UserSpace>();
        }
    }

    private async Task LoadStatistics()
    {
        try
        {
            var currentUserId = UserContext.CurrentUserId;
            if (currentUserId.Value != Guid.Empty)
            {
                var query = new GetUserStatisticsQuery(currentUserId);
                statistics = await Mediator.Send(query);
            }
        }
        catch
        {
            // If query fails, statistics will remain null and UI will show 0 values
            statistics = null;
        }
    }

    private void StartEdit()
    {
        isEditing = true;
    }

    private void CancelEdit()
    {
        isEditing = false;
        editName = userProfile?.Name ?? "";
        editRevolutTag = loadedRevolutTag;
    }

    private async Task SaveProfile()
    {
        if (userProfile == null)
            return;

        var command = new UpdateProfileCommand(editName, userProfile.PictureUrl);
        var result = await Mediator.Send(command);
        if (result.IsSuccess)
        {
            await Mediator.Send(new SetRevolutTagCommand(editRevolutTag));
            loadedRevolutTag = editRevolutTag;
            userProfile.Name = editName;
            isEditing = false;
            ShowToast(false, "Profile updated", "Your changes have been saved.");
        }
        else
        {
            ShowToast(true, "Update failed", result.Errors.FirstOrDefault().Message ?? "Could not save your changes.");
        }

        StateHasChanged();
    }

    private void NavigateToSpace(Guid spaceId)
    {
        Navigation.NavigateTo($"/spaces/{spaceId}");
    }

    private void NavigateToSpaces()
    {
        Navigation.NavigateTo("/spaces");
    }

    private void NavigateToCreateSpace()
    {
        Navigation.NavigateTo("/spaces?action=create");
    }

    private string GetAvatarUrl()
    {
        if (string.IsNullOrEmpty(userProfile?.PictureUrl))
            return "";

        if (userProfile.PictureUrl.StartsWith("/uploads/"))
        {
            return $"{userProfile.PictureUrl}?v={avatarCacheBuster}";
        }

        return userProfile.PictureUrl;
    }

    private async Task TriggerFileUpload()
    {
        await JSRuntime.InvokeVoidAsync("beanshare.clickElement", "avatarInput");
    }

    private async Task HandleAvatarUpload(InputFileChangeEventArgs e)
    {
        avatarUploadError = null;
        isUploadingAvatar = true;
        StateHasChanged();

        try
        {
            var file = e.File;

            if (file.Size > 5 * 1024 * 1024)
            {
                avatarUploadError = "File size exceeds 5MB limit";
                return;
            }

            var allowedTypes = new[] { "image/jpeg", "image/png", "image/gif", "image/webp" };
            if (!allowedTypes.Contains(file.ContentType.ToLowerInvariant()))
            {
                avatarUploadError = "Invalid file type. Allowed: jpg, png, gif, webp";
                return;
            }

            using var fileStream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            var result = await AvatarStorageService.SaveAvatarAsync(
                UserContext.CurrentUserId.Value,
                file.Name,
                file.ContentType,
                file.Size,
                fileStream);

            if (result.Success)
            {
                if (!string.IsNullOrEmpty(result.AvatarUrl))
                {
                    if (userProfile != null)
                    {
                        userProfile.PictureUrl = result.AvatarUrl;
                    }

                    var updateCommand = new UpdateProfileCommand(userProfile?.Name ?? "", result.AvatarUrl);
                    await Mediator.Send(updateCommand);

                    avatarCacheBuster++;
                    ShowToast(false, "Photo updated", "Your profile photo has been updated.");
                }
                else
                {
                    avatarUploadError = "Upload failed";
                }
            }
            else
            {
                avatarUploadError = result.Error ?? "Upload failed";
            }
        }
        catch (Exception ex)
        {
            avatarUploadError = $"Error: {ex.Message}";
        }
        finally
        {
            isUploadingAvatar = false;
            StateHasChanged();
        }
    }

    private void ShowToast(bool isError, string title, string message)
    {
        isToastError = isError;
        toastTitle = title;
        toastMessage = message;
        showToast = true;
    }

    private class UserProfile
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string? PictureUrl { get; set; }
        public DateTime JoinedDate { get; set; }
    }

    private class UserSpace
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string Role { get; set; } = "";
        public int MemberCount { get; set; }
    }
}
