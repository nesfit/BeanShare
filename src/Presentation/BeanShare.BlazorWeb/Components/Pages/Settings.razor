@page "/settings"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using BeanShare.SharedUi.Services
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject IThemeService ThemeService
@inject IConfiguration Configuration
@attribute [Authorize]

<PageTitle>Settings - BeanShare</PageTitle>

<div class="bs-container" style="max-width: 760px; padding: 2rem 0;">
    <div style="margin-bottom: 1.5rem;">
        <h1 class="bs-font-bold" style="margin: 0; font-size: 1.5rem;">Settings</h1>
        <p style="margin: 0.25rem 0 0 0; color: var(--bs-text-subtle);">Manage your account preferences and application settings</p>
    </div>

    <nav class="bs-tabs" style="margin-bottom: 1.5rem;">
        <button class="bs-tab @(activeTab == "appearance" ? "bs-tab-active" : "")" @onclick='() => SetActiveTab("appearance")'>
            <span class="material-symbols-outlined" style="font-size: 1.1rem; vertical-align: -3px;">palette</span>
            Appearance
        </button>
        <button class="bs-tab @(activeTab == "privacy" ? "bs-tab-active" : "")" @onclick='() => SetActiveTab("privacy")'>
            <span class="material-symbols-outlined" style="font-size: 1.1rem; vertical-align: -3px;">lock</span>
            Privacy &amp; Security
        </button>
    </nav>

    @if (activeTab == "appearance")
    {
        <div class="bs-card">
            <h2 class="bs-font-bold" style="margin: 0 0 0.25rem 0; font-size: 1.15rem;">Appearance</h2>
            <p style="margin: 0 0 1.25rem 0; color: var(--bs-text-subtle); font-size: 0.9rem;">Customize how BeanShare looks and feels</p>

            <h3 style="margin: 0 0 0.75rem 0; font-size: 0.95rem;">Theme</h3>
            <div class="theme-selector">
                <label class="theme-option @(theme == "light" ? "active" : "")">
                    <input type="radio" name="theme" checked="@(theme == "light")" @onchange='() => SetTheme("light")' />
                    <div class="theme-preview light-preview">
                        <span class="material-symbols-outlined">light_mode</span>
                    </div>
                    <span>Light</span>
                </label>
                <label class="theme-option @(theme == "dark" ? "active" : "")">
                    <input type="radio" name="theme" checked="@(theme == "dark")" @onchange='() => SetTheme("dark")' />
                    <div class="theme-preview dark-preview">
                        <span class="material-symbols-outlined">dark_mode</span>
                    </div>
                    <span>Dark</span>
                </label>
                <label class="theme-option @(theme == "auto" ? "active" : "")">
                    <input type="radio" name="theme" checked="@(theme == "auto")" @onchange='() => SetTheme("auto")' />
                    <div class="theme-preview auto-preview">
                        <span class="material-symbols-outlined">brightness_auto</span>
                    </div>
                    <span>Auto</span>
                </label>
            </div>
            <p style="margin: 1rem 0 0 0; color: var(--bs-text-subtle); font-size: 0.8125rem;">
                <span class="material-symbols-outlined" style="font-size: 0.95rem; vertical-align: -2px;">check_circle</span>
                Your theme is saved automatically.
            </p>
        </div>
    }
    else if (activeTab == "privacy")
    {
        <div class="bs-card">
            <h2 class="bs-font-bold" style="margin: 0 0 0.25rem 0; font-size: 1.15rem;">Privacy &amp; Security</h2>
            <p style="margin: 0 0 1.25rem 0; color: var(--bs-text-subtle); font-size: 0.9rem;">Manage your account security</p>

            <div style="padding: 1rem 0; border-bottom: 1px solid var(--bs-border);">
                <h3 style="margin: 0 0 0.5rem 0; font-size: 0.95rem;">Password</h3>
                @if (useOidc)
                {
                    <p style="margin: 0; color: var(--bs-text-subtle); font-size: 0.875rem;">
                        Your sign-in is managed by <strong>@oidcProviderDisplayName</strong>. Change your password from your @oidcProviderDisplayName account.
                    </p>
                }
                else
                {
                    <p style="margin: 0; color: var(--bs-text-subtle); font-size: 0.875rem;">
                        Your account uses an email &amp; password managed by BeanShare. To reset a forgotten password, use <a class="bs-link" href="/login">the sign-in page</a>.
                    </p>
                }
            </div>

            <div style="padding: 1rem 0 0.25rem 0;">
                <h3 style="margin: 0 0 0.75rem 0; font-size: 0.95rem;">Connected account</h3>
                <div class="bs-flex bs-items-center bs-justify-between" style="gap: 1rem;">
                    <div class="bs-flex bs-items-center" style="gap: 0.75rem;">
                        <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--bs-primary); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">@_connectedAccountBadge</div>
                        <span style="font-weight: 600;">@_connectedAccountName</span>
                    </div>
                    <span style="color: var(--bs-text-subtle); font-size: 0.875rem; text-align: right;">@_connectedAccountDescription</span>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string activeTab = "appearance";
    private string theme = "light";

    private bool useOidc;
    private string oidcProviderDisplayName = "your identity provider";
    private string _connectedAccountName = "Email & password";
    private string _connectedAccountDescription = "Managed directly by BeanShare";
    private string _connectedAccountBadge = "B";

    protected override void OnInitialized()
    {
        useOidc = Configuration.GetValue<bool>("UseOidc", false);
        oidcProviderDisplayName = ResolveOidcProviderDisplayName();
        ConfigureConnectedAccountCard();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadSettings();
        StateHasChanged();
    }

    private async Task LoadSettings()
    {
        theme = await ThemeService.GetThemeAsync();
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
    }

    private async Task SetTheme(string newTheme)
    {
        theme = newTheme;
        await ThemeService.SetThemeAsync(newTheme);
    }

    private void ConfigureConnectedAccountCard()
    {
        if (useOidc)
        {
            _connectedAccountName = oidcProviderDisplayName;
            _connectedAccountDescription = "Connected via OpenID Connect";
            _connectedAccountBadge = GetProviderBadge(oidcProviderDisplayName);
            return;
        }

        _connectedAccountName = "Email & password";
        _connectedAccountDescription = "Managed directly by BeanShare";
        _connectedAccountBadge = "B";
    }

    private string ResolveOidcProviderDisplayName()
    {
        var configuredDisplayName = Configuration["Oidc:ProviderDisplayName"];
        if (!string.IsNullOrWhiteSpace(configuredDisplayName))
        {
            return configuredDisplayName;
        }

        var authority = Configuration["Oidc:Authority"];
        if (Uri.TryCreate(authority, UriKind.Absolute, out var authorityUri))
        {
            return authorityUri.Host;
        }

        return "your identity provider";
    }

    private static string GetProviderBadge(string value)
    {
        var first = value.Trim().FirstOrDefault(char.IsLetterOrDigit);
        return first == default ? "I" : char.ToUpperInvariant(first).ToString();
    }
}
