@page "/history"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject NavigationManager Navigation

<PageTitle>BeanShare</PageTitle>

@code {
    // The cross-space consumption history has moved into each space's Ledger tab, which now
    // supports editing and deleting cups per space (with a per-product running balance). This
    // route redirects for old links/bookmarks; the personal home (/spaces) shows recent activity.
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("/spaces", forceLoad: false, replace: true);
    }
}
