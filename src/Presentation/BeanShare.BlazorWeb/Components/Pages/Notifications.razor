@page "/notifications"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using MediatR
@using BeanShare.Application.Common
@using BeanShare.Application.Features.Notifications.Queries.GetUserNotifications
@using BeanShare.Application.Features.Notifications.Queries.GetUnreadCount
@using BeanShare.Application.Features.Notifications.Commands.MarkNotificationAsRead
@using BeanShare.Application.Features.Notifications.Commands.MarkAllAsRead
@attribute [Authorize]
@inject IScopedSender Mediator
@inject NavigationManager NavigationManager
@inject ILogger<Notifications> Logger

<PageTitle>Notifications - BeanShare</PageTitle>

<div class="bs-container" style="max-width: 800px; margin: 0 auto; padding: 2rem 1rem;">
    <div class="bs-flex bs-items-center bs-justify-between" style="margin-bottom: 2rem;">
        <h1 class="bs-font-bold" style="font-size: 2rem;">Notifications</h1>
        @if (notifications.Any(n => !n.IsRead))
        {
            <button class="bs-btn bs-btn-outline" @onclick="MarkAllAsReadAsync" disabled="@isLoading">
                <span class="material-symbols-outlined" style="margin-right: 0.5rem;">done_all</span>
                Mark all as read
            </button>
        }
    </div>

    @if (isLoading)
    {
        <div class="bs-card" style="text-align: center; padding: 4rem 2rem;">
            <div class="bs-spinner"></div>
            <p style="margin-top: 1rem;">Loading notifications...</p>
        </div>
    }
    else if (!notifications.Any())
    {
        <div class="bs-card" style="text-align: center; padding: 4rem 2rem;">
            <span class="material-symbols-outlined" style="font-size: 4rem; color: var(--bs-gray-400);">notifications_none</span>
            <h3 class="bs-font-medium" style="margin: 1rem 0 0.5rem;">No notifications</h3>
            <p class="bs-text-subtle">You're all caught up! Check back later for updates.</p>
        </div>
    }
    else
    {
        <div class="bs-flex bs-flex-col bs-gap-3">
            @foreach (var notification in notifications.OrderByDescending(n => n.CreatedAt))
            {
                <div class="notification-item @(notification.IsRead ? "notification-read" : "")"
                     role="button"
                     tabindex="0"
                     @onclick="() => HandleNotificationClickAsync(notification)"
                     @onkeydown="(e) => HandleNotificationKeyDownAsync(e, notification)">
                    <div class="bs-flex bs-gap-3">
                        <div class="notification-icon">
                            <span class="material-symbols-outlined">@GetNotificationIcon(notification.Type)</span>
                        </div>
                        <div style="flex: 1;">
                            <div class="bs-flex bs-items-start bs-justify-between">
                                <div style="flex: 1;">
                                    <h3 class="bs-font-medium" style="margin-bottom: 0.25rem;">@notification.Title</h3>
                                    <p class="bs-text-subtle" style="margin-bottom: 0.5rem;">@notification.Message</p>
                                    <span class="bs-text-subtle" style="font-size: 0.875rem;">@GetRelativeTime(notification.CreatedAt)</span>
                                </div>
                                @if (!notification.IsRead)
                                {
                                    <div class="notification-unread-dot"></div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>


@code {
    private List<NotificationItem> notifications = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadNotifications();
    }

    private async Task LoadNotifications()
    {
        isLoading = true;
        try
        {
            var query = new GetUserNotificationsQuery(UnreadOnly: false);
            var result = await Mediator.Send(query);

            if (result.IsSuccess && result.Value != null)
            {
                notifications = result.Value.Notifications.Select(n => new NotificationItem
                {
                    Id = n.Id,
                    Type = ParseNotificationType(n.Type),
                    Title = n.Title,
                    Message = n.Message,
                    CreatedAt = n.CreatedAt,
                    IsRead = n.IsRead,
                    SpaceId = n.SpaceId,
                    ActionUrl = n.ActionUrl
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading notifications");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleNotificationClickAsync(NotificationItem notification)
    {
        await MarkAsReadAsync(notification.Id);

        if (!string.IsNullOrWhiteSpace(notification.ActionUrl))
        {
            NavigationManager.NavigateTo(notification.ActionUrl);
        }
    }

    private async Task HandleNotificationKeyDownAsync(KeyboardEventArgs e, NotificationItem notification)
    {
        if (e.Key is "Enter" or " " or "Spacebar")
        {
            await HandleNotificationClickAsync(notification);
        }
    }

    private async Task MarkAsReadAsync(Guid notificationId)
    {
        var notification = notifications.FirstOrDefault(n => n.Id == notificationId);
        if (notification != null && !notification.IsRead)
        {
            try
            {
                var command = new MarkNotificationAsReadCommand(notificationId);
                var result = await Mediator.Send(command);

                if (result.IsSuccess)
                {
                    notification.IsRead = true;
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error marking notification as read");
            }
        }
    }

    private async Task MarkAllAsReadAsync()
    {
        try
        {
            var command = new MarkAllAsReadCommand();
            var result = await Mediator.Send(command);

            if (result.IsSuccess)
            {
                foreach (var notification in notifications)
                {
                    notification.IsRead = true;
                }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error marking all notifications as read");
        }
    }

    private NotificationType ParseNotificationType(string type)
    {
        return type.ToLowerInvariant() switch
        {
            "lowstock" => NotificationType.Stock,
            "newcoffeeadded" => NotificationType.Stock,
            "billingperiodopened" => NotificationType.Billing,
            "billingperiodclosed" => NotificationType.Billing,
            "settlementready" => NotificationType.Settlement,
            "memberjoined" => NotificationType.Member,
            "memberleft" => NotificationType.Member,
            "spaceinvite" => NotificationType.Member,
            "consumptionrecorded" => NotificationType.Consumption,
            "systemannouncement" => NotificationType.Analytics,
            _ => NotificationType.Analytics
        };
    }

    private string GetNotificationIcon(NotificationType type)
    {
        return type switch
        {
            NotificationType.Stock => "inventory_2",
            NotificationType.Billing => "receipt_long",
            NotificationType.Settlement => "account_balance",
            NotificationType.Member => "person_add",
            NotificationType.Analytics => "analytics",
            NotificationType.Consumption => "coffee",
            _ => "notifications"
        };
    }

    private string GetRelativeTime(DateTime dateTime)
    {
        var timeSpan = DateTime.UtcNow - dateTime;

        if (timeSpan.TotalMinutes < 1)
            return "Just now";
        if (timeSpan.TotalMinutes < 60)
            return $"{(int)timeSpan.TotalMinutes} minute{((int)timeSpan.TotalMinutes != 1 ? "s" : "")} ago";
        if (timeSpan.TotalHours < 24)
            return $"{(int)timeSpan.TotalHours} hour{((int)timeSpan.TotalHours != 1 ? "s" : "")} ago";
        if (timeSpan.TotalDays < 30)
            return $"{(int)timeSpan.TotalDays} day{((int)timeSpan.TotalDays != 1 ? "s" : "")} ago";

        return dateTime.ToString("MMM d, yyyy");
    }

    private class NotificationItem
    {
        public Guid Id { get; set; }
        public NotificationType Type { get; set; }
        public string Title { get; set; } = "";
        public string Message { get; set; } = "";
        public DateTime CreatedAt { get; set; }
        public bool IsRead { get; set; }
        public Guid? SpaceId { get; set; }
        public string? ActionUrl { get; set; }
    }

    private enum NotificationType
    {
        Stock,
        Billing,
        Settlement,
        Member,
        Analytics,
        Consumption
    }
}