@page "/admin/users/{UserId:guid}"
@rendermode InteractiveServer
@using MediatR
@using BeanShare.Application.Features.Admin.Users.Queries
@using BeanShare.Application.Features.Admin.Users.Commands
@using BeanShare.Application.Features.Admin.Users.Dtos
@using BeanShare.Application.Common
@using BeanShare.Domain.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "admin")]
@inject IScopedSender Mediator
@inject NavigationManager Navigation

<PageTitle>User Details - Admin - BeanShare</PageTitle>

<div class="bs-container" style="padding: 2rem 0;">
    <div style="margin-bottom: 1.5rem;">
        <button class="bs-btn bs-btn-sm bs-btn-ghost" @onclick="GoBack">
            <span class="material-symbols-outlined">arrow_back</span>
            Back to Users
        </button>
    </div>

    @if (isLoading)
    {
        <div class="bs-flex bs-flex-col bs-items-center bs-justify-center bs-gap-4" style="padding: 3rem;">
            <div class="bs-spinner"></div>
            <span class="bs-text-subtle">Loading user details...</span>
        </div>
    }
    else if (user == null)
    {
        <EmptyState Icon="person_off"
                    Title="User not found"
                    Message="The requested user could not be found."
                    ActionText="Go Back"
                    ActionIcon="arrow_back"
                    OnAction="GoBack" />
    }
    else
    {
        <div class="bs-grid bs-grid-cols-1 md:bs-grid-cols-2 bs-gap-4" style="align-items: start;">
            <div class="bs-card">
                <div class="bs-flex bs-flex-col bs-items-center" style="text-align: center; margin-bottom: 1.5rem;">
                    <div style="width: 5rem; height: 5rem; border-radius: 9999px; background: var(--bs-primary-light); color: var(--bs-primary); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.5rem; overflow: hidden; margin-bottom: 1rem;">
                        @if (!string.IsNullOrEmpty(user.PictureUrl))
                        {
                            <img src="@user.PictureUrl" alt="@user.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                        }
                        else
                        {
                            @user.Name.GetInitials()
                        }
                    </div>
                    <h2 style="margin: 0 0 0.25rem; font-size: 1.25rem;">@user.Name</h2>
                    <p class="bs-text-subtle" style="margin: 0 0 0.75rem;">@user.Email</p>
                    <div class="bs-flex bs-gap-2 bs-justify-center" style="flex-wrap: wrap;">
                        <span class="bs-badge @(user.SystemRole == SystemRole.SystemAdmin ? "bs-badge-primary" : "bs-badge-secondary")">
                            @(user.SystemRole == SystemRole.SystemAdmin ? "System Admin" : "User")
                        </span>
                        <span class="bs-badge @(user.IsActive ? "bs-badge-success" : "bs-badge-error")">
                            @(user.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>
                </div>

                <div class="bs-flex bs-flex-col bs-gap-2">
                    @if (user.SystemRole != SystemRole.SystemAdmin)
                    {
                        <button class="bs-btn bs-btn-primary" style="width: 100%;" @onclick="ConfirmPromote">
                            <span class="material-symbols-outlined">arrow_upward</span>
                            Promote to Admin
                        </button>
                    }
                    else
                    {
                        <button class="bs-btn bs-btn-secondary" style="width: 100%;" @onclick="ConfirmDemote">
                            <span class="material-symbols-outlined">arrow_downward</span>
                            Demote to User
                        </button>
                    }
                    @if (user.IsActive)
                    {
                        <button class="bs-btn bs-btn-error" style="width: 100%;" @onclick="ConfirmDeactivate">
                            <span class="material-symbols-outlined">block</span>
                            Deactivate Account
                        </button>
                    }
                    else
                    {
                        <button class="bs-btn bs-btn-primary" style="width: 100%;" @onclick="ConfirmReactivate">
                            <span class="material-symbols-outlined">check_circle</span>
                            Reactivate Account
                        </button>
                    }
                </div>
            </div>

            <div class="bs-flex bs-flex-col bs-gap-4">
                <div class="bs-card">
                    <h3 style="margin: 0 0 1rem; font-size: 1.125rem;">Account Information</h3>
                    <div class="bs-grid bs-grid-cols-1 md:bs-grid-cols-2 bs-gap-4">
                        <div style="display: flex; flex-direction: column;">
                            <span class="bs-text-subtle" style="font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem;">User ID</span>
                            <span style="font-family: monospace; word-break: break-all;">@user.Id</span>
                        </div>
                        <div style="display: flex; flex-direction: column;">
                            <span class="bs-text-subtle" style="font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem;">Auth Provider</span>
                            <span>@user.Provider.ToString()</span>
                        </div>
                        <div style="display: flex; flex-direction: column;">
                            <span class="bs-text-subtle" style="font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem;">Preferred Currency</span>
                            <span>@(user.PreferredCurrencyCode ?? "Not set")</span>
                        </div>
                        <div style="display: flex; flex-direction: column;">
                            <span class="bs-text-subtle" style="font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem;">Account Created</span>
                            <span>@user.CreatedAt.ToString("MMMM dd, yyyy 'at' HH:mm")</span>
                        </div>
                        <div style="display: flex; flex-direction: column;">
                            <span class="bs-text-subtle" style="font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem;">Last Login</span>
                            <span>@(user.LastLoginAt == default ? "Never" : user.LastLoginAt.ToString("MMMM dd, yyyy 'at' HH:mm"))</span>
                        </div>
                        @if (user.DeactivatedAt.HasValue)
                        {
                            <div style="display: flex; flex-direction: column;">
                                <span class="bs-text-subtle" style="font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem;">Deactivated At</span>
                                <span style="color: var(--bs-error);">@user.DeactivatedAt.Value.ToString("MMMM dd, yyyy 'at' HH:mm")</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="bs-card">
                    <div class="bs-flex bs-items-center bs-justify-between" style="margin-bottom: 1rem;">
                        <h3 style="margin: 0; font-size: 1.125rem;">Space Memberships (@user.Memberships.Count)</h3>
                        @if (!showAssignForm)
                        {
                            <button class="bs-btn bs-btn-sm bs-btn-primary" @onclick="ShowAssignForm">
                                <span class="material-symbols-outlined" style="font-size: 1rem;">add</span>
                                Add to Space
                            </button>
                        }
                    </div>

                    @if (showAssignForm)
                    {
                        <div class="bs-flex bs-gap-2" style="flex-wrap: wrap; margin-bottom: 1rem;">
                            <select class="bs-input" style="flex: 1; min-width: 12rem;" @bind="selectedSpaceId" disabled="@isAssigning">
                                <option value="">Select a space...</option>
                                @foreach (var space in availableSpaces)
                                {
                                    <option value="@space.Id">@space.Name</option>
                                }
                            </select>
                            <button class="bs-btn bs-btn-primary"
                                    @onclick="AssignUserToSpace"
                                    disabled="@(selectedSpaceId == Guid.Empty || isAssigning)">
                                @if (isAssigning)
                                {
                                    <span class="bs-spinner bs-spinner-sm"></span>
                                }
                                Add
                            </button>
                            <button class="bs-btn bs-btn-secondary" @onclick="CancelAssign" disabled="@isAssigning">
                                Cancel
                            </button>
                        </div>
                        @if (!availableSpaces.Any())
                        {
                            <p class="bs-text-subtle" style="font-size: 0.875rem; margin: 0 0 1rem;">No available spaces to assign. The user is already a member of all active spaces.</p>
                        }
                    }

                    @if (user.Memberships.Any())
                    {
                        <div class="bs-flex bs-flex-col bs-gap-2">
                            @foreach (var membership in user.Memberships)
                            {
                                <div class="bs-flex bs-items-center bs-justify-between bs-gap-2" style="padding: 0.75rem; border: 1px solid var(--bs-border); border-radius: 0.5rem;">
                                    <div class="bs-flex bs-items-center bs-gap-2">
                                        <span class="bs-font-bold">@membership.SpaceName</span>
                                        <span class="bs-badge @(membership.Role.ToString() == "Admin" ? "bs-badge-primary" : "bs-badge-secondary")">
                                            @membership.Role
                                        </span>
                                    </div>
                                    <span class="bs-text-subtle" style="font-size: 0.8125rem; white-space: nowrap;">Joined @membership.JoinedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="bs-flex bs-flex-col bs-items-center bs-gap-2" style="padding: 2rem; text-align: center; color: var(--bs-text-subtle);">
                            <span class="material-symbols-outlined" style="font-size: 2.5rem;">group_off</span>
                            <p style="margin: 0;">This user is not a member of any spaces.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<ConfirmDialog IsVisible="@showConfirmDialog"
               Title="@confirmTitle"
               Message="@confirmMessage"
               ConfirmText="@confirmText"
               IsDestructive="@confirmIsDestructive"
               IsProcessing="@isProcessingConfirm"
               OnConfirm="OnConfirmDialog"
               OnCancel="CancelConfirm" />

<Toast IsVisible="@showToast"
       IsError="@isToastError"
       Title="@toastTitle"
       Message="@toastMessage"
       OnClose="@(() => showToast = false)" />


@code {
    [Parameter]
    public Guid UserId { get; set; }

    private AdminUserDetailDto? user;
    private bool isLoading = true;

    private bool showToast;
    private bool isToastError;
    private string toastTitle = "";
    private string toastMessage = "";

    private bool showConfirmDialog;
    private string confirmTitle = "";
    private string confirmMessage = "";
    private string confirmText = "Confirm";
    private bool confirmIsDestructive;
    private bool isProcessingConfirm;
    private Func<Task>? confirmAction;

    private bool showAssignForm;
    private bool isAssigning;
    private Guid selectedSpaceId;
    private List<SpaceOptionDto> availableSpaces = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadUser();
    }

    private async Task LoadUser()
    {
        isLoading = true;
        try
        {
            var result = await Mediator.Send(new GetUserDetailsQuery(UserId));
            if (result.IsSuccess)
            {
                user = result.Value;
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to load user");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load user: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/admin/users");
    }

    private void ConfirmPromote() => RequestConfirm(
        "Promote to Admin",
        $"Promote {user!.Name} to system admin? This grants full platform admin rights.",
        "Promote",
        destructive: false,
        PromoteUser);

    private void ConfirmDemote() => RequestConfirm(
        "Demote to User",
        $"Remove system admin rights from {user!.Name}? They will become a regular user.",
        "Demote",
        destructive: false,
        DemoteUser);

    private void ConfirmDeactivate() => RequestConfirm(
        "Deactivate Account",
        $"Deactivate {user!.Name}? This disables the account; the user cannot sign in.",
        "Deactivate",
        destructive: true,
        DeactivateUser);

    private void ConfirmReactivate() => RequestConfirm(
        "Reactivate Account",
        $"Reactivate {user!.Name}? This re-enables the account so the user can sign in again.",
        "Reactivate",
        destructive: false,
        ReactivateUser);

    private void RequestConfirm(string title, string message, string confirmLabel, bool destructive, Func<Task> action)
    {
        confirmTitle = title;
        confirmMessage = message;
        confirmText = confirmLabel;
        confirmIsDestructive = destructive;
        confirmAction = action;
        showConfirmDialog = true;
    }

    private async Task OnConfirmDialog()
    {
        if (confirmAction == null) return;

        isProcessingConfirm = true;
        try
        {
            await confirmAction();
        }
        finally
        {
            isProcessingConfirm = false;
            showConfirmDialog = false;
            confirmAction = null;
        }
    }

    private void CancelConfirm()
    {
        showConfirmDialog = false;
        confirmAction = null;
    }

    private async Task PromoteUser()
    {
        try
        {
            var result = await Mediator.Send(new SetUserRoleCommand(UserId, SystemRole.SystemAdmin));
            if (result.IsSuccess)
            {
                ShowToast(false, "Success", "User promoted to System Admin");
                await LoadUser();
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to promote user");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to promote user: {ex.Message}");
        }
    }

    private async Task DemoteUser()
    {
        try
        {
            var result = await Mediator.Send(new SetUserRoleCommand(UserId, SystemRole.User));
            if (result.IsSuccess)
            {
                ShowToast(false, "Success", "User demoted to regular user");
                await LoadUser();
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to demote user");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to demote user: {ex.Message}");
        }
    }

    private async Task DeactivateUser()
    {
        try
        {
            var result = await Mediator.Send(new DeactivateUserCommand(UserId));
            if (result.IsSuccess)
            {
                ShowToast(false, "Success", "User deactivated successfully");
                await LoadUser();
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to deactivate user");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to deactivate user: {ex.Message}");
        }
    }

    private async Task ReactivateUser()
    {
        try
        {
            var result = await Mediator.Send(new ReactivateUserCommand(UserId));
            if (result.IsSuccess)
            {
                ShowToast(false, "Success", "User reactivated successfully");
                await LoadUser();
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to reactivate user");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to reactivate user: {ex.Message}");
        }
    }

    private async Task ShowAssignForm()
    {
        try
        {
            var result = await Mediator.Send(new GetAllSpacesForAssignmentQuery());
            if (result.IsSuccess)
            {
                var memberSpaceIds = user!.Memberships.Select(m => m.SpaceId).ToHashSet();
                availableSpaces = result.Value
                    .Where(s => !memberSpaceIds.Contains(s.Id))
                    .ToList();
                selectedSpaceId = Guid.Empty;
                showAssignForm = true;
            }
            else
            {
                ShowToast(true, "Error", "Failed to load spaces");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load spaces: {ex.Message}");
        }
    }

    private void CancelAssign()
    {
        showAssignForm = false;
        selectedSpaceId = Guid.Empty;
    }

    private async Task AssignUserToSpace()
    {
        if (selectedSpaceId == Guid.Empty)
        {
            return;
        }

        isAssigning = true;
        try
        {
            var result = await Mediator.Send(new AssignUserToSpaceCommand(UserId, selectedSpaceId));
            if (result.IsSuccess)
            {
                showAssignForm = false;
                selectedSpaceId = Guid.Empty;
                ShowToast(false, "Success", "User assigned to space successfully");
                await LoadUser();
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to assign user to space");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to assign user: {ex.Message}");
        }
        finally
        {
            isAssigning = false;
        }
    }

    private void ShowToast(bool isError, string title, string message)
    {
        isToastError = isError;
        toastTitle = title;
        toastMessage = message;
        showToast = true;
    }

}
