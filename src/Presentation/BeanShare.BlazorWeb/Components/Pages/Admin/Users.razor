@page "/admin/users"
@rendermode InteractiveServer
@implements IDisposable
@using MediatR
@using BeanShare.Application.Common
@using BeanShare.Application.Features.Admin.Users.Queries
@using BeanShare.Application.Features.Admin.Users.Commands
@using BeanShare.Application.Features.Admin.Users.Dtos
@using BeanShare.Domain.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "admin")]
@inject IScopedSender Mediator
@inject NavigationManager Navigation

<PageTitle>User Management - Admin - BeanShare</PageTitle>

<div class="bs-container" style="padding: 2rem 0;">
    <div style="margin-bottom: 1.5rem;">
        <h1 class="bs-font-bold" style="font-size: 1.5rem; margin: 0 0 0.25rem;">User Management</h1>
        <p class="bs-text-subtle" style="margin: 0;">Manage system users, roles, and account status</p>
    </div>

    <div class="bs-flex bs-gap-4" style="flex-wrap: wrap; margin-bottom: 1.5rem;">
        <div class="bs-flex bs-flex-col bs-gap-2" style="min-width: 12rem;">
            <label class="bs-label">Filter by Status</label>
            <select class="bs-input" @bind="statusFilter" @bind:after="ApplyFilters">
                <option value="all">All Users</option>
                <option value="active">Active Only</option>
                <option value="inactive">Inactive Only</option>
            </select>
        </div>
        <div class="bs-flex bs-flex-col bs-gap-2" style="min-width: 12rem;">
            <label class="bs-label">Filter by Role</label>
            <select class="bs-input" @bind="roleFilter" @bind:after="ApplyFilters">
                <option value="all">All Roles</option>
                <option value="admin">System Admins</option>
                <option value="user">Regular Users</option>
            </select>
        </div>
        <div class="bs-flex bs-flex-col bs-gap-2" style="flex: 1; min-width: 14rem;">
            <label class="bs-label">Search</label>
            <input type="text" class="bs-input" placeholder="Search by name or email..."
                   value="@searchTerm" @oninput="OnSearchInput" />
        </div>
    </div>

    @if (isLoading)
    {
        <div class="bs-flex bs-flex-col bs-items-center bs-justify-center bs-gap-4" style="padding: 3rem;">
            <div class="bs-spinner"></div>
            <span class="bs-text-subtle">Loading users...</span>
        </div>
    }
    else if (users == null || !users.Any())
    {
        <EmptyState Icon="person_off"
                    Title="No users found"
                    Message="No users match your current filters." />
    }
    else
    {
        <div class="bs-table-wrap">
            <table class="bs-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>System Role</th>
                        <th>Status</th>
                        <th class="bs-table-num">Spaces</th>
                        <th>Joined</th>
                        <th>Last Login</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in users)
                    {
                        <tr style="@(user.IsActive ? "" : "opacity: 0.55;")">
                            <td>
                                <div class="bs-flex bs-items-center bs-gap-3">
                                    <div style="width: 2.25rem; height: 2.25rem; border-radius: 9999px; background: var(--bs-primary-light); color: var(--bs-primary); display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 0.8125rem; flex-shrink: 0; overflow: hidden;">
                                        @if (!string.IsNullOrEmpty(user.PictureUrl))
                                        {
                                            <img src="@user.PictureUrl" alt="@user.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            @user.Name.GetInitials()
                                        }
                                    </div>
                                    <div class="bs-flex bs-flex-col">
                                        <span class="bs-font-bold">@user.Name</span>
                                        <span class="bs-text-subtle" style="font-size: 0.8125rem;">@user.Email</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="bs-badge @(user.SystemRole == SystemRole.SystemAdmin ? "bs-badge-primary" : "bs-badge-secondary")">
                                    @(user.SystemRole == SystemRole.SystemAdmin ? "Admin" : "User")
                                </span>
                            </td>
                            <td>
                                <span class="bs-badge @(user.IsActive ? "bs-badge-success" : "bs-badge-error")">
                                    @(user.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="bs-table-num">@user.SpaceCount</td>
                            <td>@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>@(user.LastLoginAt == default ? "Never" : user.LastLoginAt.ToString("MMM dd, yyyy"))</td>
                            <td>
                                <div class="bs-flex bs-items-center bs-gap-2">
                                    <button class="bs-btn bs-btn-sm bs-btn-ghost" aria-label="View details for @user.Name" title="View details" @onclick="() => ViewUserDetails(user.Id)">
                                        <span class="material-symbols-outlined">visibility</span>
                                    </button>
                                    @if (user.SystemRole != SystemRole.SystemAdmin)
                                    {
                                        <button class="bs-btn bs-btn-sm bs-btn-ghost" aria-label="Promote @user.Name to admin" title="Promote to Admin" @onclick="() => ConfirmPromote(user)">
                                            <span class="material-symbols-outlined" style="color: var(--bs-primary);">arrow_upward</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="bs-btn bs-btn-sm bs-btn-ghost" aria-label="Demote @user.Name to user" title="Demote to User" @onclick="() => ConfirmDemote(user)">
                                            <span class="material-symbols-outlined" style="color: var(--bs-text-subtle);">arrow_downward</span>
                                        </button>
                                    }
                                    @if (user.IsActive)
                                    {
                                        <button class="bs-btn bs-btn-sm bs-btn-ghost" aria-label="Deactivate @user.Name" title="Deactivate user" @onclick="() => ConfirmDeactivate(user)">
                                            <span class="material-symbols-outlined" style="color: var(--bs-error);">block</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="bs-btn bs-btn-sm bs-btn-ghost" aria-label="Reactivate @user.Name" title="Reactivate user" @onclick="() => ConfirmReactivate(user)">
                                            <span class="material-symbols-outlined" style="color: var(--bs-success);">check_circle</span>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<ConfirmDialog IsVisible="@showConfirmDialog"
               Title="@confirmTitle"
               Message="@confirmMessage"
               ConfirmText="@confirmText"
               IsDestructive="@confirmIsDestructive"
               IsProcessing="@isProcessingConfirm"
               OnConfirm="OnConfirmDialog"
               OnCancel="CancelConfirm" />

<Toast IsVisible="@showToast"
       IsError="@isToastError"
       Title="@toastTitle"
       Message="@toastMessage"
       OnClose="@(() => showToast = false)" />


@code {
    private List<AdminUserDto>? users;
    private List<AdminUserDto>? allUsers;
    private bool isLoading = true;
    private string statusFilter = "all";
    private string roleFilter = "all";
    private string searchTerm = "";

    private bool showToast;
    private bool isToastError;
    private string toastTitle = "";
    private string toastMessage = "";

    private bool showConfirmDialog;
    private string confirmTitle = "";
    private string confirmMessage = "";
    private string confirmText = "Confirm";
    private bool confirmIsDestructive;
    private bool isProcessingConfirm;
    private Func<Task>? confirmAction;

    private CancellationTokenSource? _loadCts;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        // Cancel previous load operation if still running
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        var cancellationToken = _loadCts.Token;

        isLoading = true;
        StateHasChanged();

        try
        {
            var result = await Mediator.Send(new GetAllUsersQuery(), cancellationToken);
            if (result.IsSuccess && !cancellationToken.IsCancellationRequested)
            {
                allUsers = result.Value.Users.ToList();
                ApplyFilters();
            }
            else if (!cancellationToken.IsCancellationRequested)
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to load users");
            }
        }
        catch (OperationCanceledException)
        {
            // Operation was cancelled, ignore
        }
        catch (Exception ex)
        {
            if (!cancellationToken.IsCancellationRequested)
            {
                ShowToast(true, "Error", $"Failed to load users: {ex.Message}");
            }
        }
        finally
        {
            if (!cancellationToken.IsCancellationRequested)
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (allUsers == null) return;

        var filtered = allUsers.AsEnumerable();

        if (statusFilter == "active")
            filtered = filtered.Where(u => u.IsActive);
        else if (statusFilter == "inactive")
            filtered = filtered.Where(u => !u.IsActive);

        if (roleFilter == "admin")
            filtered = filtered.Where(u => u.SystemRole == SystemRole.SystemAdmin);
        else if (roleFilter == "user")
            filtered = filtered.Where(u => u.SystemRole == SystemRole.User);

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.ToLower();
            filtered = filtered.Where(u =>
                u.Name.ToLower().Contains(term) ||
                u.Email.ToLower().Contains(term));
        }

        users = filtered.ToList();
    }

    private void ViewUserDetails(Guid userId)
    {
        Navigation.NavigateTo($"/admin/users/{userId}");
    }

    private void ConfirmPromote(AdminUserDto user) => RequestConfirm(
        "Promote to Admin",
        $"Promote {user.Name} to system admin? This grants full platform admin rights.",
        "Promote",
        destructive: false,
        () => PromoteUser(user.Id));

    private void ConfirmDemote(AdminUserDto user) => RequestConfirm(
        "Demote to User",
        $"Remove system admin rights from {user.Name}? They will become a regular user.",
        "Demote",
        destructive: false,
        () => DemoteUser(user.Id));

    private void ConfirmDeactivate(AdminUserDto user) => RequestConfirm(
        "Deactivate Account",
        $"Deactivate {user.Name}? This disables the account; the user cannot sign in.",
        "Deactivate",
        destructive: true,
        () => DeactivateUser(user.Id));

    private void ConfirmReactivate(AdminUserDto user) => RequestConfirm(
        "Reactivate Account",
        $"Reactivate {user.Name}? This re-enables the account so the user can sign in again.",
        "Reactivate",
        destructive: false,
        () => ReactivateUser(user.Id));

    private void RequestConfirm(string title, string message, string confirmLabel, bool destructive, Func<Task> action)
    {
        confirmTitle = title;
        confirmMessage = message;
        confirmText = confirmLabel;
        confirmIsDestructive = destructive;
        confirmAction = action;
        showConfirmDialog = true;
    }

    private async Task OnConfirmDialog()
    {
        if (confirmAction == null) return;

        isProcessingConfirm = true;
        try
        {
            await confirmAction();
        }
        finally
        {
            isProcessingConfirm = false;
            showConfirmDialog = false;
            confirmAction = null;
        }
    }

    private void CancelConfirm()
    {
        showConfirmDialog = false;
        confirmAction = null;
    }

    private async Task PromoteUser(Guid userId)
    {
        try
        {
            var result = await Mediator.Send(new SetUserRoleCommand(userId, SystemRole.SystemAdmin));
            if (result.IsSuccess)
            {
                ShowToast(false, "Success", "User promoted to System Admin");
                await LoadUsers();
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to promote user");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to promote user: {ex.Message}");
        }
    }

    private async Task DemoteUser(Guid userId)
    {
        try
        {
            var result = await Mediator.Send(new SetUserRoleCommand(userId, SystemRole.User));
            if (result.IsSuccess)
            {
                ShowToast(false, "Success", "User demoted to regular user");
                await LoadUsers();
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to demote user");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to demote user: {ex.Message}");
        }
    }

    private async Task DeactivateUser(Guid userId)
    {
        try
        {
            var result = await Mediator.Send(new DeactivateUserCommand(userId));
            if (result.IsSuccess)
            {
                ShowToast(false, "Success", "User deactivated successfully");
                await LoadUsers();
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to deactivate user");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to deactivate user: {ex.Message}");
        }
    }

    private async Task ReactivateUser(Guid userId)
    {
        try
        {
            var result = await Mediator.Send(new ReactivateUserCommand(userId));
            if (result.IsSuccess)
            {
                ShowToast(false, "Success", "User reactivated successfully");
                await LoadUsers();
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to reactivate user");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to reactivate user: {ex.Message}");
        }
    }

    private void ShowToast(bool isError, string title, string message)
    {
        isToastError = isError;
        toastTitle = title;
        toastMessage = message;
        showToast = true;
    }

}
