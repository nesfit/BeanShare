@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject NavigationManager Navigation

<PageTitle>BeanShare</PageTitle>

@code {
    // The former standalone dashboard has been folded into the action-first /spaces home
    // (hero KPIs + "Your insights" panel). Keep the route as a redirect for old links/bookmarks.
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("/spaces", forceLoad: false, replace: true);
    }
}
