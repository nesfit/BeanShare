@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using MediatR
@using BeanShare.Application.Common
@using BeanShare.Application.Features.Spaces.Queries
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IScopedSender Mediator

<PageTitle>Welcome - BeanShare</PageTitle>

<AuthorizeView>
    <Authorized>
        @* Authenticated users are redirected in OnInitializedAsync (smart landing):
           a single space -> straight to its Consumption view (0 clicks to log);
           zero or multiple spaces -> the /spaces home. This skeleton shows only
           for the brief moment before the redirect resolves. *@
        <div class="bs-container bs-flex bs-flex-col bs-items-center" style="padding-top: 5rem; gap: 1rem; text-align: center;">
            <div class="bs-spinner"></div>
            <p class="bs-text-subtle" style="margin: 0;">Taking you to your coffee…</p>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="bs-landing-container">
            <div class="bs-landing-content">
                <div class="bs-landing-header">
                    <h1 class="bs-landing-title">Welcome to BeanShare</h1>
                    <p class="bs-landing-subtitle">
                        Track your coffee consumption and share costs with your team
                    </p>
                </div>

                <div class="bs-landing-features">
                    <div class="bs-feature-card">
                        <span class="material-symbols-outlined bs-feature-icon">groups</span>
                        <h3>Shared Spaces</h3>
                        <p>Create or join spaces with your team to track coffee together</p>
                    </div>
                    <div class="bs-feature-card">
                        <span class="material-symbols-outlined bs-feature-icon">inventory_2</span>
                        <h3>Stock Management</h3>
                        <p>Keep track of coffee purchases and remaining stock</p>
                    </div>
                    <div class="bs-feature-card">
                        <span class="material-symbols-outlined bs-feature-icon">local_cafe</span>
                        <h3>Consumption Logs</h3>
                        <p>Log your coffee consumption and see your costs</p>
                    </div>
                </div>

                <div class="bs-landing-cta">
                    <a href="/register" class="bs-btn bs-btn-primary" style="padding: 1rem 2rem; font-size: 1rem;">
                        Get Started
                    </a>
                    <a href="/login" class="bs-btn bs-btn-secondary" style="padding: 1rem 2rem; font-size: 1rem;">
                        Sign In
                    </a>
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>


@code {
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            return; // anonymous -> render the marketing landing above
        }

        // Smart landing: send a single-space user straight to logging; everyone else
        // to the /spaces home (which lets them pick a space or create/join one).
        try
        {
            var result = await Mediator.Send(new GetUserSpacesQuery());
            if (result.IsSuccess)
            {
                var spaces = result.Value.Spaces.ToList();
                if (spaces.Count == 1)
                {
                    Navigation.NavigateTo($"/spaces/{spaces[0].SpaceId}/consumption");
                    return;
                }
            }
        }
        catch
        {
            // Fall through to the spaces home on any failure loading spaces.
        }

        Navigation.NavigateTo("/spaces");
    }
}
