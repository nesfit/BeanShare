@page "/not-found"
@layout MainLayout

<PageTitle>Not Found - BeanShare</PageTitle>

<div class="bs-empty-state">
    <div class="bs-empty-state-icon">
        <span class="material-symbols-outlined" style="font-size: inherit;">explore_off</span>
    </div>
    <h1 class="bs-empty-state-title">Page not found</h1>
    <p class="bs-empty-state-text">
