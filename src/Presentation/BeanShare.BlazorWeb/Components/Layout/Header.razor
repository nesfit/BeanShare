@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using MediatR
@using BeanShare.Application.Features.Notifications.Queries.GetUnreadCount
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@implements IDisposable
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IServiceScopeFactory ScopeFactory
@inject IJSRuntime JSRuntime

<header class="app-header">
    <div class="header-left">
        <button class="header-menu-toggle" @onclick="ToggleSidebarButton">
            <span class="material-symbols-outlined">@sidebarToggleIcon</span>
        </button>

        @if (Breadcrumbs?.Any() == true)
        {
            <nav class="breadcrumb">
                @foreach (var (text, link, index) in Breadcrumbs.Select((item, i) => (item.Text, item.Link, i)))
                {
                    @if (index > 0)
                    {
                        <span class="breadcrumb-separator">/</span>
                    }
                    @if (!string.IsNullOrEmpty(link) && index < Breadcrumbs.Count - 1)
                    {
                        <a href="@link" class="breadcrumb-link">@text</a>
                    }
                    else
                    {
                        <span class="breadcrumb-current">@text</span>
                    }
                }
            </nav>
        }
    </div>

    <div class="header-center">
        <div class="header-search">
            <span class="material-symbols-outlined search-icon">search</span>
            <input type="text" class="search-input" placeholder="Search spaces, members, or coffee..." @bind="searchQuery" @onkeyup="@(async (e) => { if (e.Key == "Enter") await Search(); })" />
            <span class="search-shortcut">Enter</span>
        </div>
    </div>

    <div class="header-right">
        <AuthorizeView>
            <Authorized>
                <button class="header-icon-btn" title="Notifications" @onclick="ShowNotifications">
                    <span class="material-symbols-outlined">notifications</span>
                    @if (unreadNotifications > 0)
                    {
                        <span class="notification-badge">@unreadNotifications</span>
                    }
                </button>

                <button class="header-icon-btn" title="Help" @onclick="ShowHelp">
                    <span class="material-symbols-outlined">help</span>
                </button>

                <div class="header-user-menu">
                    <button class="header-user-btn" @onclick="ToggleUserDropdown">
                        <div class="header-user-avatar">
                            @if (!string.IsNullOrEmpty(userPictureUrl))
                            {
                                <img src="@userPictureUrl" alt="@userName" />
                            }
                            else
                            {
                                @userName.GetInitials()
                            }
                        </div>
                        <span class="header-user-name">@userName</span>
                        <span class="material-symbols-outlined">@(isUserDropdownOpen ? "expand_less" : "expand_more")</span>
                    </button>

                    @if (isUserDropdownOpen)
                    {
                        <div class="dropdown-backdrop" @onclick="CloseDropdown"></div>
                        <div class="user-dropdown">
                            <div class="dropdown-header">
                                <div class="dropdown-user-info">
                                    <div class="dropdown-user-name">@userName</div>
                                    <div class="dropdown-user-email">@userEmail</div>
                                </div>
                            </div>
                            <div class="dropdown-divider"></div>
                            <button class="dropdown-item" @onclick='() => NavigateTo("/profile")'>
                                <span class="material-symbols-outlined">person</span>
                                <span>My Profile</span>
                            </button>
                            <button class="dropdown-item" @onclick='() => NavigateTo("/settings")'>
                                <span class="material-symbols-outlined">settings</span>
                                <span>Settings</span>
                            </button>
                            <div class="dropdown-divider"></div>
                            <button class="dropdown-item" @onclick='() => NavigateTo("/help")'>
                                <span class="material-symbols-outlined">help</span>
                                <span>Help & Support</span>
                            </button>
                            <div class="dropdown-divider"></div>
                            <button class="dropdown-item dropdown-item-danger" @onclick="Logout">
                                <span class="material-symbols-outlined">logout</span>
                                <span>Logout</span>
                            </button>
                        </div>
                    }
                </div>
            </Authorized>
            <NotAuthorized>
                <a href="/login" class="bs-btn bs-btn-primary bs-btn-sm">Login</a>
                <a href="/register" class="bs-btn bs-btn-secondary bs-btn-sm">Register</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</header>

@code {
    [Parameter] public List<BreadcrumbItem>? Breadcrumbs { get; set; }

    private bool isUserDropdownOpen = false;
    private string searchQuery = "";
    private int unreadNotifications = 0;
    private string userName = "";
    private string userEmail = "";
    private string? userPictureUrl = null;
    private string sidebarToggleIcon = "menu";

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        Navigation.LocationChanged += OnLocationChanged;

        await UpdateUserInfo();
    }

    private async void OnAuthenticationStateChanged(Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState> task)
    {
        try
        {
            await UpdateUserInfo();
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // Component was disposed before callback completed
        }
    }

    private async Task UpdateUserInfo()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            userName = authState.User.Identity.Name ?? "User";
            userEmail = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
            userPictureUrl = authState.User.FindFirst("picture")?.Value;
        }
        else
        {
            userName = "";
            userEmail = "";
            userPictureUrl = null;
            unreadNotifications = 0;
        }
    }

    private async Task LoadUnreadNotifications()
    {
        try
        {
            // Use a separate DI scope to avoid DbContext threading issues
            // when page components also make concurrent MediatR calls
            using var scope = ScopeFactory.CreateScope();
            var mediator = scope.ServiceProvider.GetRequiredService<IMediator>();
            var result = await mediator.Send(new GetUnreadCountQuery());
            if (result.IsSuccess)
            {
                unreadNotifications = result.Value;
            }
        }
        catch
        {
            unreadNotifications = 0;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("beanshare.sidebar.restoreState");
            await UpdateSidebarIcon();
            await LoadUnreadNotifications();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        try
        {
            var isMobile = await JSRuntime.InvokeAsync<bool>("beanshare.isMobile");
            if (isMobile)
            {
                await JSRuntime.InvokeVoidAsync("beanshare.sidebar.close");
            }
        }
        catch (ObjectDisposedException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private async Task ToggleSidebarButton()
    {
        var isMobile = await JSRuntime.InvokeAsync<bool>("beanshare.isMobile");

        if (isMobile)
        {
            var isOpen = await JSRuntime.InvokeAsync<bool>("beanshare.sidebar.isOpen");
            if (isOpen)
            {
                await JSRuntime.InvokeVoidAsync("beanshare.sidebar.close");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("beanshare.sidebar.open");
            }
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("beanshare.sidebar.toggle");
            await UpdateSidebarIcon();
        }
    }

    private async Task UpdateSidebarIcon()
    {
        try
        {
            var collapsed = await JSRuntime.InvokeAsync<bool>("beanshare.sidebar.isCollapsed");
            sidebarToggleIcon = collapsed ? "menu" : "menu_open";
            StateHasChanged();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private void ToggleUserDropdown()
    {
        isUserDropdownOpen = !isUserDropdownOpen;
        StateHasChanged();
    }

    private void CloseDropdown()
    {
        isUserDropdownOpen = false;
        StateHasChanged();
    }

    private async Task Search()
    {
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            Navigation.NavigateTo($"/spaces?q={Uri.EscapeDataString(searchQuery)}");
            searchQuery = "";
        }
    }

    private void NavigateTo(string url)
    {
        isUserDropdownOpen = false;
        StateHasChanged();
        Navigation.NavigateTo(url);
    }

    private void ShowNotifications()
    {
        Navigation.NavigateTo("/notifications");
    }

    private void ShowHelp()
    {
        Navigation.NavigateTo("/help");
    }

    private void ShowKeyboardShortcuts()
    {
        isUserDropdownOpen = false;
        Navigation.NavigateTo("/help");
    }

    private void Logout()
    {
        Navigation.NavigateTo("/logout", forceLoad: true);
    }

    public class BreadcrumbItem
    {
        public string Text { get; set; } = "";
        public string? Link { get; set; }
    }
}