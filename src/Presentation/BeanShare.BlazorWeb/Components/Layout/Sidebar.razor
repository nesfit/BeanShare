@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

<aside class="sidebar">
    <div class="sidebar-header">
        <div class="sidebar-logo" @onclick="NavigateHome">
            <img src="_content/BeanShare.SharedUi/images/logo.svg" alt="BeanShare" class="sidebar-logo-img" />
            <span class="sidebar-brand">BeanShare</span>
        </div>
        <button class="sidebar-toggle" @onclick="ToggleSidebar">
            <span class="material-symbols-outlined">@sidebarIcon</span>
        </button>
    </div>

    <nav class="sidebar-nav">
        <AuthorizeView>
            <Authorized>
                <div class="sidebar-section">
                    <NavLink class="sidebar-link" href="/spaces" Match="NavLinkMatch.All">
                        <span class="material-symbols-outlined">groups</span>
                        <span class="sidebar-link-text">My Spaces</span>
                    </NavLink>

                    <NavLink class="sidebar-link" href="/history">
                        <span class="material-symbols-outlined">history</span>
                        <span class="sidebar-link-text">History</span>
                    </NavLink>
                </div>

                <AuthorizeView Roles="admin">
                    <Authorized Context="adminContext">
                        <div class="sidebar-section sidebar-section-admin">
                            <div class="sidebar-subtitle">Administration</div>
                            <NavLink class="sidebar-link sidebar-link-admin" href="/admin/users" Match="NavLinkMatch.Prefix">
                                <span class="material-symbols-outlined">manage_accounts</span>
                                <span class="sidebar-link-text">User Management</span>
                            </NavLink>
                            <NavLink class="sidebar-link sidebar-link-admin" href="/admin/presets" Match="NavLinkMatch.Prefix">
                                <span class="material-symbols-outlined">tune</span>
                                <span class="sidebar-link-text">Global Presets</span>
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>

                <div class="sidebar-section sidebar-section-bottom">
                    <div class="sidebar-subtitle">Account</div>
                    <NavLink class="sidebar-link" href="/profile">
                        <span class="material-symbols-outlined">person</span>
                        <span class="sidebar-link-text">Profile</span>
                    </NavLink>

                    <NavLink class="sidebar-link" href="/settings">
                        <span class="material-symbols-outlined">settings</span>
                        <span class="sidebar-link-text">Settings</span>
                    </NavLink>

                    <button class="sidebar-link" @onclick="Logout">
                        <span class="material-symbols-outlined">logout</span>
                        <span class="sidebar-link-text">Logout</span>
                    </button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="sidebar-section">
                    <NavLink class="sidebar-link" href="/login">
                        <span class="material-symbols-outlined">login</span>
                        <span class="sidebar-link-text">Login</span>
                    </NavLink>

                    <NavLink class="sidebar-link" href="/register">
                        <span class="material-symbols-outlined">person_add</span>
                        <span class="sidebar-link-text">Register</span>
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>

    <div class="sidebar-footer">
        <div class="sidebar-user">
            <AuthorizeView>
                <Authorized>
                    <div class="sidebar-user-avatar">
                        @if (!string.IsNullOrEmpty(userPictureUrl))
                        {
                            <img src="@userPictureUrl" alt="@userName" />
                        }
                        else
                        {
                            @userName.GetInitials()
                        }
                    </div>
                    <div class="sidebar-user-info">
                        <div class="sidebar-user-name">@userName</div>
                        <div class="sidebar-user-email">@userEmail</div>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
</aside>


@code {
    [Parameter] public EventCallback OnCreateSpace { get; set; }
    [Parameter] public EventCallback OnJoinSpace { get; set; }

    private string userName = "";
    private string userEmail = "";
    private string? userPictureUrl = null;
    private string sidebarIcon = "close";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            userName = authState.User.Identity.Name ?? "User";
            userEmail = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
            userPictureUrl = authState.User.FindFirst("picture")?.Value;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await UpdateSidebarIcon();
        }
    }

    private async Task ToggleSidebar()
    {
        var isMobile = await JSRuntime.InvokeAsync<bool>("beanshare.isMobile");
        if (isMobile)
        {
            await JSRuntime.InvokeVoidAsync("beanshare.sidebar.close");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("beanshare.sidebar.toggle");
            await UpdateSidebarIcon();
        }
    }

    private async Task UpdateSidebarIcon()
    {
        try
        {
            var collapsed = await JSRuntime.InvokeAsync<bool>("beanshare.sidebar.isCollapsed");
            sidebarIcon = collapsed ? "menu" : "close";
            StateHasChanged();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private void NavigateHome()
    {
        Navigation.NavigateTo("/");
    }

    private async Task ShowCreateSpace()
    {
        if (OnCreateSpace.HasDelegate)
        {
            await OnCreateSpace.InvokeAsync();
        }
    }

    private async Task ShowJoinSpace()
    {
        if (OnJoinSpace.HasDelegate)
        {
            await OnJoinSpace.InvokeAsync();
        }
    }

    private void Logout()
    {
        Navigation.NavigateTo("/logout", forceLoad: true);
    }
}